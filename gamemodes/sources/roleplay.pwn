stock SetPlayerSkills(playerid)
{
	SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL_SILENCED, p_info[playerid][pGunSkill][0] * 10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_DESERT_EAGLE, p_info[playerid][pGunSkill][1] * 10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_SHOTGUN, p_info[playerid][pGunSkill][2] * 10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_MP5, p_info[playerid][pGunSkill][3] * 10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_AK47, p_info[playerid][pGunSkill][4] * 10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_M4, p_info[playerid][pGunSkill][5] * 10);
	return 1;
}

stock ToDevelopSkills(slashes, points)
{
	new _str[149], Slash[2] = "|", Point[2] = ".";
	for(new i = 0; i < slashes; i++) strcat(_str, Slash);
	for(new i = 0; i < points; i++) strcat(_str, Point);
	return _str;
}

stock SetPlayerPrison(playerid, place, time)
{
	if(p_info[playerid][pVip] == 3) time /= 2;

    p_info[playerid][pMestoPrison] = place;
    p_info[playerid][pPrison] = time;
	SetPlayerWantedLevel(playerid, 0);
}

function create_server_promocode(playerid, code[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows) return SendClientMessage(playerid, col_white, !""c_error"The promo code already exists.");

	dlobal_string[0] = EOS;
	format(dlobal_string, sizeof(dlobal_string), "INSERT INTO `server_promocode` (`s_promo`,`s_type`,`s_hour`,`s_activation`,`s_money`,`s_exp`,`s_lic_car`,`s_lic_fly`,`s_lic_boat`,`s_lic_gun`,`s_pistol`,`s_deagle`,`s_shotgun`,`s_mp5`,`s_ak47`,`s_m4`) VALUES ('%s','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d')", code, promo_params[0], promo_params[1] * 3600, promo_params[2], promo_params[3], promo_params[4], promo_params[5], promo_params[6], promo_params[7], promo_params[8], (promo_params[9]) ? (100) : (0), (promo_params[10]) ? (100) : (0), (promo_params[11]) ? (100) : (0), (promo_params[12]) ? (100) : (0), (promo_params[13]) ? (100) : (0), (promo_params[14]) ? (100) : (0));
	mysql_query(dbHandle, dlobal_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_sucess"You created a promo code "c_server"%s"c_white". To receive bonuses you need to play: "c_yellow"%d hour(s)", code, promo_params[1]);
	SendClientMessage(playerid, col_white, text_string);

	for(new i; i < 15; i++) promo_params[i] = 0;
	DeletePVar(playerid, "Promo Code");
	return 1;
}

function activation_promocode(playerid, code[])
{
	new rows;
	cache_get_row_count(rows);

	if(!rows) return SendClientMessage(playerid, col_white, !""c_error"The promo code does not exist.");
	else
	{
		new promo_id, promo_type, promo_hour, promo_activation;
		cache_get_value_name_int(0, "s_id", promo_id);
		cache_get_value_name_int(0, "s_type", promo_type);
		cache_get_value_name_int(0, "s_hour", promo_hour);
		cache_get_value_name_int(0, "s_activation", promo_activation);

		if(p_info[playerid][promo_used] == 1) return SendClientMessage(playerid, col_white, !""c_error"You have already activated the promo code from this group.");
		if(promo_type == 1 && promo_activation == 0) return SendClientMessage(playerid, col_white, !""c_error"This promo code has run out of activations.");

	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), "SELECT * FROM `promocode_activation` WHERE `account_id`='%d' AND `promo_name`='%s' LIMIT 1", p_info[playerid][pID], code);
	    new Cache: result = mysql_query(dbHandle, text_string);

	    if(cache_num_rows()) return SendClientMessage(playerid, col_white, !""c_error"You have already activated the promo code.");

		cache_delete(result);

		text_string[0] = EOS;
	    format(text_string, sizeof(text_string), "INSERT INTO `promocode_activation` (`account_id`,`promo_name`,`promo_hour`) VALUES ('%d','%s','%d')", p_info[playerid][pID], code, promo_hour);
		mysql_query(dbHandle, text_string);

		format(text_string, sizeof(text_string), "UPDATE `server_promocode` SET `s_activation`=`s_activation`-'1',`s_promo_used`=`s_promo_used`+'1' WHERE `s_id`='%d' LIMIT 1", promo_id);
		mysql_query(dbHandle, text_string);

		if(promo_type == 0)
		{
	        p_info[playerid][promo_used] = 1;

			format(text_string, sizeof(text_string), "UPDATE `accounts` SET `promo`='1' WHERE `pID`='%d' LIMIT 1", p_info[playerid][pID]);
			mysql_query(dbHandle, text_string);
	    }

		SendClientMessage(playerid, col_white, !""c_sucess"You successfully activated the promo code. Use the command:"c_server"/plist");
	}
	return 1;
}

function time_promocode(playerid)
{
	new rows;
	cache_get_row_count(rows);

    new promo_name[64], promo_hour, promo_accept;
    for(new i; i < rows; i++)
    {
	    cache_get_value_name(i, "promo_name", promo_name);
		cache_get_value_name_int(i, "promo_hour", promo_hour);
		cache_get_value_name_int(i, "promo_accept", promo_accept);

		if(promo_hour != 0 && promo_accept != 1)
		{
			if(promo_hour > 0) promo_hour -= 60;
			else if(promo_hour <= -1) promo_hour = 0;
		}
	}
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "UPDATE `promocode_activation` SET `promo_hour`='%d' WHERE `promo_name`='%s' AND `account_id`='%d'", promo_hour, promo_name, p_info[playerid][pID]);
	mysql_query(dbHandle, text_string);
	return 1;
}

function bonus_promocode(playerid)
{
	new rows;
	cache_get_row_count(rows);

    for(new i; i < rows; i++)
    {
		new promo_name[64], promo_hour, promo_accept;
		cache_get_value_name(i, "promo_name", promo_name);
		cache_get_value_name_int(i, "promo_hour", promo_hour);
		cache_get_value_name_int(i, "promo_accept", promo_accept);

		if(promo_hour <= 0 && promo_accept != 1)
		{
		    new query_string[300];
		    format(query_string, sizeof(query_string), "SELECT `s_promo`,`s_money`,`s_exp`,`s_lic_car`,`s_lic_fly`,`s_lic_boat`,`s_lic_gun`,`s_pistol`,`s_deagle`,`s_shotgun`,`s_mp5`,`s_ak47`,`s_m4` FROM `server_promocode` WHERE `s_promo`='%s'", promo_name);
			new Cache: result = mysql_query(dbHandle, query_string);

            new promo_names[64], promo_money, promo_exp, promo_lic[4], promo_gun[6];
			cache_get_value_name(0, "s_promo", promo_names);
	        cache_get_value_name_int(0, "s_money", promo_money);
	        cache_get_value_name_int(0, "s_exp", promo_exp);
	        cache_get_value_name_int(0, "s_lic_car", promo_lic[0]);
	        cache_get_value_name_int(0, "s_lic_fly", promo_lic[1]);
	        cache_get_value_name_int(0, "s_lic_boat", promo_lic[2]);
	        cache_get_value_name_int(0, "s_lic_gun", promo_lic[3]);
	        cache_get_value_name_int(0, "s_pistol", promo_gun[0]);
	        cache_get_value_name_int(0, "s_deagle", promo_gun[1]);
	        cache_get_value_name_int(0, "s_shotgun", promo_gun[2]);
	        cache_get_value_name_int(0, "s_mp5", promo_gun[3]);
	        cache_get_value_name_int(0, "s_ak47", promo_gun[4]);
	        cache_get_value_name_int(0, "s_m4", promo_gun[5]);

	        if(promo_money >= 1) GivePlayerMoneyEx(playerid, promo_money, "the promo code");
	        if(promo_exp >= 1) GivePlayerExp(playerid, promo_exp);

	        if(promo_lic[0] >= 1) p_info[playerid][pLicenses][0] = 1;
	        if(promo_lic[1] >= 1) p_info[playerid][pLicenses][1] = 1;
	        if(promo_lic[2] >= 1) p_info[playerid][pLicenses][2] = 1;
	        if(promo_lic[3] >= 1) p_info[playerid][pLicenses][3] = 1;

	        if(promo_gun[0] >= 1) p_info[playerid][pGunSkill][0] = promo_gun[0];
	        if(promo_gun[1] >= 1) p_info[playerid][pGunSkill][1] = promo_gun[1];
	        if(promo_gun[2] >= 1) p_info[playerid][pGunSkill][2] = promo_gun[2];
	        if(promo_gun[3] >= 1) p_info[playerid][pGunSkill][3] = promo_gun[3];
	        if(promo_gun[4] >= 1) p_info[playerid][pGunSkill][4] = promo_gun[4];
	        if(promo_gun[5] >= 1) p_info[playerid][pGunSkill][5] = promo_gun[5];

			slobal_string[0] = text_string[0] = EOS;
	        format(text_string, sizeof(text_string), ""c_white"You received a bonus for using the promo code: "c_server"%s\n", promo_names);
			strcat(slobal_string, text_string);

			if(promo_money >= 1)
			{
			    format(text_string, sizeof(text_string), ""c_white"Game currency: "c_green"%d$\n", promo_money);
				strcat(slobal_string, text_string);
			}
			if(promo_exp >= 1)
			{
			    format(text_string, sizeof(text_string), ""c_white"EXP: %d\n", promo_exp);
				strcat(slobal_string, text_string);
			}

			if(promo_lic[0] >= 1) strcat(slobal_string, "\n"c_white"� Driver's license");
			if(promo_lic[1] >= 1) strcat(slobal_string, "\n"c_white"� Air transport license");
			if(promo_lic[2] >= 1) strcat(slobal_string, "\n"c_white"� Water transport license");
			if(promo_lic[3] >= 1) strcat(slobal_string, "\n"c_white"� Weapon carrying license\n");

			if(promo_gun[0] >= 1) strcat(slobal_string, "\n"c_white"� Silenced Pistol");
			if(promo_gun[1] >= 1) strcat(slobal_string, "\n"c_white"� Desert Eagle");
			if(promo_gun[2] >= 1) strcat(slobal_string, "\n"c_white"� Shotgun");
			if(promo_gun[3] >= 1) strcat(slobal_string, "\n"c_white"� MP5");
			if(promo_gun[4] >= 1) strcat(slobal_string, "\n"c_white"� AK-47");
			if(promo_gun[5] >= 1) strcat(slobal_string, "\n"c_white"� M4");
			SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Promo Code", slobal_string, !"Close", !"");

			SavePlayerLicenses(playerid);
			SetPlayerSkills(playerid);

			format(text_string, sizeof(text_string), "UPDATE `promocode_activation` SET `promo_accept`='1' WHERE `account_id`='%d' AND `promo_name`='%s'", p_info[playerid][pID], promo_name);
			mysql_query(dbHandle, text_string);

			cache_delete(result);
		}
	}
	return 1;
}

stock is_text_invalid(text[])
{
    new length = strlen(text);
	for(new i; i < length; i++)
	{
		switch(text[i])
		{
			case 'A'..'Z', 'a'..'z', '0'..'9', '_', '@', '.', ',', '[', ']', ' ': continue;
			default: return 1;
		}
	}
	return 0;
}

stock convert_cmd_time(count)
{
	new hours = 0, minutes = 0, string[30];
	hours = count / 3600;
	minutes = (count - hours * 3600) / 60;
	format(string, 30, "%d hr %d min", hours, minutes);
	return string;
}

stock report_delete(i)
{
	report_player[i] = -1;
    report_text[i][0] = EOS;
    report_text_admin[i][0] = EOS;
    report_slot[i] = -1;
    return 1;
}

stock question_delete(i)
{
	question_player[i] = -1;
	question_text[i][0] = EOS;
    question_text_admin[i][0] = EOS;
    question_slot[i] = -1;
	return 1;
}

function load_car_settings()
{
