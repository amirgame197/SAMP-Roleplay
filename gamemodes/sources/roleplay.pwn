stock find_family_name(family_name[])
{
	new _fam_count = 0;

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "SELECT `fam_name` FROM `family` WHERE `fam_name`='%s' LIMIT 1", family_name);
	new Cache:result = mysql_query(dbHandle, text_string);

	_fam_count = cache_num_rows();

	cache_delete(result);
	return _fam_count;
}

stock family_leader(playerid)
{
	new _t_name[64];

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "SELECT `fam_creator` FROM `family` WHERE `fam_id`='%d' LIMIT 1", p_info[playerid][family]);
	new Cache:result = mysql_query(dbHandle, text_string);

	cache_get_value_name(0, "fam_creator", _t_name);

	cache_delete(result);
	return _t_name;
}

stock clear_fam_house(playerid, house_id)
{
	new family_id = p_info[playerid][family];
	if(family_id)
	{
	    if(!family_info[family_id - 1][fam_house]) return 1;
	    if(family_info[family_id - 1][fam_house] == house_id)
		{
		  			    family_info[family_id - 1][fam_house] = 0;

						text_string[0] = EOS;
		   		    	format(text_string, sizeof(text_string), "UPDATE `family` SET `fam_house`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[family_id - 1][fam_house], family_id);
				 		mysql_query(dbHandle, text_string);
				 		text_string[0] = EOS;
      				    format(text_string, sizeof(text_string), "familyveh/%s.ini", family_info[family_id - 1][fam_name]);
   				        if(fexist(text_string))
    				    {
    				    new FMVEHFILE = ini_openFile(text_string);
    				    ini_getInteger(FMVEHFILE,"family vehicle 1",familyveh1);
    				    ini_getInteger(FMVEHFILE,"family vehicle 2",familyveh2);
    				    ini_getInteger(FMVEHFILE,"family vehicle 3",familyveh3);
    				    ini_getInteger(FMVEHFILE,"family vehicle 4",familyveh4);
    				    ini_getInteger(FMVEHFILE,"family vehicle 5",familyveh5);
    				    ini_getInteger(FMVEHFILE,"familyveh6",familyveh6);
    				    ini_getInteger(FMVEHFILE,"familyveh7",familyveh7);
    				    ini_getInteger(FMVEHFILE,"fmveh1",fmveh1);
						ini_getInteger(FMVEHFILE,"fmveh2",fmveh2);
						ini_getInteger(FMVEHFILE,"fmveh3",fmveh3);
						ini_getInteger(FMVEHFILE,"fmveh4",fmveh4);
						ini_getInteger(FMVEHFILE,"fmveh5",fmveh5);
						ini_getInteger(FMVEHFILE,"fmveh6",fmveh6);
						ini_getInteger(FMVEHFILE,"fmveh7",fmveh7);
						ini_setInteger(FMVEHFILE,"familyvehs",0);
						ini_setInteger(FMVEHFILE,"family vehicle 1",0);
    				    ini_setInteger(FMVEHFILE,"family vehicle 2",0);
    				    ini_setInteger(FMVEHFILE,"family vehicle 3",0);
    				    ini_setInteger(FMVEHFILE,"family vehicle 4",0);
    				    ini_setInteger(FMVEHFILE,"family vehicle 5",0);
    				    ini_setInteger(FMVEHFILE,"familyveh6",0);
    				    ini_setInteger(FMVEHFILE,"familyveh7",0);
    				    ini_setInteger(FMVEHFILE,"ffamilyveh1",1);
	   			        ini_setInteger(FMVEHFILE,"ffamilyveh2",0);
	 			        ini_setInteger(FMVEHFILE,"ffamilyveh3",0);
	 			        ini_setInteger(FMVEHFILE,"ffamilyveh4",0);
	 			        ini_setInteger(FMVEHFILE,"ffamilyveh5",0);
	 			        ini_setInteger(FMVEHFILE,"ffamilyveh6",0);
	 			        ini_setInteger(FMVEHFILE,"ffamilyveh7",0);
     				    ini_closeFile(FMVEHFILE);
						if(familyveh1 == 1 && famvehload[fmveh1] == 1) DestroyVehicle(fmveh1);
						if(familyveh2 == 1 && famvehload[fmveh2] == 1) DestroyVehicle(fmveh2);
						if(familyveh3 == 1 && famvehload[fmveh3] == 1) DestroyVehicle(fmveh3);
						if(familyveh4 == 1 && famvehload[fmveh4] == 1) DestroyVehicle(fmveh4);
						if(familyveh5 == 1 && famvehload[fmveh5] == 1) DestroyVehicle(fmveh5);
						if(familyveh6 == 1 && famvehload[fmveh6] == 1) DestroyVehicle(fmveh6);
						if(familyveh7 == 1 && famvehload[fmveh7] == 1) DestroyVehicle(fmveh7);
						}
		}
	}
	return 1;
}

