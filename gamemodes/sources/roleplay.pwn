/*--------------------------------------------------------------------*/
SetupTune(playerid, vehicleid)
{
	SetVehiclePos(vehicleid, 2176.5900, -1801.8576, 14.9802);
	SetVehicleZAngle(vehicleid, 333.7999);
	SetVehicleVirtualWorld(vehicleid, playerid+1);
	SetPlayerVirtualWorld(playerid, playerid+1);
	PutPlayerInVehicle(playerid, vehicleid, 0);
	CameraDefault(playerid);
	TogglePlayerControllable(playerid, false);
}
/*--------------------------------------------------------------------*/
CloseTunning(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	SetVehiclePos(vehicleid, 2176.5900, -1801.8576, 14.9802);
	SetVehicleZAngle(vehicleid, 333.7999);
	SetVehicleVirtualWorld(vehicleid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	PutPlayerInVehicle(playerid, vehicleid, 0);
	SetCameraBehindPlayer(playerid);
	TogglePlayerControllable(playerid, true);
	InTunning[playerid] = false;
}
