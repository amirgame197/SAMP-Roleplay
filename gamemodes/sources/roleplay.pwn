		else if(i >= car_dealership[4]) SetVehicleVirtualWorld(i, 5);
		else if(i >= car_dealership[3]) SetVehicleVirtualWorld(i, 4);
		else if(i >= car_dealership[2]) SetVehicleVirtualWorld(i, 3);
		else if(i >= car_dealership[1]) SetVehicleVirtualWorld(i, 2);
		else if(i >= car_dealership[0]) SetVehicleVirtualWorld(i, 1);
		LinkVehicleToInterior(i, 82);

		SetVehicleParamsEx(i, false, false, false, true, false, false, false);
		veh_info[i][v_type] = VEHICLE_TYPE_AUTOSALON;
	}

    new objcount;
	printf("[MySQL R41-3]: CreateObject count: %d", (objcount = CreateObject(19122, 0.0, 0.0, -50.0, 0.0, 0.0, 0.0)));
	DestroyObject(objcount);
	SetTimer("HungerSystem", 1000, 1); SetTimer("HungerValues", 230000, 1); SetTimer("ValueHungerDown", 26000, 1);
	SetTimer("WaterSystem", 1000, 1); SetTimer("WaterValues", 230000, 1); SetTimer("ValueWaterDown", 26000, 1);
	return 1;
}

function HungerSystem()
{
	foreach(new i:Player)
	{
		new string[128];

		format(string, sizeof(string), "%d", p_info[i][pHungry]);
  PlayerTextDrawSetString(i, HungerTD[i][1], string); //Goshne
		CheckYourGoshnegi(i);
	}
	return 1;
}

function HungerValues()
{
	foreach(new i:Player)
	{
		if(p_info[i][pLogin] == 1)
		{
			if(p_info[i][pHungry] != 0) p_info[i][pHungry]--;
			OnPlayerUpdateAccountsPer(i, "pHungry", p_info[i][pHungry]);
		}
	}
	return 1;
}


function ValueHungerDown()
{
	foreach(new i:Player)
	{
		if(p_info[i][pLogin] == 1)
		{
			new Float:health;
			GetPlayerHealth(i, health);
			switch(p_info[i][pHungry])
			{
				case 16..25: SetPlayerHealth(i, health-4);
				case 0..15: SetPlayerHealth(i, health-8);
			}
		}
	}
	return 1;
}

function CheckYourGoshnegi(playerid)
{
	new Float:health;
	GetPlayerHealth(playerid, health);
	if(p_info[playerid][pLogin] == 1)
	{
		if(p_info[playerid][pHungry] < 30)
		{
			if(!SendGoshnegiWarn[playerid])
			{
				SendClientMessage(playerid, COLOR_RED, "You need food, {ffffff}please go to the restaurant.");
				SendGoshnegiWarn[playerid] = true;
				SetTimerEx("WarnGoshnegi", 210000, false, "i", playerid);
			}
		}
	}
	return 1;
}

function WarnGoshnegi(playerid) return SendGoshnegiWarn[playerid] = false;


/*---------------------Water--------------------------*/




function WaterSystem()
{
	foreach(new i:Player)
	{
		new string[128];

		format(string, sizeof(string), "%d", p_info[i][pWater]);
		PlayerTextDrawSetString(i, WaterTD[i], string); //Water
		CheckYourWater(i);
        CheckYourPee(i);
	}
	return 1;
}

function WaterValues()
{
	foreach(new i:Player)
	{
		if(p_info[i][pLogin] == 1)
		{
			if(p_info[i][pWater] != 0) p_info[i][pWater]--;
			OnPlayerUpdateAccountsPer(i, "pWater", p_info[i][pWater]);
		}
	}
	return 1;
}


function WaterHungerDown()
{
	foreach(new i:Player)
	{
		if(p_info[i][pLogin] == 1)
		{
			new Float:health;
			GetPlayerHealth(i, health);
			switch(p_info[i][pWater])
			{
				case 16..25: SetPlayerHealth(i, health-4);
				case 0..15: SetPlayerHealth(i, health-8);
			}
		}
	}
	return 1;
}

function CheckYourWater(playerid)
{
	new Float:health;
	GetPlayerHealth(playerid, health);
	if(p_info[playerid][pLogin] == 1)
	{
		if(p_info[playerid][pWater] < 20)
		{
			if(!SendWaterWarn[playerid])
			{
				SendClientMessage(playerid, COLOR_RED, "You need water, {ffffff}please go to the restaurant.");
				SendWaterWarn[playerid] = true;
				SetTimerEx("WarnWater", 210000, false, "i", playerid);
			}
		}
	}
     return 1;
}

	function CheckYourPee(playerid)
{

	{
		if(p_info[playerid][pWater] < 60)
		if(p_info[playerid][pWater] > 50)
		{
			if(!SendWaterWarn1[playerid])
			{
				SendClientMessage(playerid, COLOR_RED, "You have a weapon, {ffffff}Press /pee");
				SendWaterWarn1[playerid] = true;
				SetTimerEx("WarnWater1", 210000, false, "i", playerid);
			}
		}
	}
	return 1;
}

function WarnWater(playerid) return SendWaterWarn[playerid] = false;
function WarnWater1(playerid) return SendWaterWarn1[playerid] = false;
