	return 1;
}
//hastry (_)
cmd:hhp(playerid, params[])
{
	if(p_info[playerid][pHoster] != 1) return SendClientMessage(playerid, -1, "You Are Not A Hoster!");
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /hhp [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

    SetPlayerHealth(targetid, 100);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[H] %s[%d] restored player %s[%d]'s health.", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);

	if(GetPVarInt(targetid, !"p_dead") >= 1) DeletePVar(targetid, !"p_dead");
	return 1;
}
cmd:hgoto(playerid, params[])
{
	if(p_info[playerid][pHoster] != 1) return SendClientMessage(playerid, -1, "You Are Not Hoster!");
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /hgoto [Player id]");
	if(!IsPlayerConnected(targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(p_info[targetid][pPrison] > 0) return SendClientMessage(playerid, col_white, !""c_error"Player is In Jail!");

	if(GetPlayerState(targetid) != 1 && GetPlayerState(targetid) != 2 && GetPlayerState(targetid) != 3) return SendClientMessage(playerid, col_white, !""c_error"The player has not joined the game.");
	if(GetPlayerState(targetid) == PLAYER_STATE_SPECTATING && gSpectateID[targetid] != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The player is in spectator mode.");

    new Float:plocx, Float:plocy, Float:plocz;
	GetPlayerPos(targetid, plocx, plocy, plocz);
	if(GetPlayerState(playerid) == 2)
	{
		new tmpcar = GetPlayerVehicleID(playerid);
		SetVehiclePos(tmpcar, plocx, plocy + 4, plocz + 1);
	}
	else SetPlayerPos(playerid, plocx, plocy + 2, plocz);

	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(targetid));
	SetPlayerInterior(playerid, GetPlayerInterior(targetid));

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[H] %s[%d] teleported to player %s[%d].", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);
	return 1;
}
cmd:hplveh(playerid, params[])
{
	if(p_info[playerid][pHoster] != 1) return SendClientMessage(playerid, -1, "You Are Not A Hoster!");
	extract params -> new player:targetid, model_id; else return SendClientMessage(playerid, col_grey, !"Use: /hplveh [playerid] [model id].");
    if(model_id < 400 || model_id > 611) return SendClientMessage(playerid, col_white, !""c_error"The model ID of the vehicle is between 400 and 611.");
	if(GetPlayerState(targetid) != 1) return SendClientMessage(playerid, col_white, !""c_error"The player is already in a vehicle.");

	new Float:pl_posX, Float:pl_posY, Float:pl_posZ, Float:pl_posA;
	GetPlayerPos(targetid, pl_posX, pl_posY, pl_posZ);
	GetPlayerFacingAngle(targetid, pl_posA);

	if(p_t_info[targetid][plveh] != -1) DestroyVehicle(p_t_info[targetid][plveh]);

	p_t_info[targetid][plveh] = AddStaticVehicle(model_id, pl_posX, pl_posY, pl_posZ, pl_posA, random(100), random(100));
	veh_info[p_t_info[targetid][plveh]][vSost] = 100;
	veh_info[p_t_info[targetid][plveh]][vStatus] = 2;
	Fuell[p_t_info[targetid][plveh]] = MAX_VEHICLE_FUEL;

	SetVehicleVirtualWorld(p_t_info[targetid][plveh], GetPlayerVirtualWorld(targetid));
	LinkVehicleToInterior(p_t_info[targetid][plveh], GetPlayerInterior(targetid));
	PutPlayerInVehicle(targetid, p_t_info[targetid][plveh], 0);

	new lights, alarm, doors, bonnet, boot, objective;
	SetVehicleParamsEx(p_t_info[targetid][plveh], true, lights, alarm, doors, bonnet, boot, objective);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[H] %s[%d] gave temporary transport to player %s[%d] [%d].", Name(playerid), playerid, Name(targetid), targetid, p_t_info[targetid][plveh]);
	send_admin_message(col_grey, text_string);
	return 1;
}
cmd:makehast(playerid, params[])
{
 	if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
 	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /makehstkon [playerid]");
 	if(!IsPlayerConnected(targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
 	if(p_info[targetid][pHoster] == 1) return SendClientMessage(playerid, -1, "Player Is Already Hoster!");
	p_info[targetid][pHoster] = 1;
	update_int_sql(targetid, "pHoster", p_info[targetid][pHoster]);


	/*format_string[0] = EOS;
    mysql_format(dbHandle, format_string, sizeof(format_string), "UPDATE `accounts` SET `pHoster` = '1' WHERE `accounts`.`pName` = '%s'", Name(targetid));
	mysql_tquery(dbHandle, format_string);*/

    format_string[0] = EOS;
	format(format_string, sizeof(format_string), "Administrator %s(%d): You have become the host.", Name(playerid), playerid);
	SendClientMessage(targetid, COLOR_BLUE, format_string);

	format_string[0] = EOS;
	format(format_string, sizeof(format_string), "You have made player %s(%d) the host.", Name(targetid), targetid);
	SendClientMessage(playerid, COLOR_BLUE, format_string);

	return 1;
}
cmd:unhast(playerid, params[])
{
	if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;
 	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /unhoster [playerid]");
 	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pHoster] == 0) return SendClientMessage(playerid, -1, "The player is not the host!");

/*	format_string[0] = EOS;
    mysql_format(dbHandle, format_string, sizeof(format_string), "UPDATE `accounts` SET `pHoster` = '0' WHERE `accounts`.`pName` = '%s'", Name(targetid));
	mysql_tquery(dbHandle, format_string);*/

	p_info[targetid][pHoster] = 0;
	update_int_sql(targetid, "pHoster", p_info[targetid][pHoster]);

    format_string[0] = EOS;
	format(format_string, sizeof(format_string), "Administrator %s(%d): You have been kicked from the host.", Name(playerid), playerid);
	SendClientMessage(targetid, COLOR_BLUE, format_string);

	format_string[0] = EOS;
	format(format_string, sizeof(format_string), "You kicked player %s(%d) from the host.", Name(targetid), targetid);
	SendClientMessage(playerid, COLOR_BLUE, format_string);

	return 1;
}
