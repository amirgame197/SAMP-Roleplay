function FChangeColorVeh(id, slot, color1, color2)
{
	id--;
	slot--;
    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "[Family-Vehicle]: "c_silver"Car color changed from %s(%d) to: %d & %d.", VehicleNames[GetVehicleModel(family_info[id][fam_veh][slot])-400], slot);
    send_family_message(id, col_white, text_string);
    family_info[id][fam_color1][slot] = color1;
    family_info[id][fam_color2][slot] = color2;
    //ChangeVehicleColor(family_info[id][fam_veh][slot], family_info[id][fam_color1][slot], family_info[id][fam_color2][slot]);

    format(MySQLStr, 280, "UPDATE `family` SET `fam_color1` = '%d|%d|%d|%d|%d|%d|%d|%d', `fam_color2` = '%d|%d|%d|%d|%d|%d|%d|%d' WHERE `fam_id` = %d",
	family_info[id][fam_color1][0], family_info[id][fam_color1][1], family_info[id][fam_color1][2], family_info[id][fam_color1][3], family_info[id][fam_color1][4],
    family_info[id][fam_color1][5], family_info[id][fam_color1][6], family_info[id][fam_color1][7],

	family_info[id][fam_color2][0], family_info[id][fam_color2][1], family_info[id][fam_color2][2], family_info[id][fam_color2][3], family_info[id][fam_color2][4],
    family_info[id][fam_color2][5], family_info[id][fam_color2][6], family_info[id][fam_color2][7],
	family_info[id][fam_id]);
	printf("id:%d",family_info[id][fam_id]);
	mysql_tquery(dbHandle, MySQLStr);

	new fvModel = GetVehicleModel(family_info[id][fam_veh][slot]);
	ClearVehicleData(family_info[id][fam_veh][slot]);
	DestroyVehicle(family_info[id][fam_veh][slot]);

	family_info[id][fam_veh][slot] = AddStaticVehicleEx(fvModel, family_info[id][fam_vposx][slot], family_info[id][fam_vposy][slot], family_info[id][fam_vposz][slot], family_info[id][fam_vposa][slot], family_info[id][fam_color1][slot], family_info[id][fam_color2][slot], 900);

	fam_label[id][slot] = Text3D:INVALID_3DTEXT_ID;
	fam_label[id][slot] = Create3DTextLabel(family_info[id][fam_name], 0xFF0000AA, 0.0, 0.0, 0.0, 15.0, 0, 1);
	Attach3DTextLabelToVehicle(fam_label[id][slot], family_info[id][fam_veh][slot], 0.0, 0.0, 0.5);
	return 1;
}
function SaveFVeh(f)
{
    format(MySQLStr, 2000, "UPDATE `family` SET `fam_vposx` = '%f|%f|%f|%f|%f|%f|%f|%f'",
	family_info[f][fam_vposx][0], family_info[f][fam_vposx][1], family_info[f][fam_vposx][2], family_info[f][fam_vposx][3],
	family_info[f][fam_vposx][4], family_info[f][fam_vposx][5], family_info[f][fam_vposx][6],family_info[f][fam_vposx][7]);

    format(MySQLStr, 2000, "%s, `fam_vposy` = '%f|%f|%f|%f|%f|%f|%f|%f'",MySQLStr,
	family_info[f][fam_vposy][0], family_info[f][fam_vposy][1], family_info[f][fam_vposy][2], family_info[f][fam_vposy][3],
	 family_info[f][fam_vposy][4], family_info[f][fam_vposy][5], family_info[f][fam_vposy][6],family_info[f][fam_vposy][7]);

    format(MySQLStr, 2000, "%s, `fam_vposz` = '%f|%f|%f|%f|%f|%f|%f|%f'",MySQLStr,
	family_info[f][fam_vposz][0], family_info[f][fam_vposz][1], family_info[f][fam_vposz][2], family_info[f][fam_vposz][3],
	family_info[f][fam_vposz][4], family_info[f][fam_vposz][5], family_info[f][fam_vposz][6],family_info[f][fam_vposz][7]);

    format(MySQLStr, 2000, "%s, `fam_vposa` = '%f|%f|%f|%f|%f|%f|%f|%f'",MySQLStr,
	family_info[f][fam_vposa][0], family_info[f][fam_vposa][1], family_info[f][fam_vposa][2], family_info[f][fam_vposa][3],
	family_info[f][fam_vposa][4], family_info[f][fam_vposa][5], family_info[f][fam_vposa][6],family_info[f][fam_vposa][7]); //[fam_id]

	format(MySQLStr, 2000, "%s, `fam_veh` = '%d|%d|%d|%d|%d|%d|%d|%d' WHERE fam_id = %d",MySQLStr,
	GetVehicleModel(family_info[f][fam_veh][0]), GetVehicleModel(family_info[f][fam_veh][1]), GetVehicleModel(family_info[f][fam_veh][2]), GetVehicleModel(family_info[f][fam_veh][3]),
	GetVehicleModel(family_info[f][fam_veh][4]), GetVehicleModel(family_info[f][fam_veh][5]), GetVehicleModel(family_info[f][fam_veh][6]),GetVehicleModel(family_info[f][fam_veh][7]), family_info[f][fam_id]); //[fam_id]
	printf("id:%d, f:%d",family_info[f][fam_id],f);
	mysql_tquery(dbHandle, MySQLStr);

	return 1;
}

function SaveHouse(i)
{
	if(i == -1) return 0;

    format(MySQLStr, 666, "UPDATE `house` SET `hOwner` = '%s', `hOwned` = %d, `hHel` = %d, `hLock` = %d, `hUpdAD` = %d, `hUpdHel` = %d, `hUpdSub` = %d, `hUpdStore` = %d, `hSlet` = %d, `hOplata` = %d, `hGaragex` = %f, `hGaragey` = %f, `hGaragez` = %f, `hGarage` = %d, `hAttic` = %d",
 	HouseInfo[i][hOwner], HouseInfo[i][hOwned], HouseInfo[i][hHel], HouseInfo[i][hLock], HouseInfo[i][hUpdAD], HouseInfo[i][hUpdHel], HouseInfo[i][hUpdSub], HouseInfo[i][hUpdStore], HouseInfo[i][hSlet], HouseInfo[i][hOplata], HouseInfo[i][hGaragex], HouseInfo[i][hGaragey], HouseInfo[i][hGaragez], HouseInfo[i][hGarage], HouseInfo[i][hAttic]);

	format(MySQLStr, 666, "%s, `hHealpickX` = %f, `hHealpickY` = %f, `hHealpickZ` = %f , `hValue` = %d, `hEntrancex` = %f, `hEntrancey` = %f, `hEntrancez` = %f, `hKlass` = %d, `hInt` = %d WHERE `hID` = %d", MySQLStr, HouseInfo[i][hHealpickX], HouseInfo[i][hHealpickY], HouseInfo[i][hHealpickZ], HouseInfo[i][hValue], HouseInfo[i][hEntrancex],  HouseInfo[i][hEntrancey],  HouseInfo[i][hEntrancez], HouseInfo[i][hKlass], HouseInfo[i][hInt], HouseInfo[i][hID]);
 	//
    mysql_tquery(dbHandle, MySQLStr);
    return 1;
}
function SaveABizz(i)
{
    format(MySQLStr, 344, "UPDATE `bizz_fuel` SET `aOwned` = %d, `aOwner` = '%s', `aMoney` = %d, `aRaschet` = %d, `aSklad` = %d, `aLocked` = %d, `aProducts` = %d, `aPrice` = %d, `aMafia` = %d, `aOplata` = %d, `aSlet` = %d WHERE `aID` = %d",
    BizzAInfo[i][aOwned], BizzAInfo[i][aOwner], BizzAInfo[i][aMoney], BizzAInfo[i][aRaschet], BizzAInfo[i][aSklad], BizzAInfo[i][aLocked], BizzAInfo[i][aProducts], BizzAInfo[i][aPrice], BizzAInfo[i][aMafia], BizzAInfo[i][aOplata], BizzAInfo[i][aSlet], i);

    mysql_tquery(dbHandle, MySQLStr);
    return 1;
}
stock SaveBizz(i)
{
	if(BizzInfo[i][bEntranceX] == 0.0) return 0;

    format(MySQLStr, 440, "UPDATE `bizz` SET `bOwned` = %d, `bOwner` = '%s', `bEntranceCost` = %d, `bMoney` = %d, `bRaschet` = %d, `bLocked` = %d, `bProducts` = %d, `bPrice` = %d, `bMafia` = %d, `bSlet` = %d, `bOplata` = %d",
	BizzInfo[i][bOwned], BizzInfo[i][bOwner], BizzInfo[i][bEntranceCost], BizzInfo[i][bMoney], BizzInfo[i][bRaschet], BizzInfo[i][bLocked], BizzInfo[i][bProducts], BizzInfo[i][bPrice], BizzInfo[i][bMafia], BizzInfo[i][bSlet], BizzInfo[i][bOplata]);

	format(MySQLStr, 440, "%s, `bUpdMusic` = %d, `bUpdHeal` = %d, `bUpdSub` = %d, `bSklad` = %d, `bPhone` = %d, `bProcent` = %d, `bSotrud` = %d WHERE `bID` = %d",
 	MySQLStr, BizzInfo[i][bUpdMusic], BizzInfo[i][bUpdHeal], BizzInfo[i][bUpdSub], BizzInfo[i][bSklad], BizzInfo[i][bPhone], BizzInfo[i][bProcent], BizzInfo[i][bSotrud], i);

    mysql_tquery(dbHandle, MySQLStr);
    return 1;
}

function SaveFrac(i)
{
	format(MySQLStr, 440, "%s, `fBank0` = %d, `fBank1` = %d, `fBank2` = %d WHERE `fID` = %d",
	MySQLStr, FracInfo[i][fBank][0], FracInfo[i][fBank][1], FracInfo[i][fBank][2], i);

	mysql_tquery(dbHandle, MySQLStr, "", "");
	return 1;
}

stock SaveCars(playerid)
{
    if(p_info[playerid][pLogin] == 0) return 1;

    format(MySQLStr, 1200, "UPDATE `accounts` SET `cModel` = '%d,%d,%d', ",
    CarInfo[playerid][cModel][0], CarInfo[playerid][cModel][1], CarInfo[playerid][cModel][2]);

	format(MySQLStr, 1200, "%s `cSost` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cSost][0], CarInfo[playerid][cSost][1], CarInfo[playerid][cSost][2]);

    format(MySQLStr, 1200, "%s `cColor1` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cColor1][0], CarInfo[playerid][cColor1][1], CarInfo[playerid][cColor1][2]);

    format(MySQLStr, 1200, "%s `cColor2` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cColor2][0], CarInfo[playerid][cColor2][1], CarInfo[playerid][cColor2][2]);

    format(MySQLStr, 1200, "%s `cNumber` = '%s,%s,%s', ", MySQLStr,
    VehicleNumberPlate[playerid][0], VehicleNumberPlate[playerid][1], VehicleNumberPlate[playerid][2]);

    format(MySQLStr, 1200, "%s `cPaintJobs` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cPaintJobs][0], CarInfo[playerid][cPaintJobs][1], CarInfo[playerid][cPaintJobs][2]);

    format(MySQLStr, 1200, "%s `cLock` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cLock][0], CarInfo[playerid][cLock][1], CarInfo[playerid][cLock][2]);

    format(MySQLStr, 1200, "%s `cFuel` = '%f,%f,%f', ", MySQLStr,
    CarInfo[playerid][cFuel][0], CarInfo[playerid][cFuel][1], CarInfo[playerid][cFuel][2]);

    format(MySQLStr, 1200, "%s `cCost` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cCost][0], CarInfo[playerid][cCost][1], CarInfo[playerid][cCost][2]);

    format(MySQLStr, 1200, "%s `cProbeg` = '%f,%f,%f', ", MySQLStr,
    CarInfo[playerid][cProbeg][0], CarInfo[playerid][cProbeg][1], CarInfo[playerid][cProbeg][2]);

    format(MySQLStr, 1200, "%s `cWheels` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cWheels][0], CarInfo[playerid][cWheels][1], CarInfo[playerid][cWheels][2]);

    format(MySQLStr, 1200, "%s `cSpoiler` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cSpoiler][0], CarInfo[playerid][cSpoiler][1], CarInfo[playerid][cSpoiler][2]);

    format(MySQLStr, 1200, "%s `cBumper1` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cBumper1][0], CarInfo[playerid][cBumper1][1], CarInfo[playerid][cBumper1][2]);

    format(MySQLStr, 1200, "%s `cBumper2` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cBumper2][0], CarInfo[playerid][cBumper2][1], CarInfo[playerid][cBumper2][2]);

    format(MySQLStr, 1200, "%s `cNitro` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cNitro][0], CarInfo[playerid][cNitro][1], CarInfo[playerid][cNitro][2]);

    format(MySQLStr, 1200, "%s `cHydrawlic` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cHydrawlic][0], CarInfo[playerid][cHydrawlic][1], CarInfo[playerid][cHydrawlic][2]);

    format(MySQLStr, 1200, "%s `cHood` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cHood][0], CarInfo[playerid][cHood][1], CarInfo[playerid][cHood][2]);

    format(MySQLStr, 1200, "%s `cRoof` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cRoof][0], CarInfo[playerid][cRoof][1], CarInfo[playerid][cRoof][2]);

    format(MySQLStr, 1200, "%s `cSideskirt` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cSideskirt][0], CarInfo[playerid][cSideskirt][1], CarInfo[playerid][cSideskirt][2]);

    format(MySQLStr, 1200, "%s `cLamps` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cLamps][0], CarInfo[playerid][cLamps][1], CarInfo[playerid][cLamps][2]);

    format(MySQLStr, 1200, "%s `cExhaust` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cExhaust][0], CarInfo[playerid][cExhaust][1], CarInfo[playerid][cExhaust][2]);

    format(MySQLStr, 1200, "%s `cStereo` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cStereo][0], CarInfo[playerid][cStereo][1], CarInfo[playerid][cStereo][2]);

    format(MySQLStr, 1200, "%s `cVentRight` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cVentRight][0], CarInfo[playerid][cVentRight][1], CarInfo[playerid][cVentRight][2]);

    format(MySQLStr, 1200, "%s `cVentLeft` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cVentLeft][0], CarInfo[playerid][cVentLeft][1], CarInfo[playerid][cVentLeft][2]);

    format(MySQLStr, 1200, "%s `cHeal` = '%f,%f,%f	', ", MySQLStr,
    CarInfo[playerid][cHeal][0], CarInfo[playerid][cHeal][1], CarInfo[playerid][cHeal][2]);

    format(MySQLStr, 1200, "%s `cDamagePanel` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cDamagePanel][0], CarInfo[playerid][cDamagePanel][1], CarInfo[playerid][cDamagePanel][2]);

    format(MySQLStr, 1200, "%s `cDamageDoors` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cDamageDoors][0], CarInfo[playerid][cDamageDoors][1], CarInfo[playerid][cDamageDoors][2]);

    format(MySQLStr, 1200, "%s `cDamageLights` = '%d,%d,%d', ", MySQLStr,
    CarInfo[playerid][cDamageLights][0], CarInfo[playerid][cDamageLights][1], CarInfo[playerid][cDamageLights][2]);

    format(MySQLStr, 1200, "%s `cDamageTires` = '%d,%d,%d' WHERE `pID` = %d", MySQLStr,
    CarInfo[playerid][cDamageTires][0], CarInfo[playerid][cDamageTires][1], CarInfo[playerid][cDamageTires][2], GetPlayerAccountID(playerid));

	mysql_tquery(dbHandle, MySQLStr);

    return 1;
}

public OnQueryError(errorid, const error[], const callback[], const query[], MySQL:handle)
{
	printf("Error in mysql: ID %d | Error: %s | Function: %s | Query: %s", errorid, error, callback, query);
	return 1;
}

function OnMySQL_Query(playerid, id, params[])
{
    new rows;
    cache_get_row_count(rows);
    switch(id)
    {
		case 2:
		{
		    if(!rows) return dialog_referal(playerid);
			else
			{
				cache_get_value_int(0, "pID", p_info[playerid][pReferal]);

				text_string[0] = EOS;
				format(text_string, sizeof(text_string), "Player %s receives a reward for your attendance.", params);
				SendClientMessage(playerid, col_white, text_string);

				SPD(playerid, 5, DIALOG_STYLE_MSGBOX, !""c_server"Gender", !""c_white"Please select your gender.", !"Male", !"Female");
			}
		}
		case 3:
		{
		    if(!rows) return SendClientMessage(playerid, -1, "Statistics have not yet been compiled.");

			if(rows > 20)
			{
			    new b = GetPVarInt(playerid, "CheckStatsBizz");
				format(MySQLStr, 96, "SELECT * FROM `bizz_stats` WHERE `bID` = %d LIMIT %d,%d", b, rows-20, rows);
				mysql_tquery(dbHandle, MySQLStr, "OnMySQL_Query","dd", playerid, 4);
				return 1;
			}

		    String = "";
		    new bDate[16], strg[124], bSumma;

		    strcat(String, "{FFDEAD}Yes, before business");
		    for(new i; i < rows; i++)
		    {
     			cache_get_value_name(i, "bData", bDate, 16);
    			cache_get_value_name_int(i, "bSumma", bSumma);

        		format(strg,sizeof(strg),""c_white"%s\t\t\t%d$\n",bDate,bSumma), strcat(String,strg);
    		}
		   	SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"business before in 20 days", String, "Close","");
		   	return 1;
  		}
		case 4:
		{
		    if(!rows) return SendClientMessage(playerid, -1, "A global error has occurred, please inform the administration.");

		    new bDate[16], strg[124], bSumma;

            String = "{FFDEAD}Yes, before business";
		    for(new i; i < rows; i++)
		    {
     			cache_get_value_name(i, "bData", bDate, 16);
    			cache_get_value_name_int(i, "bSumma", bSumma);

        		format(strg,sizeof(strg),""c_white"%s\t\t\t%d$\n",bDate,bSumma), strcat(String,strg);
    		}
    		SetPVarInt(playerid, "CheckStatsBizz", 0);
		   	SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"business before in 20 days", String, "Close","");
		   	return 1;
		}
		case 5:
		{
		    if(rows) // ???? ????? ????? ??? ????
			{
			    player_sim_number[playerid] = 111111 + random(888888);

			    format(MySQLStr, 96, "SELECT * FROM `accounts` WHERE `pNumber` = %d", player_sim_number[playerid]);
		    	mysql_tquery(dbHandle, MySQLStr, "OnMySQL_Query","iis", playerid, 5, player_sim_number[playerid]);
				return 1;
			}
			new h = player_use_bizbar[playerid];
 		    if(!PlayerToPoint(3, playerid,BizzInfo[h][bBarX], BizzInfo[h][bBarY], BizzInfo[h][bBarZ]) || GetPlayerVirtualWorld(playerid) != BizzInfo[h][bVirtualWorld]) return player_use_bizbar[playerid] = 0;

   			SCMF(playerid, -1, "Your mobile phone number: {03D7FF}%d", player_sim_number[playerid]);
   			p_info[playerid][pNumber] = player_sim_number[playerid];
   			OnPlayerUpdateAccountsPer(playerid, "pNumber", p_info[playerid][pNumber]);
      		player_sim_number[playerid] = 0;
   		}
   		case 6:
   		{
   		    if(rows) return SPD(playerid, 62, DIALOG_STYLE_INPUT, !""c_server"SIM card", ""c_white"Enter the desired number for purchase:\nThis number is already taken, try another\n", "Choose", "Back"), player_sim_number[playerid] = 0;

   		    new h = player_use_bizbar[playerid];
 		    if(!PlayerToPoint(3, playerid,BizzInfo[h][bBarX], BizzInfo[h][bBarY], BizzInfo[h][bBarZ]) || GetPlayerVirtualWorld(playerid) != BizzInfo[h][bVirtualWorld]) return player_use_bizbar[playerid] = 0;

 		    new cena = BizzInfo[h][bPrice]*2;
 		    SCMF(playerid, -1, "You bought a new phone number, your new number: {03D7FF}%d", player_sim_number[playerid]), SetPlayerChatBubble(playerid, "bought a SIM card",COLOR_NEWS,30.0,10000);

       		GiveBusinessMoney(h, cena, 4);
	    	GivePlayerMoneyEx(playerid, -cena, "purchase of a phone number"), p_info[playerid][pNumber] = player_sim_number[playerid];
	    	OnPlayerUpdateAccountsPer(playerid, "pNumber", p_info[playerid][pNumber]);
	    	player_sim_number[playerid] = 0, ProductsMenu(playerid);
	    }
	    case 7:
		{
		    if(!rows) return SendClientMessage(playerid, -1, "Statistics have not yet been compiled.");

			if(rows > 20)
			{
			    new b = GetPVarInt(playerid, "CheckStatsABizz");
				format(MySQLStr, 96, "SELECT * FROM `bizz_astats` WHERE `aID` = %d LIMIT %d,%d", b, rows-20, rows);
				mysql_tquery(dbHandle, MySQLStr, "OnMySQL_Query","dd", playerid, 8);
				return 1;
			}

		    String = "";
		    new aDate[16], strg[124], aSumma;

		    strcat(String, "{FFDEAD}Yes, before business");
		    for(new i; i < rows; i++)
		    {
     			cache_get_value_name(i, "aData", aDate, 16);
    			cache_get_value_name_int(i, "aSumma", aSumma);

        		format(strg,sizeof(strg),""c_white"%s\t\t\t%d$\n",aDate,aSumma), strcat(String,strg);
    		}
		   	SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Before??? Gas station for 20 days", String, "Close","");
		   	return 1;
  		}
  		case 8:
		{
		    if(!rows) return SendClientMessage(playerid, -1, "A global Error(#1) has occurred, please inform the administration.");

		    String = "";
		    new aDate[16], strg[124], aSumma;

            strcat(String, "{FFDEAD}Yes, before business");
		    for(new i; i < rows; i++)
		    {
     			cache_get_value_name(i, "aData", aDate, 16);
    			cache_get_value_name_int(i, "aSumma", aSumma);

        		format(strg,sizeof(strg),""c_white"%s\t\t\t%d$\n",aDate,aSumma), strcat(String,strg);
    		}
    		SetPVarInt(playerid, "CheckStatsABizz", 0);
		   	SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Before??? Gas station for 20 days", String, "Close","");
		   	return 1;
		}
		case 9:
		{
		    if(!rows) return SendClientMessage(playerid, -1, "Account with this IP address (last entry) not found.");

		    if(rows > 20)
		    {
		        SetPVarInt(playerid, "allrows", rows);
		        format(MySQLStr, 96, "SELECT * FROM `accounts` WHERE `pIp` = '%s' LIMIT %d,%d", params, rows-20, rows);
				mysql_tquery(dbHandle, MySQLStr, "OnMySQL_Query","iis", playerid, 10, params);
				return 1;
			}
		    String = "";
		    new lastIP[MAX_IP_ADRESS], Name[24], strg[124];
		    new IpReg[MAX_IP_ADRESS], level;

		    strcat(String, "{FFDEAD}Name\t{FFDEAD}IP Address (last login)\t{FFDEAD}IP Address (registration)\t{FFDEAD}Level\n\n");
		    for(new i; i < rows; i++)
		    {
		        cache_get_value_name(i, "pName", Name, 36);
     			cache_get_value_name(i, "pIp", lastIP, MAX_IP_ADRESS);
     			cache_get_value_name(i, "pIpReg", IpReg, MAX_IP_ADRESS);
     			cache_get_value_name_int(i, "pLevel", level);

        		format(strg,sizeof(strg),""c_white"%s\t%s\t%s\t%d\n",Name, lastIP, IpReg, level), strcat(String, strg);
    		}
		   	SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Information about the IP address", String, "Close","");
		   	SCMF(playerid, -1, "You have been shown the last 20 accounts from this IP address. Total in the database {FFB103}%d "c_white"accounts from this IP.", rows);
		   	return 1;
		}
		case 10:
		{
		    String = "";
		    new lastIP[MAX_IP_ADRESS], Name[24], strg[124];
		    new IpReg[MAX_IP_ADRESS], level;

		    strcat(String, "{FFDEAD}Name\t{FFDEAD}IP Address (last login)\t{FFDEAD}IP Address (registration)\t{FFDEAD}Level\n\n");
		    for(new i; i < rows; i++)
		    {
		        cache_get_value_name(i, "pName", Name, 36);
     			cache_get_value_name(i, "pIp", lastIP, MAX_IP_ADRESS);
     			cache_get_value_name(i, "pIpReg", IpReg, MAX_IP_ADRESS);
     			cache_get_value_name_int(i, "pLevel", level);

        		format(strg,sizeof(strg),""c_white"%s\t%s\t%s\t%d\n",Name, lastIP, IpReg, level), strcat(String, strg);
    		}
		   	SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Information about the IP address", String, "Close","");
		   	SCMF(playerid, -1, "You have been shown the last 20 accounts from this IP address. Total in the database {FFB103}%d "c_white"accounts from this IP.", GetPVarInt(playerid, "allrows"));
		   	return 1;
		}
		case 11:
		{
		    if(rows) return SPD(playerid, 103, DIALOG_STYLE_INPUT, !""c_server"Phone number", ""c_white"Enter the desired number for purchase:\nThis number is already taken, try another\n", "Choose", "Back"), SendClientMessage(playerid, 0xB8B8B8FF, "[Check]: The number is occupied by a Player!"), player_sim_number[playerid] = 0;

 		    SendClientMessage(playerid, 0xB8B8B8FF, "[Check]: The number is not occupied by Players ...");

 		    format(MySQLStr, 96, "SELECT * FROM `bizz` WHERE `bPhone` = %d", player_sim_number[playerid]);
	    	mysql_tquery(dbHandle, MySQLStr, "OnMySQL_Query","iis", playerid, 12, player_sim_number[playerid]);
	    	return 1;
	    }
	    case 12:
	    {
	        if(rows) return SPD(playerid, 103, DIALOG_STYLE_INPUT, !""c_server"Phone number", ""c_white"Enter the desired number for purchase:\nThis number is already taken, try another\n", "Choose", "Back"), SendClientMessage(playerid, 0xB8B8B8FF, "[Check]: The number is occupied by a Residence!"), player_sim_number[playerid] = 0;

 		    SendClientMessage(playerid, 0xB8B8B8FF, "[Check]: The number is not occupied by enterprises ...");


 		    SendClientMessage(playerid, 0xBEF500FF, "You bought a 4-digit mobile phone number for your enterprise.");
 		    SCMF(playerid, 0xBEF500FF, "Before, you can call the line now at number: {03D7FF}%d", player_sim_number[playerid]);
	    	GivePlayerMoneyEx(playerid, -10000, "purchase of a number from Taxi"), BizzInfo[GetPlayerBizz(playerid)][bPhone] = player_sim_number[playerid];
	    	SaveBizzPer(GetPlayerBizz(playerid), "bPhone", BizzInfo[GetPlayerBizz(playerid)][bPhone]);
	    	player_sim_number[playerid] = 0;
	    	return 1;
	    }
		case 17:
		{
		    if(rows && GetPVarInt(playerid,"mklr_admin") != 1)
			{
			    new names[32];
			    cache_get_value_name(0, "pName", names, 32);
				SCMF(playerid, COLOR_GREY, "You cannot assign a Leader for this faction. This faction already has a Leader {00C8F7}%s.", names);
				return SendClientMessage(playerid, -1, "Use {00B074}/offleader "c_white"to interact with faction Leaders offline!");
			}

			new useplayer = GetPVarInt(playerid, "IDLeadersPlayer");
			new frac = GetPVarInt(playerid, "IDLeaders");

			p_info[useplayer][pLeader] = frac;
			p_info[useplayer][pMember] = frac;
			p_info[useplayer][pJob] = 0;
			p_info[useplayer][pRank] = FracInfo[frac][fRankMax];
			p_info[useplayer][setspawn] = 4;


			SCMF(useplayer, 0x6BB3FFAA, "Administrator %s(%d) appointed you to control faction %s.", Name(playerid), playerid, FracInfo[frac][fName]);
			SCMF(playerid, 0x6BB3FFAA, "You appointed Player %s(%d) to control faction %s.", Name(useplayer), useplayer, FracInfo[frac][fName]);

		    format(String, 188, "[A] Administrator %s[%d] appointed Player %s[%d] to control faction %s[%d].", Name(playerid), playerid, Name(useplayer), useplayer, FracInfo[frac][fName], frac);
			send_admin_message(COLOR_GREY, String);
			form_fraction[useplayer] = p_info[useplayer][pMember];
			if(p_info[useplayer][pSex] == 1) p_info[useplayer][pFrSkin] = FracInfo[frac][fSkin][1];
			else p_info[useplayer][pFrSkin] = FracInfo[frac][fSkin][0];
			SetPlayerSkinEx(useplayer, p_info[useplayer][pFrSkin]);
			SetPlayerToTeamColor(useplayer);

			SavePlayerFraction(useplayer);

			DeletePVar(playerid, "IDLeadersPlayer"), DeletePVar(playerid, "IDLeaders");
			return 1;
		}
	   	case 18:
	   	{
	   	    if(!rows) return SendClientMessage(playerid, COLOR_GREY, "The administration list is empty.");

	   	    new str[128], names[32], datanazn[32], level, adminkey[12];

	   	    String = "";

	   	    for(new i = 0; i < rows; i++)
	   	    {
	   	        cache_get_value_int(i, "pAdmin", level);
	   	        cache_get_value_name(i, "Name", names, 32);
   	    		cache_get_value_name(i, "pDataNaz", datanazn, 32);
   	    		cache_get_value_name(i, "pAdminKey", adminkey, 12);

   	    		format(str, 128, "%s\t\t%d Level\t%s\t%s\n", names, level, datanazn, adminkey);
				strcat(String, str);
			}
			SPD(playerid, 197, DIALOG_STYLE_TABLIST, !""c_server"Administrator control panel offline", String, "Choose", "Close");
			return 1;
		}
		case 19:
		{
	   	    if(!rows) return SendClientMessage(playerid, COLOR_GREY, "The administration list is empty.");

	   	    new str[128], names[32], datanazn[32], level, adminkey[12];

	   	    String = "";

	   	    for(new i = 0; i < rows; i++)
	   	    {
	   	        cache_get_value_int(i, "pAdmin", level);
	   	        cache_get_value_name(i, "Name", names, 32);
   	    		cache_get_value_name(i, "pDataNaz", datanazn, 32);
   	    		cache_get_value_name(i, "pAdminKey", adminkey, 12);

   	    		format(str, 128, "%s\t\t%d Level\t%s\t%s\n", names, level, datanazn, adminkey);
				strcat(String, str);
			}
			SPD(playerid, 197, DIALOG_STYLE_TABLIST, !""c_server"Administrator control panel offline", String, "Choose", "Close");
			return 1;
		}
		case 22:
		{
		    if(rows >= MAX_NUMBER) return SendClientMessage(playerid, COLOR_GREY, "You can have a maximum of 15 numbers in the address book.");

		    SCMF(playerid, -1, "{09D6C7}%s "c_white"was successfully added to your contact list. Use /book", Name(GetPVarInt(playerid, "nName")));
			format(MySQLStr, 128, "INSERT INTO `book` (`plID`, `nName`, `nNumber`) VALUES (%d,'%s',%d)", p_info[playerid][pID], Name(GetPVarInt(playerid, "nName")), GetPVarInt(playerid, "Save Number")), mysql_tquery(dbHandle, MySQLStr, "", "");
			DeletePVar(playerid,"Save Number"), SetPVarInt(playerid, "nName", -1);
			return 1;
		}
		case 23:
		{
		    if(!rows) return SendClientMessage(playerid, COLOR_GREY, "An Error occurred! Such an account does not exist...");

			new vig, names[32];
			cache_get_value_name(0, "pName", names, 32);
			cache_get_value_int(0, "pfWarn", vig);

			vig++;
			if(vig >= 3)
			{
			    mysql_format(dbHandle, MySQLStr, 188, "UPDATE `accounts` SET `pLeader` = '0',`pfWarn` = '0',`pMember` = '0',`pRank` = '0', `pText` = '4' WHERE `pName` = '%e'", names);
				mysql_tquery(dbHandle, MySQLStr, "", "");

                format(String, sizeof(String), "[A] Administrator %s[%d] removed the leadership from Player %s 3/3 Warnings.", Name(playerid), playerid, names), send_admin_message(COLOR_GREY, String);
				SCMF(playerid, 0x6BB3FFAA, "Offline: You removed Player %s from the leadership position...", names);

				return pc_cmd_offleaders(playerid, "");
			}
			mysql_format(dbHandle, MySQLStr, 144, "UPDATE `accounts` SET `pfWarn` = %d, `pText` = '3' WHERE `pName` = '%e'", vig, names), mysql_tquery(dbHandle, MySQLStr, "", "");

			format(String, sizeof(String), "[A] Administrator %s[%d] issued a warning to the Leader %s %d/3", Name(playerid), playerid, vig, names), send_admin_message(COLOR_GREY, String);
			SCMF(playerid, 0x6BB3FFAA, "Offline: You issued a warning to Leader %s %d/3...", names, vig);

			return pc_cmd_offleaders(playerid, "");
		}
		case 28:
		{
		    if(!rows) return SendClientMessage(playerid, COLOR_GREY, "There is not a single Leader on the server!");

		    String = "";
		    new str[144];

            new names[MAX_PLAYER_NAME], leaders, number;

      		for(new i = 0; i < rows; i++)
			{
	   	        cache_get_value_name(i, "pName", names, MAX_PLAYER_NAME);
	   	    	cache_get_value_int(i, "pLeader", leaders);
	   	    	cache_get_value_int(i, "pNumber", number);

	   	        format(str, 144, ""c_white"%s\t%s\t%s\t%s\n", names, FracInfo[leaders][fName], number ? IntToString(number) : ("No numbers"), GetPlayerID(names) == INVALID_PLAYER_ID ? ("{EE4000}Offline") : ("{3CB371}Online"));
				strcat(String, str);
			}
		    SPD(playerid, 204, DIALOG_STYLE_TABLIST, !""c_server"Leaders", String, "Close","");
		    return 1;
   		}
   		case 29:
   		{
   		    if(!rows) return SendClientMessage(playerid, COLOR_GREY, "A global Error occurred, please inform the administration.");

   		    new names[32], leaders, rank, online, level, number;
       		new statusonl[28];

   		    cache_get_value_name(0, "pName", names, 32);
   		    cache_get_value_int(0, "pLevel", level);
   		    cache_get_value_int(0, "pNumber", number);
   	    	cache_get_value_int(0, "pLeader", leaders);
   	    	cache_get_value_int(0, "pRank", rank);
   	    	cache_get_value_int(0, "pLogin", online);

   	    	if(online == 0) statusonl = "{B22222}Offline";
			else statusonl = "{3CB371}Online";

			format(String, sizeof(String), ""c_white"Name: {1A8FA9}%s\n"c_white"Status: %s\n"c_white"Level: %d\n\nOrganization: {3CB371}%s\n"c_white"beforelack: {3CB371}%s\n"c_white"Phone: {00FFFF}%d", names, statusonl, level, FracInfo[leaders][fName], FracRank[leaders][rank], number);
   	    	SPD(playerid, 9992, DIALOG_STYLE_MSGBOX, !""c_server"Information about the Leader", String, "Back", "");
   	    	return 1;
   	    }
	}
	return 1;
}

stock SkinChar(playerid)//????? ???????????
{
    if(p_info[playerid][pSex] == 1) SetPlayerSkin(playerid, 79);
	else SetPlayerSkin(playerid, 9);

	SetPlayerPos(playerid, 1437.2947,-1069.0331,84.7043);
	SetPlayerFacingAngle(playerid, 266.5251);

	SetPlayerVirtualWorld(playerid, playerid);
	SetPlayerInterior(playerid, 10);

	new Float: x = 1437.2947,
		Float: y = -1069.0331;

    GetXYInFront(x, y, 266.5251, 2.0);

	SetPlayerCameraPos(playerid, x, y, 84.7043 + 1.0);
	SetPlayerCameraLookAt(playerid, 1437.2947,-1069.0331,84.7043);

	for(new td; td < 3; td ++) TextDrawShowForPlayer(playerid, skinTD[td]);
	SelectTextDraw(playerid, 0x2641FEAA);
	TogglePlayerControllableEx(playerid,0);

	return 1;
}

stock send_support_message(color, text[])
{
	foreach(new i: admin_list) if(admin_logged[i] != 0) SendClientMessage(i, color, text);
	return 1;
}

stock send_admin_message(color, text[])
{
    foreach(new i: admin_list) if(admin_level[i] > 1 && admin_logged[i] != 0) SendClientMessage(i, color, text);
	return 1;
}

stock ProxDetector(Float: radi, playerid, string[], col1, col2, col3, col4, col5)
{
    new Float: ProxX, Float: ProxY, Float: ProxZ;
    GetPlayerPos(playerid, ProxX, ProxY, ProxZ);

	new world = GetPlayerVirtualWorld(playerid);

	foreach(new i : Player)
    {
        if(GetPlayerVirtualWorld(i) != world) continue;

        new Float: r = GetPlayerDistanceFromPoint(i, ProxX, ProxY, ProxZ);
        if(r < radi/16) SendClientMessage(i, col1, string);
        else if(r < radi / 8) SendClientMessage(i, col2, string);
        else if(r < radi / 4) SendClientMessage(i, col3, string);
        else if(r < radi / 2) SendClientMessage(i, col4, string);
        else if(r < radi) SendClientMessage(i, col5, string);

		if(admin_global_chat[i] != 0) SendClientMessage(i, col1, string);
    }
    return 1;
}
stock ProxDetectorS(Float:radi, playerid, targetid)
{
	if(IsPlayerConnected(playerid)&&IsPlayerConnected(targetid))
	{
		new Float:posx, Float:posy, Float:posz, Float:oldposx, Float:oldposy, Float:oldposz, Float:tempposx, Float:tempposy, Float:tempposz;

		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		GetPlayerPos(targetid, posx, posy, posz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		tempposz = (oldposz -posz);
		if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) return 1;
	}
	return 0;
}
stock ProxDetectorBot(Float:radi, actorid, string[],col1,col2,col3,col4,col5)
{
	if(actorid == 0) return 1;
	if(ActorInfo[actorid][aAntiFlood] > 0) return 1;

    new Float: Pos[3], Float: Radius;
    GetActorPos(ActorInfo[actorid][aID], Pos[0], Pos[1], Pos[2]);
    foreach(new i : Player)
    {
        if(GetActorVirtualWorld(ActorInfo[actorid][aID]) != GetPlayerVirtualWorld(i)) continue;

	    ApplyActorAnimation(ActorInfo[actorid][aID], "PED", "IDLE_CHAT",4.1,0,1,1,1,1);
        Radius = GetPlayerDistanceFromPoint(i, Pos[0], Pos[1], Pos[2]);

        if (Radius < radi / 16) SCMF(i, col1, "%s: %s", ActorInfo[actorid][aName], string);
        else if(Radius < radi / 8) SCMF(i, col2, "%s: %s", ActorInfo[actorid][aName], string);
        else if(Radius < radi / 4) SCMF(i, col3, "%s: %s", ActorInfo[actorid][aName], string);
        else if(Radius < radi / 2) SCMF(i, col4, "%s: %s", ActorInfo[actorid][aName], string);
        else if(Radius < radi) SCMF(i, col5, "%s: %s", ActorInfo[actorid][aName], string);
        ActorInfo[actorid][aAntiFlood] = 5;
    }
    return 1;
}

stock me_action(playerid, action[], Float:distance = 13.0)
{
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "%s %s", Name(playerid), action);
	send_world_message(playerid, distance, text_string, col_light_purple, col_light_purple, col_light_purple, false);

	SetPlayerChatBubble(playerid, action, col_light_purple, distance, 5000);
	return 1;
}

stock send_world_message(pointplayerid, Float:max_radius, text[], color1, color2, color3, bool: chat_buble = false)
{
    new Float:distance;
	new Float:point_x, Float:point_y, Float:point_z;
	GetPlayerPos(pointplayerid, point_x, point_y, point_z);

	foreach(new i: Player)
    {
		if(IsPlayerInRangeOfPoint(i, max_radius, point_x, point_y, point_z) && GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(pointplayerid))
        {
            distance = GetPlayerDistanceFromPoint(i, point_x, point_y, point_z);
            if(distance >= 0.0 && distance < max_radius / 3) SendClientMessage(i, color1, text);
            if(distance >= max_radius / 3 && distance < max_radius / 3 * 2) SendClientMessage(i, color2, text);
            if(distance >= max_radius / 3 * 2 && distance <= max_radius) SendClientMessage(i, color3, text);
       }
	}
	if(chat_buble) SetPlayerChatBubble(pointplayerid, text, color1, max_radius, 5000);
	return 1;
}

function LoadGangZones()
{
    new rows;

	cache_get_row_count(rows);

	if(!rows) return print("No GangZones found in the database!");

	for(new i; i < MAX_ZONES; i++)
	{
		cache_get_value_name_int(i, "fraction", GZInfo[i][gFraction]);
		cache_get_value_name_float(i, "ginfo1", GZInfo[i][gPos][0]);
		cache_get_value_name_float(i, "ginfo2", GZInfo[i][gPos][1]);
		cache_get_value_name_float(i, "ginfo3", GZInfo[i][gPos][2]);
		cache_get_value_name_float(i, "ginfo4", GZInfo[i][gPos][3]);
		GZInfo[i][gID] = GangZoneCreate(GZInfo[i][gPos][0],GZInfo[i][gPos][1],GZInfo[i][gPos][2],GZInfo[i][gPos][3]);
	}
	return printf("[MySQL R41-3]: Gangzone created: %d", rows);
}

stock SaveGZ(idx)
{
	format(MySQLStr, sizeof(MySQLStr), "UPDATE `gangzone` SET `ginfo1` = '%f', `ginfo2` = '%f', `ginfo3` = '%f', `ginfo4` = '%f', `fraction` = '%d' WHERE `id` = '%d'",
	GZInfo[idx][gPos][0], GZInfo[idx][gPos][1],GZInfo[idx][gPos][2],GZInfo[idx][gPos][3],GZInfo[idx][gFraction], idx);
	mysql_query(dbHandle, MySQLStr);
	return 1;
}

