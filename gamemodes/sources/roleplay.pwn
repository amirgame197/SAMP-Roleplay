			GiveFuelMoney(abizz, BizzAInfo[abizz][aPrice]*50, 50 / 4);

			GivePlayerMoneyEx(playerid, -(BizzAInfo[abizz][aPrice]*50), "gasoline at the gas station (canister)");

			SetPVarInt(playerid, "canister", 1);
			SCMF(playerid, -1, "You bought a canister of gasoline for %d$, use {FFE569}/fillcar."c_white"next to the car tank to refuel it.", BizzAInfo[abizz][aPrice]*50);
			SetPlayerAttachedObject(playerid, 0, 1650, 5,0.15,0.03,-0.05,10,-90,180,1.0,1.0,1.0);
		}
		case 60:
		{
		    if(!response) return 1;

			new carid = GetNearestVehicle(playerid);

		    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,-1,"Cannot be used in a vehicle.");
			if(!carid) return SendClientMessage(playerid,-1,"You must approach the fuel tank of the car you wish to refuel.");
			if(CloseEngine(carid) && !IsVehicleHaveFuel(carid)) return SendClientMessage(playerid,-1,"This vehicle does not need fuel.");
			if(Fuell[carid] >= MAX_VEHICLE_FUEL) return SendClientMessage(playerid,-1, "This vehicle has a full tank.");

			Fuell[carid] += 50.0;
			SendClientMessage(playerid, -1, "You refueled the car with 50 liters."), PlayerPlaySound(playerid, 20802, 0.0, 0.0, 0.0), RemovePlayerAttachedObject(playerid, 0);
 			if(Fuell[carid] > MAX_VEHICLE_FUEL) Fuell[carid] = MAX_VEHICLE_FUEL;
 			SetPVarInt(playerid, "canister", 0);
 		}
 		case 61:
