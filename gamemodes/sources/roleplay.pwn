stock ShowPlayerOfflineMembers(playerid)
{
	new page = player_mysql_page[playerid];

    format(format_string, 188, "SELECT `pID`,`pRank`,`pName`,`pfWarn` FROM `accounts` WHERE `pMember`= %d AND `pLogin`= 0 ORDER BY `pRank` ASC LIMIT %d, 20", p_info[playerid][pMember], page*20);
    new Cache: result = mysql_query(dbHandle, format_string);

	new rows = cache_num_rows();

    if(!rows) return SendClientMessage(playerid,COLOR_GREY, "No staff offline."), pc_cmd_lpanel(playerid);

	new str[96], count = 0;

	String = "";

    new namepl[MAX_PLAYER_NAME], rank, fwarn, sql_id;

	for(new i; i < rows; ++i)
	{
        cache_get_value_name_int(i, "pID", sql_id);
		cache_get_value_name(i, "pName", namepl, MAX_PLAYER_NAME);
		cache_get_value_name_int(i, "pRank", rank);
		cache_get_value_name_int(i, "pfWarn", fwarn);

		format(str, 96,"%s\t%d/%d\t%d/3\n", namepl, rank, FracInfo[p_info[playerid][pMember]][fRankMax]-1, fwarn);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, sql_id);
	}

	cache_delete(result);

	if(rows == 20) strcat(String, "Choose");
	if(page > 0) strcat(String, "Back");

	return SPD(playerid,166,DIALOG_STYLE_TABLIST, !""c_server"Eezay The organization is offline",String,"View","Back");
}

