cmd:donateall(playerid, params[])
{
   if(admin_level[playerid] < 8) return 1;

	extract params -> new give_donate; else return SendClientMessage(playerid, col_grey, !"Use: /givedonate [amount]");

     for (new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(IsPlayerConnected(i) && p_info[i][pLogin] != 0)
        {
          p_info[i][pRouble] += give_donate;
          SendClientMessage(i, -1 , "You Give Donate");
    }
  }

  text_string[0] = EOS;
  format(text_string, sizeof(text_string), ""c_info"Admin "c_server"%s"c_white" give donate all : "c_green"%d$",Name(playerid), give_donate);
  SendClientMessage(playerid, col_white, text_string);
  return 1;
}

