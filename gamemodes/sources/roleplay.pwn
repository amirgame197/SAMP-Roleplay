stock ShowPlayerNearPlayers(playerid, dialogid)
{
	new count = 0;
	slobal_string[0] = format_string[0] = EOS;
	foreach(Player, i)
	{
	    if(i == playerid) continue;
	    if(admin_level[i]) continue;
	    if(!ProxDetectorS(15.0, playerid, i)) continue;

	    format(format_string, sizeof(format_string), ""c_server"[%d]"c_white" %s[%d]\n", count, Name(i), i);
	    strcat(slobal_string, format_string);

	    SetPlayerListitemValue(playerid, count++, i);
	}
	if(count == 0) return SendClientMessage(playerid, col_white, !""c_error"There are no players in the r?House with you.");
	return SPD(playerid, dialogid, DIALOG_STYLE_LIST, !""c_server"List of players in the r?House.", slobal_string, !"Choose", !"Back");
}

