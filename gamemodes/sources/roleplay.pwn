CMD:robbank(playerid, params[])
{
/*	if(robtimer[playerid] == false) return SendClientMessage(playerid, COLOR_RED, !""c_error"[Rob System] You Just Now Committed Theft!");*/
	if(!IsAGang(playerid) && !IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_RED, !""c_error"[Rob System] You Are Not A Member Of A Gang or Mafia!");
    if(GetPVarInt(playerid,"robshoporbank")) return SendClientMessage(playerid, COLOR_RED, !""c_error"[Rob System] You Have Already Used Rob. Please Try Again Later.");

	if(IsPlayerInRangeOfPoint(playerid, 3.0, -1.8354, 172.8807, 1243.9700))
	{
		robtimer[playerid] = false;
		SetTimerEx("robtimers", 60000, false, "i", playerid);
	   	if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) return RemovePlayerAttachedObject(playerid, 4);
	    SetPVarInt(playerid, "robshoporbank", true);
	    GivePlayerMoneyEx(playerid, 50000, "You 50000$ Robbed The Bank");
	    SendClientMessage(playerid, COLOR_GREEN, !""c_green"[Rob System] You Have Been Robbed The Bank!");
	    p_info[playerid][pWanted] = 6;
	   	SetPlayerWantedLevel(playerid, 6);
	   	ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
	    ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
	    SetPlayerAttachedObject(playerid, 0, 1550, 17, -0.2789, -0.2349, 0.0000, 158.0999, 71.4999, 0.0000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF); // CJ_MONEY_BAG attached to the Neck of
	    SetPlayerAttachedObject(playerid, 1, 19941, 17, 0.0310, -0.2899, 0.0000, 0.0000, 0.0000, 0.0000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF); // GoldBar1 attached to the Neck of
	    SetPlayerAttachedObject(playerid, 2, 19941, 17, 0.0000, -0.3759, 0.0000, 0.0000, 0.0000, 0.0000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF); // GoldBar1 attached to the Neck of
	    SetPlayerAttachedObject(playerid, 3, 19941, 17, 0.0000, -0.3419, -0.0829, 0.0000, 0.0000, 0.0000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF); // GoldBar1 attached to the Neck of
	 	text_string[0] = EOS;
	    format(text_string, sizeof(text_string), "{%s}[Robed The Bank]", Name(playerid));
	    SendClientMessageToAll(col_white, text_string);
	}
    else
	{
    	SendClientMessage(playerid, COLOR_RED, !""c_error"[Rob System] You are not in the robbery area!");
	}
    return 1;
}
forward robtimers(playerid);
public robtimers(playerid)
{
	robtimer[playerid] = true;
	return 1;
}

