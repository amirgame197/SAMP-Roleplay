}

cmd:skick(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /skick [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(admin_level[targetid] > admin_level[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You cannot punish an Administrator of a higher level.");

    p_info[playerid][pAdmKick]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmKick", p_info[playerid][pAdmKick]);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "You were kicked by Administrator %s for violating server rules.", Name(playerid));
	SendClientMessage(targetid, col_grey, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] quietly disconnected Player %s[%d]", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);
	Kick(targetid);
	return 1;
}

