stock UpdateDonate(playerid)
{
	MySQLStr[0] = EOS;
	format(MySQLStr,96,"SELECT `pRobleCheck` FROM `accounts` WHERE `pID` = %d", p_info[playerid][pID]);
	mysql_pquery(dbHandle, MySQLStr, "UpdatePlayerDonate","d",playerid);
	return 1;
}

function UpdatePlayerDonate(playerid)
{
	new rows;
    cache_get_row_count(rows);
    if(!rows) return 0;

    new donate;

    cache_get_value_name_int(0, "pRobleCheck", donate);

    if(donate == 0) return 1;

    format(String, 144, "INSERT INTO `donate_log` (`user_id`,`amount`) VALUES (%d,%d)", GetPlayerAccountID(playerid), donate);
	mysql_tquery(dbHandle, String);

	if(_bonus_donate) donate *= 2;

	p_info[playerid][pRouble] += donate;

	SCMF(playerid, COLOR_GREY, "New addition: %d Donates.", donate);

    format(String, 96, "UPDATE `accounts` SET `pRobleCheck` = 0 WHERE `pID` = %d", p_info[playerid][pID]);
    mysql_tquery(dbHandle, String);
	return 1;
}

cmd:call(playerid, params[])
{
	if(PhoneOnline[playerid] > 0) return SendClientMessage(playerid, col_white, !""c_error"Your mobile phone is disabled.");
	if(p_info[playerid][pProducts][0] == 0) return SendClientMessage(playerid, col_white, !""c_error"You don't have a mobile phone.");
    if(p_info[playerid][pNumber] == 0) return SendClientMessage(playerid, col_white, !""c_error"You do not have a SIM card.");
    if(player_gag[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You have a gag, you cannot speak.") & 0;
	extract params -> new phone_call; else return SendClientMessage(playerid, col_grey, !"Use: /call [phone number]");

	if(Mobile[playerid] != -1) return SendClientMessage(playerid, col_white, !""c_error"You are already on the call.");
	if(p_info[playerid][pSummaNumber] <= 0) return SendClientMessage(playerid, col_white, !""c_error"You don't have enough funds in your mobile phone account.");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "%s pulls out a mobile phone",Name(playerid));
	ProxDetector(10.0, playerid, text_string, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE);
	if(phone_call == p_info[playerid][pNumber]) return SendClientMessage(playerid, col_white, !""c_error"You can't call yourself.");

    if(phone_call == 110) return SPD(playerid, 8949, DIALOG_STYLE_INPUT, !""c_server"Police call", !""c_white"Describe the place where you are:", !"Call", !"Close");
	if(phone_call == 118) return SPD(playerid, 8950, DIALOG_STYLE_INPUT, !""c_server"Ambulance call", !""c_white"Describe the place where you are walking:", !"Call", !"Close");

	for(new i = 70; i <= 72; i++)
	{
		if(!BizzInfo[i][bPhone] || phone_call != BizzInfo[i][bPhone]) continue;

		SetPlayerUseListitem(playerid, i);
		return SPD(playerid, 8948, DIALOG_STYLE_INPUT, !""c_server"Taxi call", !""c_white"Describe the place where you are:", !"Call", !"Close");
	}

	foreach(new i: Player)
	{
		if(p_info[i][pNumber] == phone_call && phone_call != 0)
		{
			Mobile[playerid] = i;
			if(PhoneOnline[Mobile[playerid]] > 0) return SendClientMessage(playerid, col_white, !""c_error"The subscriber's phone is off.");

			if(Mobile[Mobile[playerid]] == -1)
			{
			    SendClientMessage(Mobile[playerid], col_white, !""c_info"Your mobile phone is ringing. Use:"c_server" / p "c_white" to answer.");
                PlayerPlaySound(Mobile[playerid], 20600, 0.0, 0.0, 0.0);
				PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);

                text_string[0] = EOS;
				format(text_string, sizeof(text_string), "Your %s mobile is ringing.", Name(i));
				SetPlayerChatBubble(i, text_string, COLOR_PURPLE, 10.0, 5000);

				SetPlayerAttachedObject(playerid, 0, 19513,6,0.101998,0.013999,-0.007999,79.899864,-178.999969,-4.200003,1.000000,1.000000,1.000000);
				SetPlayerSpecialAction(playerid, 11);
				CellTime[playerid] = 1;
				break;
			}
		}
	}
	return 1;
}
CMD:p(playerid, params[])
{
    if(Mobile[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "You are already on a call; end the call /h.");
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);

	foreach(new i : Player)
	{
		if(Mobile[i] == playerid)
		{
			Mobile[playerid] = i;
			SendClientMessage(i, COLOR_GREY, "Picked up the phone...");
			SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
			SetPlayerAttachedObject(playerid,0, 19513,6,0.101998,0.013999,-0.007999,79.899864,-178.999969,-4.200003,1.000000,1.000000,1.000000);
			format(String, 86, "%s replied to the call.", Name(playerid)), SetPlayerChatBubble(playerid, String, COLOR_PURPLE, 10.0, 5000);
			PlayerPlaySound(playerid, 1069, 0.0, 0.0, 0.0);
		}
	}
	return 1;
}
CMD:h(playerid, params[])
{
	if(IsPlayerConnected(Mobile[playerid]) && p_info[Mobile[playerid]][pLogin] == 1)
	{
		if(Mobile[playerid] != -1)
		{
			SendClientMessage(Mobile[playerid], COLOR_GREY, "The subscriber hung up the mobile phone...");
			SetPlayerSpecialAction(Mobile[playerid],SPECIAL_ACTION_STOPUSECELLPHONE);
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
			RemovePlayerAttachedObject(playerid,0);
			RemovePlayerAttachedObject(Mobile[playerid],0);
			CellTime[Mobile[playerid]] = 0;
			CellTime[playerid] = 0;
			Mobile[Mobile[playerid]] = -1;
			SendClientMessage(playerid, COLOR_GREY, "You hung up the mobile phone.");
		}
		Mobile[playerid] = -1;
		CellTime[playerid] = 0;
		return 1;
	}
	SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
	RemovePlayerAttachedObject(playerid,0);
	return 1;
}
CMD:sms(playerid, params[])
{
	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(p_info[playerid][pProducts][0] == 0) return SendClientMessage(playerid, COLOR_GREY, "You don't have a mobile phone.");
	if(p_info[playerid][pNumber] == 0) return SendClientMessage(playerid, COLOR_GREY, "You don't have a SIM card.");
	if(PhoneOnline[playerid] != 0) return SendClientMessage(playerid,COLOR_GREY, "Your phone is off.");
	if(p_info[playerid][pSummaNumber] <= 0) return SendClientMessage(playerid, COLOR_GREY, "You have no balance in your mobile phone account.");
	if(player_gag[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You have a block, you cannot send messages.") & 0;

	if(sscanf(params, "ds[80]", params[0], params[1])) return SendClientMessage(playerid, -1,"Enter: /sms [number] [text]");
	//
    if(params[0] < 0 || params[0] > 999999) return SendClientMessage(playerid, COLOR_GREY,"The specified mobile phone number is incorrect.");
    if(params[1] == p_info[playerid][pNumber]) return SendClientMessage(playerid, COLOR_GREY, "You can't send a message to yourself, you fool.");
    new full = 0;

    foreach(new i : Player)
	{
        if(params[0] == p_info[i][pNumber] && params[0] != 0)
		{
            if(PhoneOnline[i] != 0) return SendClientMessage(playerid, COLOR_GREY, "The subscriber's phone is off.");

            full++;
            PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0), PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
            SetPlayerChatBubble(playerid, "SMS >>" ,COLOR_YELLOW,10.0,5000), SetPlayerChatBubble(i, "SMS <<",COLOR_YELLOW,10.0,5000);

            SCMF(i, COLOR_YELLOW, "SMS: %s. Sender: %s(%d)[Tel. %d]", params[1], Name(playerid), playerid, p_info[playerid][pNumber]);
            SCMF(playerid, COLOR_YELLOW, "SMS: %s. Recipient: %s(%d)[Tel. %d]", params[1], Name(i), i, p_info[i][pNumber]);

            if(afk_time[i] > 5) SendClientMessage(playerid, COLOR_GREY, "The message was successfully delivered. The recipient is AFK.");

			p_info[playerid][pSummaNumber] -= strlen(params[1])*2/2;
			break;
   		}
	}
	if(full == 0) return SendClientMessage(playerid, COLOR_GREY,"This number does not exist, or the owner is offline.");
  	return 1;
}
CMD:phone(playerid, params[])
{
    if(p_info[playerid][pProducts][0] == 0) return SendClientMessage(playerid, COLOR_GREY, "You do not have a mobile phone.");
	if(p_info[playerid][pNumber] == 0) return SendClientMessage(playerid, COLOR_GREY, "You do not have a SIM card.");

	format
	(
		String, 244,
		""c_white"[1] Seda Zedn\t-\n\
		[2] Ersal SMS\t-\n\
		[3] %s\t"c_white"-\n\
		[4] Sim Charge:\t{A6EB00}%d$\n\
		[5] Mobile Number:\t{00D6B0}%d",
		PhoneOnline[playerid] ? ("{D65502}Silencing the mobile") : ("{7BC910}Activating the mobile"), p_info[playerid][pSummaNumber], p_info[playerid][pNumber]
	);

	SPD(playerid,111,DIALOG_STYLE_LIST, !""c_server"Mobile Phone", String, "Choose", "Close");
	return 1;
}
CMD:togphone(playerid, params[])
{
    if(p_info[playerid][pProducts][0] == 0) return 1;
	if(p_info[playerid][pNumber] == 0) return 1;
	if(p_info[playerid][pVip] < 1) return SendClientMessage(playerid,0xafafafff,"The given feature is only available to VIP Players.");

    if(!PhoneOnline[playerid]) PhoneOnline[playerid] = 1, format(String, 64, "%s has turned off the mobile phone", Name(playerid));
    else PhoneOnline[playerid] = 0, format(String, 64, "%s has turned on the mobile phone", Name(playerid));
    ProxDetector(15.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
    return 1;
}

