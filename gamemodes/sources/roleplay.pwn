cmd:sellhouse(playerid)
{
	new house = GetPlayerHouse(playerid);
    if(house == -1) return SendClientMessage(playerid, col_white, !""c_error"You don't have a room.");
	if(HouseInfo[house][hSlet] != 0) return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !""c_server"Sale of house", !""c_white"You cannot sell your house, as it is sealed by the government.\nYou can urgently apply for resettlement at the City Hall.", !"Close", !"");

	new h_class = HouseInfo[house][hKlass];
	if(!PlayerToPoint(10, playerid, house_exit[h_class][0], house_exit[h_class][1], house_exit[h_class][2])) return SendClientMessage(playerid, col_white, !""c_error"Use this command inside your house.");

    SPD(playerid, 7246, DIALOG_STYLE_LIST, !""c_server"Whom do you want to sell the house to?", !"- To the government\n- Player", !"Choose", !"Close");
	return 1;
}

CMD:sellsim(playerid, params[])
{
	if(!p_info[playerid][pNumber]) return SendClientMessage(playerid, COLOR_GREY, "You do not have a SIM card.");

    new i = player_enter_biz[playerid];
	if(!PlayerToPoint(15.0, playerid,BizzInfo[i][bExitX], BizzInfo[i][bExitY], BizzInfo[i][bExitZ]) || BizzInfo[i][bType] != 3)
		return SendClientMessage(playerid, COLOR_GREY, "You are not in a 24/7 store!");

	new to_player, price;

    if(sscanf(params,"ui",to_player, price)) return SendClientMessage(playerid,0xafafafff,"Use: /sellsim [playerid] [price]");

    if(!(1 <= price <= 5000000)) return SendClientMessage(playerid, COLOR_GREY, "The minimum amounts are from $1 to $5,000,000.");

    if(playerid == to_player)
	    return SendClientMessage(playerid, COLOR_GREY, "You specified yourself.");

	if(!ProxDetectorS(5.0, playerid, to_player))
	    return SendClientMessage(playerid, COLOR_GREY, "You are far from this player.");

	if(GetPlayerOfferInfo(to_player, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "The player already has an incoming trade request!");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_SELLSIM, price);

	SCMF(playerid, -1, "You offered %s to buy number %d from you. Price: $%d", Name(to_player), p_info[playerid][pNumber], price);

	SCMF(to_player, -1, "%s offered you to buy number %d from them. Price: $%d", Name(playerid), p_info[playerid][pNumber], price);
    return SendClientMessage(to_player, -1, "To agree, press Y(/accept) or for refusal, N(/cancel).");
}

cmd:sellcar(playerid)
{
	if(GetPlayerOfferInfo(playerid, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"Not available with an active sale offer.");

	new u_car = GetPlayerUseHomeCar(playerid);
	if(u_car == -1) return SendClientMessage(playerid, col_white, !""c_error"You are not in your personal transport.");

    SetPlayerUseListitem(playerid, u_car);

	SPD(playerid, 3329, DIALOG_STYLE_LIST, !""c_server"Vehicle sale", !"Who do you want to sell the vehicle to?\n"c_server"[1]"c_white" The State\n"c_server"[2]"c_white" Player", !"Choose", !"Back");
	return 1;
}

CMD:exit(playerid)
{
	if(player_hotel_id[playerid] != -1) PlayerLeaveHotelNumber(playerid);

    if(GetPVarInt(playerid, "VibClothes") != 0) return PlayerExitFromClothesShop(playerid);

	new i = player_enter_home[playerid];

	if(i == -1) return 1;

	new h_class = HouseInfo[i][hKlass];

	if(PlayerToPoint(3.0, playerid,house_exit[h_class][0], house_exit[h_class][1], house_exit[h_class][2]))
	{
        SetPlayerInterior(playerid,0), SetPlayerVirtualWorld(playerid,0);
		SetPlayerPos(playerid,HouseInfo[i][hEntrancex],HouseInfo[i][hEntrancey],HouseInfo[i][hEntrancez]);

		player_enter_home[playerid] = -1;
	}
    if(PlayerToPoint(3.0, playerid, 719.4288,10.1567,1000.6981))
	{
        PlayerEnterToHouse(playerid, i);
	}
	//else SendClientMessage(playerid, COLOR_GREY, "You are far from the back from House.");

	return 1;
}

CMD:astats(playerid, params[])
{
	if(admin_level[playerid] == 0) return 1;

    if(admin_level[playerid] < 6) return ShowAdminStats(playerid, playerid);

	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_GREY, "/astats [id]");

	if(!p_info[params[0]][pLogin]) return SendClientMessage(playerid, -1,"Player is not authorized!");

	if(admin_level[params[0]] == 0) return SendClientMessage(playerid, COLOR_GREY, "Player is not an Administrator.");

	if(admin_level[params[0]] > admin_level[playerid]) return SendClientMessage(playerid, COLOR_GREY, "Player you have a level.");

	ShowAdminStats(playerid, params[0]);

	return 1;
}

CMD:number(playerid, params[])
{
	if(!p_info[playerid][pProducts][1]) return SendClientMessage(playerid, COLOR_GREY, "You don't have a phone book.");

	if(!strlen(params)) return SendClientMessage(playerid, COLOR_GREY, "Use: /number [id]");

	new to_player = strval(params);

	if(!p_info[to_player][pLogin]) return SendClientMessage(playerid, COLOR_GREY, "Player has not passed authorization.");

	if(!p_info[to_player][pNumber]) return SendClientMessage(playerid, COLOR_GREY, "This player does not have a phone number.");

	return SCMF(playerid, COLOR_YELLOW, "Phone number %s: #%d", Name(to_player), p_info[to_player][pNumber]);
}
new bool:CoolDownZ[MAX_PLAYERS];

function CoolDownFunc(playerid)
{
	CoolDownZ[playerid] = false;
}

public OnPlayerRequestClass(playerid, classid)
{
	if(!CoolDownZ[playerid])
	{
		CoolDownZ[playerid] = true;
		SetTimerEx("CoolDownFunc", 2000, false, "i", playerid);
	    if(p_info[playerid][pLogin] == 1) return 0;

		new query[86];
	    mysql_format(dbHandle, query, sizeof(query), "SELECT * FROM `banips` WHERE `ipadress`='%e' LIMIT 0, 1", GetPlayerIpEx(playerid));
		mysql_tquery(dbHandle, query, "OnPlayerCheckBanIP", "is", playerid, GetPlayerIpEx(playerid));
	}
	else return SCMKick(playerid, COLOR_YELLOW, "I have a message for the flooder, dear..");
	return 1;
}
//-----------------------------------------------antibot-----------------------------------------------
stock CountIP(ip[])
{
    new b = 0;
    for(new i = 0; i < MAX_PLAYERS; i++) if(IsPlayerConnected(i) && !strcmp(GetIP(i),ip)) b++;
    return b;
}

stock GetIP(playerid) // Fetches the player IP.
{
    new ip[16];
    GetPlayerIp(playerid,ip,sizeof(ip));
    return ip;
}
stock BanAllBots(playerid) // Bans the player.
{
    new PlayerName[25];
    GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
    printf("%s kicked by Anti-Bot system.", PlayerName);
    KickWithMessage(playerid,COLOR_ERROR,"[Anti-Bot] You have been kicked by Anti-Bot | Max IP connections: 2");
    return 1;
}
//--------------------------------------------<Kick with Massage By Pawn-Coder>----------------------------------
forward KickPublic(plyid);
public KickPublic(plyid) { Kick(plyid); }
stock KickWithMessage(plyid, color, message[])
{
    if(IsPlayerConnected(plyid))
    {
        SendClientMessage(plyid, color, message);
        SetTimerEx("Kick public", 50, 0, "i", plyid);
    }
    return 1;
}
stock IsValidRoleplayName(const name[], short_name_len = 3) {
    new
        len = strlen(name),
        underscore_pos = strfind(name, "_", true);

    // The name is empty
    if (name[0] == 0) return false;

    // Underscore not found
    if (underscore_pos == -1) return false;

    // Firstname and lastname is not capital
    #define isupper(%0) (%0 != (%0 | 0x20))
    if (!isupper(name[0]) || !isupper(name[underscore_pos + 1])) return false;

    // Firstname is too short
    if (underscore_pos < short_name_len) return false;

    // Lastname is too short
    if (((len - 1) - underscore_pos) < short_name_len) return false;

    // Invalid characters
    for (new i; i != len; i ++) {
        switch (name[i]) {
            case 'A'..'Z', 'a'..'z', '_': continue;
            default: {
                return false;
            }
        }
    }
    return true;
}

