cmd:kssetskin(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, skin_id; else return SendClientMessage(playerid, col_grey, !"Use: /setskin [Player id] [clothing id]");
	if(skin_id > 300 || skin_id < 0 || skin_id == 74) return SendClientMessage(playerid, col_white, !""c_error"Invalid skin number.");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] You gave permanent clothing (?%d) to Player %s[%d]", Name(playerid), playerid, skin_id, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white"You received permanent clothing ?%d", Name(playerid), skin_id);
	SendClientMessage(targetid, col_white, text_string);

	if(GetPlayerSkin(targetid) == p_info[targetid][pSkin]) SetPlayerSkinEx(targetid, skin_id);

    p_info[targetid][pSkin] = skin_id;
    update_int_sql(targetid, "pSkin", p_info[targetid][pSkin]);
	return 1;
}

cmd:templeader(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, col_white, !""c_error"To get started, exit the transport.");

	new count = 0;
	dlobal_string[0] = EOS;
	for(new i = 1; i < MAX_FRACTIONS; i++)
	{
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\n", i, FracInfo[i][fName]);
