function PlayerUseCarryAnim(playerid) return SetPlayerSpecialAction (playerid, SPECIAL_ACTION_CARRY);

stock PlayerStopTryOpenDoor(playerid)
{
    for(new i; i < 2; i++) TextDrawHideForPlayer(playerid, rob_global_td[i]);
	PlayerTextDrawHide(playerid, rob_player_td[playerid]);

	TogglePlayerControllable(playerid, true);

	ClearAnimations(playerid);
}

stock GetPlayerRobPartnerID(playerid)
{
	if(player_rob_id[playerid] != -1)
	{
	    new rob_id = player_rob_id[playerid];

		if(rob_info[rob_id][r_player][0] == playerid) return rob_info[rob_id][r_player][1];
		if(rob_info[rob_id][r_player][1] == playerid) return rob_info[rob_id][r_player][0];
	}
    return INVALID_PLAYER_ID;
}

stock SetPlayerGPS(playerid, Float: x, Float: y, Float: z, Float: radi = 3.0)
{
    SetPlayerCheckpoint(playerid, x, y, z, radi);
	PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);

	SetPVarInt(playerid, "GPS", 1);

	if(admin_level[playerid])
    {
	    SetPVarFloat(playerid,"teleportX",x), SetPVarFloat(playerid,"teleportY",y), SetPVarFloat(playerid,"teleportZ",z);
		return SPD(playerid, 214, DIALOG_STYLE_MSGBOX, !""c_server"Teleport", ""c_white"Do you want to move to a specified point?", "Yes", "No");
	}

	return 1;
}

stock PlayerStopRobbery(playerid)
{
    if(player_rob_id[playerid] != -1)
	{
	    new rob_id = player_rob_id[playerid];

	    new partnerid = GetPlayerRobPartnerID(playerid);

		if(GetPVarInt(playerid, "take_house_item") != 0)
		{
		    DeletePVar(playerid, "take_house_item");

	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

	        RemovePlayerAttachedObject(playerid, 7);
		}

	    if(partnerid == INVALID_PLAYER_ID)
	    {
	        if(rob_info[rob_id][r_vehicleid] != INVALID_VEHICLE_ID)
			{
	        	DestroyVehicle(rob_info[rob_id][r_vehicleid]);
	        	rob_info[rob_id][r_vehicleid] = INVALID_VEHICLE_ID;
			}
	    }

	    for(new x; x < 2; x++) if(rob_info[rob_id][r_player][x] == playerid) rob_info[rob_id][r_player][x] = INVALID_PLAYER_ID;
	}
}

stock CreateBizWarTD()
{
	BW_INFO[bw_td][0] = TextDrawCreate(211.000000, 325.000000, "_");
    TextDrawUseBox(BW_INFO[bw_td][0], 1);
    TextDrawTextSize(BW_INFO[bw_td][0], 5.000000, 200.000000);
    TextDrawLetterSize(BW_INFO[bw_td][0], 0.240000, -7.000000);
    TextDrawBoxColor(BW_INFO[bw_td][0], 0x00000050);

    BW_INFO[bw_td][1] = TextDrawCreate(14.000000, 260.000000, "~n~Time:");
    TextDrawBackgroundColor(BW_INFO[bw_td][1], 255);
    TextDrawFont(BW_INFO[bw_td][1], 1);
    TextDrawLetterSize(BW_INFO[bw_td][1], 0.500000, 1.000000);
    TextDrawColor(BW_INFO[bw_td][1], 0x00D900C8);
    TextDrawSetOutline(BW_INFO[bw_td][1], 1);
    TextDrawSetProportional(BW_INFO[bw_td][1], 1);

    BW_INFO[bw_td][2] = TextDrawCreate(75.000000, 260.000000, "6:00");
    TextDrawFont(BW_INFO[bw_td][2], 1);
    TextDrawLetterSize(BW_INFO[bw_td][2], 0.500000, 1.000000);
    TextDrawColor(BW_INFO[bw_td][2], 0x00D900C8);
    TextDrawSetOutline(BW_INFO[bw_td][2], 1);
    TextDrawSetProportional(BW_INFO[bw_td][2], 1);

    BW_INFO[bw_td][3] = TextDrawCreate(14.000000, 276.000000, "_");//banda napad
    TextDrawFont(BW_INFO[bw_td][3], 1);
    TextDrawLetterSize(BW_INFO[bw_td][3], 0.500000, 1.000000);
    TextDrawColor(BW_INFO[bw_td][3], -1);
    TextDrawSetOutline(BW_INFO[bw_td][3], 1);
    TextDrawSetProportional(BW_INFO[bw_td][3], 1);

    BW_INFO[bw_td][4] = TextDrawCreate(14.000000, 293.000000, "_");// banda vlad
    TextDrawFont(BW_INFO[bw_td][4], 1);
    TextDrawLetterSize(BW_INFO[bw_td][4], 0.500000, 1.000000);
    TextDrawColor(BW_INFO[bw_td][4], -1);
    TextDrawSetOutline(BW_INFO[bw_td][4], 1);
    TextDrawSetProportional(BW_INFO[bw_td][4], 1);

    BW_INFO[bw_td][5] = TextDrawCreate(190.000000, 276.000000, "0");// score napad
    TextDrawFont(BW_INFO[bw_td][5], 1);
    TextDrawLetterSize(BW_INFO[bw_td][5], 0.500000, 1.000000);
    TextDrawColor(BW_INFO[bw_td][5], 0xFF0000FF);
    TextDrawSetOutline(BW_INFO[bw_td][5], 1);
    TextDrawSetProportional(BW_INFO[bw_td][5], 1);

    BW_INFO[bw_td][6] = TextDrawCreate(190.000000, 293.000000, "0");// score vlad
    TextDrawFont(BW_INFO[bw_td][6], 1);
    TextDrawLetterSize(BW_INFO[bw_td][6], 0.500000, 1.000000);
    TextDrawColor(BW_INFO[bw_td][6], 0xFF0000FF);
