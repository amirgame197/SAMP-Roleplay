function MoveShip()
{
	ship_pos_id++;

	if(ship_pos_id == sizeof ship_positions) ship_pos_id = 0;

	switch(ship_pos_id)
	{
	    case 0: UpdateShip3DText("Ship:\nDocking at the shore of LS port");
	    case 3: UpdateShip3DText("Ship:\nWaiting for departure to the OilNick port");
	    case 4: UpdateShip3DText("Ship:\nSailing to the OilNick port");
	    case 5: UpdateShip3DText("Ship:\nDocking at the shore of OilNick port");
	    case 6: UpdateShip3DText("Ship:\nAwaiting departure to LS port");
	    case 7: UpdateShip3DText("Ship:\nSailing to LS port");
	}

	if(ship_positions[ship_pos_id][0] != 0.0)
	{
		ship_move_time = MoveObject(ship_mid_object,
			ship_positions[ship_pos_id][0], ship_positions[ship_pos_id][1], ship_positions[ship_pos_id][2] + 10.0, //- 0.004,
			12.0,
			ship_positions[ship_pos_id][3], ship_positions[ship_pos_id][4], ship_positions[ship_pos_id][5]);
	}
	else ship_move_time = 30 * 1000;

	return SetTimer("MoveShip", ship_move_time, false);
}

