cmd:arep(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;

	for(new i; i < max_report; i++)
	{
		if(report_player[i] != -1)
		{
			if(report_slot[i] == 1) continue;

			new dialog_string[400];
			format(dialog_string, sizeof(dialog_string), "\
			"c_white"Complaint from %s[%d]\n\n\
			"c_server"%s\n", Name(report_player[i]), report_player[i], report_text[i]);
			SPD(playerid, 9947, DIALOG_STYLE_INPUT, !""c_server"Complaint", dialog_string, !"Accept", !"Cancel");

