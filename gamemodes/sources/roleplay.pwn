cmd:adminibede(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, adm_level; else return SendClientMessage(playerid, col_grey, !"Use: /makeadmin [Player id] [Level]");
    if(!IsPlayerConnected(targetid) || targetid == playerid) return SendClientMessage(playerid, col_grey, !"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_grey, !"Player is not logged in.");
	if(afk_time[targetid] > 2) return SendClientMessage(playerid, col_white, !""c_error"The Player is AFK.");
	if(admin_level[playerid] == 8 && !(1 <= adm_level <= 8)) return SendClientMessage(playerid, col_white, !""c_error"Use administrator level from 1 to 8.");
	if(!(1 <= adm_level <= 8)) return SendClientMessage(playerid, col_white, !""c_error"Use administrator level from 1 to 8.");
	if(adm_level == admin_level[targetid])
	{
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_error"Administrator already has %d level.", adm_level);
		SendClientMessage(playerid, col_white, text_string);
		return 1;
	}

	if(!admin_level[targetid])
	{
	    text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white" appointed You as Administrator %d level.", Name(playerid), adm_level);
		SendClientMessage(targetid, col_white, text_string);

		format(text_string, sizeof(text_string), ""c_info"You have successfully appointed "c_server"%s"c_white" Administrator %d level.", Name(targetid), adm_level);
		SendClientMessage(playerid, col_white, text_string);

        ALogin(targetid);

        new strstre[16];
    	format(strstre, 16, "%02d/%02d/%d", day, month, year);

		format_string[0] = EOS;
        mysql_format(dbHandle, format_string, sizeof(format_string), "INSERT INTO `admin` (`Name`, `pAdmin`, `pAdminKey`, `pDataNaz`) VALUES ('%e','%d','0','%e')", Name(targetid), adm_level, strstre);
		mysql_tquery(dbHandle, format_string);

        p_info[targetid][pAdmRep] = p_info[targetid][pAdmRepDay] = 0;

		admin_level[targetid] = adm_level;
		strmid(p_info[targetid][pAdminKey], "0", 0, strlen("0"), 32);
		strmid(p_info[targetid][pDataNaz], strstre, 0, strlen(strstre), 32);

        for(new x; x < 2; x++)
		{
			for(new i; i < 10; i++) TextDrawShowForPlayer(playerid, cheat_td[x][i]);
		}

		Iter_Add(admin_list, targetid);
		return 1;
	}
	if(adm_level > admin_level[targetid])
	{
	    text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white" by you before Administrator at level %d", Name(playerid), adm_level);
		SendClientMessage(targetid, col_white, text_string);

		format(text_string, sizeof(text_string), ""c_info"You successfully promoted yourself"c_server"%s"c_white" before Administrator at level %d", Name(targetid), adm_level);
		SendClientMessage(playerid, col_white, text_string);

		admin_level[targetid] = adm_level;
	}
	if(adm_level < admin_level[targetid])
	{
	    text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white"You were demoted from Administrator at level %d", Name(playerid), adm_level);
		SendClientMessage(targetid, col_white, text_string);

		format(text_string, sizeof(text_string), ""c_info"You successfully demoted"c_server"%s"c_white" before Administrator at level %d", Name(targetid), adm_level);
		SendClientMessage(playerid, col_white, text_string);

		admin_level[targetid] = adm_level;
	}
	OnPlayerUpdateAdminPer(targetid, "pAdmin", admin_level[targetid]);
	return 1;
}

cmd:setunadmin(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /unadmin [Player id]");
    if(!IsPlayerConnected(targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(admin_level[targetid] <= 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not an Administrator.");
	admin_level[targetid] = admin_logged[targetid] = 0;

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "DELETE FROM `admin` WHERE `Name`='%s'", Name(targetid));
	mysql_query(dbHandle, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white"You were removed from the Administrator position.", Name(playerid));
	SendClientMessage(targetid, col_white, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You successfully removed "c_server"%s"c_white" from the Administrator position.", Name(targetid));
	SendClientMessage(playerid, col_white, text_string);

    Iter_Remove(admin_list, targetid);

    for(new x; x < 2; x++)
	{
		for(new i; i < 10; i++) TextDrawHideForPlayer(targetid, cheat_td[x][i]);
	}
	return 1;
}

