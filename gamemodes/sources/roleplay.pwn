function LoadHouse()
{
	//new rows;
	cache_get_row_count(max_houses);
	new result_string[96];
    printf("houses: %i",max_houses);
	if(max_houses)
	{
	    for(new i = 0; i < max_houses; i++)
		{
		    cache_get_value_name_int(i, "hID", HouseInfo[i][hID]);
		    printf("hID: %d i:%d",HouseInfo[i][hID],i);
		    cache_get_value_name(i, "hOwner", HouseInfo[i][hOwner], 32);
		    cache_get_value_name_int(i, "hOwned", HouseInfo[i][hOwned]);
			cache_get_value_name_float(i, "hEntrancex", HouseInfo[i][hEntrancex]);
			cache_get_value_name_float(i, "hEntrancey", HouseInfo[i][hEntrancey]);
		    cache_get_value_name_float(i, "hEntrancez", HouseInfo[i][hEntrancez]);
			cache_get_value_name_float(i, "hCarx", HouseInfo[i][hCarx]);
			cache_get_value_name_float(i, "hCary", HouseInfo[i][hCary]);
			cache_get_value_name_float(i, "hCarz", HouseInfo[i][hCarz]);
			cache_get_value_name_float(i, "hCarc", HouseInfo[i][hCarc]);

			//Garage
            cache_get_value_name_float(i, "hGaragex", HouseInfo[i][hGaragex]);
            cache_get_value_name_float(i, "hGaragey", HouseInfo[i][hGaragey]);
            cache_get_value_name_float(i, "hGaragez", HouseInfo[i][hGaragez]);

            cache_get_value_name_float(i, "hGarage", HouseInfo[i][hGarage]);
            cache_get_value_name_float(i, "hAttic", HouseInfo[i][hAttic]);

            //
            cache_get_value_name_int(i, "hTakings", HouseInfo[i][hTakings]);
            cache_get_value_name_int(i, "hOplata", HouseInfo[i][hOplata]);
            cache_get_value_name_int(i, "hValue", HouseInfo[i][hValue]);
            cache_get_value_name_int(i, "hHel", HouseInfo[i][hHel]);
            cache_get_value_name_int(i, "hInt", HouseInfo[i][hInt]);
            cache_get_value_name_int(i, "hLock", HouseInfo[i][hLock]);
			cache_get_value_name_int(i, "hKlass", HouseInfo[i][hKlass]);
			cache_get_value_name_int(i, "hUpdAD", HouseInfo[i][hUpdAD]);
            cache_get_value_name_int(i, "hUpdHel", HouseInfo[i][hUpdHel]);
            cache_get_value_name_int(i, "hUpdSub", HouseInfo[i][hUpdSub]);
            cache_get_value_name_int(i, "hUpdStore", HouseInfo[i][hUpdStore]);

            if(HouseInfo[i][hUpdStore])
            {
                new Float: pos[3];

                cache_get_value_name(i, "hUpdStorePos", result_string);
                sscanf(result_string, "p<,>a<f>[3]", pos);

                CreateHouseStore(i, pos[0], pos[1], pos[2]);

                cache_get_value_name(i, "hWeaponID", result_string);
                sscanf(result_string, "p<,>a<i>[3]", HouseInfo[i][hWeaponID]);

                cache_get_value_name(i, "hAmmo", result_string);
                sscanf(result_string, "p<,>a<i>[3]", HouseInfo[i][hAmmo]);

                cache_get_value_name_int(i, "hDrugs", HouseInfo[i][hDrugs]);
            }

            cache_get_value_name_float(i, "hHealpickX", HouseInfo[i][hHealpickX]);
            cache_get_value_name_float(i, "hHealpickY", HouseInfo[i][hHealpickY]);
            cache_get_value_name_float(i, "hHealpickZ", HouseInfo[i][hHealpickZ]);
           	cache_get_value_name_int(i, "hSlet", HouseInfo[i][hSlet]);

           	cache_get_value_name(i, "hLodgers", result_string);

           	SplitString(result_string, house_lodgers[i], ',');

           	if(HouseInfo[i][hSlet] != 0)
           	{
				format(format_string, 144, "UPDATE `accounts` SET `pBank` = `pBank` + %d WHERE `pName` = '%s'", HouseInfo[i][hValue] / 2, HouseInfo[i][hOwner]);
				mysql_tquery(dbHandle, format_string);

				strmid(HouseInfo[i][hOwner], "None", 0, strlen("None"), 64);
			    HouseInfo[i][hOwned] = 0;
				HouseInfo[i][hHel] = 0;
				HouseInfo[i][hLock] = 0;
				HouseInfo[i][hGarage] = 0;
                HouseInfo[i][hAttic] = 0;
				HouseInfo[i][hUpdAD] = 0;
				HouseInfo[i][hUpdHel] = 0;
				HouseInfo[i][hUpdSub] = 0;
				HouseInfo[i][hUpdStore] = 0;
				HouseInfo[i][hSlet] = 0;
				HouseInfo[i][hOplata] = 0;

				DestroyHouseStore(i);

				SaveHouse(i);
           	}

           	if(HouseInfo[i][hOwned] == 0)
			{
				if(HouseInfo[i][hKlass] == 5) HouseInfo[i][hPickup] = CreatePickup(1273, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				else HouseInfo[i][hPickup] = CreatePickup(1273, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				HouseInfo[i][hMIcon] = CreateDynamicMapIcon(HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez], 31, -1, 0, -1, -1);
			}
            if(HouseInfo[i][hOwned] == 1)
			{
	    		if(HouseInfo[i][hSlet] == 2) HouseInfo[i][hPickup] = CreatePickup(19522, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				else if(HouseInfo[i][hKlass] == 5) HouseInfo[i][hPickup] = CreatePickup(19522, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				else HouseInfo[i][hPickup] = CreatePickup(19522, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				HouseInfo[i][hMIcon] = CreateDynamicMapIcon(HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez], 32, -1, 0, -1, -1);
			}
			if(HouseInfo[i][hGaragex] != 0 && HouseInfo[i][hGaragey] != 0 && HouseInfo[i][hGaragez] != 0)
			{
				new strla[444];
				format(strla, 244, "{FFC900}Garage\nClass: {FFFFFF}%d\n{FFC900}House : {FFFFFF}#%d\n{FFC900}Owner : {FFFFFF}%s \n{FFFFFF}Use {FFC900}/garage{FFFFFF} to enter",HouseInfo[i][hKlass],i,HouseInfo[i][hOwner]);
    			HouseInfo[i][gLabel] = Create3DTextLabel(strla, 0xFFFFFFFF,  HouseInfo[i][hGaragex], HouseInfo[i][hGaragey], HouseInfo[i][hGaragez], 25.0000, 0, 1);

				//CreatePickup(1239, 23, HouseInfo[i][hGaragex], HouseInfo[i][hGaragey], HouseInfo[i][hGaragez],-1);
			}

			if(HouseInfo[i][hUpdHel] == 1)
			{
		 		HouseInfo[i][hAreaHeal] = CreateDynamicPickup(11738, 23, HouseInfo[i][hHealpickX], HouseInfo[i][hHealpickY], HouseInfo[i][hHealpickZ], i);
		 		format(String, 64, "{E5D81E}First Aid Kits: %d PCs.", HouseInfo[i][hHel]);
 				healtext[i] = CreateDynamic3DTextLabel(String,0xFFFFFFFF,HouseInfo[i][hHealpickX],HouseInfo[i][hHealpickY],HouseInfo[i][hHealpickZ]+0.5, 10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1, i);
 			}
 			new h_class = HouseInfo[i][hKlass];
 			HouseInfo[i][hAreaExit] = CreateDynamicSphere(house_exit[h_class][0], house_exit[h_class][1], house_exit[h_class][2],3,i);
			HouseInfo[i][hAreaEnter] = CreateDynamicSphere(HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],1.2,0);
		}
		printf("[MySQL R41-3]: HOUSE'S IS LOADED: %d.", max_houses);
	}

	for(new i, z = sizeof house_exit; i < z; i++)
	{
	    CreateDynamic3DTextLabel("To exit, type the command below:\n/exit",0xFFFFFFFF,house_exit[i][0],house_exit[i][1],house_exit[i][2], 10.0);
	}
    //max_houses--;
	return 1;
}

function LoadABizz()
{
    new rows;
	cache_get_row_count(rows);

	if(rows)
	{
	    for(new i = 1; i <= rows; i++)
		{
		    cache_get_value_name_int(i-1, "aID", BizzAInfo[i][aID]);
		    cache_get_value_name(i-1, "aOwner", BizzAInfo[i][aOwner], 32);
		    cache_get_value_name(i-1, "aMessage", BizzAInfo[i][aMessage], 32);
		    cache_get_value_name_int(i-1, "aOwned", BizzAInfo[i][aOwned]);

		    cache_get_value_name_float(i-1, "aAreaFillX", BizzAInfo[i][aAreaFillX]);
		    cache_get_value_name_float(i-1, "aAreaFillY", BizzAInfo[i][aAreaFillY]);
		    cache_get_value_name_float(i-1, "aAreaFillZ", BizzAInfo[i][aAreaFillZ]);

		    cache_get_value_name_int(i-1, "aBuyPrice", BizzAInfo[i][aBuyPrice]);
		    cache_get_value_name_int(i-1, "aMoney", BizzAInfo[i][aMoney]);
		    cache_get_value_name_int(i-1, "aLocked", BizzAInfo[i][aLocked]);
		    cache_get_value_name_int(i-1, "aProducts", BizzAInfo[i][aProducts]);
		    cache_get_value_name_int(i-1, "aPrice", BizzAInfo[i][aPrice]);
		    cache_get_value_name_int(i-1, "aMafia", BizzAInfo[i][aMafia]);
		    cache_get_value_name_int(i-1, "aArenda", BizzAInfo[i][aArenda]);
		    cache_get_value_name_int(i-1, "aOplata", BizzAInfo[i][aOplata]);
		    cache_get_value_name_int(i-1, "aRaschet", BizzAInfo[i][aRaschet]);
		    cache_get_value_name_int(i-1, "aSklad", BizzAInfo[i][aSklad]);
		    cache_get_value_name_int(i-1, "aSlet", BizzAInfo[i][aSlet]);

            if(BizzAInfo[i][aOwned] == 0)
			{
			    format(String, sizeof(String), "{0099FF}Gas station '%s'\n"c_white"Price per liter: %d$\n\n{EBBD00}The gas station is for sale\nPrice: %d$\n{66CC00}/buyfuelst to buy",BizzAInfo[i][aMessage], BizzAInfo[i][aPrice], BizzAInfo[i][aBuyPrice]);
				BizzAInfo[i][aLabel] = Create3DTextLabel(String, -1, BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ],15.0,0,1);
			}
			else if(BizzAInfo[i][aOwned] == 1)
			{
				format(String, sizeof(String), "{0099FF}Gas station '%s'\n"c_white"Owner: {66CC00}%s\n"c_white"Price per liter: {EBBD00}%d$\n{66CC00}/fuel - for gas stations",BizzAInfo[i][aMessage], BizzAInfo[i][aOwner], BizzAInfo[i][aPrice]);
				BizzAInfo[i][aLabel] = Create3DTextLabel(String,0x00D900FF,BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ],15.0,0,1);
			}
   			CreateDynamicMapIcon(BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ], 47, -1, 0, -1, -1);

   			BizzAInfo[i][aEntranceArea] = CreateDynamicSphere(BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ], 5);
   			TotalABizz++;
   		}
   	}

   	for(new i = 1; i <= rows; i++)
	{
	    if(BizzAInfo[i][aSlet] == 0) continue;

	    new bizz = i;

	    format(MySQLStr, 96, "DELETE FROM `bizz_stats` WHERE `bID` = %d", bizz);
		mysql_tquery(dbHandle, MySQLStr); // delete stats bizz

		format(format_string, 144, "UPDATE `accounts` SET `pBank` = `pBank` + %d WHERE `pName` = '%s'", BizzAInfo[bizz][aBuyPrice] / 2, BizzAInfo[i][aOwner]);
		mysql_tquery(dbHandle, format_string);

		new sql_id = GetPlayerSqlIDByName(BizzAInfo[i][aOwner]);

	    AddPlayerNotifyBySQL(sql_id, "Your refill was sold due to non-payment.");

	    BizzAInfo[bizz][aOwned] = 0, BizzAInfo[bizz][aLocked] = 0, BizzAInfo[bizz][aPrice] = 50, BizzAInfo[bizz][aMoney] = 0, BizzAInfo[bizz][aRaschet] = 0, BizzAInfo[bizz][aSklad] = 1000;
		BizzAInfo[bizz][aOplata] = 0, BizzAInfo[bizz][aSlet] = 0;
		strmid(BizzAInfo[bizz][aOwner], "None", 0, strlen("None"), 32);

		SaveABizz(bizz);
   	}

   	return printf("[MySQL R41-3]: Pomp Benzin Ha Load Shod: %d", TotalABizz);
}

function LoadTaxiBizz()
{
    new rows;
	cache_get_row_count(rows);

	if(!rows) return 1;

	new b_id, c_id;

    for(new i; i < rows; i++)
	{
	    cache_get_value_name_int(i, "b_id", b_id);
	    cache_get_value_name_int(i, "c_id", c_id);

	    cache_get_value_name_int(i, "model", taxi_bizz_models[b_id][c_id]);
	    //cache_get_value_name_float(i, "fuel", taxi_bizz_fuels[b_id][c_id]);
	    taxi_bizz_fuels[b_id][c_id] = MAX_VEHICLE_FUEL;
	    cache_get_value_name_int(i, "price", taxi_bizz_rent[b_id][c_id]);
	}

	return 1;
}

stock LoadBizz()
{
	new Cache: result = mysql_query(dbHandle, "SELECT * FROM `bizz`", true);

    new rows = cache_num_rows();

	if(!rows) return 1;

    for(new i; i < rows; i++)
	{
	    cache_get_value_name(i, "bOwner", BizzInfo[i][bOwner], 32);
	    cache_get_value_name(i, "bMessage", BizzInfo[i][bMessage], 32);
	    cache_get_value_name_int(i, "bOwned", BizzInfo[i][bOwned]);

		cache_get_value_name_float(i, "bEntranceX", BizzInfo[i][bEntranceX]);
		cache_get_value_name_float(i, "bEntranceY", BizzInfo[i][bEntranceY]);
