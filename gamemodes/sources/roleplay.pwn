function minute_timer()
{
	if(capture_kd > 0) capture_kd--;

    foreach(new i: Player)
	{
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), "SELECT * FROM `promocode_activation` WHERE `account_id`='%d' AND `promo_hour`>0", p_info[i][pID]);
		mysql_tquery(dbHandle, text_string, "Promotion time", "d", i);
	}
	return 1;
}
function second_timer()
{
    new hour, minute, second;
	gettime(hour, minute, second);
	getdate(day, month, year);
	foreach(new playerid:Player)

    if(minute == 0 && second >= 11 && second <= 16) pay_day = 0;
    if(minute == 0 && second >= 0 && second <= 10 && pay_day == 0)
   	{
    	pay_day = 1;
   	    SetWorldTime(hour);
   	    pay_day_time();

		if(hour == 4)
		{
			SendClientMessageToAll(col_orange_red, "A technical restart of the server is in progress. This will take a few seconds.");
			foreach(new i: Player) Kick(i);

			SaveAllServers();
			SendRconCommand("gmx");
		}
	}
	static str[64];

	PlayerUpdatee();

	if(second == 00 && minute == 00)
	{
	    if(ship_metall_amount < 50000) ship_metall_amount = 50000;
	    if(ship_ammo_amount < 50000) ship_ammo_amount = 50000;
	}

	if(hour == 15 && minute == 00 && second == 0 && DayOfWeak() == 5)
	{
	    foreach(Player, i)
	    	player_quest_info[i][quest_id] = player_quest_info[i][quest_status] = player_quest_info[i][quest_progress] = 0;

        mysql_tquery(dbHandle, "UPDATE `accounts` SET `warehouse_quest_id` = 0, `warehouse_quest_status` = 0, `warehouse_quest_progress` = 0");
	}

	if(hour == 23 && minute == 59 && second == 59 && DayOfWeak() == 7)
	{
	    foreach(Player, i) DeletePlayerQuestData(i);
	}

	for(new i; i < MAX_CRANES; i++)
	{
	    if(crane_refresh[i] == 0) continue;

	    crane_refresh[i]--;

		if(crane_refresh[i] == 0) DestroyDynamicObject(crane_obj[i][2]);
	}

	if(crane_unload_refresh != 0)
	{
	    crane_unload_refresh--;

		if(crane_unload_refresh == 0)crane_unload_obj[0] = CreateDynamicObject(1251, 2785.223632, -2457.605468, 27.420410, 90.000000, 0.000000, 0.000000, map_world, map_int, -1, 300.00, 300.00);
	}

	if(pb_state != 0)
	{
	    pb_time--;

	    if(pb_state == 1)
	    {
			if(pb_time == 299) SendClientMessageToAll(-1, "[PB] 5 minutes before the event starts.");
			if(pb_time == 119) SendClientMessageToAll(-1, "[PB] 2 minutes before the event starts.");

			if(pb_time == 0)
			{
			    new team_players[2];

			    foreach(Player, i)
			    {
			        if(player_reg_pb[i] == 0) team_players[0]++;
			        if(player_reg_pb[i] == 1) team_players[1]++;
			    }

			    if(team_players[0] > 0 && team_players[1] > 0)
				{
				    foreach(Player, i)
				    {
						if(player_reg_pb[i] == -1) continue;

						new t_id = player_reg_pb[i];

						TogglePlayerControllable(i, false);

						new rand = random(5);

						SetPlayerPos(i, team_pos_pb[t_id][rand][0], team_pos_pb[t_id][rand][1], team_pos_pb[t_id][rand][2]);
						SetPlayerFacingAngle(i, team_pos_pb[t_id][rand][3]);

						player_kills_pb[i] = 0;

						GivePlayerWeapon(i, 24, 100);
						GivePlayerWeapon(i, 25, 50);
						GivePlayerWeapon(i, 31, 300);

						SetPlayerColor(i, t_id ? COLOR_RED : COLOR_BLUE);

						SetPlayerInterior(i, 0);
						SetPlayerVirtualWorld(i, 5);
				    }

				    pb_blue_kills = pb_red_kills = 0;

				    pb_state = 2;
				    pb_time = 5;
				}
				else
				{
				    foreach(Player, i)
					{
						if(player_reg_pb[i] == -1) continue;

						player_reg_pb[i] = -1;
						GivePlayerMoneyEx(i, 2000, "refund for PB");

						SendClientMessage(i, COLOR_YELLOW, "[PB] You have been refunded.");
				    }

				    pb_state = pb_time = 0;

				    SendClientMessageToAll(-1, "[PB] The game is canceled, not enough participants.");
				}
			}
	    }
	    else if(pb_state == 2)
	    {
	        if(pb_time > 0) format(str, 16, "~r~%d", pb_time);
	        else str = "~g~GO";

	        foreach(Player, i) if(player_reg_pb[i] != -1) GameTextForPlayer(i, str, 1200, 4);

			if(pb_time == 0)
			{
			    foreach(Player, i) if(player_reg_pb[i] != -1) TogglePlayerControllable(i, true);

			    pb_state = 3;
			    pb_time = 300;
			}
	    }
	    else if(pb_state == 3)
	    {
	        new red_team, blue_team;

			format(str, 32, "TIME: %s~n~KILLS: %d/%d", Convert(pb_time), pb_blue_kills, pb_red_kills);

			foreach(Player, i)
			{
				if(player_reg_pb[i] == 0) blue_team++;
				if(player_reg_pb[i] == 1) red_team++;

				if(player_reg_pb[i] != -1) GameTextForPlayer(i, str, 1200, 4);
			}

			if(blue_team == 0) StopGamePB(1);

			if(red_team == 0) StopGamePB(0);

			if(pb_time == 0)
			{
			    if(pb_blue_kills > pb_red_kills) StopGamePB(0);
			    else if(pb_red_kills > pb_blue_kills) StopGamePB(1);
			    else StopGamePB(-1);

			    pb_state = 0;
			    pb_time = 0;
			}
	    }
	}

	if(race_state != 0)
	{
		if(race_time != 0) race_time--;

		if(race_state == 1)
		{
		    if(race_time == 300) SendClientMessageToAll(COLOR_SERVER, "[Admin]:"c_white"Use /rep to report cheaters!");
			if(race_time == 120) SendClientMessageToAll(COLOR_SERVER, "[Admin]:"c_white"Use /rep for your complains!");

			if(race_time == 0)
			{
			    new carid, count = 0;

			    foreach(Player, i) if(player_race_reg{i}) count++;

			    if(count > 1)
			    {
				    foreach(Player, i)
				    {
				        if(!player_race_reg{i}) continue;

				        TogglePlayerControllable(i, false);

				        SetPlayerInterior(i, 0);
				        SetPlayerVirtualWorld(i, 1);

				        SetPlayerPos(i, race_vehicle_pos[count][0], race_vehicle_pos[count][1], race_vehicle_pos[count][2]);

				        carid = CreateVehicle(541, race_vehicle_pos[count][0], race_vehicle_pos[count][1], race_vehicle_pos[count][2], race_vehicle_pos[count][2], random(90), random(90), 3600);
						SetVehicleVirtualWorld(carid, 1);

						count++;

						veh_info[carid][vFuel] = 0.0;
						veh_info[carid][vSost] = 100;
						veh_info[carid][vStatus] = 2;

						Fuell[carid] = MAX_VEHICLE_FUEL;

						player_race_vehicle[i] = carid;

						PutPlayerInVehicle(i, carid, 0);
						SetVehicleParamsEx(carid,1,1,0,0,0,0,0);

						SetPlayerArmedWeapon(i, 0);

						player_race_mark[i] = 0;

						UpdatePlayerRaceMark(i);
				    }

				    race_state = 2;
			    	race_time = 20;
			    }
			    else
			    {
			        foreach(Player, i) player_race_reg{i} = 0;

			        SendClientMessageToAll(COLOR_SERVER, "[Tones]:"c_white"Cancel registration, not enough Nicks.");

			        race_state = race_time = 0;
			    }
			}
		}
		else if(race_state == 2)
		{
		    if(race_time > 0) format(str, 16, "~r~%d", race_time);
		    else str = "~g~GO";

		    foreach(Player, i)
		    {
		        if(!player_race_reg{i}) continue;

		        GameTextForPlayer(i, str, 1100, 4);

		        if(race_time == 0) TogglePlayerControllable(i, true);
		 	}

		 	if(race_time == 0)
		 	{
		 	    race_state = 3;
		 	    race_time = 600;
		 	}
		}
		else if(race_state == 3)
		{
		    if(race_finish_id == 0)
			{
			    if(GetRacePlayersAmount() == 0) SendClientMessageToAll(COLOR_SERVER, "Race Event:"c_white"The event is concluded; all players have exited the race.");

			    race_time = 0;
	       	}

			if(race_time == 0) race_state = 0;
		}
	}

    if(second == 00 && minute == 00)
	{
    foreach(new i: Player)
	{
	if(GetPVarInt(i,"robshoporbank"))
	{
	DeletePVar(i, "robshoporbank");
	}
	}
	//SendClientMessageToAll(COLOR_GREEN, "[Rob System] It is time to use Rob!");
	return 1;
	}

	//??????
	if(pb_state == 0 && second == 00 && minute == 00 && (hour == 11 || hour == 15 || hour == 21))
	{
	    StartPaint();
	}

	if(second == 00)
	{
	    for(new i; i < MAX_BIZZ_TAXI; i++)
	    {
	    	for(new x; x < MAX_TAXI_VEHICLES; x++)
	    	{
	    	    new vehicleid = taxi_bizz_vehicles[i][x];

	    	    taxi_bizz_fuels[i][x] = Fuell[vehicleid];

	    	    if(hour == 00) SaveTaxiBizzVehicle(i, x);
	    	}
	    }

	    for(new i; i < 8; i++) wh_zones_gang[i] = wh_graffiti_gang[i] = 0;

	    for(new i; i < MAX_ZONES; i++)
	    {
	        if(GZInfo[i][gFraction] == FRACTION_BALLAS) wh_zones_gang[0] ++;
	        if(GZInfo[i][gFraction] == FRACTION_VAGOS) wh_zones_gang[1] ++;
	        if(GZInfo[i][gFraction] == FRACTION_GROVE) wh_zones_gang[2] ++;
	        if(GZInfo[i][gFraction] == FRACTION_AZTEC) wh_zones_gang[3] ++;
	        if(GZInfo[i][gFraction] == FRACTION_RIFA) wh_zones_gang[4] ++;
	    }

	    for(new i; i < MAX_GRAFFITI; i++)
	    {
	        if(graffiti_fraction[i] == FRACTION_BALLAS) wh_graffiti_gang[0] ++;
	        if(graffiti_fraction[i] == FRACTION_VAGOS) wh_graffiti_gang[1] ++;
	        if(graffiti_fraction[i] == FRACTION_GROVE) wh_graffiti_gang[2] ++;
	        if(graffiti_fraction[i] == FRACTION_AZTEC) wh_graffiti_gang[3] ++;
	        if(graffiti_fraction[i] == FRACTION_RIFA) wh_graffiti_gang[4] ++;
	    }

	    for(new i; i < MAX_BIZZ; i++)
	    {
	        if(BizzInfo[i][bMafia] == FRACTION_YAKUZA) wh_zones_gang[5]++;
	        if(BizzInfo[i][bMafia] == FRACTION_COLUMBIA) wh_zones_gang[6]++;
	        if(BizzInfo[i][bMafia] == FRACTION_RUMAFIA) wh_zones_gang[7]++;
	    }

	    for(new i; i < 8; i++) UpdateGangWH3DTextLabel(i);

		//

		new time = gettime();

		for(new i; i < MAX_HOTELS; i++)
		{
		    if(hotel_info[i][hOwned] == 0) continue;
		    if(hotel_info[i][hRentTime] > time) continue;

			new playerid = GetPlayerID(hotel_info[i][hOwner]);

			if(IsPlayerConnected(playerid))
			{
			    p_info[playerid][pHotel] = -1;

	       		if(player_hotel_id[playerid] != -1) PlayerLeaveHotelNumber(playerid);

	       		SendClientMessage(playerid, -1, "You were evicted from the hotel room for non-payment.");
			}
			else
			{
			    new sql_id = GetPlayerSqlIDByName(hotel_info[i][hOwner]);

			    AddPlayerNotifyBySQL(sql_id, "Your hotel room has been sold due to non-payment.");
			}

	        hotel_info[i][hOwned] = 0;

	        UpdateHotel3DTextLabel(i);

	        format(format_string, 96, "UPDATE `hotels` SET `hOwned` = %d WHERE `id` = %d", hotel_info[i][hOwned], i);
	       	mysql_tquery(dbHandle, format_string);

	       	format(format_string, 128, "UPDATE `accounts` SET `pHotel` = -1 WHERE `pName` = '%s'", hotel_info[i][hOwned], hotel_info[i][hOwner]);
	       	mysql_tquery(dbHandle, format_string);
		}
	}

	if((minute == 15 || minute == 30 || minute == 45 || minute == 59) && second == 00)
	{
		for(new i; i < MAX_TRASH; i++) if(trash_info[i][t_amount] <= 90) UpdateTrashAmount(i, 10);
		for(new i; i < TotalAtms; i++) if(AtmsInfo[i][c_amount] <= 10) UpdateCollectorAmount(i, 40);
	}

	switch(hour)
	{
	    case 10, 12, 15, 16, 18, 21:
	    {
	        if(minute == 3 || minute == 25 || minute == 26)
	        {
	            if(race_state == 0) StartRace();
	        }
	    }
	}

	if(fraction_steal_block != 0) fraction_steal_block--;

 	if(minute == 00 && second == 50) SetWorldTime(hour);

    if(minute == 10 && second == 00 || minute == 30 && second == 00 || minute == 50 && second == 00)
	{
		switch(random(4))
		{
	   		case 0: SendClientMessageToAll(col_white, ""c_server"�"c_white"Welcome to the city:"c_server""SERVERNAME""c_white" | Our Telegram Channel:"c_server""SERVER_CHANNEL"");
			case 1: SendClientMessageToAll(col_white, ""c_server"�"c_white"For server news, refer to our Telegram channel:"c_server""SERVER_CHANNEL"");
			case 2: SendClientMessageToAll(col_white, ""c_server"�"c_white"If you invite someone to the server, you receive"c_server"5,000,000$"c_white"By inviting your friends, gain 3 levels."c_server"3 levels"c_white" ");
			case 3: SendClientMessageToAll(col_white, ""c_server"�"c_white"By purchasing donations, gain special abilities:"c_server""SERVER_CHANNEL"");
		}
	}
	if(minute == 37 && second == 00)
	{
		if(hour % 2 == 0) SaveHouseAll(), print("[MySQL R41-3]: Houses and cars have been successfully saved.");
		else SaveBizzAll(), SaveABizzAll(), print("[MySQL R41-3]: Business and gas station have been successfully saved.");
    }
 	if(hour == 23 && minute == 55 && second == 00)
 	{
 	    new strstre[16];
		format(strstre, 16, "%d/%d/%d",year,month,day);

	    for(new i; i < TotalBizz; i++)
	    {
	        if(!BizzInfo[i][bOwned]) continue;

            if(BizzInfo[i][bOplata]) BizzInfo[i][bOplata] --;
            if(BizzInfo[i][bOplata] <= 0) BizzInfo[i][bOplata] = 0, BizzInfo[i][bSlet] = 1;

    		format(MySQLStr, 144, "INSERT INTO `bizz_stats`(`bID`, `bData`, `bSumma`) VALUES (%d,'%s',%d)", i, strstre, BizzInfo[i][bRaschet]);
			mysql_tquery(dbHandle, MySQLStr, "", "");

			BizzInfo[i][bRaschet] = 0;
			SaveBizz(i);
		}
  	}
  	if(hour == 23 && minute == 58 && second == 00)
 	{
 	    new strstre[16];
		format(strstre,sizeof(strstre), "%d/%d/%d",year,month,day);

	    for(new i=1; i <= TotalABizz; i++)
	    {
	        if(!BizzAInfo[i][aOwned]) continue;

            if(BizzAInfo[i][aOplata]) BizzAInfo[i][aOplata] --;
            if(BizzAInfo[i][aOplata] <= 0) BizzAInfo[i][aOplata] = 0, BizzAInfo[i][aSlet] = 1;

    		format(MySQLStr, 144, "INSERT INTO `bizz_astats`(`aID`, `aData`, `aSumma`) VALUES (%d,'%s',%d)", i, strstre, BizzAInfo[i][aRaschet]);
			mysql_tquery(dbHandle, MySQLStr, "", "");

			BizzAInfo[i][aRaschet] = 0;
			SaveABizz(i);
		}
  	}
  	if(hour == 00 && minute == 00 && second == 30)
 	{
 	    for(new i; i < max_houses; i++)
		{
		    if(HouseInfo[i][hOwned] == 1)
		    {
				if(HouseInfo[i][hOplata] >= 1) HouseInfo[i][hOplata] --;
				if(HouseInfo[i][hOplata] <= 0) HouseInfo[i][hOplata] = 0, HouseInfo[i][hSlet] = 1;
				SaveHouse(i);
			}
  	   	}
  	}
  	for(new v = 0; v < MAX_VEHICLES; v++)
	{
	    if(pizza_veh_time{v})
	    {
	        pizza_veh_time{v}--;
	        if(pizza_veh_time{v} == 0) pizza_veh_have{v} = 0;
	    }
        new engine, lights, alarm, doors, bonnet, boot, objective;
		GetVehicleParamsEx(v,engine,lights,alarm,doors,bonnet,boot,objective);
		if(engine && Fuell[v] > 0.0 && IsVehicleHaveFuel(v))
		{
			if(GetVehicleSpeed(v) < 1.0) Fuell[v] -= 0.01;
			else if(1.0 <= GetVehicleSpeed(v) <= 60.0) Fuell[v] -= 0.02;
		    else Fuell[v] -= 0.03;

			if(vehicle_owner_id[v] != INVALID_PLAYER_ID)
			{
			    new owner_id = vehicle_owner_id[v];

			    for(new i; i < MAX_PLAYER_VEHICLES; i++)
			    {
			        if(v != player_home_car[owner_id][i]) continue;

                    CarInfo[owner_id][cFuel][i] = Fuell[v];
					CarInfo[owner_id][cProbeg][i] = Milliage[v];
			    }
			}
		}
	}

	new Float: health;

	for(new i; i < MAX_VEHICLES; i++)
	{
		GetVehicleHealth(i, health);
		if(health < 350.0)
		{
			SetVehicleHealth(i, 350.0);

			new engine, lights, alarm, doors, bonnet, boot, objective;
			GetVehicleParamsEx(i,engine,lights,alarm,doors,bonnet,boot,objective);
    		return SetVehicleParamsEx(i, 0,lights,alarm,doors,bonnet,boot,objective);
		}
	}
	return 1;
}

stock PlayerUpdatee()
{
    new hour, minute, second,stateEx;
	gettime(hour, minute, second);

	if(hour == 23 && minute == 59 && second == 59)
	{
	    foreach(Player, i) p_info[i][pInGameSeconds] = p_info[i][pInGameAFKSeconds] = 0;

		format(format_string, 188, "UPDATE `accounts` SET `pInGameSeconds` = 0, `pInGameAFKSeconds` = 0, `last_curdate` = %d WHERE `pLogin` = 1", getdate());
		mysql_tquery(dbHandle, format_string);
	}

    foreach(new playerid: Player)
	{
	    stateEx = GetPlayerState(playerid);

		if(GetPVarInt(playerid, "LoginOgran") != -1)
		{
			SetPVarInt(playerid, "LoginOgran", GetPVarInt(playerid, "LoginOgran") -1);
			if(GetPVarInt(playerid, "LoginOgran") == 0) return Kick(playerid);
		}

		if(GetPVarInt(playerid,"Drug_Time"))
		{
			SetPVarInt(playerid,"Drug_Time",GetPVarInt(playerid,"Drug_Time") - 1);
			if(GetPVarInt(playerid,"Drug_Time") == 100) SetPlayerWeather(playerid, weather_id);
		}

		if(p_info[playerid][pLogin] && GetPlayerDistanceFromPoint(playerid, 0.0, 0.0, 0.0) < 10.0)
		{
		    SpawnPlayer(playerid);
		    printf("[FIX-SPAWN] %s | %d %d", Name(playerid), p_info[playerid][setspawn], p_info[playerid][pMember]);
		}

		if((beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_DRIVER && p_info[playerid][pLicenses][0] ||
			beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_PHONE && p_info[playerid][pProducts][0] ||
			beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_FRACTION && p_info[playerid][pMember]) && beg_quest_info[playerid][b_quest_status] == 1)
		{
	        SendClientMessage(playerid, col_white, !""c_yellow"Quest:"c_white"The quest task has already been completed. Use: "c_server"/quest"c_white", to receive an award.");
	        beg_quest_info[playerid][b_quest_status] = 2;
	        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
		}

		if(follow_id[playerid] != INVALID_PLAYER_ID)
		{
			new to_player = follow_id[playerid];

		    if(!IsPlayerInAnyVehicle(to_player) && !IsPlayerInAnyVehicle(playerid))
			{
				if(GetDistanceBetweenPlayers(playerid, to_player) < 1.5) ClearAnimations(playerid), TogglePlayerControllable(playerid, false);
				else if(1.5 <= GetDistanceBetweenPlayers(playerid, to_player) <= 10.0)
				{
				    TogglePlayerControllable(playerid,true);
					SetPlayerToFacePlayer(playerid, to_player);
					ApplyAnimation(playerid, "ped", "WALK_civi", 6.0, 1, 1, 1, 1, 0, 1);
				}
				else if(GetDistanceBetweenPlayers(playerid, to_player) > 10.0)
				{
					new Float: x, Float: y, Float: z;

					GetPlayerPos(to_player, x, y, z);

				    SetPPos(playerid, x, y + 0.3, z, 0.0, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid), false);

                    SetPlayerToFacePlayer(playerid, to_player);

					/*SCMF(to_player,COLOR_REDD,"You have strayed too far from %s[%d] whom you are leading!",Name(to_player),to_player);
					follow_id[playerid] = INVALID_PLAYER_ID;
					TogglePlayerControllable(playerid,false);*/
				}
		  	}
	        else
			{
				follow_id[playerid] = INVALID_PLAYER_ID;
				ClearAnimations(playerid);
			}
		}

		if(gSpectateID[playerid] != INVALID_PLAYER_ID)
		{
		    new spec_id = gSpectateID[playerid];

		    if(IsPlayerConnected(spec_id))
		    {
			    if(GetPlayerInterior(playerid) != GetPlayerInterior(spec_id)) SetPlayerInterior(playerid, GetPlayerInterior(spec_id));
			    if(GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(spec_id)) SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(spec_id));
			}
			else StopSpectate(playerid);
		}

		if(p_t_info[playerid][uborka_timer] != 0)
		{
		    p_t_info[playerid][uborka_timer]--;

		    format(format_string, 16, "~r~%d", p_t_info[playerid][uborka_timer]);
		    GameTextForPlayer(playerid, format_string, 1100, 4);

		    if(p_t_info[playerid][uborka_timer] == 0) spawned_uborka(playerid);
		}

		if(p_t_info[playerid][bus_timer] != 0)
		{
		    p_t_info[playerid][bus_timer]--;

		    format(format_string, 16, "~r~%d", p_t_info[playerid][bus_timer]);
		    GameTextForPlayer(playerid, format_string, 1100, 4);

		    if(p_t_info[playerid][bus_timer] == 0) spawned_bus(playerid);
		}

		if(player_rob_id[playerid] != -1 && player_rob_progress[playerid] > 0)
		{
		    new rob_id = player_rob_id[playerid];

	     	if(player_rob_progress[playerid] == 1)
	     		for(new i; i < 2; i++)
				 	TextDrawShowForPlayer(playerid, rob_global_td[i]);

			player_rob_progress[playerid]++;

		    PlayerTextDrawTextSize(playerid, rob_player_td[playerid], 273.6195 + ((78.3805 / 100) * (player_rob_progress[playerid] * 10)), 0.0000);

			PlayerTextDrawHide(playerid, rob_player_td[playerid]);
			PlayerTextDrawShow(playerid, rob_player_td[playerid]);

			ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.0, 0, 0, 0, 0, 0,1);

			if(player_rob_progress[playerid] == 10)
			{
				new h_id = rob_info[rob_id][r_house];

				player_rob_progress[playerid] = 0;

				HouseInfo[h_id][hLock] = 0;

				PlayerStopTryOpenDoor(playerid);

				SendMessageToRobPlayers(rob_id, 0x6495EDff, "[ROB]: "c_white"The house {6495ED} has been hacked, let's enter.");
			}
		}

		new vehicleid = GetPlayerVehicleID(playerid);

		if(vehicleid != INVALID_VEHICLE_ID && (70 <= p_info[playerid][pJob] <= 72) && (70 <= veh_info[vehicleid][vFr] <= 72) && player_taxi_passanger[playerid] != INVALID_PLAYER_ID)
		{
		    new Float: distance = GetPlayerDistanceFromPoint(playerid, player_taxi_X[playerid], player_taxi_Y[playerid], player_taxi_Z[playerid]);

		    if(distance > 500.0)
		    {
		        new b_id = p_info[playerid][pJob];

		        new passanger_id = player_taxi_passanger[playerid];
		        new price = BizzInfo[b_id][bPrice];

		        if(p_info[passanger_id][pCash] < price)
		        {
		            player_taxi_passanger[playerid] = INVALID_PLAYER_ID;

		            SearchNextClientForTaxi(vehicleid, passanger_id);

		            RemovePlayerFromVehicleEx(passanger_id);
		            SendClientMessage(playerid, -1, "The passenger has no funds to continue the trip!");
					SendClientMessage(passanger_id, COLOR_GREY, "You have no funds to continue the trip!");
		        }
		        else
		        {
	                GivePlayerMoneyEx(playerid, price, "taxi salary");
		            GivePlayerMoneyEx(passanger_id, -price, "taxi payment");

		            format(format_string, 32, "~g~+~w~$%d", price);
		            GameTextForPlayer(playerid, format_string, 3000, 3);

		            format(format_string, 32, "~r~-~w~$%d", price);
		            GameTextForPlayer(passanger_id, format_string, 3000, 3);
		        }

		        GetPlayerPos(playerid, player_taxi_X[playerid], player_taxi_Y[playerid], player_taxi_Z[playerid]);
		    }
		}

		if(player_quest_info[playerid][quest_block] != 0)
		{
		    player_quest_info[playerid][quest_block]--;

		    if(player_quest_info[playerid][quest_block] == 0)
		    {
		        switch(player_quest_info[playerid][quest_id])
		        {
		            case GQUEST_TYPE_GRAFFITI..GQUEST_TYPE_DRUGMARK: SendClientMessage(playerid, 0xffff00ff, "SMS: I have a Job for you, stop by when you have time. | Sender: Ryder Wilson");
		            case GQUEST_TYPE_DOCSTEAL: SendClientMessage(playerid, 0xffff00ff, "SMS: Come to me urgently, I need your help! | Sender: Ryder Wilson");
		        }

		        OnPlayerUpdateAccountsPer(playerid, "warehouse quest block", 0);
		    }
		}

		//new vehicleid = GetPlayerVehicleID(playerid);

		if(p_info[playerid][pVip] > 0)
		{
			if(p_info[playerid][pVipTime] < gettime())
			{
			    p_info[playerid][pVip] = 0;
			    p_info[playerid][pVipTime] = 0;

			    SendClientMessage(playerid, COLOR_YELLOW, "VIP status has expired.");

			    format(format_string, 144, "UPDATE `accounts` SET `pVip` = 0, `pVipTime` = 0 WHERE `pID` = %d", p_info[playerid][pID]);
			    mysql_tquery(dbHandle, format_string);
			}
		}

		if(graffiti_player_id[playerid] != -1 && GetPVarInt(playerid,"ColorFire") && GetPlayerWeapon(playerid) == 41)
		{
		    new g_id = graffiti_player_id[playerid];

	        if(IsPlayerInRangeOfPoint(playerid,2.0,graffiti_obj_pos[g_id][0],graffiti_obj_pos[g_id][1],graffiti_obj_pos[g_id][2]))
			{
			    new Float:angle;
			    GetPlayerFacingAngle(playerid, angle);

				if(graffiti_obj_pos[g_id][4]-30.0 < angle < graffiti_obj_pos[g_id][4]+30.0)
			    {
			        graffiti_player_progress[playerid]++;

			        PlayerTextDrawTextSize(playerid, graffiti_player_td[playerid], 273.6195 + ((78.3805 / 100) * (graffiti_player_progress[playerid] * 10)), 0.0000);

					if(graffiti_player_progress[playerid] == 1)
					{
					    for(new i; i < 2; i++) TextDrawShowForPlayer(playerid, graffiti_global_td[i]);
						PlayerTextDrawShow(playerid, graffiti_player_td[playerid]);
					}

					PlayerTextDrawHide(playerid, graffiti_player_td[playerid]);
					PlayerTextDrawShow(playerid, graffiti_player_td[playerid]);

			        if(graffiti_player_progress[playerid] >= 10 || graffiti_fraction[g_id] == p_info[playerid][pMember])
			        {
			            graffiti_block[g_id] = gettime() + 3600;

			            if(graffiti_fraction[g_id] != p_info[playerid][pMember])
						{
			            	format(format_string, 188, "UPDATE `graffiti` SET `owner_frac` = %d, `color_owner` = '%s', `block` = %d WHERE `id` = %d", p_info[playerid][pMember], Name(playerid), graffiti_block[g_id], g_id);
			            	mysql_tquery(dbHandle, format_string);

							format(graffiti_colored[g_id], MAX_PLAYER_NAME, Name(playerid));
						}

			            if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_GRAFFITI && player_quest_info[playerid][quest_status] == 1)
			            {
			                player_quest_info[playerid][quest_progress]++;

			                if(player_quest_info[playerid][quest_progress] >= 1)
			                {
			                    player_quest_info[playerid][quest_status] = 2;

			                    OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 2);

			                    SetTimerEx("SendPlayerQuestInfoSMS", 15000, false, "ii", playerid, 1);
			                }
			                else SCMF(playerid, COLOR_YELLOW, "[QUEST] Graffiti painted: %d/10", player_quest_info[playerid][quest_progress]);
			            }

						graffiti_fraction[g_id] = p_info[playerid][pMember];

			            UpdateGraffitiGang(g_id);

			            PlayerStopRestyleGraffiti(playerid);
			        }
			    }
			}
		}

		if(player_lecenie[playerid] != -1)
		{
		    new Float:shealth;
			GetPlayerHealth(playerid, shealth);

		    if(shealth < 100)
			{
				GameTextForPlayer(playerid, "~h~~g~+1hp", 1000, 5);
				SetPlayerHealthEx(playerid, shealth + 1);
			}
		    else
			{
			    DeletePVar(playerid, !"p_dead");
			    SendClientMessage(playerid, col_white, !""c_info"You have been treated and can now leave the hospital.");
			    PlayerLeaveHospitalBed(playerid);
			}
		}

	    if(p_info[playerid][pCash] != GetPlayerMoney(playerid))
		{
			ResetPlayerMoney(playerid);
			GivePlayerMoney(playerid, p_info[playerid][pCash]);
		}

		if(!PlayerToPoint(3.0, playerid, PosPic[playerid][0][0], PosPic[playerid][0][1], PosPic[playerid][0][2])) ac_pickups[playerid][0] = -1; // antiflood pickup
	    if(!PlayerToPoint(3.0, playerid, PosPic[playerid][1][0], PosPic[playerid][1][1], PosPic[playerid][1][2])) ac_pickups[playerid][1] = -1; // antiflood pickup

		if(stateEx == PLAYER_STATE_DRIVER)
		{
			new Float:ms = (SpeedVehicle(playerid)/8.6)/600;
			if(ms > 0) Milliage[GetPlayerVehicleID(playerid)] += ms;
	  	}
		//if(minute == 10 && second == 00 || minute == 35 && second == 00 || minute == 50 && second == 00) Quest(playerid);
		//
		if(second == 00)
	 	{
	 	    new f_id = p_info[playerid][pMember];
			if(f_id && form_fraction[playerid])
			{
			    new rang_id = p_info[playerid][pRank];

			    GivePlayerPayCheck(playerid, FracInfo[f_id][fSalary][rang_id] / 60);
			}

		    if(p_info[playerid][pDrunk]) GivePlayerDrunkLevel(playerid, -1);

	 	    //
	 	    //new Float:health;
			//GetPlayerHealth(playerid,health);

			//if(p_info[playerid][pSatiety] > 0 && !p_info[playerid][pInfSatiety]) UpdatePlayerSatiety(playerid, p_info[playerid][pSatiety] - 0.5);

			//if(health > 10)
			{
			    //if(p_info[playerid][pUpdPlayer][0] == 1 && p_info[playerid][pSatiety] < 30) SetPlayerHealthEx(playerid, health - 0.3);
				//else
				{
					//if(p_info[playerid][pSatiety] < 80)
					{
						//SetPlayerHealthEx(playerid, health - 0.2);
						//SendClientMessage(playerid, col_white, ""c_error"You are a bit hungry! Visit the diner. [ More -> {FFFF00}/satiety"c_white" ]");
					}
					//if(p_info[playerid][pSatiety] < 25)
					{
						//SetPlayerHealthEx(playerid, health - 0.5);
						//SendClientMessage(playerid, col_white, ""c_error"You are hungry! Visit the diner. [ More -> {FFFF00}/satiety"c_white" ]");
					}
					//if(p_info[playerid][pSatiety] < 10)
					{
						//SetPlayerHealthEx(playerid, health - 1.0);
						//SendClientMessage(playerid, col_white, ""c_error"You are very hungry! Visit the diner urgently. [ More -> {FFFF00}/satiety"c_white" ]");
					}
				}
			}
		}

		if(player_road_school[playerid] == 2 && player_school_back[playerid] != 0)
		{
		    player_school_back[playerid]--;

		    format(format_string, 32, "TIME: %d", player_school_back[playerid]);
		    GameTextForPlayer(playerid, format_string, 1200, 0);

		    if(player_school_back[playerid] == 0)
		    {
		        player_road_school[playerid] = 0;
				player_road_id[playerid] = -1;

				new school_veh_id = GetPVarInt(playerid, "school_vehicle");

				SetVehicleToRespawn(school_veh_id);

				DisablePlayerRaceCheckpoint(playerid);

		        SendClientMessage(playerid, COLOR_GREY, "You did not return to the vehicle, the exam has failed.");

		        DeletePVar(playerid, "school_vehicle");
		    }
		}

		if(killer_clear[playerid])
		{
		    killer_clear[playerid]--;

		    if(killer_clear[playerid] == 0) killer_id[playerid] = INVALID_PLAYER_ID;
		}

	    if(trash_player_back[playerid])
	    {
	        trash_player_back[playerid]--;
	        if(trash_player_back[playerid] == 0)
	        {
	            SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
				player_jobvehicle_time[playerid] = 0;
	            rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;

	            SendClientMessage(playerid, COLOR_RED, "You didn't manage to return to the transport and it disappeared!");
	        }
	    }
	    if(collector_player_back[playerid] != 0)
	    {
	        collector_player_back[playerid]--;
	        if(collector_player_back[playerid] == 0)
	        {
	            SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
				player_jobvehicle_time[playerid] = 0;
	            rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;

	            SendClientMessage(playerid, COLOR_RED, "You didn't manage to return to the transport and it disappeared!");
	        }
	    }

		p_info[playerid][pInGameHourSeconds]++;

  		p_info[playerid][pInGameSeconds]++;

		// AFK
		new StringF[50];
	 	if(afk_tick[playerid] > 10000) afk_tick[playerid] = 1, afk_check[playerid] = 0;
	 	if(afk_check[playerid] < afk_tick[playerid] && GetPlayerState(playerid)) afk_check[playerid] = afk_tick[playerid], afk_time[playerid] = 0;
	 	if(afk_check[playerid] == afk_tick[playerid] && GetPlayerState(playerid))
	  	{
	   		afk_time[playerid]++;
	     	if(afk_time[playerid] > 2)
	      	{
	      	    p_info[playerid][pInGameAFKSeconds]++;

	       		format(StringF, sizeof(StringF), "Player is Paused: ""%s", convert_time(afk_time[playerid] - 2));
				SetPlayerChatBubble(playerid, StringF, col_white, 15.0, 1200);
	    	}
	    }
	    if(GetPVarInt(playerid, "Anti-Sbiv") <= gettime() && GetPVarInt(playerid, "Anti-Sbiv") != 0)
	    {
			DeletePVar(playerid,"Anti-Sbiv");
			if(player_job[playerid] == 1)
			{
				new bablo[50];
				SetPVarInt(playerid,"Saw",0);
				ClearAnimations(playerid);
				new rand = random(20);
				SetPlayerCheckpoint(playerid, RandomSaw[rand][0], RandomSaw[rand][1], RandomSaw[rand][2], 2.0);
				SetPVarInt(playerid,"Saw_",rand);
				GivePlayerMoneyEx(playerid, 550, "cut down a tree"); //TEST
				SetPVarInt(playerid,"JobMoney",GetPVarInt(playerid,"JobMoney")+550);
				format(bablo,32,"~g~+550$~n~~b~TOTAL:~w~ %d$",GetPVarInt(playerid,"JobMoney"));
				GameTextForPlayer(playerid,bablo, 5000, 1);
				SendClientMessage(playerid,-1,"You successfully cut down the tree, continue your work.");
			}
			else if(player_job[playerid] == 3)
			{
				ClearAnimations(playerid);
				DestroyObject(PlantObject[playerid]);
				PlantObject[playerid] = -1;
				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
				DisablePlayerCheckpoint(playerid);
				SetPlayerCheckpoint(playerid,2564.6721,-1292.9766,1044.1250,2.0);
				SetPVarInt(playerid,"CHECKPOINTID",5);
				SendClientMessage(playerid,-1,"You collected the product, take it to the warehouse. {afafaf}(red marker)");

				SetPlayerAttachedObject(playerid, 2 , 2358, 1,0.11,0.36,0.0,0.0,90.0);
			}
			else if(player_job[playerid] == 4)
			{
				new rand = RandomEx(1,30);
				new stirng[155];
				RemovePlayerAttachedObject(playerid,0);
				SetPVarInt(playerid,"FishKG",GetPVarInt(playerid,"FishKG")+rand);
				TogglePlayerControllableEx(playerid, 1);
				ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0);
				format(stirng, 155,"You caught fish weighing {20A9FF}%d"c_white" kg. You've caught a total of {20A9FF}%d"c_white". {afafaf}(Earnings: %d)",rand,GetPVarInt(playerid,"FishKG"),GetPVarInt(playerid,"FishKG")*2);
				SendClientMessage(playerid, -1, stirng);
				DeletePVar(playerid,"Fishing");
				ClearAnimations(playerid);
			}
		}
	 	if(IsAWorkbench(playerid) && GetPVarInt(playerid,"Metal") == 1 && player_job[playerid] == 3)
		{
			new Float:x,Float:y,Float:z,Float:a;
			GetPlayerPos(playerid,x,y,z);
			if(IsPlayerAttachedObjectSlotUsed(playerid,2)) RemovePlayerAttachedObject(playerid,2);
			DeletePVar(playerid,"Metal");
			SetPVarInt(playerid,"Anti-Sbiv",gettime()+20);
			GetPlayerFacingAngle(playerid,a);
			ClearAnimations(playerid);
			if(floatround(a) > 130 && floatround(a) < 300) PlantObject[playerid] = CreateObject(1356,x,y-0.85,1044.20703125,0.00000000,0.00000000,0.00000000);
			else PlantObject[playerid] = CreateObject(1356,x,y+0.85,1044.20703125,0.00000000,0.00000000,0.00000000);
			ApplyAnimation(playerid,"CAR_CHAT","CAR_Sc4_BL",4.0,1,1,1,0,0,0);
		}
	    // cars
	    if(player_jobvehicle_time[playerid] > 0)
		{
			player_jobvehicle_time[playerid]--;
			format(String, 64, "~y~TIME:~n~~b~%d", player_jobvehicle_time[playerid]);
			GameTextForPlayer(playerid, String, 1000, 4);

			if(player_jobvehicle_time[playerid] <= 0)
			{
			    player_product_id[playerid] = -1;

			    SendClientMessage(playerid, col_white, !""c_info"The work transport has been confiscated.");

				SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
				player_jobvehicle_time[playerid] = 0;
				rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;

				DisablePlayerRaceCheckpoint(playerid);
				DisablePlayerCheckpoint(playerid);

				if(GetPVarInt(playerid, "GPS") != 0) SetPVarInt(playerid, "GPS", 0);
				if(p_info[playerid][pJob] == 7 && p_t_info[playerid][pPilot_Access] == true)
				{
				    p_t_info[playerid][pPilot_Access] = false;
				 	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
					p_t_info[playerid][pPilot] =
					p_t_info[playerid][pPilot_Checkpoint] = 0;
				}
				if(player_take_collector[playerid] != -1) RemovePlayerAttachedObject(playerid, 4);
				if(p_info[playerid][pJob] == WORK_TYPE_DELIVERY) DestroyDeliveryObject(playerid);
				if(p_info[playerid][pJob] == 6 && p_t_info[playerid][pTrucker_Access] == true)
				{
					p_t_info[playerid][pTrucker_Unit] = 0;
					p_t_info[playerid][pTrucker] = -1;
					rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
					p_t_info[playerid][pTrucker_Access] = false;
				}
			}
		}
	    if(afk_time[playerid] > 1200 && !admin_level[playerid]) Kick(playerid);

		if(CellTime[playerid] > 0)
		{
			CellTime[playerid]++;
			if(Mobile[Mobile[playerid]] == -1 && CellTime[playerid] == 5)
			{
				CellTime[playerid] = 0;
				format(String, 53, "%s has a mobile phone ringing", Name(Mobile[playerid])), SetPlayerChatBubble(Mobile[playerid], String, COLOR_PURPLE, 10.0, 5000);
				PlayerPlaySound(Mobile[playerid], 20600, 0.0, 0.0, 0.0);
			}
		}
		if(player_search_player[playerid] != -1)
		{
		    new Float:X,Float:Y,Float:Z;
			GetPlayerPos(player_search_player[playerid], X,Y,Z);

			if(GetPlayerVirtualWorld(player_search_player[playerid]) != 0) return SendClientMessage(playerid,COLOR_GREY,"Connection with the satellite has been lost, the player may have entered an interior or attended an event."), player_search_player[playerid] = -1;
			if(GetPlayerInterior(player_search_player[playerid]) != 0) return SendClientMessage(playerid,COLOR_GREY,"Connection with the satellite has been lost, the player may have entered an interior."), player_search_player[playerid] = -1;
			DisablePlayerCheckpoint(playerid), SetPlayerCheckpoint(playerid, X,Y,Z, 3);
		}
		// timers
		if(p_info[playerid][pPrison] > 0)
		{
			p_info[playerid][pPrison]--;

			if(p_info[playerid][pPrison] == 0)
			{
				if(p_info[playerid][pMestoPrison] == 1) t_SetPlayerPos(playerid, 1551.8297,-1675.4524,16.0214), SetPlayerFacingAngle(playerid, 87.3740);
				else if(p_info[playerid][pMestoPrison] == 2) t_SetPlayerPos(playerid, -304.1972,1537.6333,75.5625), SetPlayerFacingAngle(playerid, 184.3335);
				else SpawnPlayer(playerid);

				p_info[playerid][pMestoPrison] = 0;
				SendClientMessage(playerid, COLOR_ISPOLZUY, "You paid your debt to society, now you are free!");
				if(p_info[playerid][pCash] >= 500) GivePlayerMoneyEx(playerid, -500, "Back from prison");
				p_info[playerid][pWanted] = 0;
				SetPlayerWantedLevel(playerid, 0);
				SetPlayerVirtualWorld(playerid, 0), SetPlayerInterior(playerid, 0);
				SetCameraBehindPlayer(playerid);
				GameTextForPlayer(playerid,"~g~Freedom", 3000, 1);
			}
		}
		UnSurfCar(playerid);

		if(p_info[playerid][mute] > 0) p_info[playerid][mute]--;
		if(p_info[playerid][family_mute] > 0) p_info[playerid][family_mute]--;

		for(new i = 1; i <= TotalActor; i++)
		{
			if(ActorInfo[i][aAntiFlood] > 0) ActorInfo[i][aAntiFlood]--;
		}
		if(second == 00 || second == 30 || second == 45)
		{
			if(player_warning_ac[playerid] != 0) player_warning_ac[playerid]--;
		}
		if(player_gos_time[playerid] > 0) player_gos_time[playerid]--;
		if(player_veh_damage[playerid] > 0) player_veh_damage[playerid]--;
	}
	return 1;
}

