CMD:pee(playerid, params[])
{


		if(p_info[playerid][pWater] <= 30) return SendClientMessage(playerid,COLOR_GREY, "You are not drinking!");

		{
		UpdatePlayerSatiety(playerid, p_info[playerid][pSatiety]-5);
		ApplyAnimation(playerid, !"PAULNMAC", !"Piss_in", 4.1, 0, 0, 0, 0, 0, 1);
		p_info[playerid][pWater] -= 5;
		update_int_sql(playerid, "pWater", p_info[playerid][pWater]);
		}
       return 1;
}
CMD:buy(playerid, params[])
{
    if(GetPVarInt(playerid, "VibClothes") != 0)
    {
	    new choose_id = player_choose_skin[playerid];

		new sex = p_info[playerid][pSex];

		new s_id = sex == 1 ? SkinMan[choose_id] : SkinMale[choose_id];

		new price = gSkins[s_id][skinPrice];

		new skin_id = gSkins[s_id][skinID];

	    format(String, 244, ""c_white"Your skin {FFFF00}[ID: %d]"c_white" will be replaced with skin {FFFF00}[ID: %d]($%d)"c_white"\n\nAre you sure you want to buy the skin?", p_info[playerid][pSkin], skin_id, price);
		return SPD(playerid,126,DIALOG_STYLE_MSGBOX, !""c_server"Warning", String, "Purchase", "Cancel");
	}

	new i = player_use_bizbar[playerid];
	if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 3 || BizzInfo[i][bType] == 7 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
		if(BizzInfo[i][bLocked] == 1) return SendClientMessage(playerid,-1, "Business is closed by the owner.");

 		ProductsMenu(playerid);
	}
	return 1;
}
CMD:fillcar(playerid, params[])
{
    if(GetPVarInt(playerid, "canister") == 0) return SendClientMessage(playerid, -1, "You don't have a canister; you can buy one at any gas station.");

    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,-1,"Cannot be used in a vehicle.");
    if(GetNearestVehicle(playerid) == 0) return SendClientMessage(playerid,-1,"You must approach the fuel tank of the car you wish to refuel.");

    SPD(playerid, 60, DIALOG_STYLE_MSGBOX, !""c_server"Refueling", ""c_white"Are you sure you want to refuel this car with 50 liters?", "Yes", "No");
	return 1;
}

cmd:business(playerid, params[])
{
	if(GetPlayerBizz(playerid) == -1) return SendClientMessage(playerid, col_white, !""c_error"You don't have a business.");
	return ShowBizz(playerid, GetPlayerBizz(playerid));
}

CMD:fuelst(playerid, params[])
{
	if(GetPlayerABizz(playerid) == 0) return SendClientMessage(playerid, -1, "You don't have a gas station.");
	return ShowABizz(playerid, GetPlayerABizz(playerid));
}

CMD:key(playerid)
{
	new carid = GetPlayerUseHomeCar(playerid);

	if(carid == -1)
	    return SendClientMessage(playerid, COLOR_GREY, "You are not in a personal vehicle.");

    player_car_keys[playerid][carid] = !player_car_keys[playerid][carid];

	new vehicleid = GetPlayerVehicleID(playerid);

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
    if(!player_car_keys[playerid][carid]) SetVehicleParamsEx(vehicleid,0,lights,alarm,doors,bonnet,boot,objective);

	SCMF(playerid, -1, "You have %s keys.", player_car_keys[playerid][carid] ? ("inserted") : ("You dragged"));

	return 1;
}

alias:lock("lk")
cmd:lock(playerid, params[])
{
	extract params -> new lock_type; else return SendClientMessage(playerid, col_grey, !"Use: /lock [type] (1 - Home car 2 - Rented car 3 - Work vehicle 4 - Family car)");

	switch(lock_type)
	{
		case 1:
		{
		    for(new i; i < MAX_PLAYER_VEHICLES; i++)
		    {
		        new vehicleid = player_home_car[playerid][i];
				if(vehicleid == INVALID_VEHICLE_ID) continue;

			    new Float:cx,Float:cy,Float:cz;
				GetVehiclePos(vehicleid, cx, cy, cz);
				if(!PlayerToPoint(5.0, playerid, cx, cy, cz)) continue;

                new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

				if(doors == 0)
				{
				    SetVehicleParamsEx(vehicleid, engine, lights, alarm, 1, bonnet, boot, objective);
					GameTextForPlayer(playerid, "~w~CAR ~r~LOCK", 1000, 3);
					CarInfo[playerid][cLock][i] = 1;
				}
				else
				{
				    SetVehicleParamsEx(vehicleid, engine, lights, alarm, 0, bonnet, boot, objective);
					GameTextForPlayer(playerid, "~w~CAR ~g~UNLOCK", 1000, 3);
					CarInfo[playerid][cLock][i] = 0;
				}
				SetPlayerChatBubble(playerid, !doors ? ("closed the transport doors") : ("opened the transport doors"), COLOR_PURPLE, 30.0, 10000);

				PlayerPlaySoundEx(24600, cx, cy, cz);
				return 1;
			}
			return SendClientMessage(playerid, col_white, !""c_error"You are too far from personal transport.");
		}
		case 2:
		{
			if(rent_vehicle_id[playerid] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, col_white, !""c_error"You don't have the keys to the rented transport.");

			new Float:cx,Float:cy,Float:cz;
			GetVehiclePos(rent_vehicle_id[playerid], cx, cy, cz);

			if(PlayerToPoint(4.0, playerid, cx, cy, cz))
			{
			    new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(rent_vehicle_id[playerid],engine,lights,alarm,doors,bonnet,boot,objective);
				if(doors == 0)
				{
					GameTextForPlayer(playerid, "~w~CAR ~r~LOCK", 1000, 3);
					SetVehicleParamsEx(rent_vehicle_id[playerid], engine, lights, alarm, 1, bonnet, boot, objective);
				}
				else
				{
					GameTextForPlayer(playerid, "~w~CAR ~g~UNLOCK", 1000, 3);
					SetVehicleParamsEx(rent_vehicle_id[playerid], engine, lights, alarm, 0, bonnet, boot, objective);
				}
				SetPlayerChatBubble(playerid, !doors ? ("closed the transport doors") : ("opened the transport doors"), COLOR_PURPLE, 30.0, 10000);

				PlayerPlaySoundEx(24600, cx, cy, cz);
			}
			else SendClientMessage(playerid, col_white, !""c_error"You are too far from the rented transport.");
		}
		case 3:
		{
			if(rent_job_vehicle[playerid] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, col_white, !""c_error"You do not have the keys to the rented transport.");

			new Float:cx,Float:cy,Float:cz;
			GetVehiclePos(rent_job_vehicle[playerid], cx, cy, cz);

			if(PlayerToPoint(4.0, playerid, cx, cy, cz))
			{
			    new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(rent_job_vehicle[playerid],engine,lights,alarm,doors,bonnet,boot,objective);

				if(doors == 0)
				{
					GameTextForPlayer(playerid, "~w~CAR ~r~LOCK", 1000, 3);
					SetVehicleParamsEx(rent_job_vehicle[playerid], engine, lights, alarm, 1, bonnet, boot, objective);
				}
				else
				{
					GameTextForPlayer(playerid, "~w~CAR ~g~UNLOCK", 1000, 3);
					SetVehicleParamsEx(rent_job_vehicle[playerid], engine, lights, alarm, 0, bonnet, boot, objective);
				}
				SetPlayerChatBubble(playerid, !doors ? ("closed the transport doors") : ("opened the transport doors"), COLOR_PURPLE, 30.0, 10000);

				PlayerPlaySoundEx(24600, cx, cy, cz);
			}
			else SendClientMessage(playerid, col_white, !""c_error"You are too far from working transport.");
		}
		case 4:
		{
    		new family_id = p_info[playerid][family];
    		text_string[0] = EOS;
    		format(text_string, sizeof(text_string), "familyveh/%s.ini", family_info[family_id - 1][fam_name]);
    		new FMVEHFILE = ini_openFile(text_string);
			ini_getInteger(FMVEHFILE,"familyvehs",familymaxveh);
			ini_getInteger(FMVEHFILE,"fmveh1",fmveh1);
			ini_getInteger(FMVEHFILE,"fmveh2",fmveh2);
			ini_getInteger(FMVEHFILE,"fmveh3",fmveh3);
			ini_getInteger(FMVEHFILE,"fmveh4",fmveh4);
			ini_getInteger(FMVEHFILE,"fmveh5",fmveh5);
			ini_getInteger(FMVEHFILE,"fmveh6",fmveh6);
			ini_getInteger(FMVEHFILE,"fmveh7",fmveh7);
			ini_getInteger(FMVEHFILE,"family vehicle 1",familyveh1);
    		ini_getInteger(FMVEHFILE,"family vehicle 2",familyveh2);
   	    	ini_getInteger(FMVEHFILE,"family vehicle 3",familyveh3);
  		    ini_getInteger(FMVEHFILE,"family vehicle 4",familyveh4);
 		    ini_getInteger(FMVEHFILE,"family vehicle 5",familyveh5);
