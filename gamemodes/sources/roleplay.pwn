    }
    if(lvpd_pickups[5] <= pickupid <= lvpd_pickups[6]) SetPPos(playerid, 2292.4429,2468.9202,10.8203,88.8389, 0, 0, false);

    if(pickupid == sfhosp_pickups[0]) SetPPos(playerid,-643.034,-899.383,1436.17,181.046, 8, 8, false);
    if(pickupid == sfhosp_pickups[1])
	{
	    if(CheckHospitalHealth(playerid)) return 1;

		SetPPos(playerid,-2655.4536,635.1159,14.4531,181.8861, 0, 0, false);
	}

    if(pickupid == lvhosp_pickups[0]) SetPPos(playerid,-643.034,-899.383,1436.17,181.046, 8, 9, false);
    if(pickupid == lvhosp_pickups[1])
	{
	    if(CheckHospitalHealth(playerid)) return 1;

		SetPPos(playerid,1606.9171,1818.9822,10.8203,2.0018, 0, 0, false);
	}

	if(pickupid == yakuza_enter[0]) SetPPos(playerid,-1984.9525,1180.4413,109.2679,95.9533, 1, 1, false);
	if(pickupid == yakuza_enter[1]) SetPPos(playerid,2631.2766,1824.2800,11.0234,89.0400, 0, 0, false);

	if(pickupid == columbia_enter[0]) SetPPos(playerid,-1984.9525,1180.4413,109.2679,95.9533, 1, 2, false);
	if(pickupid == columbia_enter[1]) SetPPos(playerid,939.3159,1733.3010,8.8516,271.7543, 0, 0, false);

	if(pickupid == rm_enter[0]) SetPPos(playerid,-1984.9525,1180.4413,109.2679,95.9533, 1, 3, false);
	if(pickupid == rm_enter[1]) SetPPos(playerid,1458.1165,2773.3064,10.8203,270.2503, 0, 0, false);

	if(pickupid == pd_enter_pickup) SetPPos(playerid,246.1840,85.7662,1003.6406,193.2450, 6, 1, false);

    if(pickupid == warehouse_pickup[0]) SetPPos(playerid,1979.0916,-2025.3134,1019.5756,181.5865, 1, 1, true);
	if(pickupid == warehouse_pickup[1]) SetPPos(playerid,1940.0271,-2068.1433,13.5427,272.4800, 0, 0, false);

	if(pickupid == stash_pickup[0]) SetPPos(playerid,318.5356,1115.9697,1083.8828,0.4612, 5, 1, true);
	if(pickupid == stash_pickup[1]) SetPPos(playerid,2166.9353,-1672.3673,15.0753,222.2349, 0, 0, false);

    if(wh_army_pickup[0] <= pickupid <= wh_army_pickup[2])
    {
        if(!IsAGang(playerid) && !IsAMafia(playerid) && !IsAArmy(playerid)) return 1;
        if(form_fraction[playerid] != p_info[playerid][pMember]) return 1;

        new m_id = -1;
		switch(GetPlayerVirtualWorld(playerid))
		{
		    case 3: m_id = FRACTION_ARMY_LS;
		    case 5: m_id = FRACTION_ARMY_LV;
		    case 2: m_id = FRACTION_ARMY_SF;
		}

        if(GetPVarInt(playerid, "take_mats"))
	    {
	        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000) return SendClientMessage(playerid, col_white, !""c_error"Enough ammunition in stock.");

	        SendClientMessage(playerid, col_white, !""c_info"You placed ammunition in the organization's warehouse.");

	        FracInfo[m_id][fBank][0] += 250;
	        FracInfo[m_id][fBank][1] += 250;

	        UpdateArmyWarehouse3D(m_id);

	        return RemovePlayerAmmoBox(playerid);
	    }

        if(IsAGang(playerid) || IsAMafia(playerid))
        {
		    new limit = GetPlayerBackpackLimit(playerid);
			if(p_info[playerid][pPatron] >= limit && p_info[playerid][pMetall] >= limit) return SendClientMessage(playerid, COLOR_GREY, "You have floor pockets.");

	        new rand_ammo = p_info[playerid][pPatron] >= limit ? limit - p_info[playerid][pPatron] : 1 + random(4);
	        new rand_weapon = p_info[playerid][pMetall] >= limit ? limit - p_info[playerid][pMetall] : 2 + random(3);

	        new string[64], str[32];
	        if(FracInfo[m_id][fBank][0] > rand_weapon && p_info[playerid][pMetall] + rand_weapon < limit) //Metal
	        {
	            p_info[playerid][pMetall] += rand_weapon;
	            FracInfo[m_id][fBank][0] -= rand_weapon;

	            format(str, 32, "~n~~y~gun unit: +%d", rand_weapon);
	        	strcat(string, str);
	        }

	        if(FracInfo[m_id][fBank][1] > rand_ammo && p_info[playerid][pPatron] + rand_ammo < limit) //??????
	        {
	            p_info[playerid][pPatron] += rand_ammo;
	            FracInfo[m_id][fBank][1] -= rand_ammo;

	            format(str, 32, "~n~~b~ammo: +%d", rand_ammo);
	        	strcat(string, str);
	        }
			GameTextForPlayer(playerid, string, 1200, 4);

			UpdateArmyWarehouse3D(m_id);
		}
		else if(IsAArmy(playerid))
		{
			if(p_info[playerid][pMember] != m_id) return SendClientMessage(playerid, col_white, !""c_error"You do not have access to this warehouse.");
		    ShowPlayerAmmoDialog(playerid);
		}
    }

    if(ac_pickups[playerid][0] == pickupid) return 0;

	ac_pickups[playerid][0] = pickupid;
	GetPlayerPos(playerid, PosPic[playerid][0][0], PosPic[playerid][0][1], PosPic[playerid][0][2]);

    if(pickupid == license_pickup)
	{
	    SPD(playerid, 9871, DIALOG_STYLE_TABLIST, !""c_server"List of licenses", ""c_white"Pilot license\t10,000$\nWater transport license\t10,000$\nWeapon license\t30,000$", "Purchase", "Close");
	}

    if(pickupid == elecation_bulletin)
	{
	    if(p_info[playerid][pLevel] < 2) return SendClientMessage(playerid, COLOR_GREY, "Accessible from level 2.");

	    if(p_info[playerid][pElecVote]) return SendClientMessage(playerid, COLOR_GREY, "You have already voted.");
	    if(GetPVarInt(playerid, "can_vote")) return SendClientMessage(playerid, COLOR_GREY, "You have already taken the ballot.");

		SetPVarInt(playerid, "can_vote", 1);

		SendClientMessage(playerid, COLOR_GREEN, "You took the ballot.");
	}

	if(pickupid == elecation_vote)
	{
        if(!GetPVarInt(playerid, "can_vote")) return SendClientMessage(playerid, COLOR_GREY, "You do not have a ballot.");

        new str[64], count = 0;

		String = "";

		for(new i; i < MAX_ELECATIONS; i++)
		{
		    if(strlen(elecation_info[i][e_name]) < 4) continue;

		    format(str, 64, "[%d] %s\t%s\n", i + 1, elecation_info[i][e_name], elecation_info[i][e_owner]);
		    strcat(String, str);

		    SetPlayerListitemValue(playerid, count++, i);
		}

		return SPD(playerid, 3481, DIALOG_STYLE_TABLIST, !""c_server"List of parties", String, "Choose", "Close");
	}

    if(pickupid == docsteal_quest_pickup)
	{
	    if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_DOCSTEAL && player_quest_info[playerid][quest_status] == 1)
        {
            SPD(playerid, 8818, DIALOG_STYLE_LIST, !""c_server"List of transport documents", "Voodoo\nPerennial\nEsperanto\nOceanic\nGlendale\nHermes\nVirgo\nMajestic\nBuccaneer", "Take", "Close");
        }
	}

	for(new h; h < max_houses; h++)
	{
    	if(pickupid != HouseInfo[h][hPickup]) continue;

		if(player_rob_id[playerid] != -1 && HouseInfo[h][hLock] == 1)
		{
		    new rob_id = player_rob_id[playerid];

			new h_id = rob_info[rob_id][r_house];

			if(h_id == h) return SendClientMessage(playerid, COLOR_GREEN, "Hold and do not release the ALT key to start breaking the door.");
		}
	    new klass[16];
		switch(HouseInfo[h][hKlass])
		{
			case 0: klass = "Class C";
		    case 1: klass = "Class B";
		    case 2: klass = "Class A";
		    case 3: klass = "Modern Class";
		    case 4: klass = "Class Admin";
		    case 5: klass = "VIP House";
		}

		SetPVarInt(playerid, "house_want_enter", h);

		//new h_id = GetPlayerHouse(h);

  		if(HouseInfo[h][hOwned])
		{
			slobal_string[0] = EOS;
			format(slobal_string, 250, ""c_white"House ID: #%d\n"c_white"Owner: "c_server"%s\n\n"c_white"House Class: "c_yellow"%s\n"c_white"Price: "c_green"%d$\n"c_white"Rent: "c_green"%d$ / Day", HouseInfo[h][hID], HouseInfo[h][hOwner], klass, HouseInfo[h][hValue], HouseInfo[h][hTakings]);
			SPD(playerid, 9, DIALOG_STYLE_MSGBOX, !""c_server"House Sold", slobal_string, !"Enter", !"Cancel");
		}
		else
		{
			format_string[0] = EOS;
			format(format_string, sizeof(format_string), ""c_white"House ID: #%d\n"c_white"House Class: "c_yellow"%s\n"c_white"Price: "c_green"%d$\n"c_white"Rent: "c_green"%d$ / In Day\n\n"c_grey"Are you sure about buying the house?",HouseInfo[h][hID], klass, HouseInfo[h][hValue], HouseInfo[h][hTakings]);
			SPD(playerid, 13, DIALOG_STYLE_MSGBOX, !""c_server"Buy House", format_string, !"Choose", !"Cancel");
		}
		return 1;
	}
	//Gun Gang
	if(pickupid == gungang[0]) //Gun Gange Vagos
	{
	if(p_info[playerid][pMember] == FRACTION_VAGOS)
	{
	GivePlayerWeapon(playerid, 31, 200);
	GivePlayerWeapon(playerid, 24, 100);
	}
	}

	if(pickupid == gungang[1]) //Gun Gange Grove
	{
	if(p_info[playerid][pMember] == FRACTION_GROVE)
	{
	GivePlayerWeapon(playerid, 31, 200);
	GivePlayerWeapon(playerid, 24, 100);
	}
	}

	if(pickupid == gungang[2]) //Gun Gange Aztec
	{
	if(p_info[playerid][pMember] == FRACTION_AZTEC)
	{
	GivePlayerWeapon(playerid, 31, 200);
	GivePlayerWeapon(playerid, 24, 100);
	}
	}

	if(pickupid == gungang[3]) //Gun Gange Rifa
	{
	if(p_info[playerid][pMember] == FRACTION_RIFA)
	{
	GivePlayerWeapon(playerid, 31, 200);
	GivePlayerWeapon(playerid, 24, 100);
	}
	}

	if(pickupid == gungang[4]) //Gun Gange Yakuza
	{
	if(p_info[playerid][pMember] == FRACTION_YAKUZA)
	{
	GivePlayerWeapon(playerid, 31, 200);
	GivePlayerWeapon(playerid, 24, 100);
	}
	}

	if(pickupid == gungang[5]) //Gun Gange Columbia
	{
	if(p_info[playerid][pMember] == FRACTION_COLUMBIA)
	{
	GivePlayerWeapon(playerid, 31, 200);
	GivePlayerWeapon(playerid, 24, 100);
	}
	}

	if(pickupid == gungang[6]) //Gun Gange Biker
	{
	if(p_info[playerid][pMember] == FRACTION_BIKER)
	{
	GivePlayerWeapon(playerid, 31, 200);
	GivePlayerWeapon(playerid, 24, 100);
	}
	}

	if(pickupid == gungang[7]) //Gun Gange Ballas
	{
	if(p_info[playerid][pMember] == FRACTION_BALLAS)
	{
	GivePlayerWeapon(playerid, 31, 200);
	GivePlayerWeapon(playerid, 24, 100);
	}
	}
	//VagusGate
	if(pickupid == Vagusgate[0])
	{
	if(p_info[playerid][pMember] == FRACTION_VAGOS)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		SetVehiclePos(vehicleid, 2799.52, -1582.23, 10.93);
		SetVehicleZAngle(vehicleid, 35.5160);
		SetPPos(playerid, 2799.52, -1582.23, 10.93, 0, 0, false);
	}
	}

	if(pickupid == Vagusgate[1])
	{
	if(p_info[playerid][pMember] == FRACTION_VAGOS)
	{
	new vehicleid = GetPlayerVehicleID(playerid);
	SetVehiclePos(vehicleid, 2799.37817, -1590.62646, 10.528276);
	SetVehicleZAngle(vehicleid, 35.5160);
	SetPPos(playerid, 2799.37817, -1590.62646, 10.52827, 0, 0, false);
	}
	}

	if(Cloakroom[0] <= pickupid <= Cloakroom[sizeof Cloakroom - 1])
	{
		if(pickupid == Cloakroom[0] && p_info[playerid][pMember] != FRACTION_LSPD) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of LSPD");
		if(pickupid == Cloakroom[1] && p_info[playerid][pMember] != FRACTION_FBI) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of FBI");
		if(pickupid == Cloakroom[2] && p_info[playerid][pMember] != FRACTION_ARMY_LS) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of the SV.");
		if(pickupid == Cloakroom[3] && p_info[playerid][pMember] != FRACTION_MAYOR) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of the Los Santos city hall.");
		if(pickupid == Cloakroom[4] && p_info[playerid][pMember] != FRACTION_NEWS) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of the Radio Center organization.");
        if(pickupid == Cloakroom[5] && p_info[playerid][pMember] != FRACTION_ARMY_SF) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of the Navy.");
        if(pickupid == Cloakroom[6] && p_info[playerid][pMember] != FRACTION_ARMY_LV) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of the Air Force.");
        if(pickupid == Cloakroom[7] && p_info[playerid][pMember] != FRACTION_SFPD) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of the SFPD.");
        if(pickupid == Cloakroom[8] && p_info[playerid][pMember] != FRACTION_LVPD) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of the LVPD.");
        if(pickupid == Cloakroom[9] && p_info[playerid][pMember] != FRACTION_SFMEDICS) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of SF Hospital.");
        if(pickupid == Cloakroom[10] && p_info[playerid][pMember] != FRACTION_LVMEDICS) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of LV Hospital.");
        if(pickupid == Cloakroom[11] && p_info[playerid][pMember] != FRACTION_LSMEDICS) return SendClientMessage(playerid,COLOR_GREY,!"You are not a member of LS Hospital.");

		return SPD(playerid,163,DIALOG_STYLE_MSGBOX, !""c_server"Changing room.", ""c_white"Choose clothing.", "Uniform.", "Casual.");
	}
	else if(pickupid == pizza_work_pickup)
	{
	    if(p_info[playerid][pJob] != 0) return SendClientMessage(playerid, COLOR_GREY, "To start, quit /leave.");

        pizza_player_house[playerid] = -1;

	    p_info[playerid][pJob] = WORK_TYPE_PIZZA;

	    SendClientMessage(playerid, -1, "You successfully got hired as a pizza delivery person.");
	    SendClientMessage(playerid, 0x33AAFFff, "� {FFCC00}[Hint]: "c_white"Go to the back yard and take the pizza.");
	}
	else if(pickupid == pizza_take_pickup)
	{
	    if(p_info[playerid][pJob] != WORK_TYPE_PIZZA) return SendClientMessage(playerid, COLOR_GREY, "You are not working at the pizzeria.");

	    if(GetPVarInt(playerid, "take_pizza") == 1) return SendClientMessage(playerid, COLOR_GREY, "You have already taken the pizza.");

		if(GetPlayerSkin(playerid) != 155)
		{
		    SetPVarInt(playerid, "old_skin", GetPlayerSkin(playerid));
		    SetPlayerSkin(playerid, 155);
		}

	    SetPVarInt(playerid, "take_pizza", 1);

		SetPlayerAttachedObject(playerid, 4, 2814, 6, 0.0579, -0.0310, -0.1430, -108.9999, -13.1000, -2.0999, 1.0000, 1.0000, 1.0000);

        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

	    SendClientMessage(playerid, -1, "You took the pizza, press ALT near the scooter to deliver it.");
	    SendClientMessage(playerid, -1, "If you want to drop the pizza, use the command: /drop");
	}

	for(new h; h < TotalBizz; h++)
	{
	    if(pickupid != BizzInfo[h][bPickup]) continue;

		if(PlayerToPoint(2.0,playerid,BizzInfo[h][bBarX],BizzInfo[h][bBarY],BizzInfo[h][bBarZ]) && GetPlayerVirtualWorld(playerid) == BizzInfo[h][bVirtualWorld])
		{
		    player_use_bizbar[playerid] = h;
			switch(BizzInfo[h][bType])
			{
			    case 1: PC_EmulateCommand(playerid, "/drink");
			    case 2: PC_EmulateCommand(playerid, "/eat");
			    case 3,7: PC_EmulateCommand(playerid, "/buy");
			    case 5: PC_EmulateCommand(playerid, "/lease");
			    case 6: PC_EmulateCommand(playerid, "/clothes");
			    case 8: ShowPlayerBizzAmmoMenu(playerid);
			    case 23:
			    {
			        if(p_info[playerid][pLevel] < 2) return SendClientMessage(playerid, COLOR_GREY, "You need to be level 2 before starting.");

			        if(pb_state != 1) return SendClientMessage(playerid, COLOR_GREY, "The registration moment is closed.");

			        if(player_reg_pb[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "You're already registered.");

                    if(p_info[playerid][pCash] < 2000) return SendClientMessage(playerid, COLOR_GREY, "Registration requires $2,000.");

                    p_info[playerid][pCash] -= 2000;

                    GiveBusinessMoney(h, 500, 1);

                    pb_reward += 2000;

			        player_reg_pb[playerid] = pb_next_team;

			        pb_next_team = !pb_next_team;

			        SCMF(playerid, -1, "You registered for Paint Ball. Choose your team: %s", player_reg_pb[playerid] ? ("Red") : ("Blue"));
			    }
   			}
			return 1;
		}
	}
	for(new i = 1; i <= TotalEnters; i++)
	{
		if(pickupid == EntersInfo[i][pickPickup])
		{
		    switch(EntersInfo[i][pickID])
		    {
		        case 5: // ?????? ????????????
				{
					new text[32], text1[36], text2[32];
					if(GetPlayerHouse(playerid) == -1) text = "{FF6C00}No House";
					else format(text, sizeof(text), "{36DE00}House #%d", GetPlayerHouse(playerid));

					if(GetPlayerBizz(playerid) == -1) text1 = "{FF6C00}No business";
					else format(text1, sizeof(text1), "{36DE00}%s (#%d)", BizzInfo[GetPlayerBizz(playerid)][bMessage], GetPlayerBizz(playerid));

					if(GetPlayerABizz(playerid) == 0) text2 = "{FF6C00}No Gas Station";
					else format(text2, sizeof(text2), "{36DE00}%s (#%d)", BizzAInfo[GetPlayerABizz(playerid)][aMessage], GetPlayerABizz(playerid));

				    format(String, 244, ""c_white"1. Small House\t%s\n"c_white"2. Small Business\t%s\n"c_white"3. Small Gas\t%s", text, text1, text2);
					SPD(playerid,107, DIALOG_STYLE_LIST, !""c_server"Payment for real estate", String, "Choose", "Back");
					ProxDetectorBot(20.0, player_enter_actors[playerid], "Hello! What would you like to pay?",COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE5,COLOR_FADE5);
				}
				case 6:
				{
				    SetPlayerUseListitem(playerid, 0);

					MenuAtms(playerid);//BankDialog(playerid);
				}
				case 8: // ?Back from ??????
				{
					if(CheckHospitalHealth(playerid)) return 1;

					t_SetPlayerPos(playerid,EntersInfo[i][pickPosX], EntersInfo[i][pickPosY],EntersInfo[i][pickPosZ]), SetPlayerFacingAngle(playerid, EntersInfo[i][pickPosA]);
					SetPlayerInterior(playerid, EntersInfo[i][pickPosI]), SetPlayerVirtualWorld(playerid, EntersInfo[i][pickPosV]);
					SetCameraBehindPlayer(playerid);
				}
				case 9:
				{
				    if(p_info[playerid][pJob] == 1) return SendClientMessage(playerid, COLOR_GREY, "You're already working as a food/fuel distributor. Use /leave to quit.");

					format(format_string, sizeof(format_string), "Before getting a job: {09E097}Food/fuel delivery service\n"c_white"At the moment You: %s\n\nAre you sure you want to get this job?", NamesJob(playerid));
					SPD(playerid, 152, DIALOG_STYLE_MSGBOX, !""c_server"Before Getting A Job", format_string, "Yes", "No");
				}
				case 20: return 1; //????????? ????? ?????
 				case 23:
				{
				    if(GetPVarInt(playerid, "take_mats"))
				    {
				        new m_id = FRACTION_LSPD;
				        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000) return SendClientMessage(playerid, col_white, !""c_error"Enough ammunition in stock.");

				        SendClientMessage(playerid, col_white, !""c_info"You placed ammunition in the organization's warehouse.");

				        text_string[0] = EOS;
				        format(text_string, sizeof(text_string), ""c_info"Warehouse condition: "c_server"%d / 200000", FracInfo[m_id][fBank][0]);
				        SendClientMessage(playerid, col_white, text_string);

				        FracInfo[m_id][fBank][0] += 250;
				        FracInfo[m_id][fBank][1] += 250;

				        return RemovePlayerAmmoBox(playerid);
				    }
				    if(p_info[playerid][pMember] != 1) return SendClientMessage(playerid, col_white, !""c_error"You do not have access to this warehouse.");
				    return ShowPlayerAmmoDialog(playerid);
	   			}
				case 25:
				{
				    if(player_news_live[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You cannot leave the building while on air (/leave).");

				    SetPPos(playerid, EntersInfo[i][pickPosX], EntersInfo[i][pickPosY],EntersInfo[i][pickPosZ], EntersInfo[i][pickPosA], EntersInfo[i][pickPosI], EntersInfo[i][pickPosV], true);
				}
				default:
				{
				    SetPPos(playerid, EntersInfo[i][pickPosX], EntersInfo[i][pickPosY],EntersInfo[i][pickPosZ], EntersInfo[i][pickPosA], EntersInfo[i][pickPosI], EntersInfo[i][pickPosV], true);
				}
      		}
			return 1;
		}
	}
	return 1;
}

public OnVehicleMod(playerid, vehicleid, componentid)
{
    if(GetPlayerUseHomeCar(playerid) == -1) return SendClientMessage(playerid, COLOR_GREY, "You are not in a personal vehicle.");

	SCMF(playerid, -1, "{33AA33}Component successfully installed! "c_white"Name: %s(ID: %d, Model: %s). {43CD80}Price: %d$", VehicleComponent[componentid-1000][cType], VehicleComponent[componentid-1000][cID], VehicleComponent[componentid-1000][cName], VehicleComponent[componentid-1000][cCost]);
	return 1;
}

