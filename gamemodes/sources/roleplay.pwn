		if(!response)
		{
			CloseTunning(playerid);
			return 1;
		}
		switch(listitem)
		{

			case 0:
			{
			Showcolor(playerid);
			return 1;
			}
			case 1:
			{
				ShowNitro(playerid);
				return 1;
			}
			case 2:
			{
				if(AllowPaintJob(GetPlayerVehicleID(playerid)))
				{
					ShowPaint(playerid);
				}
				else return TuneMessage(playerid, "Paintjob is not allowed for this car."), ShowTuneDialog(playerid);
			}
			case 3:
			{
				ShowSpoilers(playerid);
				return 1;
			}
			case 4:
			{
				ShowHoods(playerid);
				return 1;
			}
			case 5:
			{
				ShowVents(playerid);
				return 1;
			}
			case 6:
			{
				ShowLights(playerid);
				return 1;
			}
			case 7:
			{
				ShowExhausts(playerid);
				return 1;
			}
			case 8:
			{
				ShowFront(playerid);
				return 1;
			}
			case 9:
			{
				ShowRear(playerid);
				return 1;
			}
			case 10:
			{
				ShowRoofs(playerid);
				return 1;
   }
			case 11:
			{
				ShowWheels(playerid);
				return 1;
			}
			case 12:
			{

				if(GetPlayerMoney(playerid) >= 175000)
				{
				ShowTuneDialog(playerid);
					new car = GetPlayerVehicleID(playerid);
//					new use_car = GetPlayerUseListitem(playerid);

					GivePlayerMoneyEx(playerid, -175000, "Tuning");

					AddVehicleComponent(car,1087);

					PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);

					TuneMessage(playerid, "Installed (Hydraulic) in your {FFFFFF}vehicle");


					ShowTuneDialog(playerid);
				}
				else ShowTuneDialog(playerid), TuneMessage(playerid, "You don't have enough {FFFFFF}money {7FFF00}[$175,000]");
			}
			case 13:
			{
			ShowNeon(playerid);
			return 1;
			}
			case 14:
			{
			ShowXenon(playerid);
			return 1;
			}
			case 15:
			{

				if(GetPlayerMoney(playerid) >= 125000)
				{
				ShowTuneDialog(playerid);

//					new use_car = GetPlayerUseListitem(playerid);

					GivePlayerMoneyEx(playerid, -125000, "Tuning");



					PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);

					TuneMessage(playerid, "Installed (Radio) in your {FFFFFF}vehicle");


					ShowTuneDialog(playerid);
				}
				else ShowTuneDialog(playerid), TuneMessage(playerid, "You don't have enough {FFFFFF}money {7FFF00}[$125,000]");
			}
            case 16:
            {
            ShowTuneDialog(playerid);
            TuneMessage(playerid, "Soon!!!");
            }

		}
	}
