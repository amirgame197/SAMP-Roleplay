stock IsAFly(vehicleid)
{
	switch(GetVehicleModel(vehicleid))
	{
	    case 460, 476, 511..513, 519, 520, 553, 577, 592, 593: return 1; //Airplanes
	    case 417, 425, 447, 469, 487, 488, 497, 548, 563: return 1; //Helicopters
	}

	return 0;
}

stock PlayerEnterToBizz(playerid, b)
{
    p_t_info[playerid][pSelectBusinessID] = b;
    SetPVarInt(playerid, "next_area", gettime() + 3);

    if(BizzInfo[b][bType] == 9)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, 561.961, -1293.72, 17.2482)) SetPVarInt(playerid, "sellcarClass", 1);
		if(IsPlayerInRangeOfPoint(playerid, 5.0, -1957.34, 297.945, 35.4688)) SetPVarInt(playerid, "sellcarClass", 3);
		if(IsPlayerInRangeOfPoint(playerid, 5.0, 1658.47, 2200.35, 10.8203)) SetPVarInt(playerid, "sellcarClass", 5);
		if(IsPlayerInRangeOfPoint(playerid, 5.0, 2131.8152, -1151.3242, 24.0600)) SetPVarInt(playerid, "sellcarClass", 6);
		return SPD(playerid, 1241, DIALOG_STYLE_MSGBOX, !""c_server"Car dealership", !""c_white"Would you like to see the list of vehicles?", !"Choose", !"Cancel");
	}

	SetPPos(playerid, BizzInfo[b][bExitX], BizzInfo[b][bExitY], BizzInfo[b][bExitZ], 0.0, BizzInfo[b][bInterior], BizzInfo[b][bVirtualWorld], true);
	if(BizzInfo[b][bUpdMusic]) PlayerPlaySound(playerid, 6401, BizzInfo[b][bExitX], BizzInfo[b][bExitY], BizzInfo[b][bExitZ]);
    player_enter_biz[playerid] = b;
    return 1;
}

stock UpdatePlayerName(playerid)
{
	new new_nick[MAX_PLAYER_NAME + 12];

	new mobile_text[6];

	format(mobile_text, 6, IsPlayerMobile(playerid) ? ("[M] ") : ("[PC] "));

	new status_text[6];

	format(status_text, 6, admin_level[playerid] ? ("[A] ") : p_info[playerid][pLeader] ? ("[L] ") : p_info[playerid][pVip] ? ("[V] ") : (""));

    strins(new_nick, mobile_text, strlen(new_nick));
    strins(new_nick, status_text, strlen(new_nick));
    strins(new_nick, Name(playerid), strlen(new_nick));

	printf("%s %d", new_nick, SetPlayerName(playerid, new_nick));
}

