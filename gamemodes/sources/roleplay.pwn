stock ProductsMenu(playerid)
{
	if(player_use_bizbar[playerid] == 0) return 1;
	new i = player_use_bizbar[playerid];

	if(BizzInfo[i][bType] == 7) // ??????? ??????
	{
	    if(GetPlayerHouse(playerid) == -1) return SendClientMessage(playerid, COLOR_GREY, "To purchase furniture, you must have a House.");
    	return SPD(playerid,17,DIALOG_STYLE_INPUT, !""c_server"Furniture Store",""c_white"[1] Furniture for Home\n[2] Doors\n[3] Paintings\n[4] Home Flowers\n[5] Home Technology\n[6] Everything for the Bathroom","Choose","Exit");
    }

    format(String, 480,
		""c_white"[1] Mobile\t{43CD80}%d$\n\
		"c_white"[2] SIM Card\t{43CD80}%d$\n\
		"c_white"[3] Telephone Book\t{43CD80}%d$\n\
		"c_white"[4] First Aid Kits\t{43CD80}%d$\n\
		"c_white"[5] First Aid Kits for Home (10 PC)\t{43CD80}%d$\n\
		"c_white"[6] Mask (1 PC)\t{43CD80}%d$\n\
		"c_white"[7] Clip (1 PC)\t{43CD80}%d$\n\
		"c_white"[8] Repair Car (1 PC)\t{43CD80}%d$\n\
		"c_white"[9] Spray Can (1000 ml)\t{43CD80}%d$\n\
		"c_white"[11] Watch\t{43CD80}%d$\n\
		"c_white"[10] Hookah (1 PC)\t{43CD80}%d$",
		BizzInfo[i][bPrice]*10,
		BizzInfo[i][bPrice]*2,
		BizzInfo[i][bPrice]*6,
		BizzInfo[i][bPrice]*4,
		BizzInfo[i][bPrice]*7,
		BizzInfo[i][bPrice]*3,
		BizzInfo[i][bPrice]*10,
		BizzInfo[i][bPrice]*3,
		BizzInfo[i][bPrice]*5,
		BizzInfo[i][bPrice]*2,
		BizzInfo[i][bPrice]*100);

	return SPD(playerid, 61, DIALOG_STYLE_TABLIST, !""c_server"Shop", String, "Purchase", "Cancel");
}
stock isNum(const text[])
{
	new kolvo;
	for(new i, z = strlen(text); i < z; i++)
	{
	    if('0' <= text[i] <= '9')
	    {
	        kolvo++;
			if(kolvo == strlen(text)) return 0;
	    }
	}
	return 1;
}

stock convert_time(seconds)
{
	new time_string[12],
		minutes = floatround(seconds / 60);

	seconds -= minutes * 60;

	format(time_string, sizeof(time_string), "%02d:%02d", minutes, seconds);
	return time_string;
}

stock Convert(number)
{
	new sting[100];
	new hours = 0, mins = 0, secs = 0;
	hours = floatround(number / 3600);
	mins = floatround((number / 60) - (hours * 60));
	secs = floatround(number - ((hours * 3600) + (mins * 60)));
	if(hours > 0) format(sting, 100, "%d:%02dm", hours, mins);
	else format(sting, 100, "%d:%02d", mins, secs);
	return sting;
}

stock ConvertSeconds(time)
{
	new string[20];
	format(string, 20, "%d:%02i:%02i", floatround(time/3600), floatround(time%3600/60), time%3600%60);
	return string;
}

stock SetPlayerToTeamColor(playerid)
{
	switch(p_info[playerid][pMember])
	{
		case FRACTION_LSPD, FRACTION_SFPD, FRACTION_LVPD, FRACTION_FP, FRACTION_RCPD: SetPlayerColor(playerid, 0x110CE7FF);
		case FRACTION_FBI: SetPlayerColor(playerid, COLOR_GREY);
		case FRACTION_ARMY_LS,FRACTION_ARMY_SF,FRACTION_ARMY_LV: SetPlayerColor(playerid, COLOR_GREEN);
		case FRACTION_MAYOR: SetPlayerColor(playerid, 0xFFFF00ff);
		case FRACTION_LSMEDICS, FRACTION_SFMEDICS, FRACTION_LVMEDICS: SetPlayerColor(playerid, 0xFF6666ff);
		case FRACTION_NEWS: SetPlayerColor(playerid, 0xff4f00ff);

		case FRACTION_BIKER: SetPlayerColor(playerid, 0x2F4F4Fff);

		case FRACTION_BALLAS: SetPlayerColor(playerid, 0x882288BB);
		case FRACTION_VAGOS: SetPlayerColor(playerid, 0xEEEE00BB);
		case FRACTION_GROVE: SetPlayerColor(playerid, 0x66AA22BB);
		case FRACTION_AZTEC: SetPlayerColor(playerid, 0x66EEEEBB);
		case FRACTION_RIFA: SetPlayerColor(playerid, 0x88CCCCBB);

		case FRACTION_YAKUZA: SetPlayerColor(playerid, 0x800000ff);
		case FRACTION_COLUMBIA: SetPlayerColor(playerid, 0xBC8F8Fff);
		case FRACTION_RUMAFIA: SetPlayerColor(playerid, 0xC0C0C0ff);

		default: SetPlayerColor(playerid, TEAM_HIT_COLOR);
	}
	return 1;
}

