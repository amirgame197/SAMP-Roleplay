				    if(HouseInfo[house][hHel] >= 10) return SendClientMessage(playerid, -1, "You cannot have more than 10 first-aid kits in storage.");
			    	if(p_info[playerid][pCash] < cena) return SCMF(playerid, -1, "You don't have enough money to buy the House first-aid kit set, you need %d$", cena);

