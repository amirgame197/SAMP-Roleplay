					p_info[playerid][pID]);
					mysql_tquery(dbHandle, query);
					SendClientMessage(playerid, -1, !"- You successfully dropped the accessory.");
				}
			}
			DeletePVar(playerid, "acc_listitem");
			new string[42];
			dlobal_string[0] = EOS;
			strcat(dlobal_string, ""c_server"Please choose an accessory slot\n");
			for(new j = 0; j < 9; j ++) {
