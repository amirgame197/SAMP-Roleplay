cmd:dgun(playerid, params[])
{
        if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
        if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, col_grey, !"Use: /dgun [Ammo]");
        if(params[0] == 0) return SendClientMessage(playerid, col_grey, !"Ammo Invalid (1-300)");
        if(params[0] > 299) return SendClientMessage(playerid, col_grey, !"Ammo Invalid (1-300)");
        new GunID = GetPlayerWeapon(playerid);
        new GunAmmo = GetPlayerAmmo(playerid);
        if(GunAmmo-params[0] < 1) return SendClientMessage(playerid, col_grey, !"Invalid ammo.");
        if(GunID > 0 && GunAmmo != 0)
        {
            new f = MAX_OBJ+1;
            for(new a = 0; a < MAX_OBJ; a++)
            {
                if(dGunData[a][ObjPos][0] == 0.0)
                {
                    f = a;
                    break;
                }
            }
            if(f > MAX_OBJ) return SendClientMessage(playerid, 0xFFC900, "You cannot drop weapons at the moment, please try again later!");
            if(GunAmmo-params[0] < 1) RemovePlayerWeapon(playerid, GunID);
			else SetPlayerAmmo(playerid,GunID,GunAmmo-params[0]);
			SetPlayerArmedWeapon(playerid, 0);
			SaveGun(playerid);
			dGunData[f][ObjData][0] = GunID;
			dGunData[f][ObjData][1] = params[0];
            GetPlayerPos(playerid, dGunData[f][ObjPos][0], dGunData[f][ObjPos][1], dGunData[f][ObjPos][2]);
            new playerVW = GetPlayerVirtualWorld(playerid);
            dGunData[f][VW] = playerVW;
			dGunData[f][ObjID] = CreateDynamicPickup(GunObjects[GunID], 23, dGunData[f][ObjPos][0], dGunData[f][ObjPos][1], dGunData[f][ObjPos][2], dGunData[f][VW]);
			new bufferr[200];
			format(bufferr, sizeof(bufferr), "{FFC900}Drop\n{FFFFFF}%s's weapon\n%s\nAmmo : %i\nPress ALT or use /pgun to pick", GN(playerid), GunNames[dGunData[f][ObjData][0]], dGunData[f][ObjData][1]);
  			dGunData[f][Label] = Create3DTextLabel(bufferr, 0xFFFFFFFF, dGunData[f][ObjPos][0], dGunData[f][ObjPos][1], dGunData[f][ObjPos][2], 25.0000, dGunData[f][VW], 0);
            new buffer[50];
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 2, 0, 0, 0, 0, 0);
			format(buffer, sizeof(buffer), "You dropped %s.", GunNames[dGunData[f][ObjData][0]]);
			SendClientMessage(playerid, 0x3FFC900, buffer);
        }
        return 1;
}
alias:jp("Jetpack.", "Jet.")
cmd:jp(playerid)
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USEJETPACK);
	return 1;
}
cmd:gm(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /godmod [Player ID].");
 	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

    SetPlayerHealth(targetid, 999999999);
	SetPlayerArmour(playerid, 999999999);
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] Godmode has been applied to Player %s[%d].", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);

	if(GetPVarInt(targetid, !"p_dead") >= 1) DeletePVar(targetid, !"p_dead");
	return 1;
}
cmd:pgun(playerid)
{
        if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
        if(p_info[playerid][pLevel] < 10) return SendClientMessage(playerid, col_white, !""c_error"Your level must be above 10.");
        new f = MAX_OBJ+1;
		for(new a = 0; a < MAX_OBJ; a++)
		{
		    if(IsPlayerInRangeOfPoint(playerid, 5.0, dGunData[a][ObjPos][0], dGunData[a][ObjPos][1], dGunData[a][ObjPos][2]))
		    {
		        f = a;
		        break;
		    }
		}
		if(f > MAX_OBJ) return SendClientMessage(playerid, 0x33AA3300, "You cannot pick up weapons at the moment, please try again later!");
		DestroyDynamicPickup(dGunData[f][ObjID]);
		GivePlayerWeapon(playerid, dGunData[f][ObjData][0], dGunData[f][ObjData][1]);
		SaveGun(playerid);
		dGunData[f][ObjPos][0] = 0.0;
		dGunData[f][ObjPos][1] = 0.0;
		dGunData[f][ObjPos][2] = 0.0;
		dGunData[f][ObjID] = 0;
		dGunData[f][ObjID] = -1;
		//dGunData[f][ObjData][0] = 0;
		dGunData[f][ObjData][1] = 0;
		Delete3DTextLabel(dGunData[f][Label]);
		new buffer[50];
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 2, 0, 0, 0, 0, 0);
		format(buffer, sizeof(buffer), "You picked up %s.", GunNames[dGunData[f][ObjData][0]]);
  		SendClientMessage(playerid, 0xFFC900, buffer);
  		return 1;
}
stock BuyFamilyCar(playerid)
{
        new family_id = p_info[playerid][family];
        GetPlayerPos(playerid,pposx,pposy,pposz);
        text_string[0] = EOS;
        format(text_string, sizeof(text_string), "familyveh/%s.ini", family_info[family_id - 1][fam_name]);
	    if(!fexist(text_string))
	    {
	    new File:handle = fopen(text_string, io_write);
	    fclose(File:handle);
	    new FMVEHFILE = ini_openFile(text_string);
	    ini_setInteger(FMVEHFILE,"familyvehs",0);
	    ini_getInteger(FMVEHFILE,"familyvehs",familymaxveh);
	    ini_setInteger(FMVEHFILE,"ffamilyveh1",1);
	    ini_getInteger(FMVEHFILE,"ffamilyveh1",ffamilyveh1);
	    ini_setInteger(FMVEHFILE,"ffamilyveh2",0);
