	    SPD(playerid, 4378, DIALOG_STYLE_MSGBOX, !""c_server"Rent A Bike", !""c_white"Do you want to rent a bike?\nCost: $50\n"c_grey"Rent will be canceled when you are out of the vehicle for 40 seconds.", !"Yes", !"No");
	}

	if(areaid == hotel_reception_area)
	{
		if(GetPlayerHouse(playerid) != -1) return SendClientMessage(playerid, COLOR_GREY, "You already have a house.");
		if(GetPlayerHouseLodger(playerid) != -1) return SendClientMessage(playerid, COLOR_GREY, "You are already registered somewhere, use: /leavelodger.");
	    if(p_info[playerid][pHotel] != -1) return SendClientMessage(playerid, COLOR_GREY, "You already have a hotel room.");

	    command_text = "";

	    new str[64], count = 0;

	    for(new i; i < MAX_HOTELS; i++)
	    {
	        if(hotel_info[i][hOwned] == 1) continue;

	        if(count == 20) break;

	        //SetPlayerListitemValue(playerid, count++, i);

	        format(str, 64, "\n[%d] floor %d room %d, price: $%d.", i + 1, hotel_info[i][hFloor] + 1, hotel_info[i][hNumber], hotel_info[i][hPrice]);
			strcat(command_text, str);

			count++;
	    }

	    strcat(command_text, "\n\nEnter line number:");

	    return ShowPlayerDialog(playerid, 4373, DIALOG_STYLE_INPUT, !""c_server"List of available rooms.", command_text, "Rental.", "Close");
	}

    if(hotel_areas[0] <= areaid <= hotel_areas[sizeof hotel_areas - 1])
	{
	    if(player_hotel_id[playerid] != -1) return 1;

	    new index = _:(areaid - hotel_areas[0]);

	    new floor = player_hotel_floor[playerid];

		new h_id = g_entrance_flat[floor][index];

	    new is_owned = hotel_info[h_id][hOwned];

	    if(is_owned == 0) return 1;

	    SetPlayerUseListitem(playerid, h_id);

	    command_text = "";

		new str[64];

	    format(str, 64, "Owner: %s.", hotel_info[h_id][hOwner]);
	    strcat(command_text, str);

	    format(str, 32, "\nApartment number: %d.", index + 1);
	    strcat(command_text, str);

	    format(str, 16, "\nFloor: %d.", floor + 1);
	    strcat(command_text, str);

		return ShowPlayerDialog(playerid, 4872, DIALOG_STYLE_MSGBOX, !""c_server"Entering the room.", command_text, "Enter.", "Close");
	}

    if(areaid == race_area)
    {
        if(p_info[playerid][pLicenses][0] != 1) return SendClientMessage(playerid,-1,"You do not have a driver's license.");

        if(race_state != 1) return SendClientMessage(playerid, COLOR_GREY, "Currently, registration is closed.");

		if(player_race_reg{playerid}) return SPD(playerid, 1872, DIALOG_STYLE_MSGBOX, !""c_server"Races", ""c_white"Do you want to cancel participation in the race?", "Yes", "No");

		SPD(playerid, 1871, DIALOG_STYLE_MSGBOX, !""c_server"Races", ""c_white"Do you want to participate in the race?", "Yes", "No");
    }
    else if(areaid == hotel_lift)
    {
        ShowPlayerDialog(playerid, 4771, DIALOG_STYLE_INPUT, !""c_server"Floor selection", "Enter floor number:\nFrom 1 to 6", "Choose", "Close");
    }
    else if(areaid == tune_engine_area)
    {
        new use_car = GetPlayerUseHomeCar(playerid);

        if(use_car == -1) return SendClientMessage(playerid, COLOR_GREY, "You are not in a personal vehicle.");

		new vehicleid = GetPlayerVehicleID(playerid);

        if(IsABoat(vehicleid) || IsABike(vehicleid) || IsAPlane(vehicleid) || NoPerfomance(vehicleid)) return SendClientMessage(playerid, 0xafafafff, "You cannot install upgrades on this vehicle!");

		show_tune_engine(playerid);
    }
    else if(areaid == tune_brake_area)
    {
        new use_car = GetPlayerUseHomeCar(playerid);

        if(use_car == -1) return SendClientMessage(playerid, COLOR_GREY, "You are not in a personal vehicle.");

        new vehicleid = GetPlayerVehicleID(playerid);

        if(IsABoat(vehicleid) || IsABike(vehicleid) || IsAPlane(vehicleid) || NoPerfomance(vehicleid)) return SendClientMessage(playerid, 0xafafafff, "You cannot install upgrades on this vehicle!");
        show_tune_brake(playerid);
    }
    else if(areaid == trash_unload)
    {
        if(p_info[playerid][pJob] != 4) return 1;

        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;//SendClientMessage(playerid,-1,"Player is not driving");

        new vehicleid = GetPlayerVehicleID(playerid);

        if(veh_info[vehicleid][vFr] != 4) return SendClientMessage(playerid, COLOR_GREY, "You're not in the garbage truck!");

		new amount = trash_vehicle_amount[vehicleid];

        if(amount <= 0) return SendClientMessage(playerid, COLOR_GREY, "The garbage truck is empty!");

        new salary = amount * 10;

        new partner_id = GetPlayerInVehicleSeat(vehicleid, 1);
        if(partner_id != INVALID_PLAYER_ID && p_info[partner_id][pJob] == 4)
        {
            new partner_salary = salary / 2;

			GivePlayerPayCheck(partner_id, partner_salary);

			SCMF(partner_id, -1, "You unloaded the garbage truck, Earned: {91d29a}$%d.", partner_salary);

			salary /= 2;
        }

        GivePlayerPayCheck(playerid, salary);

		SCMF(playerid, -1, "You unloaded the garbage truck, Earned: {91d29a}$%d.", salary);

		if(partner_id != INVALID_PLAYER_ID)
		{
		    SendClientMessage(playerid, -1, "The payment was split between you and your partner!");
		    SendClientMessage(partner_id, -1, "The payment was split between you and your partner!");
		}
		DisablePlayerCheckpoint(playerid);
		UpdateVehicleTrashInfo(vehicleid, -amount);
    }
    else if(areaid == collector_unload)
    {
        if(p_info[playerid][pJob] != 5) return 1;

        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,-1,"You are not in an armored vehicle!");

        new vehicleid = GetPlayerVehicleID(playerid);

        if(veh_info[vehicleid][vFr] != 5) return SendClientMessage(playerid, COLOR_GREY, "You are not in the armored car!");

        new amount = collector_vehicle_amount[vehicleid];

        if(amount <= 0) return SendClientMessage(playerid, COLOR_GREY, "There is no money in the armored vehicle!");

        new salary = amount * 10;

        new partner_id = GetPlayerInVehicleSeat(vehicleid, 1);
        if(partner_id != INVALID_PLAYER_ID && p_info[partner_id][pJob] == 5)
        {
            new partner_salary = salary / 2;

			GivePlayerPayCheck(partner_id, partner_salary);

			SCMF(partner_id, -1, "You brought money, Floor received: {91d29a}$%d", partner_salary);

			salary /= 2;
        }

        GivePlayerPayCheck(playerid, salary);

		SCMF(playerid, -1, "You brought money, Floor received: {91d29a}$%d", salary);

		if(partner_id != INVALID_PLAYER_ID)
		{
		    SendClientMessage(playerid, -1, "The payment was split between you and your partner!");
		    SendClientMessage(partner_id, -1, "The payment was split between you and your partner!");
		}
		DisablePlayerCheckpoint(playerid);

		UpdateVehicleCollectorInfo(vehicleid, -amount);
    }
    for(new i=1; i <= TotalActor; i++)
	{
		if(areaid == ActorInfo[i][aAreaActors]) return player_enter_actors[playerid] = i;
	}
 	//

  	for(new i=1; i <= TotalAtms; i++)
    {
        if(areaid == AtmsInfo[i][aAreaEnters])
		{
		    if(p_info[playerid][pJob] == 5 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID) return 1;

		    SetPlayerUseListitem(playerid, i);

			return MenuAtms(playerid);
		}
	}
	for(new i=1; i <= TotalABizz; i++)
    {
        if(areaid == BizzAInfo[i][aEntranceArea]) return player_enter_fuel[playerid] = i;
	}

	if(0 <= player_enter_home[playerid] <= max_houses-1)
	{
	    new h_id = player_enter_home[playerid];

	    if(areaid != HouseInfo[h_id][hStoreArea]) return 1;

	    ShowPlayerHouseStore(playerid);
	}

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		for(new b; b < TotalBizz; b++)
	    {
	        if(areaid == BizzInfo[b][bEntranceArea])
			{
			    if(BizzInfo[b][bType] == 14) return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"UveHouse statement", !""c_white"Entry into the business is not possible.", !"Close", !"");

			    if(BizzInfo[b][bEntranceCost] > 0 && GetPlayerBizz(playerid) != b && GetPVarInt(playerid, "EntrancePaymentBizz") != b)
				{
				    SetPlayerUseListitem(playerid, b);

					text_string[0] = EOS;
					format(text_string, sizeof(text_string), ""c_white"Entry is paid and costs "c_green"%d$\n"c_grey"Do you really want to enter the business?", BizzInfo[b][bEntranceCost]);
					return SPD(playerid, 63, DIALOG_STYLE_MSGBOX, !""c_server"Entry", text_string, !"Choose", !"Cancel");
				}
				return PlayerEnterToBizz(playerid, b);
			}

			if(areaid == BizzInfo[b][bExitArea])
			{
		        if(player_reg_pb[playerid] != -1)
		        {
		            GivePlayerMoneyEx(playerid, 2000, "Registration interrupted for PB.");
		            SendClientMessage(playerid, COLOR_GREY, "Registration interrupted, money returned.");

	                GiveBusinessMoney(b, -500, -1);
		            player_reg_pb[playerid] = -1;
		        }

		        if(BizzInfo[b][bType] == 9)
		        {
			        new b_id = p_t_info[playerid][pSelectBusinessID];
					switch(GetPlayerVirtualWorld(playerid))
					{
						case 1: SPD(playerid, 1242, DIALOG_STYLE_LIST, !""c_server"Car dealership", !"2nd floor\nBack", !"Choose", !"Cancel");
						case 2: SPD(playerid, 1242, DIALOG_STYLE_LIST, !""c_server"Car dealership", !"1st floor\nBack", !"Choose", !"Cancel");
						case 3: SPD(playerid, 1242, DIALOG_STYLE_LIST, !""c_server"Car dealership", !"2nd floor\nBack", !"Choose", !"Cancel");
						case 4: SPD(playerid, 1242, DIALOG_STYLE_LIST, !""c_server"Car dealership", !"1st floor\nBack", !"Choose", !"Cancel");
						case 5..6:
						{
							SetPlayerPos(playerid, BizzInfo[b_id][bEntranceX], BizzInfo[b_id][bEntranceY], BizzInfo[b_id][bEntranceZ]);
							SetPlayerVirtualWorld(playerid, 0);
							SetPlayerInterior(playerid, 0);
							SetCameraBehindPlayer(playerid);
						}
					}
					return 1;
				}

				SetPVarInt(playerid, "next_area", gettime() + 3);

				SetPlayerPos(playerid, BizzInfo[b][bEntranceX], BizzInfo[b][bEntranceY], BizzInfo[b][bEntranceZ]);
				SetPlayerVirtualWorld(playerid, 0);
				SetPlayerInterior(playerid, 0);

				p_t_info[playerid][pSelectBusinessID] = -1;
				return 1;
			}
		}
	}

	return 1;
}

public OnPlayerLeaveDynamicArea(playerid, areaid)
{
	if(areaid == mayor_weather_area) SetPlayerWeather(playerid, weather_id);

    if(graffiti_area[0] <= areaid <= graffiti_area[MAX_GRAFFITI - 1])
	{
	    //new index = _:(areaid - graffiti_area[0]);

		if(!IsAGang(playerid)) return 1;

		if(graffiti_player_progress[playerid] != 0) PlayerStopRestyleGraffiti(playerid);
	}

    for(new i; i < max_houses; i++)
	{
    	if(areaid != HouseInfo[i][hAreaEnter]) continue;

	    for(new x = 0; x < 3; x++) PlayerTextDrawHide(playerid, UseLAlt[playerid][x]);

	    break;
 	}

 	if(player_enter_fuel[playerid] != 0)
	{
	    for(new i = 0; i < 3; i++) PlayerTextDrawHide(playerid, UseLAlt[playerid][i]);
	 	return player_enter_fuel[playerid] = 0;
 	}
 	if(player_enter_actors[playerid] != 0) return player_enter_actors[playerid] = 0;
 	new r = GetNearestRadar(areaid);
	if(r != -1)
	{
		if(GetPVarInt(playerid, "v_radar") != 0) DeletePVar(playerid, "v_radar");
	}
	return 1;
}
public OnPlayerPickUpDynamicPickup(playerid, pickupid) //For Dynamic Puckup
{
