cmd:setprod(playerid)
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;

	for(new i; i < MAX_BIZZ; i++) BizzInfo[i][bProducts] = 20000;
    for(new i; i < MAX_aBIZZ; i++) BizzAInfo[i][aProducts] = 20000;

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] set 20,000 products for all businesses.", Name(playerid), playerid);
	send_admin_message(col_grey, text_string);

	SaveBizzAll();
	return 1;
}

cmd:setbizname(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;

    for(new i; i < MAX_BIZZ; i++)
	{
        if(!PlayerToPoint(10.0, playerid, BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ])) continue;
		extract params -> new string:biz_name[64]; else return SendClientMessage(playerid, col_grey, !"Use: /setbizname [business name]");

	    format(BizzInfo[i][bMessage], 48, biz_name);

		text_string[0] = EOS;
        mysql_format(dbHandle, text_string, sizeof(text_string), "UPDATE `bizz` SET `bMessage`='%e' WHERE `bID`='%d'", biz_name, i);
        mysql_tquery(dbHandle, text_string);

        text_string[0] = EOS;
        format(text_string, sizeof(text_string), ""c_info"You successfully changed the business name to "c_server"%s [ #%d ]", biz_name, i);
        return SendClientMessage(playerid, col_white, text_string);
	}
	return SendClientMessage(playerid, col_white, !""c_error"RyaHouse has no businesses with you.");
}

cmd:saveall(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
    if(GetPVarInt(playerid, "SaveAll") > gettime()) return SendClientMessage(playerid, COLOR_GREY, "You can save all server information every 180 seconds!");

	SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Saving", !""c_white"Saving tables:\n\n- business\n- Gas station\n- Cars\n- House\n\n"c_white"Detailed information in server.log", !"Close", !"");
	SetPVarInt(playerid, "SaveAll", gettime() + 180);
	return SaveAllServers();
}

cmd:payday(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
 	pay_day_time();
	return 1;
}

cmd:kslevel(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid, pl_level; else return SendClientMessage(playerid, col_grey, !"Use: /setlevel [Player id] [Level]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

 	p_info[targetid][pLevel] = pl_level;
	SetPlayerScore(targetid, p_info[targetid][pLevel]);
	update_int_sql(targetid, "pLevel", p_info[targetid][pLevel]);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You successfully changed Player's Level "c_server"%s"c_white" at %d", Name(targetid), pl_level);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}
cmd:offadmins(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;

	format(MySQLStr, 144, "SELECT `Name`, `pAdmin`, `pAdminKey`, `pDataNaz` FROM `admin` WHERE `pAdmin` <= '6'");
	mysql_tquery(dbHandle, MySQLStr, "OnMySQL_Query","dd", playerid, 18);
	return 1;
}

cmd:offleaders(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "SELECT `pID`,`pName`,`pfWarn`,`pLeader` FROM `accounts` WHERE `pLeader`>'0'");
	mysql_tquery(dbHandle, text_string, "ShowPlayerOffLeaders","d", playerid);
	return 1;
}

cmd:makeleader(playerid, params[])
{
	if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /makeleader [Player ID]");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(afk_time[targetid] > 2) return SendClientMessage(playerid, col_white, !""c_error"The player is AFK.");
	if(p_info[targetid][pWarn] > 0) return SendClientMessage(playerid, col_white, !""c_error"The player has an active warning.");
	if(IsPlayerInAnyVehicle(targetid)) return SendClientMessage(playerid, col_white, !""c_error"The player is in a vehicle.");
	if(admin_level[targetid] >= 1 && admin_level[targetid] <= 6) return SendClientMessage(playerid, col_white, !""c_error"It is prohibited to appoint Administrator as a leader.");

	SetPlayerUseListitem(playerid, targetid);

	new count = 0;
	dlobal_string[0] = format_string[0] = EOS;
	for(new i = 1; i < MAX_FRACTIONS; i++)
	{
		format(format_string, sizeof(format_string), ""c_server"[%d]"c_white" %s\n", i, FracInfo[i][fName]);
		strcat(dlobal_string, format_string);

		SetPlayerListitemValue(playerid, count++, i);
	}
	SPD(playerid, 7617, DIALOG_STYLE_LIST, Name(targetid), dlobal_string, !"Choose", !"Close");
	return 1;
}

cmd:setunleader(playerid, params[])
{
	if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, string:reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /unleader [Player ID] [Reason]");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] removed the leader %s[%d] of the organization %s. Reason: %s", Name(playerid), playerid, Name(targetid), targetid, FracInfo[p_info[targetid][pMember]][fName], reason);
	send_admin_message(col_grey, text_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white" removed you from the leadership of the organization %s. Reason: "c_orange"%s", Name(playerid), FracInfo[p_info[targetid][pMember]][fName], reason);
	SendClientMessage(targetid, col_white, text_string);

	p_info[targetid][pLeader] =
	p_info[targetid][setspawn] =
	p_info[targetid][pMember] =
	p_info[targetid][pRank] =
	p_info[targetid][pfWarn] =
	form_fraction[targetid] = 0;

	SavePlayerFraction(targetid);
	SetPlayerSkinEx(targetid, p_info[targetid][pSkin]);
	SetPlayerToTeamColor(targetid);
	return 1;
}

cmd:bsetmafia(playerid, params[])
{
	if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	extract params -> new biz_id, mafia_id; else return SendClientMessage(playerid, col_grey, !"Use: /bsetmafia [Mafia number (10, 16, 17)]");

	if(!(0 <= biz_id <= MAX_BIZZ - 1))
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The valid business numbers are from 0 to %d.", MAX_BIZZ - 1);
	    return SendClientMessage(playerid, col_white, text_string);
	}

	if(mafia_id != 10 && mafia_id != 16 && mafia_id != 17) return SendClientMessage(playerid, col_grey, !"Use: /bsetmafia [Mafia number (10, 16, 17)]");

	BizzInfo[biz_id][bMafia] = mafia_id;
	SaveBizzPer(biz_id, "bMafia", mafia_id);
    update_business_text(biz_id);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You successfully canceled Rent business "c_server"%s [ #%d ]"c_white" at %s", BizzInfo[biz_id][bMessage], biz_id, GetFractionName(mafia_id));
    return SendClientMessage(playerid, col_white, text_string);
}

cmd:aoph(playerid,params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	extract params -> new set_terc; else return SendClientMessage(playerid, col_grey, !"Use: /setterc [Gang number (8, 9, 11, 12, 13)]");

	for(new i; i < MAX_ZONES;i++)
	{
		if(PlayerToKvadrat(playerid, GZInfo[i][gPos][0], GZInfo[i][gPos][1], GZInfo[i][gPos][2], GZInfo[i][gPos][3]))
		{
			GZInfo[i][gFraction] = set_terc;
			GangZoneStopFlashForAll(GZInfo[i][gID]);
			GangZoneHideForAll(GZInfo[i][gID]);
			GangZoneShowForAll(GZInfo[i][gID],GetGangZoneColor(i));
			SaveGZ(i);

			text_string[0] = EOS;
			format(text_string, sizeof(text_string), ""c_info"You have successfully changed the territory (#%d) to %s.", GZInfo[i][gID], GetFractionName(set_terc));
			return SendClientMessage(playerid, col_white, text_string);
		}
	}
	return 1;
}

