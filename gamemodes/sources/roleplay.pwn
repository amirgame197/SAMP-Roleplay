}


cmd:fmenu(playerid)
{
	if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You Are Not In A Family.");

	new family_id = p_info[playerid][family];
	if(family_info[family_id - 1][fam_house])
	{
    slobal_string[0] = text_string[0] = EOS;
    strcat(slobal_string, ""c_server"[1]"c_white" Family information\n");
    strcat(slobal_string, ""c_server"[2]"c_white" Family members ["c_green"online"c_white"]\n");
    strcat(slobal_string, ""c_server"[3]"c_white" Family members ["c_orange_red"offline"c_white"]\n");
    strcat(slobal_string, ""c_server"[4]"c_white" Family settings\n");
    format(text_string, sizeof(text_string), ""c_server"[5]"c_white" Family house: "c_yellow"?��%d\n", family_info[family_id - 1][fam_house]);
    strcat(slobal_string, text_string);
    strcat(slobal_string, ""c_server"[6]"c_white" Transfer the Family\n");
    strcat(slobal_string, ""c_server"[7]"c_white" Leave Family\n");

    SPD(playerid, 1245, DIALOG_STYLE_LIST, !""c_server"Family menu", slobal_string, !"Next", !"Close");
	}
	else
	{
    slobal_string[0] = EOS;
    strcat(slobal_string, ""c_server"[1]"c_white" Family information\n");
    strcat(slobal_string, ""c_server"[2]"c_white" Family members ["c_green"online"c_white"]\n");
    strcat(slobal_string, ""c_server"[3]"c_white" Family members ["c_orange_red"offline"c_white"]\n");
    strcat(slobal_string, ""c_server"[4]"c_white" Family settings\n");
    strcat(slobal_string, ""c_server"[5]"c_white" Family house: "c_orange_red"Not Set\n");
    strcat(slobal_string, ""c_server"[6]"c_white" Transfer the Family\n");
    strcat(slobal_string, ""c_server"[7]"c_white" Leave Family");

    SPD(playerid, 1245, DIALOG_STYLE_LIST, !""c_server"Family menu", slobal_string, !"Choose", !"Close");
	}
	return 1;
}
cmd:carcolor(playerid, params[])
{

    new family_id = p_info[playerid][family];
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You are not a member of a family.");
    if(!p_info[playerid][family_rang] >= family_info[family_id - 1][fam_settings][3]) return SendClientMessage(playerid, col_white, !""c_error"You are not a family leader!");
    if(!FamilyHaveVehicle(family_id)) return SendClientMessage(playerid, COLOR_GREY, "The family does not exist.");
    extract params -> new fslot, fcolor1, fcolor2; else return SendClientMessage(playerid, col_grey, !"Use: /carcolor [vehID 1-8] [color1] [color2]");
	if(fslot > MAX_FAMILY_VEHICLE || fslot < 1) return SendClientMessage(playerid, col_white, !""c_error"vehID invalid. (1-8)");
	if(!family_info[family_id - 1][fam_veh][fslot-1])
	{
	    text_string[0] = EOS;
		format(text_string, sizeof(text_string), "VehID (%d) not available. Use /fcar -> 4 to view the list",fslot);
		//format(text_string, sizeof(text_string), "VehID (%d) not available.",fslot);
		return SendClientMessage(playerid, col_white, text_string);
	}
	FChangeColorVeh(family_id, fslot, fcolor1, fcolor2);
    return 1;
}
cmd:findfcar(playerid, params[])
{
    new family_id = p_info[playerid][family];
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You are not a member of a family.");
    if(!FamilyHaveVehicle(family_id)) return SendClientMessage(playerid, COLOR_GREY, "The family does not exist.");
    extract params -> new fslot; else return SendClientMessage(playerid, col_grey, !"Use: /findfcar [vehID 1-8]");
    if(fslot > MAX_FAMILY_VEHICLE || fslot < 1) return SendClientMessage(playerid, col_white, !""c_error"vehID invalid. (1-8)");
	if(!family_info[family_id - 1][fam_veh][fslot-1])
	{
	    text_string[0] = EOS;
		format(text_string, sizeof(text_string), "VehID (%d) not available. Use /fcar -> 4 to view the list",fslot);
		//format(text_string, sizeof(text_string), "VehID (%d) not available.",fslot);
		return SendClientMessage(playerid, col_white, text_string);
	}
	new Float: vehX, Float: vehY, Float: vehZ;

	GetVehiclePos(family_info[family_id - 1][fam_veh], vehX, vehY, vehZ);
	SetPlayerGPS(playerid, vehX, vehY, vehZ);
	return 1;
}
cmd:fpark(playerid, params[])
{
    new family_id = p_info[playerid][family]-1;
    if(!PlayerInFVehicle(playerid)) return SendClientMessage(playerid, col_white, !""c_error"You do not have a vehicle in the family.");
	if(!p_info[playerid][family_rang] >= family_info[family_id - 1][fam_settings][3]) return SendClientMessage(playerid, col_white, !""c_error"You are not a family leader!");

	new Float: vehX, Float: vehY, Float: vehZ, Float:vehA, vehF = PlayerFVehicle(playerid);
	GetVehiclePos(GetPlayerVehicleID(playerid), vehX, vehY, vehZ);
	GetVehicleZAngle(GetPlayerVehicleID(playerid), vehA);

	family_info[family_id][fam_vposx][vehF] = vehX;
	family_info[family_id][fam_vposy][vehF] = vehY;
	family_info[family_id][fam_vposz][vehF] = vehZ;
	family_info[family_id][fam_vposa][vehF] = vehA;
	SaveFVeh(family_id);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_orange"Vehicle %s parked at x: %f, y: %f, z: %f", VehicleNames[GetVehicleModel(family_info[family_id][fam_veh][vehF])-400], family_info[family_id][fam_vposx][vehF],family_info[family_id][fam_vposy][vehF],family_info[family_id][fam_vposz][vehF]);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}
cmd:fam(playerid, params[])
{
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You are not a member of a family.");
	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(p_info[playerid][family_mute])
	{
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_error"You have blocked family chat | "c_orange"%s", convert_time(p_info[playerid][family_mute]));
		SendClientMessage(playerid, col_white, text_string);
		return 0;
	}
	extract params -> new string:fam_text[128]; else return SendClientMessage(playerid, col_grey, !"Use: /fam [Text]");

	text_string[0] = EOS;
    format(text_string, sizeof(text_string), "{%s}[Family] %s %s[%d]: "c_silver"%s", family_info[p_info[playerid][family] - 1][fam_chat_color], family_rank[p_info[playerid][family] - 1][p_info[playerid][family_rang] - 1], Name(playerid), playerid, fam_text);
    send_family_message(p_info[playerid][family], col_white, text_string);
    return 1;
}

cmd:finvite(playerid, params[])
{
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You are not a member of the family.");
	if(p_info[playerid][family_rang] < family_info[p_info[playerid][family] - 1][fam_settings][0])
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The team is available from position %s (%d)", family_rank[p_info[playerid][family] - 1][family_info[p_info[playerid][family] - 1][fam_settings][0] - 1], family_info[p_info[playerid][family] - 1][fam_settings][0]);
		SendClientMessage(playerid, col_white, text_string);
		return 1;
	}
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /finvite [Player ID]");
 	if(!IsPlayerConnected (targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
 	if(!ProxDetectorS(5.0, playerid, targetid)) return SendClientMessage(playerid, col_white, !""c_error"The player is too far away.");
	if(p_info[targetid][family] > 0) return SendClientMessage(playerid, col_white, !""c_error"The player is already in the family.");
	if(GetPlayerOfferInfo(targetid, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The player has an active offer.");

	SendPlayerOffer(playerid, targetid, OFFER_TYPE_FINVITE);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You offered "c_server"%s"c_white" to join the family %s", Name(targetid), family_info[p_info[playerid][family] - 1][fam_name]);
	SendClientMessage(playerid, col_white, text_string);

	format(text_string, sizeof(text_string), ""c_info""c_server"%s"c_white" invited you to join the family %s", Name(playerid), family_info[p_info[playerid][family] - 1][fam_name]);
	SendClientMessage(targetid, col_white, text_string);
	SendClientMessage(targetid, col_white, !"Click to agree "c_green"Y (/accept)"c_white" or to cancel "c_orange_red"N (/cancel)");
    return 1;
}

cmd:funinvite(playerid, params[])
{
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You Are Not In A Family.");
	if(p_info[playerid][family_rang] < family_info[p_info[playerid][family] - 1][fam_settings][1])
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The team is available from position %s (%d)", family_rank[p_info[playerid][family] - 1][family_info[p_info[playerid][family] - 1][fam_settings][1] - 1], family_info[p_info[playerid][family] - 1][fam_settings][1]);
		SendClientMessage(playerid, col_white, text_string);
		return 1;
	}
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /funinvite [Player id]");
	if(!IsPlayerConnected (targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][family] != p_info[playerid][family]) return SendClientMessage(playerid, col_white, !""c_error"Player Is Not In Your Family.");

	new family_id = p_info[playerid][family];

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_info"You successfully Kicked "c_server"%s"c_white" from family %s", Name(targetid), family_info[p_info[playerid][family] - 1][fam_name]);
    SendClientMessage(playerid, col_white, text_string);

	format(text_string, sizeof(text_string), "{%s}[Family]"c_silver" %s %s[%d] Kicked You From Family %s[%d]", family_info[family_id - 1][fam_chat_color], family_rank[family_id - 1][p_info[playerid][family_rang] - 1], Name(playerid), playerid, Name(targetid), targetid);
	send_family_message(family_id, col_white, text_string);

    Iter_Remove(family_players[family_id], targetid);
	p_info[targetid][family] = p_info[targetid][family_rang] = 0;

	if(p_info[targetid][family_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(p_info[targetid][family_text]);
		p_info[targetid][family_text] = Text3D:INVALID_3DTEXT_ID;
	}
    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "UPDATE `accounts` SET `u_family`='0',`u_family_rank`='0' WHERE `pID`='%d' LIMIT 1", p_info[targetid][pID]);
	mysql_query(dbHandle, text_string);

	family_info[family_id - 1][fam_members]--;

	format(text_string, sizeof(text_string), "UPDATE `family` SET `fam_members`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[family_id - 1][fam_members], family_id);
	mysql_query(dbHandle, text_string);
    return 1;
}

cmd:frang(playerid, params[])
{
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You Are Not In A Family.");
	if(p_info[playerid][family_rang] < family_info[p_info[playerid][family] - 1][fam_settings][2])
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The team is available from position %s (%d)", family_rank[p_info[playerid][family] - 1][family_info[p_info[playerid][family] - 1][fam_settings][2] - 1], family_info[p_info[playerid][family] - 1][fam_settings][2]);
		SendClientMessage(playerid, col_white, text_string);
		return 1;
	}
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /frang [Player id]");
	if(!IsPlayerConnected (targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][family] != p_info[playerid][family]) return SendClientMessage(playerid, col_white, !""c_error"Player Is Not From This Family.");

	dlobal_string[0] = EOS;
	for(new i; i < family_info[p_info[playerid][family] - 1][fam_settings][3]; i++)
	{
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\n", i + 1, family_rank[p_info[playerid][family] - 1][i]);
		strcat(dlobal_string, text_string);
	}
	SPD(playerid, 1256, DIALOG_STYLE_LIST, !""c_server"from changing before priority", dlobal_string, !"Choose", !"Back");

	SetPVarInt(playerid, "pl_setrank_id", targetid);
	return 1;
}

cmd:fmute(playerid, params[])
{
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You Are Not From A Family.");
	if(p_info[playerid][family_rang] < family_info[p_info[playerid][family] - 1][fam_settings][4])
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The team is available from position %s (%d)", family_rank[p_info[playerid][family] - 1][family_info[p_info[playerid][family] - 1][fam_settings][4] - 1], family_info[p_info[playerid][family] - 1][fam_settings][4]);
		SendClientMessage(playerid, col_white, text_string);
		return 1;
	}
	extract params -> new player:targetid, f_time, string:f_reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /fmute [Player id] [number of minutes] [Cause]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
	if(p_info[targetid][family] != p_info[playerid][family]) return SendClientMessage(playerid, col_white, !""c_error"Player Is Not From This Family.");
	if(p_info[targetid][family_rang] >= p_info[playerid][family_rang]) return SendClientMessage(playerid, col_white, !""c_error"Your Rank Is Low For Mute This player.");
	if(!(5 <= f_time <= 60)) return SendClientMessage(playerid, col_grey, !"mute time is 5 min before 60 min.");

    new family_id = p_info[playerid][family];

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "{%s}[Family]"c_silver" %s %s[%d] ????????????(-?) ???????? ??? %s[%d] ?? %d ????? (Cause: %s)", family_info[family_id - 1][fam_chat_color], family_rank[family_id - 1][p_info[playerid][family_rang] - 1], Name(playerid), playerid, Name(targetid), targetid, f_time, f_reason);
    send_family_message(family_id, col_white, text_string);

	p_info[targetid][family_mute] = f_time * 60;
	return 1;
}

cmd:funmute(playerid, params[])
{
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You Are Not From A Family.");
	if(p_info[playerid][family_rang] < family_info[p_info[playerid][family] - 1][fam_settings][4])
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The team is available from position %s (%d)", family_rank[p_info[playerid][family] - 1][family_info[p_info[playerid][family] - 1][fam_settings][4] - 1], family_info[p_info[playerid][family] - 1][fam_settings][4]);
		SendClientMessage(playerid, col_white, text_string);
		return 1;
	}
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /funmute [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
	if(p_info[targetid][family] != p_info[playerid][family]) return SendClientMessage(playerid, col_white, !""c_error"Player Is Not From This Family.");
	if(p_info[targetid][family_mute] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player Is Not Mute");

	p_info[targetid][family_mute] = 0;
	update_int_sql(targetid, "u_family_mute", p_info[targetid][family_mute]);

	new family_id = p_info[playerid][family];

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "{%s}[Family]"c_silver" %s %s[%d] ?????????????(-?) ???????? ??? %s[%d]", family_info[family_id - 1][fam_chat_color], family_rank[family_id - 1][p_info[playerid][family_rang] - 1], Name(playerid), playerid, Name(targetid), targetid);
    send_family_message(family_id, col_white, text_string);
	return 1;
}

cmd:flock(playerid)
{
    if(p_info[playerid][family] == 0) return SendClientMessage(playerid, col_white, !""c_error"You Are Not From A Family.");
	if(p_info[playerid][family_rang] < family_info[p_info[playerid][family] - 1][fam_settings][5])
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The team is available from position %s (%d)", family_rank[p_info[playerid][family] - 1][family_info[p_info[playerid][family] - 1][fam_settings][5] - 1], family_info[p_info[playerid][family] - 1][fam_settings][5]);
		SendClientMessage(playerid, col_white, text_string);
		return 1;
	}

	text_string[0] = EOS;
	new family_id = p_info[playerid][family];
	if(family_info[p_info[playerid][family] - 1][fam_dorm_status])
	{
		family_info[family_id - 1][fam_dorm_status] = 0;

		format(text_string, sizeof(text_string), "UPDATE `family` SET `fam_dorm_status`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[family_id - 1][fam_dorm_status], family_id);
		mysql_query(dbHandle, text_string);

		SendClientMessage(playerid, col_white, !""c_info"You successfully "c_green"Unlock"c_white" the family dorm.");

		format(text_string, sizeof(text_string), "{%s}[Family]"c_silver" %s %s[%d] Unlock the family dorm", family_info[family_id - 1][fam_chat_color], family_rank[family_id - 1][p_info[playerid][family_rang] - 1], Name(playerid), playerid);
    	send_family_message(family_id, col_white, text_string);
	}
	else
	{
		family_info[family_id - 1][fam_dorm_status] = 1;

		format(text_string, sizeof(text_string), "UPDATE `family` SET `fam_dorm_status`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[family_id - 1][fam_dorm_status], family_id);
		mysql_query(dbHandle, text_string);

		SendClientMessage(playerid, col_white, !""c_info"You successfully "c_orange_red"Lock"c_white" the family dorm.");

		format(text_string, sizeof(text_string), "{%s}[Family]"c_silver" %s %s[%d] Lock the family dorm", family_info[family_id - 1][fam_chat_color], family_rank[family_id - 1][p_info[playerid][family_rang] - 1], Name(playerid), playerid);
    	send_family_message(family_id, col_white, text_string);
	}
	return 1;
}

//test


CMD:style(playerid)
{
    new carid = GetPlayerUseHomeCar(playerid);

    if(carid == -1) return SendClientMessage(playerid, COLOR_GREY, "You do not have any cards.");

	new bool: is_have_perf;

    for(new i; i < 5; i++) if(player_engine_tune[playerid][carid][i]) is_have_perf = true;

	if(is_have_perf == false) return SendClientMessage(playerid, COLOR_GREY, "This vehicle has no perfect tuning.");

	new vehicleid = GetPlayerVehicleID(playerid);

	if(veh_info[vehicleid][vEngineTune] == 0)
	{
	    for(new i; i < 5; i++) if(player_engine_tune[playerid][carid][i]) veh_info[vehicleid][vEngineTune][i] = 1;

	    SendClientMessage(playerid, COLOR_GREEN, "You have enabled the driving style: "c_white"PRO");
	}
	else
	{
	    for(new i; i < 5; i++) veh_info[vehicleid][vEngineTune][i] = 0;

	    SendClientMessage(playerid, COLOR_GREEN, "You have enabled the driving style: "c_white"COMFORT");
	}

    return 1;
}

cmd:history(playerid, params[])
{
	extract params -> new string:name_player[24]; else return SendClientMessage(playerid, col_grey, !"Use: /history [Player Nick]");

    text_string[0] = EOS;
	mysql_format(dbHandle, text_string, sizeof(text_string), "SELECT `pID` FROM `accounts` WHERE `pName`='%e' LIMIT 1", name_player);
    new Cache: result = mysql_query(dbHandle, text_string);

    if(cache_num_rows() == 0) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");

    new user_id;
    cache_get_value_int(0, "pID", user_id);

    cache_delete(result);

    mysql_format(dbHandle, format_string, 144, "SELECT `old_nick`,`new_nick` FROM `history_name` WHERE `user_id`='%d' ORDER BY `user_id` DESC", user_id);
    result = mysql_query(dbHandle, format_string);

    new rows = cache_num_rows();
    if(rows == 0) return SendClientMessage(playerid, col_white, !""c_error"Player has not changed their Nick yet.");

    slobal_string[0] = EOS;
	text_string[0] = EOS;

    new old_nick[MAX_PLAYER_NAME], new_nick[MAX_PLAYER_NAME];
    for(new i; i < rows; i++)
    {
        format(text_string, sizeof(text_string), "[%d] %s\t%s\n", i + 1, old_nick, new_nick);
        strcat(slobal_string, text_string);
    }
    cache_delete(result);
    return SPD(playerid, 0000, DIALOG_STYLE_LIST, name_player, slobal_string, !"Close", !"");
}

CMD:hi(playerid, params[])
{
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, 0x00D900AA, "[Hint]: "c_white"/hi [id]");
	if(IsPlayerInAnyVehicle(playerid)) return  SendClientMessage(playerid, COLOR_GREY, "Cannot use in a vehicle.");
	if(!p_info[params[0]][pLogin]) return SendClientMessage(playerid, COLOR_GREY, "Player not found!");
	if(!ProxDetectorS(2.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "The person is far from you.");
	if(params[0] == playerid)  return  SendClientMessage(playerid,COLOR_GRAD1,"You specified your ID.");

	SendPlayerOffer(playerid, params[0], OFFER_TYPE_HI);

	SCMF(playerid,-1,"You offered %s a handshake.",GN(params[0]));
	SCMF(params[0],-1,"%s offered you a handshake.",GN(playerid));

	return SendClientMessage(params[0], -1, "To agree, press Y(/accept) or for refusal, N(/cancel).");
}

CMD:pts(playerid, params[])
{
    new carid = GetPlayerUseHomeCar(playerid);

    if(carid == -1) return SendClientMessage(playerid, COLOR_GREY, "You are not in a personal vehicle.");

    new to_player;

	if(sscanf(params, "u", to_player))
	{
	    SendClientMessage(playerid, -1, "For demonstration, use: /pts [id].");
		return ShowPlayerCarPass(playerid, playerid, car_id);
	}

    if(!ProxDetectorS(5.0, playerid, to_player)) return SendClientMessage(playerid, COLOR_GREY, "You are far from this player.");

	return ShowPlayerCarPass(playerid, to_player, carid);
}

stock ShowPlayerCarPass(playerid, to_player, carid)
{
    new model = CarInfo[playerid][cModel][carid];

    format(String, 244,
		"Owner: %s\n\
		Name: %s\n\
		State: %d/100",
		Name(playerid),
		VehicleNames[model-400],
		CarInfo[playerid][cSost][car_id]);

    return SPD(to_player, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Vehicle registration.", String, "Close", "");
}

CMD:makestore(playerid)
{
	new h_id = player_enter_home[playerid];

	if(h_id != GetPlayerHouse(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You are not in your house.");

	if(!HouseInfo[h_id][hUpdStore]) return SendClientMessage(playerid, COLOR_GREY, "You do not have the upgrade 'Cabinet'.");

	new Float: x, Float: y, Float: z;

	GetPlayerPos(playerid, x, y, z);

	CreateHouseStore(h_id, x, y, z);

	format(format_string, 144, "UPDATE `house` SET `hUpdStorePos` = '%.1f,%.1f,%.1f' WHERE `hID` = %d",
	    x, y, z, h_id);

	mysql_tquery(dbHandle, format_string);

	return SendClientMessage(playerid, COLOR_GREEN, "You have changed the Cabinet's position.");
}

function player_infoip(playerid, response_code, data[])
{
    if(response_code != 200) return SendClientMessage(playerid, col_white, !""c_error"Error during the execution of the query.");

    new geo_info[4][32];
    SplitString(data, geo_info, ',');

    format_string[0] = EOS;
	format(format_string, sizeof(format_string), ""c_white"IP: "c_orange"%s\n\n"c_white"Country: %s\nCity: %s\nUTC: %s", geo_info[0], geo_info[1], geo_info[2], geo_info[3]);
	return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"IP Information", format_string, !"Close", !"");
}

stock ShowPlayerFakeList(playerid)
{
    new page = player_mysql_page[playerid];

	new ip_address[16];
	format(ip_address, 16, g_player_listitem[playerid]);

    format(format_string, 188, "SELECT `pName`, `pLevel`, `pIpReg`, `pIp`, `pDataReg`, `pOnline` FROM `accounts` WHERE `pIp` LIKE '%s%s%s' ORDER BY `pLevel` DESC LIMIT %d, 10", ("%"), ip_address, ("%"), page * 10);
	new Cache: result = mysql_query(dbHandle, format_string, true);

	new rows = cache_num_rows();
	if(rows == 0) return SendClientMessage(playerid, COLOR_GREY, "IP logs not found.");

	command_text = "";

	new str[188], player_name[MAX_PLAYER_NAME], l_ip[16], r_ip[16], l_date[16], r_date[16], level;

	for(new i; i < rows; i++)
	{
	    cache_get_value_name_int(i, "pLevel", level);
        cache_get_value_name(i, "pName", player_name);

        cache_get_value_name(i, "pIp", l_ip);
        cache_get_value_name(i, "pIpReg", r_ip);

        cache_get_value_name(i, "pOnline", l_date);
        cache_get_value_name(i, "pDataReg", r_date);

		format(str, 188, "[%d] %s (L:%d)\t%s(%s)\t%s(%s)\n", i, player_name, level, l_ip, r_ip, l_date, r_date);
		strcat(command_text, str);
	}

	cache_delete(result);

	if(rows == 10) strcat(command_text, "[10] Next page\t\n");
	if(page != 0) strcat(command_text, "[11] Previous page\t\n");

	format(format_string, 46, "IP: %s", ip_address);
	return SPD(playerid, 4319, DIALOG_STYLE_TABLIST, format_string, command_text, "Choose", "Close");
}

stock ShowPlayerAdminLog(playerid)
{
    new page = player_mysql_page[playerid];

    format(format_string, 144, "SELECT `action`, `date` FROM `admin_log` WHERE `user_id` = %d ORDER BY `date` DESC LIMIT %d, 10", player_mysql_params[playerid], page * 10);
	new Cache: result = mysql_query(dbHandle, format_string);

	new rows = cache_num_rows();

	if(rows == 0) return SendClientMessage(playerid, COLOR_GREY, "Administrator logs not found.");

	command_text = "";

	new str[188], action[144], data[24];

	for(new i; i < rows; i++)
	{
        cache_get_value_name(i, "action", action);
        cache_get_value_name(i, "date", data);

		format(str, 188, "[%d] %s\t%s\n", i, action, data);
		strcat(command_text, str);
	}

	SetPlayerUseListitem(playerid, rows);

	cache_delete(result);

	if(rows == 10) strcat(command_text, "[10] Next page\t\n");
	if(page != 0) strcat(command_text, "[11] Previous page\t\n");

	return SPD(playerid, 4316, DIALOG_STYLE_TABLIST, !""c_server"List of promos", command_text, "Choose", "Close");
}

CMD:lodgerleave(playerid)
{
	new h_id = GetPlayerHouseLodger(playerid);

	if(h_id == -1) return SendClientMessage(playerid, COLOR_GREY, "You are not registered anywhere.");

	for(new i; i < MAX_HOUSE_LODGERS; i++)
	{
	    if(strfind(house_lodgers[h_id][i], GN(playerid), true) == -1) continue;

		format(house_lodgers[h_id][i], 6, "-");

		SaveHouseLodgers(h_id);

		break;
	}

	return SendClientMessage(playerid, COLOR_YELLOW, "You spawned in your house");
}

cmd:dice(playerid, params[])
{
    if(p_info[playerid][pLevel] < 2) return SendClientMessage(playerid, col_white, !""c_error"The dice game is available from level 2.");
	if(!PlayerToPoint(50.0, playerid, 1381.2874, -28.3831, 1000.9262)) return SendClientMessage(playerid, col_white, !""c_error"You are in the casino");
	extract params -> new player:targetid, money; else return SendClientMessage(playerid, col_grey, !"Use: /dice [Player id] [amount]");
	if(!IsPlayerConnected(targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
	if(!ProxDetectorS(5.0, playerid, targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player is too far away.");
    if(p_info[targetid][pLevel] < 2) return SendClientMessage(playerid, col_white, !""c_error"The player's level is less than 2.");
	if(!(1000 <= money <= 100000)) return SendClientMessage(playerid, col_white, !""c_error"Use an amount in the range of $1,000 before $100,000.");
	if(p_info[playerid][pCash] < money) return SendClientMessage(playerid, col_white, !""c_error"You do not have enough funds.");
	if(p_info[targetid][pCash] < money) return SendClientMessage(playerid, col_white, !""c_error"The player does not have enough funds.");
	if(GetPlayerOfferInfo(targetid, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The player has an active offer.");

	SendPlayerOffer(playerid, targetid, OFFER_TYPE_DICE, money);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You offered "c_server"%s"c_white" to play dice with you. Bet: "c_green"%d$", Name(targetid), money);
	SendClientMessage(playerid, col_white, text_string);

	format(text_string, sizeof(text_string), ""c_info""c_server"%s"c_white" has offered you to play dice. Bet: "c_green"%d$", Name(playerid), money);
	SendClientMessage(targetid, col_white, text_string);
	SendClientMessage(targetid, col_white, !"To agree, press "c_green"Y (/accept)"c_white" or for refusal "c_orange_red"N (/cancel)");
	return 1;
}

CMD:demote(playerid, params[])
{
	if(p_info[playerid][pMember] != FRACTION_FBI && p_info[playerid][pMember] != FRACTION_MAYOR) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1) return SendClientMessage(playerid,COLOR_GREY,"You are not the Leader/deputy of the organization!");

	new to_player, reason[64];

    if(sscanf(params,"us[64]", to_player, reason)) return SendClientMessage(playerid, COLOR_GREY, "/demote [id] [Cause]");

    if(p_info[playerid][pMember] == FRACTION_FBI && !IsACop(to_player) && !IsAArmy(to_player)) return SendClientMessage(playerid, COLOR_GREY, "Available only in the Army and PD.");

    if(p_info[playerid][pMember] == FRACTION_MAYOR && !IsACop(to_player) && !IsAArmy(to_player) && p_info[to_player][pMember] != FRACTION_FBI) return SendClientMessage(playerid, COLOR_GREY, "Available only in the Army, PD, and FBI");

    if(p_info[to_player][pRank] >= FracInfo[p_info[to_player][pMember]][fRankMax]-2) return SendClientMessage(playerid,COLOR_GREY,"This player has too high a rank.");

    p_info[to_player][pRank] --;

	if(p_info[to_player][pRank] > 0)
	{
	    SCMF(playerid, -1, "You lowered rank %s before %d. Cause: %s", Name(to_player), p_info[to_player][pRank], reason);
	    SCMF(to_player, -1, "%s informed you about rank %d. Cause: %s", GN(playerid), p_info[to_player][pRank], reason);
    }
    else
    {
        p_info[to_player][pLeader] = 0;
	    p_info[to_player][setspawn] = 1;
	    p_info[to_player][pMember] = 0;
	    p_info[to_player][pRank] = 0;
	    p_info[to_player][pfWarn] = 0;
		form_fraction[to_player] = 0;

		SavePlayerFraction(to_player);

		SetPlayerSkinEx(to_player, p_info[to_player][pSkin]);
		SetPlayerToTeamColor(to_player);

		SCMF(playerid, -1, "You were fired from the organization %s. Cause: %s", Name(to_player), reason);
	    SCMF(to_player, -1, "%s fired you from the organization. Cause: %s", GN(playerid), reason);
    }

    return SavePlayerFraction(to_player);
}

CMD:coin(playerid, params[])
{
	if(p_info[playerid][pCash] < 1) return SendClientMessage(playerid, COLOR_GREY, "You have no coins.");

	new rand = random(2);

	format(String, 128, "%s flipped a coin and you got %s",Name(playerid), rand ? ("{33AA33}eagle") : ("{FF0000}tails"));
	ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPlayerChatBubble(playerid, String, 0xDD90FFFF, 20.0, 10000);
	return 1;
}

CMD:selldrugs(playerid, params[])
{
	if(!IsAGang(playerid) && !IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this.");

	new to_player, amount, price;

    if(sscanf(params, "uii", to_player, amount, price)) return SendClientMessage(playerid,0x00D900AA, "[Hint]: "c_white"/selldrugs [id] [amount] [price]");

	if(!(1 <= amount <= 500)) return SendClientMessage(playerid, COLOR_GREY, "The available amount of ammo is between 1 and 500.");

	if(!(1 <= price <= 50000)) return SendClientMessage(playerid, COLOR_GREY, "The starting price is between $1 and $50,000.");

	if(p_info[playerid][pDrugs] < amount) return SendClientMessage(playerid, COLOR_GREY, "You do not have that many bullets.");

  	if(!ProxDetectorS(5.0, playerid, to_player)) return SendClientMessage(playerid, COLOR_GREY, "You are far from this player.");

	if(GetPlayerOfferInfo(to_player, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "The player already has an incoming trade request!");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_SELLDRUGS, price, amount);

	SCMF(playerid, 0x6BB3FFAA, "You offered %s to buy %d grams of drugs from you for $%d.", Name(to_player), amount, price);
	SCMF(to_player, 0x6BB3FFAA, "%s offered you to buy %d grams of drugs for $%d.", Name(playerid), amount, price);

    return SendClientMessage(to_player, -1, "To agree, press Y(/accept) or for refusal, N(/cancel).");
}

cmd:sellgun(playerid, params[])
{
	if(!IsAGang(playerid) && !IsAMafia(playerid)) return SendClientMessage(playerid, col_white, !""c_error"This command is not available to you.");
	if(p_info[playerid][pMestoPrison] > 0) return SendClientMessage(playerid, col_white, !""c_error"You cannot use this command while in custody.");
	extract params -> new player:targetid, pl_ammo, pl_price; else return SendClientMessage(playerid, col_grey, !"Use: /sellgun [Player id] [number of bullets] [price]");
    if(p_info[targetid][pMestoPrison] > 0) return SendClientMessage(playerid, col_white, !""c_error"You cannot sell weapons to a prisoner.");

	new weapon_id = GetPlayerWeapon(playerid);
	if(weapon_id == 0) return SendClientMessage(playerid, col_white, !""c_error"You are not holding any weapon.");
	if(!(1 <= pl_ammo <= 10000)) return SendClientMessage(playerid, col_white, !""c_error"Use a bullet quantity in the range from 1 to 10,000.");
	if(!(1 <= pl_price <= 50000)) return SendClientMessage(playerid, col_white, !""c_error"Use a price in the range from $1 to $50,000.");
	if(GetPlayerAmmo(playerid) < pl_ammo) return SendClientMessage(playerid, col_white, !""c_error"You do not have that many bullets.");
  	if(!ProxDetectorS(5.0, playerid, targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player is too far away.");
	if(GetPlayerOfferInfo(targetid, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The player has an active offer.");

	SendPlayerOffer(playerid, targetid, OFFER_TYPE_SELLGUN, pl_price, weapon_id, pl_ammo);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You offered "c_server"%s"c_white" buy a weapon %s (%d pts.) from you for "c_green"%d$", Name(targetid), GetWeaponName(weapon_id), pl_ammo, pl_price);
	SendClientMessage(playerid, col_white, text_string);

	format(text_string, sizeof(text_string), ""c_info""c_server"%s"c_white" offered you to buy weapon %s (%d pts.) for "c_green"%d$", Name(playerid), GetWeaponName(weapon_id), pl_ammo, pl_price);
	SendClientMessage(targetid, col_white, text_string);
    SendClientMessage(targetid, col_white, !"To agree, press "c_green"Y (/accept)"c_white" or for refusal "c_orange_red"N (/cancel)");
    return 1;
}

CMD:gomp(playerid)
{
	if(mp_status == 0) return SendClientMessage(playerid, COLOR_GREY, "Currently, the gathering in MP is stopped.");

    if(p_info[playerid][pPrison] > 0) return SendClientMessage(playerid, col_white, !""c_error"You are in jail.");

	if(PlayerCuffed[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are in handcuffs.");

	if(player_tie[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are tied up.");

	SetPPos(playerid, mp_X, mp_Y, mp_Z, 0.0, mp_int, mp_world, true);


	return SendClientMessage(playerid, COLOR_YELLOW, "You have been teleported to the MP.");
}
CMD:tahakhar(playerid)
{
SetPPos(playerid, 201.0441, -1787.3477, 2.8988);
}
CMD:usedrugs(playerid, params[])
{
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid,0x00D900AA, "[Hint]: "c_white"/usedrugs [grams(1-6)]");
    if(params[0] < 1 || params[0] > 6) return SendClientMessage(playerid,0x00D900AA, "It is possible to consume 1 - 6 grams.");
    if(p_info[playerid][pDrugs] < params[0]) return SendClientMessage(playerid,COLOR_GREY,"You do not have that amount of drugs!");

    if(GetPVarInt(playerid,"Drug_Time")) return SCMF(playerid,COLOR_GREY,"You will be able to use it in %d seconds.", GetPVarInt(playerid,"Drug_Time"));

	new Float: health;

	GetPlayerHealth(playerid, health);

	health += params[0] * 10;

    if(health > 160.0) health = 160.0;

	SetPlayerHealth(playerid, health);

    p_info[playerid][pDrugs] -= params[0];
	p_info[playerid][pDrugDep] += params[0];

    SetPlayerChatBubble(playerid,"You have consumed the drug.",COLOR_PURPLE,30.0,10000);
    SetPlayerWeather(playerid, -68);

    SetPVarInt(playerid,"Drug_Time", 120);

    format(format_string, 144, "UPDATE `accounts` SET `pDrugs` = %d, `pDrugDep` = %d WHERE `pID` = %d", p_info[playerid][pDrugs], p_info[playerid][pDrugDep], GetPlayerAccountID(playerid));
    mysql_tquery(dbHandle, format_string);

    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
    return SCMF(playerid,0x0099FFAA,"You have consumed drugs! ( %.0f/160 )", health);
}

CMD:graffiti(playerid)
{
	if(!IsAGang(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Available only to gangs.");

	String = "";
	new str[48], count;

	for(new i; i < MAX_GRAFFITI; i++)
	{
	    if(graffiti_fraction[i] == p_info[playerid][pMember]) continue;

		new Float: dist = GetPlayerDistanceFromPoint(playerid, graffiti_obj_pos[i][0], graffiti_obj_pos[i][1], graffiti_obj_pos[i][2]);

	    format(str, 48, "%d\t%s\t%.1f\n", i, GetFractionName(graffiti_fraction[i]), dist);
	    strcat(String, str);

	    SetPlayerListitemValue(playerid, count++, i);
	}

	if(!count) return SendClientMessage(playerid, COLOR_GREY, "Your gang has painted over all the graffiti.");

	return SPD(playerid, 7647, DIALOG_STYLE_LIST, !""c_server"List of available graffiti", String, "Choose", "Close");
}

CMD:alldonate(playerid)
{
    new amount_all;
    new amount_day;

	//

	new Cache: result = mysql_query(dbHandle, "SELECT sum(amount) as `count` FROM `donate_log` WHERE 1");

	if(!cache_num_rows()) return SendClientMessage(playerid, COLOR_GREY, "Donations are completely empty.");

	cache_get_value_int(0, "count", amount_all);

    cache_delete(result);

    SCMF(playerid, -1, "All time: %d rub.", amount_all);

	//

	result = mysql_query(dbHandle, "SELECT sum(amount) as `count` FROM `donate_log` WHERE UNIX_TIMESTAMP(`date`) > (UNIX_TIMESTAMP(NOW()) - 86400)");

	if(!cache_num_rows()) return SendClientMessage(playerid, COLOR_GREY, "Donations in the last 24 hours.");

	cache_get_value_int(0, "count", amount_day);

	cache_delete(result);

	//

	return SCMF(playerid, -1, "Last 24 hours: %d rub.", amount_day);
}

CMD:barrage(playerid)
{
	if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "Available only on the street.");

	String = "";

	new str[64], count = 0;

	for(new i; i < MAX_BARRAGE_OBJ; i++)
	{
	    if(player_barrage[playerid][i] == 0) continue;

	    new b_id = player_barrage_id[playerid][i];

		format(str, 64, "[%d] %s\n", i + 1, barrage_names[b_id]);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, i);
	}

	strcat(String, "- Create a barricade");

	return SPD(playerid, 8180, DIALOG_STYLE_LIST, !""c_server"Barricade menu", String, "Choose", "Close");
}

CMD:tie(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "You need to be in the driver's seat.");

	new to_player;

    if(sscanf(params, "u", to_player)) return SendClientMessage(playerid, -1,"Enter: /tie [Player id]");

    if(GetPlayerVehicleID(playerid) != GetPlayerVehicleID(to_player)) return SendClientMessage(playerid, COLOR_GREY,"You are not in the same transport with this player.");

    if(!player_tie[to_player])
    {
        SCMF(playerid, -1, "You tied up %s", Name(to_player));
        SCMF(to_player, -1, "%s tied you up", Name(playerid));

        format(format_string, 188, "%s tied up %s",Name(playerid), Name(to_player));
    }
    else
    {
        SCMF(playerid, -1, "You untied %s", Name(to_player));
        SCMF(to_player, -1, "%s untied you", Name(playerid));

        format(format_string, 188, "%s untied %s",Name(playerid), Name(to_player));
    }

	TogglePlayerControllable(to_player, player_tie[to_player]);

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_tie[to_player] ? ("tied up") : ("untied"),0xDD90FFFF,20.0,10000);

    player_tie[to_player] = !player_tie[to_player];

	return 1;
}

CMD:gag(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	new to_player;

    if(sscanf(params, "u", to_player)) return SendClientMessage(playerid, -1,"Enter: /gag [Player id]");

    if(!ProxDetectorS(5.0, playerid, to_player)) return SendClientMessage(playerid, COLOR_GREY,"The person is far from you!");

    if(!player_gag[to_player])
    {
		if(!player_tie[to_player]) return SendClientMessage(playerid, COLOR_GREY, "Player is not tied.");

        SCMF(playerid, -1, "You inserted a gag on %s", Name(to_player));
        SCMF(to_player, -1, "%s gagged you", Name(playerid));

        format(format_string, 188, "%s gagged %s",Name(playerid), Name(to_player));
    }
    else
    {
        SCMF(playerid, -1, "You removed the gag from %s", Name(to_player));
        SCMF(to_player, -1, "%s removed the gag from you", Name(playerid));

        format(format_string, 188, "%s removed the gag from %s",Name(playerid), Name(to_player));
    }

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_gag[to_player] ? ("inserted the gag") : ("removed the gag"),0xDD90FFFF,20.0,10000);

    player_gag[to_player] = !player_gag[to_player];

	return 1;
}

CMD:bag(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	new to_player;

    if(sscanf(params, "u", to_player)) return SendClientMessage(playerid, -1,"Enter: /bag [Player id]");

    if(!ProxDetectorS(5.0, playerid, to_player)) return SendClientMessage(playerid, COLOR_GREY,"The person is far from you!");

    if(!player_bag[to_player])
    {
        if(!player_tie[to_player]) return SendClientMessage(playerid, COLOR_GREY, "Player is not tied.");

        SCMF(playerid, -1, "You put a bag over %s's head", Name(to_player));
        SCMF(to_player, -1, "%s put a bag over your head", Name(playerid));

        format(format_string, 188, "%s put a bag over %s's head",Name(playerid), Name(to_player));

        TextDrawBoxColor(black_display[to_player], 0x000000ff);
		TextDrawShowForPlayer(to_player, black_display[to_player]);
    }
    else
    {
        SCMF(playerid, -1, "You removed the bag from your head %s", Name(to_player));
        SCMF(to_player, -1, "%s removed the bag from you", Name(playerid));

        format(format_string, 188, "%s removed the bag from your head %s",Name(playerid), Name(to_player));

        TextDrawHideForPlayer(to_player, black_display[to_player]);
    }

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_bag[to_player] ? ("put on a bag") : ("removed the bag"),0xDD90FFFF,20.0,10000);

    player_bag[to_player] = !player_bag[to_player];

	return 1;
}

CMD:blist(playerid)
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	new m_id = p_info[playerid][pMember];

	String = "";

	new str[64], count = 0;

	for(new i; i < MAX_BIZZ; i++)
	{
		if(BizzInfo[i][bMafia] != m_id) continue;

		format(str, 64, "[%d] %s\n", i, BizzInfo[i][bMessage]);
		strcat(String, str);

		count++;
	}

	if(count == 0) return SendClientMessage(playerid, COLOR_GREY, "There are no businesses under your mafia's control.");

	return SPD(playerid, 0000, DIALOG_STYLE_LIST, !""c_server"List of businesses", String, "Close", "");
}

cmd:repaircar(playerid)
{
	if(p_info[playerid][pRepairKit] == 0) return SendClientMessage(playerid, col_white, !""c_error"You have no repair kits.");

	new vehicleid = GetNearestVehicle(playerid);
	if(!vehicleid) return SendClientMessage(playerid, col_white, !""c_error"You don't have transport with Row House.");

	new Float: health;
	GetVehicleHealth(vehicleid, health);
	if(health == 1000.0) return SendClientMessage(playerid, col_white, !""c_error"The transport is fully intact.");

    p_info[playerid][pRepairKit]--;
    update_int_sql(playerid, "pRepairKit", p_info[playerid][pRepairKit]);

	RepairVehicle(vehicleid);
	SendClientMessage(playerid, col_white, !""c_sucess"You successfully repaired the transport.");
	return 1;
}

CMD:referals(playerid)
{
	mysql_format(dbHandle, format_string, 144, "SELECT `pName`, `pLevel` FROM `accounts` WHERE `pReferal` = %d", GetPlayerAccountID(playerid));
	new Cache: result = mysql_query(dbHandle, format_string);

	new rows = cache_num_rows();

	if(!rows) return SendClientMessage(playerid, COLOR_GREY, "No one has listed you as a referral.");

	String = "";

	new str[64], name[MAX_PLAYER_NAME], level;

	for(new i; i < rows; i++)
	{
	    cache_get_value(i, "pName", name);
	    cache_get_value_int(i, "pLevel", level);

	    format(str, 64, "[%d] %s\t%d\n", i + 1, name, level);
	    strcat(String, str);
	}

	cache_delete(result);

	return SPD(playerid, 0000, DIALOG_STYLE_TABLIST, !""c_server"List of invited players", String, "Close", "");
}

