cmd:hegoto(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /hegoto [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(GetPlayerState(targetid) != 1 && GetPlayerState(targetid) != 2 && GetPlayerState(targetid) != 3) return SendClientMessage(playerid, col_white, !""c_error"Player cannot enter the city.");
	if(GetPlayerState(targetid) == PLAYER_STATE_SPECTATING && gSpectateID[targetid] != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"Player is muted for a reason.");

    new Float:plocx, Float:plocy, Float:plocz;
	GetPlayerPos(targetid, plocx, plocy, plocz);
	if(GetPlayerState(playerid) == 2)
	{
		new tmpcar = GetPlayerVehicleID(playerid);
		SetVehiclePos(tmpcar, plocx, plocy + 4, plocz + 1);
	}
	else SetPlayerPos(playerid, plocx, plocy + 2, plocz);

	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(targetid));
	SetPlayerInterior(playerid, GetPlayerInterior(targetid));

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[H] %s[%d] Used /hegoto On Player %s[%d]", Name(playerid), playerid, Name(targetid), targetid);
	send_support_message(col_grey, text_string);

	text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_server"Helper "c_red"%s "c_server"Teleported To You"c_white".", Name(playerid));
    SendClientMessage(targetid, col_white, text_string);
	return 1;
}

cmd:hgethere(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /hgethere [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(GetPlayerState(targetid) != 1 && GetPlayerState(targetid) != 2 && GetPlayerState(targetid) != 3) return SendClientMessage(playerid, col_white, !""c_error" This Player didn't entered the game.");
	if(afk_time[targetid] > 5) return SendClientMessage(playerid, col_white, !""c_error"The Player ?? AFK.");
	if(p_info[targetid][pPrison] > 0) return SendClientMessage(playerid, col_white, !""c_error"This Player is in prison.");

	new Float:plocx, Float:plocy, Float:plocz, inter = GetPlayerInterior(playerid), world = GetPlayerVirtualWorld(playerid);
	GetPlayerPos(playerid, plocx, plocy, plocz);

	if(GetPlayerState(targetid) == 2)
	{
		new tmpcar = GetPlayerVehicleID(targetid);
		SetVehiclePos(tmpcar, plocx, plocy + 4, plocz + 1);
	}
	else SetPlayerPos(targetid, plocx, plocy + 2, plocz);

    SetPlayerInterior(targetid, inter);
	SetPlayerVirtualWorld(targetid, world);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You Have Teleported By Helper "c_server"%s"c_white".", Name(playerid));
	SendClientMessage(targetid, col_white, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[H] %s[%d] teleported to him yourself %s[%d]", Name(playerid), playerid, Name(targetid), targetid);
	send_support_message(col_grey, text_string);
	return 1;
}

cmd:hveh(playerid, params[])
{
   	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	extract params -> new vehicle_id, color_1, color_2; else return SendClientMessage(playerid, col_grey, !"Use: /hveh [car id] [rank 1] [rank 2]");
	if(vehicle_id < 400 || vehicle_id > 611) return SendClientMessage(playerid, col_white, !""c_error"ID range must be between 400 and 611.");
	if(color_1 < 0 || color_1 > 255) return SendClientMessage(playerid, col_white, !""c_error"The ID range for vehicles should be between 0 and 255.");
	if(color_2 < 0 || color_2 > 255) return SendClientMessage(playerid, col_white, !""c_error"The connection to the system can make it more stable in range 0 to 255.");
	if(GetPlayerState(playerid) != 1) return SendClientMessage(playerid, col_white, !""c_error"You can join the gang.");

	new Float:pl_posX, Float:pl_posY, Float:pl_posZ;
	GetPlayerPos(playerid, pl_posX, pl_posY, pl_posZ);

	new adm_id = AddStaticVehicle(vehicle_id, pl_posX, pl_posY, pl_posZ, 0.0, color_1, color_2);
	veh_info[adm_id][vSost] = 100;
	veh_info[adm_id][vStatus] = 2;
	Fuell[adm_id] = MAX_VEHICLE_FUEL;

	PutPlayerInVehicle(playerid, adm_id, 0);

	new lights, alarm, bonnet, boot, objective;
	SetVehicleParamsEx(adm_id, true, lights, alarm, false, bonnet, boot, objective);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[H] %s[%d] Created Vehicle %s (%d) | ID: %d", Name(playerid), playerid, VehicleNames[vehicle_id - 400], vehicle_id, adm_id);
	send_support_message(col_grey, text_string);

	VehicleCreate[adm_id] = true;
	return 1;
}

cmd:hdelveh(playerid,params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, col_white, !""c_error"You cannot join the gang.");

	new vehicleid = GetPlayerVehicleID(playerid);
    if(VehicleCreate[vehicleid] != true) return SendClientMessage(playerid, col_white, !""c_error"You must join the gang in the designated area.");
    DestroyVehicle(vehicleid);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[H] %s[%d] Deleted Vehicle | ID: %d", Name(playerid), playerid, vehicleid);
	send_support_message(col_grey, text_string);
	return 1;
}
cmd:hspawn(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /hspawn [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(afk_time[targetid] > 2) return SendClientMessage(playerid, col_white, !""c_error"The Player is AFK.");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[H] %s[%d] Spawned(-a) Player %s[%d]", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"Helper "c_server"%s"c_white" Spawned(-a) You.", Name(playerid));
	SendClientMessage(targetid, col_white, text_string);

	SpawnPlayer(targetid);
    return 1;
}
