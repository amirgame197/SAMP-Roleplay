CMD:Hacking(playerid, params[])
{
      if(!IsAGang(playerid) && !IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_RED, "[Rob System] You are not a member of a Gang or Mafia!");
      if(GetPlayerWantedLevel(playerid) == 6) return SendClientMessage(playerid, COLOR_RED, "[Rob System] You Can Not Use Rob When You Have 6 Wanteds!");
      if(GetPlayerWantedLevel(playerid) == 5) return SendClientMessage(playerid, COLOR_RED, "[Rob System] You Can Not Use Rob When You Have 5 Wanteds!");
      if(GetPlayerWantedLevel(playerid) == 4) return SendClientMessage(playerid, COLOR_RED, "[Rob System] You Can Not Use Rob When You Have 4 Wanteds!");
      if(GetPlayerWantedLevel(playerid) == 3) return SendClientMessage(playerid, COLOR_RED, "[Rob System] You Can Not Use Rob When You Have 3 Wanteds!");
      if(GetPlayerWantedLevel(playerid) == 2) return SendClientMessage(playerid, COLOR_RED, "[Rob System] You Can Not Use Rob When You Have 2 Wanteds!");
      if(GetPlayerWantedLevel(playerid) == 1) return SendClientMessage(playerid, COLOR_RED, "[Rob System] You Can Not Use Rob When You Have 1 Wanteds!");
      if(IsPlayerInRangeOfPoint(playerid, 1.0, 147.97, -1962.98, 3.77))
		{
		SCM(playerid, COLOR_ABOL, "[Rob System] Rob has started, you will take the money in 30 seconds!");
		SCM(playerid, COLOR_ABOL, "[Rob System] Please do not move from your location");
		SCM(playerid, COLOR_ABOL, "[Rob System] Be aware of the police.");
  		format(format_string, 188, "[Central Radio] Systems are currently being hacked by %s[%d].", Name(playerid), playerid);
	    SendFrac(1, 0x42B66FFF, format_string);
   		format(format_string, 188, "[Central Radio] Systems are currently being hacked by %s[%d].", Name(playerid), playerid);
	    SendFrac(2, 0x42B66FFF, format_string);
		p_info[playerid][pWanted] = 2;
		SetPlayerWantedLevel(playerid, 3);
        ApplyAnimation(playerid, "INT_OFFICE", "OFF_SIT_TYPE_LOOP", 4.0999, 1, 0, 0, 0, 0);
        SetTimerEx("Hacking", 30000, false, "ii", playerid, 30000);
	    }
	    else
	    {
	    SendClientMessage(playerid, COLOR_RED, "[Rob System] You are not in the robbery area!");
	    }

        return 1;
}

