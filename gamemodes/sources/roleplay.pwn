	}
	printf("[MySQL R41-3]: ROWS LOADED: %d PC.", rows);
	return 1;
}

function load_family()
{
    new time = GetTickCount();
    cache_get_row_count(family_count);

    if(family_count)
    {
        for(new f = 0; f < family_count; f++)
        {
            cache_get_value_name_int(f, "fam_id", family_info[f][fam_id]);
			cache_get_value_name(f, "fam_name", family_info[f][fam_name], 68);
			cache_get_value_name(f, "fam_creator", family_info[f][fam_creator], MAX_PLAYER_NAME);

            cache_get_value_name_int(f, "fam_nationality", family_info[f][fam_nationality]);
			cache_get_value_name(f, "fam_chat_color", family_info[f][fam_chat_color], 8);

			slobal_string[0] = EOS;
			cache_get_value_name(f, "fam_settings", slobal_string, 64), sscanf(slobal_string, "p<|>ddddddd", family_info[f][fam_settings][0], family_info[f][fam_settings][1], family_info[f][fam_settings][2], family_info[f][fam_settings][3], family_info[f][fam_settings][4], family_info[f][fam_settings][5], family_info[f][fam_settings][6]);
			cache_get_value_name(f, "fam_ranks", slobal_string, 372), sscanf(slobal_string, "p<|>s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]s[30]", family_rank[f][0], family_rank[f][1], family_rank[f][2], family_rank[f][3], family_rank[f][4], family_rank[f][5], family_rank[f][6], family_rank[f][7], family_rank[f][8], family_rank[f][9], family_rank[f][10], family_rank[f][11]);

            cache_get_value_name(f, "fam_veh", slobal_string, 64), sscanf(slobal_string, "p<|>dddddddd", family_info[f][fam_veh][0], family_info[f][fam_veh][1], family_info[f][fam_veh][2], family_info[f][fam_veh][3], family_info[f][fam_veh][4], family_info[f][fam_veh][5], family_info[f][fam_veh][6],family_info[f][fam_veh][7]);
            cache_get_value_name(f, "fam_vposx", slobal_string, 280), sscanf(slobal_string, "p<|>ffffffff", family_info[f][fam_vposx][0], family_info[f][fam_vposx][1], family_info[f][fam_vposx][2], family_info[f][fam_vposx][3], family_info[f][fam_vposx][4], family_info[f][fam_vposx][5], family_info[f][fam_vposx][6],family_info[f][fam_vposx][7]);
            cache_get_value_name(f, "fam_vposy", slobal_string, 280), sscanf(slobal_string, "p<|>ffffffff", family_info[f][fam_vposy][0], family_info[f][fam_vposy][1], family_info[f][fam_vposy][2], family_info[f][fam_vposy][3], family_info[f][fam_vposy][4], family_info[f][fam_vposy][5], family_info[f][fam_vposy][6],family_info[f][fam_vposy][7]);
            cache_get_value_name(f, "fam_vposz", slobal_string, 280), sscanf(slobal_string, "p<|>ffffffff", family_info[f][fam_vposz][0], family_info[f][fam_vposz][1], family_info[f][fam_vposz][2], family_info[f][fam_vposz][3], family_info[f][fam_vposz][4], family_info[f][fam_vposz][5], family_info[f][fam_vposz][6],family_info[f][fam_vposz][7]);
            cache_get_value_name(f, "fam_vposa", slobal_string, 280), sscanf(slobal_string, "p<|>ffffffff", family_info[f][fam_vposa][0], family_info[f][fam_vposa][1], family_info[f][fam_vposa][2], family_info[f][fam_vposa][3], family_info[f][fam_vposa][4], family_info[f][fam_vposa][5], family_info[f][fam_vposa][6],family_info[f][fam_vposa][7]);

            cache_get_value_name(f, "fam_color1", slobal_string, 64), sscanf(slobal_string, "p<|>dddddddd", family_info[f][fam_color1][0], family_info[f][fam_color1][1], family_info[f][fam_color1][2], family_info[f][fam_color1][3], family_info[f][fam_color1][4], family_info[f][fam_color1][5], family_info[f][fam_color1][6],family_info[f][fam_color1][7]);
            cache_get_value_name(f, "fam_color2", slobal_string, 64), sscanf(slobal_string, "p<|>dddddddd", family_info[f][fam_color2][0], family_info[f][fam_color2][1], family_info[f][fam_color2][2], family_info[f][fam_color2][3], family_info[f][fam_color2][4], family_info[f][fam_color2][5], family_info[f][fam_color2][6],family_info[f][fam_color2][7]);

			cache_get_value_name_int(f, "fam_bank", family_info[f][fam_bank]);
			cache_get_value_name_int(f, "fam_house", family_info[f][fam_house]);

			cache_get_value_name_int(f, "fam_materials", family_info[f][fam_materials]);
			cache_get_value_name_int(f, "fam_drugs", family_info[f][fam_drugs]);
			cache_get_value_name_int(f, "fam_guns", family_info[f][fam_guns]);
			cache_get_value_name_int(f, "fam_dorm_status", family_info[f][fam_dorm_status]);

			cache_get_value_name(f, "fam_dorm", slobal_string), sscanf(slobal_string, "p<|>fffdd", dorm_family_pos[f][0], dorm_family_pos[f][1], dorm_family_pos[f][2], dorm_family_int[f], dorm_family_virt[f]);

			if(dorm_family_pos[f][0] + dorm_family_pos[f][1] + dorm_family_pos[f][2] != 0.0)
			{
			    dorm_family_cp[f] = CreateDynamicCP(dorm_family_pos[f][0], dorm_family_pos[f][1], dorm_family_pos[f][2], 1.0, dorm_family_virt[f], dorm_family_int[f], -1);
			    dorm_family_area[f] = CreateDynamicSphere(dorm_family_pos[f][0], dorm_family_pos[f][1], dorm_family_pos[f][2] + 1, 2.0, dorm_family_virt[f], dorm_family_int[f], -1);

				format_string[0] = EOS;
				format(format_string, sizeof(format_string), "\
				"c_white"Warehouse {%s}%s\n\n\
				"c_white"Money: "c_yellow"%d$\n\
				"c_white"Drugs: "c_yellow"%d from 5,000 gr.\n\
				"c_white"Cartridges: "c_yellow"%d from 5,000 pt.\n\
				"c_white"Metal: "c_yellow"%d from 5,000 kg.",
				family_info[f][fam_chat_color],
				family_info[f][fam_name],
				family_info[f][fam_bank],
				family_info[f][fam_drugs],
				family_info[f][fam_materials],
				family_info[f][fam_guns]);

				gdorm_family_text[f] = CreateDynamic3DTextLabel(format_string, col_white, dorm_family_pos[f][0], dorm_family_pos[f][1], dorm_family_pos[f][2] + 1, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, dorm_family_virt[f], dorm_family_int[f]);
			}
			for(new i; i < MAX_FAMILY_VEHICLE; i++)
			{
				if(family_info[f][fam_veh][i])
				{
					family_info[f][fam_veh][i] = AddStaticVehicleEx(family_info[f][fam_veh][i], family_info[f][fam_vposx][i], family_info[f][fam_vposy][i], family_info[f][fam_vposz][i], family_info[f][fam_vposa][i], family_info[f][fam_color1][i], family_info[f][fam_color2][i], 900);
					fam_label[f][i] = Create3DTextLabel(family_info[f][fam_name], 0xFF0000AA, 0.0, 0.0, 0.0, 15.0, 0, 1);
    				Attach3DTextLabelToVehicle(fam_label[f][i], family_info[f][fam_veh][i], 0.0, 0.0, 0.5);
    				printf("VehicleFamily %d, slot:%d , veh:%d, id:%d| x:%f, y:%f, z:%f, a:%f",f,i,
					GetVehicleModel(family_info[f][fam_veh][i]),
					family_info[f][fam_veh][i],family_info[f][fam_vposx][i], family_info[f][fam_vposy][i], family_info[f][fam_vposz][i], family_info[f][fam_vposa][i]);
					Fuell[family_info[f][fam_veh][i]] = 100.0;
					new engine, lights, alarm, doors, bonnet, boot, objective;
					GetVehicleParamsEx(family_info[f][fam_veh][i], engine, lights, alarm, doors, bonnet, boot, objective);
	                SetVehicleParamsEx(family_info[f][fam_veh][i], engine, lights, alarm, 0, bonnet, boot, objective);
				 	new
   					Float: vehX, Float: vehY, Float: vehZ;
					GetVehiclePos(family_info[f][fam_veh][i], vehX, vehY, vehZ);
					printf("Pos : x:%f, y:%f, z:%f",vehX, vehY, vehZ);
				}
			}
			cache_get_value_name_int(f, "fam_members", family_info[f][fam_members]);
			cache_get_value_name_int(f, "fam_rating", family_info[f][fam_rating]);
			cache_get_value_name_int(f, "fam_ticket", family_info[f][fam_ticket]);
			cache_get_value_name_int(f, "fam_max_car", family_info[f][fam_max_car]);
		}
    }
    for(new i; i < family_count; i++)
    {
		text_string[0] = EOS;
        format(text_string, sizeof(text_string), "SELECT `u_family` FROM `accounts` WHERE `u_family`='%d'", i + 1);
		new Cache:_result = mysql_query(dbHandle, text_string);
		new count_members = cache_num_rows();

		cache_delete(_result);

		family_info[i][fam_members] = count_members;
		format(text_string, sizeof(text_string), "UPDATE `family` SET `fam_members`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[i][fam_members], i + 1);
		mysql_tquery(dbHandle, text_string);
    }
    printf("[MySQL R41-3]: Families Loaded : %d  (%d SANIE)", family_count, GetTickCount() - time);
    return 1;
}

stock update_fdorm_text(family_id)
{
	format_string[0] = EOS;
	format(format_string, sizeof(format_string), "\
	"c_white"Warehouse {%s}%s\n\n\
	"c_white"Money: "c_yellow"%d$\n\
	"c_white"Drugs: "c_yellow"%d ?? 5,000 ??.\n\
	"c_white"Cartridges: "c_yellow"%d ?? 5,000 ??.\n\
	"c_white"Metal: "c_yellow"%d from 5,000 kg.",
	family_info[family_id - 1][fam_chat_color],
	family_info[family_id - 1][fam_name],
	family_info[family_id - 1][fam_bank],
	family_info[family_id - 1][fam_drugs],
	family_info[family_id - 1][fam_materials],
	family_info[family_id - 1][fam_guns]);

	UpdateDynamic3DTextLabelText(gdorm_family_text[family_id - 1], col_white, format_string);
	return 1;
}

stock show_settings_family(playerid, family_id, select_id)
{
	dlobal_string[0] = EOS;
	for(new i; i < family_info[family_id - 1][fam_settings][3]; i++)
	{
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\n", i + 1, family_rank[family_id - 1][i]);
		strcat(dlobal_string, text_string);
	}
	if(select_id == 0)
	{
	    SetPVarInt(playerid, "select_id", 0);
		SPD(playerid, 1254, DIALOG_STYLE_LIST, !""c_server"Family (/finvite)", dlobal_string, !"Choose", !"Back");
	}
	else if(select_id == 1)
	{
	    SetPVarInt(playerid, "select_id", 1);
		SPD(playerid, 1254, DIALOG_STYLE_LIST, !""c_server"Family (/funinvite)", dlobal_string, !"Choose", !"Back");
	}
	else if(select_id == 2)
	{
	    SetPVarInt(playerid, "select_id", 2);
		SPD(playerid, 1254, DIALOG_STYLE_LIST, !""c_server"Family (/frang)", dlobal_string, !"Choose", !"Back");
	}
	else if(select_id == 3)
	{
	    SetPVarInt(playerid, "select_id", 4);
		SPD(playerid, 1254, DIALOG_STYLE_LIST, !""c_server"Family (/f(un)mute)", dlobal_string, !"Choose", !"Back");
	}
	else if(select_id == 4)
	{
	    SetPVarInt(playerid, "select_id", 5);
		SPD(playerid, 1254, DIALOG_STYLE_LIST, !""c_server"Family (/flock)", dlobal_string, !"Choose", !"Back");
	}
	else if(select_id == 5)
	{
	    SetPVarInt(playerid, "select_id", 6);
		SPD(playerid, 1254, DIALOG_STYLE_LIST, !""c_server"before approaching the warehouse", dlobal_string, "Choose", "Back");
	}
	return 1;
}

