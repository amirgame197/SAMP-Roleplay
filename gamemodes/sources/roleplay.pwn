	    SetVehicleParamsEx(famveh, true, lights, alarm, fdoor, bonnet, boot, objective);
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), " %s ",family_info[family_id - 1][fam_name]);
	    famveh3d = Create3DTextLabel(text_string, COLOR_RED, 0.0, 0.0, 0.0, 20.0, -1);
        Attach3DTextLabelToVehicle(famveh3d, famveh, 0.0, 0.0, 0.0);
        veh_info[famveh][vStatus] = 2;
    	Fuell[famveh] = MAX_VEHICLE_FUEL;
	    FMVEHFILE = ini_openFile(text_string);
	    ini_setInteger(FMVEHFILE,"fmveh5",famveh);
	    ini_closeFile(FMVEHFILE);
		}
