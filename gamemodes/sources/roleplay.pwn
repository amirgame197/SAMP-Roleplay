function show_player_offstats(playerid, nick[])
{
    new rows;
    cache_get_row_count(rows);

	if(!rows) return SendClientMessage(playerid, COLOR_GREY, "Player not found.");

	new result_string[64];

	new sql_id, hotel_id, sex, level, exp, leader, member, rang, job, cash, bank, number, vip, models[3], costs[3];
	new drugs, ammo, metall, drug_dep, game_sec, game_afk_sec, game_hour_sec, last_ip[16], reg_ip[16];

	cache_get_value_int(0, "pID", sql_id);
	cache_get_value_int(0, "pSex", sex);
	cache_get_value_int(0, "pHotel", hotel_id);
	cache_get_value_int(0, "pLevel", level);
	cache_get_value_int(0, "pExp", exp);

	cache_get_value_int(0, "pLeader", leader);
	cache_get_value_int(0, "pMember", member);
	cache_get_value_int(0, "pRank", rang);
	cache_get_value_int(0, "pJob", job);

	cache_get_value_int(0, "pCash", cash);
	cache_get_value_int(0, "pBank", bank);
	cache_get_value_int(0, "pNumber", number);

	cache_get_value_int(0, "pDrugs", drugs);
	cache_get_value_int(0, "pPatron", ammo);
	cache_get_value_int(0, "pMetall", metall);
	cache_get_value_int(0, "pDrugDep", drug_dep);

	cache_get_value_int(0, "pVip", vip);

	cache_get_value_int(0, "pInGameSeconds", game_sec);
	cache_get_value_int(0, "pInGameAFKSeconds", game_afk_sec);
	cache_get_value_int(0, "pInGameHourSeconds", game_hour_sec);

	cache_get_value_name(0, "pIp",last_ip);
	cache_get_value_name(0, "pIpReg",reg_ip);

	cache_get_value_name(0, "cModel",result_string);
	sscanf(result_string, "p<,>a<i>[3]", models);

	cache_get_value_name(0, "cCost",result_string);
	sscanf(result_string, "p<,>a<i>[3]", costs);

    new str[324];

	new atext[8];
	if(sex == 1) atext = "Male";
	else atext = "Female";

	new htext[10], h_id = GetPlayerHouseBySqlName(nick);
	if(h_id != -1) format(htext, sizeof(htext), "House ?%d ($%d)", h_id, HouseInfo[h_id][hValue]);
	else if(hotel_id != -1) format(htext, sizeof(htext), "Hotel #%d", hotel_id);
	else htext = "Homeless";

	new btext[64], b_id = GetPlayerBizzBySqlName(nick);
	if(b_id == -1) btext = "No";
	else format(btext, sizeof(btext), "%s ($%d)", BizzInfo[b_id][bMessage], BizzInfo[b_id][bMoney]);

	new azctext[64], a_id = GetPlayerABizzBySqlName(nick);
	if(a_id == 0) azctext = "No";
	else format(azctext, sizeof(azctext), "%s ($%d)", BizzAInfo[a_id][aMessage], BizzAInfo[a_id][aMoney]);

	new drank[20];
	switch(level)
	{
 		case 1..2: drank = "Newbie";
 		case 3..5: drank = "Beginning";
	 	case 6..11: drank = "Sure";
	 	case 12..15: drank = "Player Constant";
	 	case 16..20: drank = "Mastered";
	 	case 21..25: drank = "Grandfather";
	 	default: drank = "Veteran";
	}

	new namejobs[64];
	switch(job)
	{
	    case 1: namejobs= "Food/Fuel Delivery Driver";
		case 2: namejobs= "Bus Driver";
		case 3: namejobs= "Street Cleaner";
		case 4: namejobs= "Garbage Truck Driver";
		case 5: namejobs= "Cash Transporter";
		case 6: namejobs= "Yes man";
		case 7: namejobs= "Pilot";
		case 13: namejobs= "Container Deliverer";
		case WORK_TYPE_PIZZA: namejobs = "Pizza Supplier";
		case WORK_TYPE_BULLDOZER: namejobs = "Bulldozer Driver";
		case 70..72: namejobs= "Taxi Driver";
		default: namejobs= "Unemployed";
	}

	new vipname[20+1];
	switch(vip)
	{
	    case 1: vipname= "{CD853F}BRONZE VIP";
		case 2: vipname= "{afafaf}SILVER VIP";
		case 3: vipname= "{ffff00}GOLD VIP";
		default: vipname= "No";
	}

	if(leader) drank = "Leader";

	new infofrac[32];
	if(member == 0) infofrac = "-";
	else format(infofrac, sizeof(infofrac), FracInfo[member][fName]);

	new infojob[64];
	if(job == 0 && member == 0) infojob = "Unemployed";
	else if(job != 0) format(infojob, sizeof(infojob), namejobs);
	else if(member != 0) format(infojob, sizeof(infojob), FracRank[member][rang]);

	String = "";
	format(str, sizeof(str), "\
	"c_white"Name:\t\t\t\t{1A8FA9}%s\n\
	"c_white"Level:\t\t\t%d (%d from %d)\n\
	Cash:\t\t%d$\n\
	Bank Cash:\t\t%d$\n\
	Mobile:\t\t%d\n\
	Drugs:\t\t\t%d ??\n\
	First Aid Kits:\t\t\t%d PC\n\
	Metal:\t\t\t%d ??\n\
	Gender:\t\t\t\t%s\n\
	Addiction:\t\t\t%d\n",
	nick, level, exp, (level+1)*4, cash, bank, number, drugs,
	ammo, metall, atext, drug_dep);
	strcat(String,str);

	format(str, sizeof(str), "\
	Faction:\t\t\t%s\n\
	 Job:\t\t%s\n\n\
	House:\t\t\t%s\n\
	House:\t\t\t%s\n\
    Gas:\t\t\t\t%s\n\n\
    Game Status:\t\t%s\n\
	VIP Status:\t\t\t%s"c_white"\n",
 	infofrac, infojob, htext, btext, azctext, drank, vipname);
	strcat(String,str);

	if(admin_level[playerid])
	{
	    strcat(String, "\nTransport:\n\n");

		for(new i; i < MAX_PLAYER_VEHICLES; i++)
		{
		    if(models[i] == 0)
		    {
		        format(str, 48, "[%d] Empty\n", i + 1);
			    strcat(String, str);
		    }
		    else
			{
				format(str, 48, "[%d] %s ($%d)\n", i + 1, VehicleNames[models[i] - 400], costs[i]);
			    strcat(String, str);
			}
		}
	}

    format(str, 324,
        "\nPlayed in a day: %s\n\
		AFK in a day: %s\n\
		Played without consideration AFK: %s\n\
		Played in the last hour: %s\n\
		L-IP: %s\n\
		R-IP: %s",
		ConvertSeconds(game_sec),
		ConvertSeconds(game_afk_sec),
		ConvertSeconds(game_sec - game_afk_sec),
		ConvertSeconds(game_hour_sec),
		last_ip,
		reg_ip);

	strcat(String ,str);

	return SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Offline Statistics Player",String, "Close", "");
}

cmd:msg(playerid, params[])
{
	if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;
	extract params -> new string:msg_text[128]; else return SendClientMessage(playerid, col_grey, !"Use: /msg [text]");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Administrator %s: %s", Name(playerid), msg_text);
	SendClientMessageToAll(0xFFCD01FF, text_string);
	return 1;
}

CMD:satiety(playerid, params[])
{
	format(String, 322, ""c_white"If your character is full, HP will not decrease.\nKeep an eye on the character's diet to avoid diseases.\nYou can track your character's needs online, more details in 'Personal Settings'.\n\nThe character's fullness is {B0BA06}%.0f percent.", p_info[playerid][pSatiety]);
    return SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Character's fullness", String, "Close", "");
}
CMD:present(playerid, params[])
{
	if(GetPlayerWeapon(playerid) != 14) return SendClientMessage(playerid,-1,"Take the flowers in your hands to give them.");
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, "Enter: /present [Player id]");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, "You cannot give flowers to yourself.");
	if(!ProxDetectorS(3.0, playerid, params[0])) return SendClientMessage(playerid, -1, "You are too far away, please come closer.");
	new rguna,rammoa;
	GetPlayerWeaponData(playerid,10,rguna,rammoa);
	GivePlayerWeapon(params[0],GetPlayerWeapon(playerid),rammoa);
	GivePlayerWeapon(playerid,GetPlayerWeapon(playerid),-rammoa);
	SetPlayerArmedWeapon(playerid, 0);
	ApplyAnimation(playerid, "DEALER", "DEALER_DEAL",4.0,0,0,0,0,0,1);
	ApplyAnimation(params[0], "DEALER", "BUY_DRUGS",4.0,0,0,0,0,0,1);

	SCMF(playerid, -1, "You gifted Player %s a bouquet of flowers.", Name(params[0]));
	SCMF(params[0], -1, "%s gave you a bouquet of flowers.", Name(playerid));
 	format(String, 86,"%s gave a bouquet of flowers to %s.", Name(playerid), Name(params[0]));
 	ProxDetector(15.0, playerid, String, 0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	return 1;
}
CMD:healme(playerid, params[])
{
	new Float:shealth;
 	GetPlayerHealth(playerid, shealth);
 	if(GetPlayerAnimationIndex(playerid) == 1157) return SendClientMessage(playerid, -1, "You cannot use two medkits at once.");
 	if(p_info[playerid][pHeals] == 0) return SendClientMessage(playerid, -1,"You have no medkits; you can buy them at the 24/7 shop.");
   	if(shealth >= 100) return SendClientMessage(playerid,-1, "You cannot use it; your health is normal.");
   	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "You cannot use it while in transport.");

   	new heal24hp = 60;
	new healedhp;
   	if((floatround(shealth) + heal24hp) > 100) healedhp = 100 - floatround(shealth);
   	else healedhp = heal24hp;

	SetPlayerHealthEx(playerid, (floatround(shealth) + healedhp));
	p_info[playerid][pHeals]--;

	new gtexthpGTS[17];
	format(gtexthpGTS, sizeof(gtexthpGTS),"+%dhp", healedhp);
	SetPlayerChatBubble(playerid, gtexthpGTS ,COLOR_NEWS,15.0,10000);

    SCMF(playerid, -1, "You used a medkit. Health restored by {33D441}."c_white"by {33D441}%d"c_white"units", healedhp);
    ApplyAnimation(playerid,"ped","eat_gum",4.0,0,0,0,0,0,1);
    SetPlayerAttachedObject(playerid,1,11736,6,0.118999,0.020000,0.026000,-93.699874,-4.799996,88.400108,1.000000,1.000000,1.000000);
    SetTimerEx("UnfreezeHeal", 1600, false, "d", playerid);
 	return 1;
}
CMD:drink(playerid, params[])
{
    new i = player_use_bizbar[playerid];

	if(player_use_bizbar[playerid] == -1) return SendClientMessage(playerid, COLOR_GREY, "You are not in any bar.");

    if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 1 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
	    if(BizzInfo[i][bLocked] == 1) return SendClientMessage(playerid,COLOR_GREY, "The snack bar is closed by the owner!");

		format(String, 322,
			"[0] Water\t{32CD32}%d$\n\
			[1] Soda\t{32CD32}%d$\n\
			[2] Coca-Cola\t{32CD32}%d$\n\
			[3] Beer\t{32CD32}%d$\n\
			[4] Vodka\t{32CD32}%d$\n\
			[5] Wine\t{32CD32}%d$\n\
			[6] Absinthe\t{32CD32}%d$\n\
			[7] Brandy\t{32CD32}%d$\n\
			[8] Whiskey\t{32CD32}%d$",

		BizzInfo[i][bPrice],BizzInfo[i][bPrice]*2,BizzInfo[i][bPrice]*3,BizzInfo[i][bPrice]*4,BizzInfo[i][bPrice]*5,BizzInfo[i][bPrice]*6,BizzInfo[i][bPrice]*7,BizzInfo[i][bPrice]*8,BizzInfo[i][bPrice]*9);

		SPD(playerid, 72, DIALOG_STYLE_LIST, !""c_server"Bar menu", String, "Choose", "Cancel");
	}
	else SendClientMessage(playerid, COLOR_GREY, "You are far from the bar counter.");

	return 1;
}
CMD:eat(playerid, params[])
{
    new i = player_use_bizbar[playerid];

	if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 2 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
		if(BizzInfo[i][bLocked] == 1) return SendClientMessage(playerid,COLOR_GREY, "The snack bar is closed by the owner!");
		if(p_info[playerid][pHungry] >= 100) return SendClientMessage(playerid,COLOR_GREY, "You are full already!");

		GiveBusinessMoney(i, 2000);

		GivePlayerMoneyEx(playerid, -2000, "ate in the business");
		UpdatePlayerSatiety(playerid, p_info[playerid][pSatiety]+20);
		ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.0, 0, 0, 0, 0, 0,1);
		p_info[playerid][pHungry] += 20;
		update_int_sql(playerid, "pHungry", p_info[playerid][pHungry]);
	}
	return 1;
}

CMD:water(playerid, params[])
{
    new i = player_use_bizbar[playerid];

	if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 2 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
		if(BizzInfo[i][bLocked] == 1) return SendClientMessage(playerid,COLOR_GREY, "The snack bar is closed by the owner!");
		if(p_info[playerid][pWater] >= 100) return SendClientMessage(playerid,COLOR_GREY, "You are not thirsty!");

		GiveBusinessMoney(i, 2000);

		GivePlayerMoneyEx(playerid, -2000, "ate in the business");
		UpdatePlayerSatiety(playerid, p_info[playerid][pSatiety]+20);
		ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.0, 0, 0, 0, 0, 0,1);
		p_info[playerid][pWater] += 20;
		update_int_sql(playerid, "pWater", p_info[playerid][pWater]);
	}
	return 1;
}
CMD:buypizz(playerid, params[])
{
new i = player_use_bizbar[playerid];
	{
		if(BizzInfo[i][bLocked] == 1) return SendClientMessage(playerid,COLOR_GREY, "The snack bar is closed by the owner!");
		if(p_info[playerid][pHungry] >= 100) return SendClientMessage(playerid,COLOR_GREY, "You are a sir!");

		GiveBusinessMoney(i, 1000);

		GivePlayerMoneyEx(playerid, -1000, "ate in the business");
		UpdatePlayerSatiety(playerid, p_info[playerid][pSatiety]+15);
		ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.0, 0, 0, 0, 0, 0,1);
		p_info[playerid][pHungry] += 15;
		update_int_sql(playerid, "pHungry", p_info[playerid][pHungry]);
	}
	return 1;
}

