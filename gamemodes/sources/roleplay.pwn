alias:suspect("su")
CMD:suspect(playerid, params[])
{
    if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Only factions and FBI are allowed.");

	if(p_info[playerid][pMember] != FRACTION_FBI && p_info[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREY, "Available from rank 2.");

	if(sscanf(params, "dds[36]", params[0], params[1], params[2])) return SendClientMessage(playerid, -1,"Enter: /suspect(/su) [playerid] [number of stars] [Cause]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, COLOR_GREY,"Player is not logged in");//+;
	if(p_info[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREY, "You can issue a wanted notice starting from rank 3.");
 	if(p_info[params[0]][pPrison] > 0) return SendClientMessage(playerid, COLOR_GREY, "There are people in prison!");
 	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "You cannot place a wanted notice on yourself.");
    if(IsACop(params[0])) return SendClientMessage(playerid, COLOR_GREY, "This person is part of LSPD or FBI!");
    //if(!ProxDetectorS(15.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY,"Player before should be with you!");
    if(GetPVarInt(params[0],"robshoporbank")) return SendClientMessage(playerid, COLOR_RED, !""c_error"You cannot use it for a robber!");

    if(params[1] <= p_info[params[0]][pWanted]) return SCMF(playerid, 0xB4B5B7FF, "This Player already has %d Wanted Level(s).", p_info[params[0]][pWanted]);
 	if(p_info[playerid][pMember] == 1 && params[1] > 6) return SendClientMessage(playerid, 0xB4B5B7FF,"The Police cannot put the criminal Nick on federal wanted list!");

	p_info[params[0]][pWanted] = params[1];
	SetPlayerCriminal(params[0], Name(playerid), params[2]);
	SetPlayerWantedLevel(params[0], params[1]);
	me_action(playerid,"before became the CPC");
	me_action(playerid,"opened the tab to Add Criminal Nick");
	me_action(playerid,"added Name of the suspect to the database");
	return 1;
}

CMD:lpanel(playerid)
{
    if(!p_info[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
    if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1) return SendClientMessage(playerid,COLOR_GREY,"You are not a Leader/deputy Leader!");
    if(form_fraction[playerid] == 0) return SendClientMessage(playerid,COLOR_GREY,"You haven't started the working day!");

	String = ""c_white"[1] Faction members online\n[2] Faction members offline (management)\n[3] Vehicle management";

	if(IsAGang(playerid) || IsAMafia(playerid) || p_info[playerid][pMember] == FRACTION_BIKER)
	{
	    new gang_id = GetPlayerGangWHID(playerid);

	    strcat(String, "\n4. Access to warehouse (Rank)");

		format(format_string, 48, "\n5. Access to warehouse | %s", wh_state_gang[gang_id] ? ("Open") : ("Closed"));
		strcat(String, format_string);
	}

    return SPD(playerid,165,DIALOG_STYLE_LIST, !""c_server"Leader Panel", String,"Choose","Close");
}

CMD:invite(playerid,params[])
{
    if(!p_info[playerid][pMember]) return 1;
	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1 || form_fraction[playerid] == 0) return SendClientMessage(playerid,COLOR_GREY,"You are not a Leader/deputy Leader.");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1,"Enter: /invite [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
 	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"You cannot invite yourself.");
	if(p_info[params[0]][pMember] != 0) return SendClientMessage(playerid,COLOR_GREY,"Player is already in The organization.");
	if(!ProxDetectorS(4.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY,"Player is too far away.");
	if(p_info[params[0]][pWarn] > 0) return SendClientMessage(playerid,COLOR_GREY,"Player has a Warn.");

	if(p_info[params[0]][pLevel] < FracInfo[p_info[playerid][pMember]][fLevel]) return SCMF(playerid, COLOR_GREY, "To join your organization, Player must have %d game Level.", FracInfo[p_info[playerid][pMember]][fLevel]);
	if(IsPlayerInAnyVehicle(params[0])) return SendClientMessage(playerid,COLOR_GREY,"The person in the car, ask him to get out.");

 	format(String,128, ""c_white"%s(%d) invites you to join the faction %s\n\nDo you accept the invitation?", Name(playerid), playerid, FracInfo[p_info[playerid][pMember]][fName]);
	SPD(params[0], 164, DIALOG_STYLE_MSGBOX, !""c_server"Joining a faction", String, "Yes", "No");

	SCMF(playerid, 0x6BB3FFAA, "You invited %s(%d) to the organization %s.", Name(params[0]), params[0], FracInfo[p_info[playerid][pMember]][fName]);

	SetPVarInt(params[0],"InvID",playerid), SetPVarInt(params[0],"Inv",1);
	return 1;
}

CMD:vipuninvite(playerid)
{
	if(p_info[playerid][pVip] < 3 && p_info[playerid][pUpdPlayer][2] == 0) return SendClientMessage(playerid, COLOR_GREY, "You are not VIP level 3 or you do not have the 'Determination' upgrade.");

    if(p_info[playerid][pLeader]) return SendClientMessage(playerid, COLOR_GREY,"Leader cannot use this command!");

    if(!p_info[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY,"You are not in any faction!");

    foreach(new i : capture_zone_list)
	{
	    if(p_info[playerid][pMember] != GZInfo[i][gFraction] && p_info[playerid][pMember] != GZInfo[i][gAttack]) continue;

		for(new j; j < 18; j++) TextDrawHideForPlayer(playerid, GZInfo[i][gTD][j]);

		break;
	}

	p_info[playerid][pLeader] = 0;
    p_info[playerid][setspawn] = 1;
    p_info[playerid][pMember] = 0;
    p_info[playerid][pRank] = 0;
    p_info[playerid][pfWarn] = 0;
	form_fraction[playerid] = 0;

	SavePlayerFraction(playerid);

	SetPlayerSkinEx(playerid, p_info[playerid][pSkin]);
	SetPlayerToTeamColor(playerid);
	SendClientMessage(playerid, -1, "You have resigned from The organization.");
	return 1;
}
CMD:uninvite(playerid, params[])
{
    if(!p_info[playerid][pMember]) return 1;
	if(sscanf(params, "us[128]",params[0], params[1])) return SendClientMessage(playerid, -1,"Enter: /uninvite [playerid] [Cause]");
    if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
 	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1) return SendClientMessage(playerid,COLOR_GREY,"You are not a Leader/deputy Leader.");
	if(p_info[playerid][pMember] != p_info[params[0]][pMember]) return SendClientMessage(playerid,COLOR_GREY,"Player is not a member of your organization.");
	if(p_info[playerid][pRank] <= p_info[params[0]][pRank] || p_info[params[0]][pLeader] > 0) return SendClientMessage(playerid,COLOR_GREY,"You cannot fire this Player.");
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"You cannot fire yourself!");

	foreach(new i : capture_zone_list)
	{
	    if(p_info[playerid][pMember] != GZInfo[i][gFraction] && p_info[playerid][pMember] != GZInfo[i][gAttack]) continue;

		for(new j; j < 18; j++) TextDrawHideForPlayer(params[0], GZInfo[i][gTD][j]);

		break;
	}

	SCMF(params[0], 0x6BB3FFAA, "%s(%d) fired you from the organization (%s). Cause: %s", Name(playerid), playerid, FracInfo[p_info[playerid][pMember]][fName], params[1]);
    SCMF(playerid, 0x6BB3FFAA, "You fired %s(%d) from the organization (%s). Cause: %s", Name(params[0]), params[0], FracInfo[p_info[playerid][pMember]][fName], params[1]);

    p_info[params[0]][setspawn] = 1;
    p_info[params[0]][pMember] = 0;
    p_info[params[0]][pRank] = 0;
    p_info[params[0]][pfWarn] = 0;
	form_fraction[params[0]] = 0;

	SetPlayerSkinEx(params[0], p_info[params[0]][pSkin]);
	SetPlayerToTeamColor(params[0]);

    SavePlayerFraction(params[0]);

	return 1;
}
CMD:giverank(playerid,params[])
{
    if(!p_info[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-2) return SendClientMessage(playerid,COLOR_GREY,"You cannot use this command.");
	if(sscanf(params, "ud", params[0],params[1])) return SendClientMessage(playerid, -1,"Enter: /giverank [playerid] [rank]");
    if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
 	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in.");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	//if(!form_fraction[playerid] || IsAGang(playerid) || IsAMafia(playerid)) return SendClientMessage(playerid,COLOR_GREY,"You haven't started the working day!");
	if(p_info[playerid][pMember] != p_info[params[0]][pMember]) return SendClientMessage(playerid,COLOR_GREY,"The player is not in your organization.");
	if(params[1] >= FracInfo[p_info[playerid][pMember]][fRankMax] || params[1] < 1) return SendClientMessage(playerid,COLOR_GREY,"The rank specified is incorrect.");
	if(params[1] >= p_info[playerid][pRank]) return SendClientMessage(playerid,COLOR_GREY,"You cannot give this rank to a person.");
	if(p_info[playerid][pRank] <= p_info[params[0]][pRank] || p_info[params[0]][pLeader] > 0) return SendClientMessage(playerid,COLOR_GREY,"You cannot change the rank of this Player.");

	if(params[1] < p_info[params[0]][pRank]) SCMF(params[0], 0x1CCCE6FF, "%s(%d) warned you before rank %d (%s)", Name(playerid), playerid, params[1], FracRank[p_info[playerid][pMember]][params[1]]);
	if(params[1] > p_info[params[0]][pRank]) SCMF(params[0], 0x1CCCE6FF, "%s(%d) warned you before rank %d (%s)", Name(playerid), playerid, params[1], FracRank[p_info[playerid][pMember]][params[1]]);

	p_info[params[0]][pRank] = params[1];
	SCMF(playerid,0x1CCCE6FF,"You and %s warned before title %s (%d rank)",Name(params[0]), FracRank[p_info[playerid][pMember]][params[1]],params[1]);

    SavePlayerFraction(params[0]);

	return 1;
}

cmd:mask(playerid)
{
	if(GetPVarInt(playerid, "use_mask"))
	{
	    RemovePlayerMask(playerid);
        SetPlayerChatBubble(playerid, "Removing mask", COLOR_ORANGE, 30.0, 10000);
	    return SendClientMessage(playerid, col_white, !""c_info"You successfully removed the mask.");
	}
	if(!p_info[playerid][pMask]) return SendClientMessage(playerid, col_white, !""c_error"You do not have a mask.");

    ApplyAnimation(playerid, !"shop", !"ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 1);
	SetPlayerColor(playerid, 0x7A766700);
	SetPlayerChatBubble(playerid, "Putting on mask", COLOR_ORANGE, 30.0, 10000);
	SetAttachToMask(playerid);

    p_info[playerid][pMask]--;
    OnPlayerUpdateAccountsPer(playerid, "pMask", p_info[playerid][pMask]);
	SetPVarInt(playerid, "use_mask", 1);

	SendClientMessage(playerid, col_white, !""c_info"You put on the mask. Your location is hidden. To remove the mask, enter the command again.");
	return 1;
}

stock RemovePlayerMask(playerid)
{
    if(!GetPVarInt(playerid, "use_mask")) return 1;
    SetPlayerToTeamColor(playerid);
	RemovePlayerAttachedObject(playerid, 3);
	DeletePVar(playerid, "use_mask");
	return 1;
}

stock SetAttachToMask(playerid)
{
   	switch(GetPlayerSkin(playerid))
	{
