		    if(isNum(inputtext)) return SPD(playerid, 62, DIALOG_STYLE_INPUT, !""c_server"SIM card", ""c_white"Enter the desired number for purchase:\nThe number can only contain digits\n", "Choose", "Back");
		    if(number > 999999 || number < 100000) return SPD(playerid, 62, DIALOG_STYLE_INPUT, !""c_server"SIM card", ""c_white"Enter the desired number for purchase:\nYou cannot enter '0' at the beginning\n", "Choose", "Back");

