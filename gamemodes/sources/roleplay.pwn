cmd:offmute(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	extract params -> new string:name_player[24], mute_time, string:reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /offmute [Player Nick] [number of minutes] [Cause]");
    if(!(5 <= mute_time <= 120)) return SendClientMessage(playerid, col_white, !""c_error"Chat block time can be from 5 to 120 minutes.");
    if(GetPlayerID(name_player) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The Player is Online .");
    if(GetPlayerAdminBySql(name_player)) return SendClientMessage(playerid, col_white, !""c_error"The Player is Administrator.");

	text_string[0] = EOS;
	mysql_format(dbHandle, text_string, sizeof(text_string), "SELECT `pID`,`pMuted` FROM `accounts` WHERE `pName`='%e' LIMIT 1", name_player);
	new Cache: result = mysql_query(dbHandle, text_string);

	if(cache_num_rows() == 0)
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"Player "c_server"%s"c_white" not found.", name_player);
	    return SendClientMessage(playerid, col_white, text_string);
	}

    new seconds, sql_id;
	cache_get_value_name_int(0, "pID", sql_id);
    cache_get_value_name_int(0, "pMuted", seconds);

	cache_delete(result);

	if(seconds) return SendClientMessage(playerid, col_white, !""c_error"This player�s chat has already been blocked.");

    p_info[playerid][pAdmMute]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmMute", p_info[playerid][pAdmMute]);

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "Administrator %s blocked your chat for %d minutes (Cause: %s)", Name(playerid), mute_time, reason);
    AddPlayerNotifyBySQL(sql_id, text_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Administrator %s blocked the player chat %s for %d minutes (Cause: %s)", Name(playerid), name_player, mute_time, reason);
	SendClientMessageToAll(col_orange_red, text_string);
	AddAdminLog(playerid, text_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "UPDATE `accounts` SET `pMuted`='%d' WHERE `pName`='%s'", mute_time * 60, name_player);
	mysql_query(dbHandle, text_string);
	return 1;
}

cmd:offajail(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	extract params -> new string:name_player[24], ajail_time, string:reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /offjail [Player Nick] [number of minutes] [Cause]");
    if(!(5 <= ajail_time <= 120)) return SendClientMessage(playerid, col_white, !""c_error"The prison time can be between 5 to 120 minutes.");
    if(GetPlayerID(name_player) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The Player Online.");
    if(GetPlayerAdminBySql(name_player)) return SendClientMessage(playerid, col_white, !""c_error"The Player Administrator.");

    text_string[0] = EOS;
	mysql_format(dbHandle, text_string, sizeof(text_string), "SELECT `pID`,`pPrison` FROM `accounts` WHERE `pName`='%e' LIMIT 1", name_player);
	new Cache: result = mysql_query(dbHandle, text_string);

	if(cache_num_rows() == 0)
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"Player "c_server"%s"c_white" not found.", name_player);
	    return SendClientMessage(playerid, col_white, text_string);
	}

    new seconds, sql_id;
    cache_get_value_name_int(0, "pID", sql_id);
	cache_get_value_name_int(0, "pPrison", seconds);

	cache_delete(result);

	if(seconds) return SendClientMessage(playerid, col_white, !""c_error"Player is already in prison.");

    p_info[playerid][pAdmPrison]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmPrison", p_info[playerid][pAdmPrison]);

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "Administrator %s put you in prison with Player for %d minutes (Cause: %s)", Name(playerid), ajail_time);
    AddPlayerNotifyBySQL(sql_id, text_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Administrator %s put Player %s in prison for %d minutes (Cause: %s)", Name(playerid), name_player, ajail_time, reason);
	SendClientMessageToAll(col_orange_red, text_string);
	AddAdminLog(playerid, format_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "UPDATE `accounts` SET `pPrison`='%d', `pMestoPrison`='5' WHERE `pName`='%s'", ajail_time * 60, name_player);
	mysql_query(dbHandle, text_string);
	return 1;
}

cmd:offwarn(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	extract params -> new string:name_player[24], string:reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /offwarn [Player Nick] [Cause]");
    if(GetPlayerID(name_player) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The Player Online.");
    if(GetPlayerAdminBySql(name_player)) return SendClientMessage(playerid, col_white, !""c_error"The Player Administrator.");

	text_string[0] = EOS;
	mysql_format(dbHandle, text_string, sizeof(text_string), "SELECT `pID` FROM `accounts` WHERE `pName`='%e' LIMIT 1", name_player);
	new Cache: result = mysql_query(dbHandle, text_string);

	if(cache_num_rows() == 0)
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"Player "c_server"%s"c_white" not found.", name_player);
	    return SendClientMessage(playerid, col_white, text_string);
	}

	cache_delete(result);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "SELECT * FROM `banlog` WHERE `nameplayer`='%s' AND `lockstate`='1'", name_player);
	result = mysql_query(dbHandle, text_string);

	if(cache_num_rows() == 0)
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"Account "c_server"%s"c_white" is already locked.", name_player);
	    return SendClientMessage(playerid, col_white, text_string);
	}

    cache_delete(result);

	new sql_id = GetPlayerSqlIDByName(name_player);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "SELECT * FROM `warninfo` WHERE `plID`='%d'", sql_id);
	result = mysql_query(dbHandle, text_string);

	new rows = cache_num_rows();

	cache_delete(result);

	if(rows + 1 == 3)
	{
	    p_info[playerid][pAdmBan]++;
	    OnPlayerUpdateAdminPer(playerid, "pAdmBan", p_info[playerid][pAdmBan]);

        text_string[0] = EOS;
    	format(text_string, sizeof(text_string), "Administrator %s has blocked account %s for 7 days (Cause: %s | 3 from 3)", Name(playerid), name_player, reason);
		send_admin_message(col_orange_red, text_string);
		AddAdminLog(playerid, text_string);

        text_string[0] = EOS;
    	mysql_format(dbHandle, text_string, sizeof(text_string), "DELETE FROM `warninfo` WHERE `plID`='%d'", sql_id);
		mysql_query(dbHandle, text_string);

    	BlockAccounts(name_player, reason, Name(playerid), gettime() + (86400 * 7));
    	return 1;
	}

    p_info[playerid][pAdmWarn]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmWarn", p_info[playerid][pAdmWarn]);

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "Administrator %s issued a warning to Player %s (Cause: %s | %d from 3)", Name(playerid), name_player, reason, rows + 1);
	send_admin_message(col_orange_red, text_string);
	AddAdminLog(playerid, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "UPDATE `accounts` SET `pLeader`='0',`pMember`='0' WHERE `pID`='%d'", sql_id);
	mysql_query(dbHandle, text_string);

	slobal_string[0] = EOS;
	mysql_format(dbHandle, slobal_string, 350, "INSERT INTO `warninfo` (`plID`,`wReasonWarn`,`wAdminWarn`,`wWarnDate`,`wUnWarnDate`) VALUES ('%d','%e','%e','%d','%d')", sql_id, reason, Name(playerid), gettime(), gettime() + (86400 * 7));
	mysql_query(dbHandle, slobal_string);
	return 1;
}

cmd:sicoff(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	extract params -> new string:name_player[24], ban_day, string:ban_reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /offban [Player Nick] [number of days] [Cause]");
    if(!(1 <= ban_day <= 30)) return SendClientMessage(playerid, col_white, !""c_error"You can only ban for between 1 and 10 days.");
    if(GetPlayerID(name_player) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"Player Online.");
    if(GetPlayerAdminBySql(name_player)) return SendClientMessage(playerid, col_white, !""c_error"The Player Administrator.");

	text_string[0] = EOS;
	mysql_format(dbHandle, text_string, sizeof(text_string), "SELECT `pID` FROM `accounts` WHERE `pName`='%e' LIMIT 1", name_player);
	new Cache: result = mysql_query(dbHandle, text_string);

	if(cache_num_rows() == 0)
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"Player "c_server"%s"c_white" not found.", name_player);
	    return SendClientMessage(playerid, col_white, text_string);
	}
	cache_delete(result);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "SELECT * FROM `banlog` WHERE `nameplayer`='%s' AND `lockstate`='1'", name_player);
	result = mysql_query(dbHandle, text_string);

	if(cache_num_rows())
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"Player "c_server"%s"c_white" is already locked.", name_player);
	    return SendClientMessage(playerid, col_white, text_string);
	}
    cache_delete(result);

	new days[6];
	switch(ban_day)
	{
	    case 1: days = "day";
	    case 2..4: days = "days";
		default: days = "days";
	}

	p_info[playerid][pAdmBan]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmBan", p_info[playerid][pAdmBan]);

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "Administrator %s has blocked account %s for %d %s (Cause: %s)", Name(playerid), name_player, ban_day, days, ban_reason);
	SendClientMessageToAll(col_orange_red, text_string);
	AddAdminLog(playerid, text_string);

	BlockAccounts(name_player, ban_reason, Name(playerid), gettime() + (86400 * ban_day));
	return 1;
}

cmd:spveh(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	extract params -> new sp_veh; else return SendClientMessage(playerid, col_grey, !"Use: /spveh [radius]");
	if(!(1 <= sp_veh <= 100)) return SendClientMessage(playerid, col_white, !""c_error"The radius must be between 1 and 100.");

    new count = 0, Float:x, Float:y, Float:z;
    for(new i; i < MAX_VEHICLES; i++)
    {
		if(!IsValidVehicle(i)) continue;
		if(vehicle_driver[i] != INVALID_PLAYER_ID) continue;

		GetVehiclePos(i, x, y, z);
        if(GetPlayerDistanceFromPoint(playerid, x, y, z) > params[0]) continue;

		count++;
		SetVehicleToRespawn(i);
    }
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] spawned a vehicle (%d PC.) within a radius of %d meters", Name(playerid), playerid, count, sp_veh);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:spawncars(playerid)
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;

	for(new i; i < MAX_VEHICLES; i++)
	{
	    if(vehicle_driver[i] != INVALID_PLAYER_ID) continue;
	    SetVehicleToRespawn(i);
 	}
 	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] spawned all unused vehicles", Name(playerid), playerid);
	send_admin_message(col_grey, text_string);
	return 1;
}
