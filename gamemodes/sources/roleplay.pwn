stock takeqalion()
{
	DestroyObject(Object);
	DestroyObject(Object1);
	DestroyObject(Object2);
	DestroyObject(Object3);
	DestroyObject(Object4);
	DestroyObject(Object5);
	DestroyObject(Object6);
	DestroyObject(Object7);
