stock GetEngineStat(vehicleid)
{
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	return engine;
}

stock string_replace ( string[], find, replace )
{
	for ( new i = 0 ; string [ i ] ; i ++ )
	{
		if ( string [ i ] == find ) string [ i ] = replace ;
	}
}

forward IsVehicleOccupied(vehicleid);
public IsVehicleOccupied(vehicleid)
{
	foreach(Player,i)
	{
		if(IsPlayerInVehicle(i,vehicleid)) return 1;
	}
	return 0;
}

stock GivePlayerMoneyEx(playerid, amount, reason[])
{
	p_info[playerid][pCash] += amount;
	OnPlayerUpdateAccountsPer(playerid, "pCash", p_info[playerid][pCash]);

    if(p_info[playerid][pCash] >= 1000000) SetPlayerMoneyCase(playerid);
	else RemovePlayerMoneyCase(playerid);

	if(amount <= -1000 || amount >= 1000)
	{
		format(format_string, 244, "INSERT INTO `money_log` (`user_id`,`amount`,`reason`,`type`) VALUES (%d,%d,'%s ($%d)',0)", GetPlayerAccountID(playerid), amount, reason, p_info[playerid][pCash]);
		mysql_tquery(dbHandle, format_string);
	}
	return 1;
}

stock GivePlayerBankEx(playerid, amount, reason[])
{
	p_info[playerid][pBank] += amount;
	OnPlayerUpdateAccountsPer(playerid, "pBank", p_info[playerid][pBank]);

    if(amount <= -1000 || amount >= 1000)
	{
		format(format_string, 244, "INSERT INTO `money_log` (`user_id`,`amount`,`reason`,`type`) VALUES (%d,%d,'%s ($%d)',1)", GetPlayerAccountID(playerid), amount, reason, p_info[playerid][pBank]);
		mysql_tquery(dbHandle, format_string);
	}

	return 1;
}
stock IsPlayerDriver(playerid) // ????? ?? Player ?? ????? ??
{
	return (IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER);
}

stock ShowPlayerChooseCar(playerid, dialogid)
{
	String = "";

	new str[96], vehicle_name[32];
	for(new i; i < MAX_PLAYER_VEHICLES; i++)
	{
	    if(CarInfo[playerid][cModel][i] == 0) vehicle_name = "Empty";
	    else format(vehicle_name, 32, VehicleNames[CarInfo[playerid][cModel][i]-400]);
		format(str, 96, ""c_server"[%d]\t"c_white"%s\n", i+1, vehicle_name);

		strcat(String, str);
	}

	return SPD(playerid, dialogid, DIALOG_STYLE_TABLIST, !""c_server"Slot selection", String, "Choose", "Back");
}

stock GetPlayerUseHomeCar(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return -1;

	for(new i; i < MAX_PLAYER_VEHICLES; i++) if(GetPlayerVehicleID(playerid) == player_home_car[playerid][i]) return i;

	return -1;
}

stock SavePlayerCarPark(playerid)
{
    format(MySQLStr, 312, "UPDATE `accounts` SET `car_park` = '%.1f,%.1f,%.1f,%.1f|%.1f,%.1f,%.1f,%.1f|%.1f,%.1f,%.1f,%.1f' WHERE `pID` = %d",
    player_car_park[playerid][0][0],player_car_park[playerid][0][1],player_car_park[playerid][0][2],player_car_park[playerid][0][3],
    player_car_park[playerid][1][0],player_car_park[playerid][1][1],player_car_park[playerid][1][2],player_car_park[playerid][1][3],
    player_car_park[playerid][2][0],player_car_park[playerid][2][1],player_car_park[playerid][2][2],player_car_park[playerid][2][3],
	GetPlayerAccountID(playerid));

	mysql_tquery(dbHandle, MySQLStr);

	return 1;
}

stock StopGamePB(team_win)
{
	if(team_win == 0) SendClientMessageToAll(-1, "[PB] The blue team has won.");
	else if(team_win == 1) SendClientMessageToAll(-1, "[PB] The red team has won.");
	else SendClientMessageToAll(-1, "[PB] The match is over. It's a draw.");

	new count = 0;

	foreach(Player, i) if(player_reg_pb[i] == team_win) count++;

	new finish_reward = pb_reward / count;

	foreach(Player, i)
    {
        if(player_reg_pb[i] == -1) continue;

		if(player_reg_pb[i] == team_win) GivePlayerMoneyEx(i, finish_reward, "You win PB");

        //ResetPlayerWeapons(i);

        SetPlayerPos(i, -2161.8418,641.5208,1052.3750);
        SetPlayerFacingAngle(i, 84.9472);
        SetPlayerVirtualWorld(i, 1);
        SetPlayerInterior(i, 1);

        player_reg_pb[i] = -1;
	}

	pb_state = pb_time = 0;

	return 1;
}

