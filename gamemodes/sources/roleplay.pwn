	{
	SetPPos(playerid, 3255.414550, 1205.897949, 1821.754638, 0.0, 0, 0, true);
	}

	//FP
    if(pickupid == fppickup[0])
	{
	SetPPos(playerid, 1800.2554, -1577.4451, 14.0625, 0.0, 0, 0, true);
	}
	if(pickupid == fppickup[1])
	{
	SetPPos(playerid, 253.9990, 86.2886, 1002.4453, 0.0, 6, 1, false);
	}

	//wc
    if(pickupid == wcpickup[0])
	{
	SetPPos(playerid, 850.0794, -2053.8750, 12.4861, 0.0, 0, 0, true);
	}
	if(pickupid == wcpickup[1])
	{
	SetPPos(playerid, 1224.8046, -2162.2495, 1110.5795, 0.0, 6, 1, false);
	}


	//RCPD
	if(pickupid == rcpickup[0])
	{
	SetPPos(playerid, 246.7840, 63.9002, 1003.6406, 0.0, 6, 2, true);
	}
	if(pickupid == rcpickup[1])
	{
	SetPPos(playerid, 629.7952, -571.5518, 16.5557, 0.0, 0, 0, false);
	}

    if(ac_pickups[playerid][1] == pickupid) return 0;

    ac_pickups[playerid][1] = pickupid;
	GetPlayerPos(playerid, PosPic[playerid][1][0], PosPic[playerid][1][1], PosPic[playerid][1][2]);

	if(ship_work_pickups[0] <= pickupid <= ship_work_pickups[sizeof ship_work_pickups - 1])
	{
	    if(!player_ship_worked[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are not working on the platform.");

	    if(player_ship_oil[playerid] == false) return SendClientMessage(playerid, COLOR_GREY, "You don't have oil, go to the lower Level and gather some.");

	    new index = _:(pickupid - ship_work_pickups[0]);

        if(gettime() < ship_repair_cd[index]) return SendClientMessage(playerid, COLOR_GREY, "No repair is needed here.");

	    ship_repair_cd[index] = gettime() + 60;

	    TogglePlayerControllable(playerid, false);

	    ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.0, 1, 0, 0, 0, 0,1);

        player_ship_oil[playerid] = false;

	    SetTimerEx("PlayerEndRepairShip", 10000, false, "i", playerid);
	}

	if(ship_oil_pickups[0] <= pickupid <= ship_oil_pickups[sizeof ship_oil_pickups - 1])
	{
	    if(!player_ship_worked[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are not working on the platform.");

	    if(player_ship_oil[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You already have oil, go grease the machines.");

	    ApplyAnimation(playerid,"MISC","GRAB_R",4.0, 0, 0, 0, 0, 0,1);

        player_ship_oil[playerid] = true;

        SendClientMessage(playerid, COLOR_GREEN, "You've taken the oil, go grease the machines.");
	}


    if(pickupid == family_create_pick)
	{
		if(p_info[playerid][family] >= 1) return SendClientMessage(playerid, col_white, !""c_error"You are in a family.");

		SPD(playerid, 1255, DIALOG_STYLE_INPUT, !""c_server"Create Family", !""c_white"Enter the family name.", !"Okay", !"Cancel");
	}

	if(pickupid == ship_pickup)
	{
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"You are part of The organization.");
	    if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, "To start working, cancel the transportation rental: /rcancel");

	    if(!player_ship_worked[playerid])
	    {
	        SendClientMessage(playerid, COLOR_GREEN, "You started the workday.");

	        SetPVarInt(playerid, "old_skin", GetPlayerSkin(playerid));
		    SetPlayerSkin(playerid, 50);

		    //player_ship_oil[playerid] = true;

		    p_t_info[playerid][pWorkSalary] = 0;

