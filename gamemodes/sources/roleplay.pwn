{
    if(!IsACop(playerid) && !IsAArmy(playerid) && !IsAMedic(playerid) && p_info[playerid][pMember] != FRACTION_MAYOR) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this.");

	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(player_gag[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are gagged, you cannot speak.") & 0;
	if(!form_fraction[playerid]) return SendClientMessage(playerid,COLOR_GREY,"You haven't put on the uniform.");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, -1,"Enter: /d [text]");

	if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_GREY, format_string);
		return 1;
	}

	format(format_string, sizeof(format_string), "[%s] %s %s[%d]: (( %s ))", FracInfo[p_info[playerid][pMember]][fTag], FracRank[p_info[playerid][pMember]][p_info[playerid][pRank]], Name(playerid), playerid ,params);
	SendTeamMessage(COLOR_ALLDEPT, format_string);
	return 1;
