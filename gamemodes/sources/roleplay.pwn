{
	//if(p_info[playerid][pJob] != 4) return SendClientMessage(playerid, COLOR_GREY, "You can't work on the garbage truck!");

	new str[64], count = 0;

	command_text = ""c_white"";

	for(new i = 1; i < MAX_ATMS; i++)
	{
	    if(AtmsInfo[i][c_amount] < 10) continue;

	    if(count == 25) break;

	    format(str, 64, "[%d] Condition: %d/100\n", i, AtmsInfo[i][c_amount]);
	    strcat(command_text, str);

	    SetPlayerListitemValue(playerid, count++, i);
	}

	strcat(command_text, "\nEnter ATM number:");

	return SPD(playerid, 551, DIALOG_STYLE_INPUT, !""c_server"ATM Locations", command_text, "Choose", "Close");
}
