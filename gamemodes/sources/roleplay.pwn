    		        ini_setInteger(FMVEHFILE,"fdoor7",1);
    		        ini_closeFile(FMVEHFILE);
				}
				else
				{
				    SetVehicleParamsEx(fmveh7, engine, lights, alarm, 0, bonnet, boot, objective);
					GameTextForPlayer(playerid, "~w~CAR ~g~UNLOCK", 1000, 3);
					text_string[0] = EOS;
    		        format(text_string, sizeof(text_string), "familyveh/%s.ini", family_info[family_id - 1][fam_name]);
    		        FMVEHFILE = ini_openFile(text_string);
    		        ini_setInteger(FMVEHFILE,"fdoor7",0);
    		        ini_closeFile(FMVEHFILE);
				}
				SetPlayerChatBubble(playerid, !doors ? ("closed the transport doors") : ("opened the transport doors"), COLOR_PURPLE, 30.0, 10000);
				return 1;
			}
		}
	}
	return 1;
}

CMD:id(playerid, params[])
{
	if(!strlen(params)) return SendClientMessage(playerid, -1, "Enter: /id [part of name]");

	if(!(2 <= strlen(params) <= MAX_PLAYER_NAME - 1)) return SendClientMessage(playerid, COLOR_GREY, "The length of Nick must be between 2 and 32 characters.");

	new count = 0;

	foreach(Player, i)
	{
	    if(count == 10) break;

	    if(strfind(Name(i), params, true) == -1) continue;

	    SCMF(playerid, -1, "[%d] %s[%d]", count, Name(i), i);

	    count++;
	}

	return SCMF(playerid, -1, "Found Players: %d", count);
}

CMD:mbuy(playerid, params[])
{
	if(GetPlayerHouse(playerid) == -1) return SendClientMessage(playerid, -1, "You do not have a House!");
    return SPD(playerid,17,DIALOG_STYLE_LIST, !""c_server"Select the required section",""c_white"- Furniture for House\n- Doors\n- Paintings\n- Houseplants\n- House equipment\n- Everything for the bathroom","Choose","Exit");
}

CMD:hotel(playerid)
{
	new h_id = p_info[playerid][pHotel];

	if(h_id == -1) return SendClientMessage(playerid, COLOR_GREY, "You do not have a room at the hotel.");

    new days = GetElapsedTime(hotel_info[h_id][hRentTime], gettime(), CONVERT_TIME_TO_DAYS);

	format(command_text, 244,
		"[1] Doors: %s\n\
		[2] Place transport in garage\n\
		[3] Rent [%d days]\n\
		[4] Terminate rental",
		hotel_info[h_id][hLock] ? ("Closed") : ("Open"),
		days);

	return ShowPlayerDialog(playerid, 8847, DIALOG_STYLE_LIST, !""c_server"Hotel Menu", command_text, "Choose", "Close");
}

cmd:home(playerid, params[])
{
	new house = GetPlayerHouse(playerid);
	if(house == -1) house = GetPlayerHouseLodger(playerid);
	if(house == -1) return SendClientMessage(playerid, col_white, !""c_error"You don't have a room.");

	new klass[20];
	switch(HouseInfo[house][hKlass])
	{
	    case 0: klass = "Class C";
	    case 1: klass = "Class B";
	    case 2: klass = "Class A";
	    case 3: klass = "VIP A";
	    case 4: klass = "VIP B";
	    case 5: klass = "VIP C";
 	}

 	slobal_string[0] = format_string[0] = EOS;
 	format(format_string, sizeof(format_string), ""c_white"House ID: #%d\n", house);
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"House Class: "c_yellow"%s\n", klass);
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"Owner: "c_orange"%s\n\n", HouseInfo[house][hOwner]);
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"City/Area: %s\n", GetTownName(HouseInfo[house][hEntrancex], HouseInfo[house][hEntrancey]));
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"Town: %s\n", GetAreaName(HouseInfo[house][hEntrancex], HouseInfo[house][hEntrancey]));
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"Worth: "c_green"%d$\n", HouseInfo[house][hValue]);
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"Rent: "c_green"%d$ In Wallet\n\n", HouseInfo[house][hTakings]);
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"Total First Aid Kits: d PC.\n", HouseInfo[house][hHel]);
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"Rent paid: %d days / 30 days.\n", HouseInfo[house][hOplata]);
 	strcat(slobal_string, format_string);
  	format(format_string, sizeof(format_string), ""c_white"Status In: %s", HouseInfo[house][hLock] ? (""c_orange_red"House is closed") : (""c_green"House is open"));
 	strcat(slobal_string, format_string);
	if(HouseInfo[house][hSlet] != 0) strcat(slobal_string, "\n\n"c_grey"");
	else strcat(slobal_string, "\n\n"c_grey"");

	SPD(playerid, 15, DIALOG_STYLE_MSGBOX, !""c_server"House Information", slobal_string, !"Options", !"Close");
	return 1;
}

CMD:makecure(playerid, params[])
{
    new i = GetPlayerHouse(playerid);
	if(i == -1) return 1;
	if(GetPlayerVirtualWorld(playerid) != i) return SendClientMessage(playerid, -1, "To install the treatment point, you must be at your House.");
	if(HouseInfo[i][hUpdHel] == 0) return SendClientMessage(playerid, -1, "To install the treatment point, 'House Medkit' improvement is required.");

	if(HouseInfo[i][hAreaHeal] == 0) SPD(playerid, 35, DIALOG_STYLE_MSGBOX, !""c_server"Installing Medkit", ""c_white"Are you sure you want to start the installation of the treatment point?", "Yes", "No");
	else SPD(playerid, 35, DIALOG_STYLE_MSGBOX, !""c_server"Moving the first-aid kit", ""c_white"Are you sure you want to move the treatment point?", "Yes", "No");
	return 1;
}

CMD:buyfuelst(playerid, params[])
{
    new i = player_enter_fuel[playerid];
    if(i == 0) return SendClientMessage(playerid, -1, "You were at the gas station you wish to buy.");
    if(BizzAInfo[i][aOwned] != 0) return SCMF(playerid, -1, "This business is already occupied by Player %s", BizzAInfo[i][aOwner]);
    if(GetPlayerABizz(playerid) != 0)  return SCMF(playerid, -1, "You already have a business {FFF74D}%s[%d]"c_white", Use /sellfulest to sell.", BizzAInfo[GetPlayerABizz(playerid)][aMessage], GetPlayerABizz(playerid));

    format(String, 322, ""c_white"Name:\t\tGas station {EBBD00}'%s'\n"c_white"Profit:\t\t{0BB5BF}%d$\n"c_white"Rent fee:\t{0BB5BF}%d$", BizzAInfo[i][aMessage], BizzAInfo[i][aBuyPrice], BizzAInfo[i][aArenda]);
    SPD(playerid,64,DIALOG_STYLE_MSGBOX, !""c_server"Purchase of gas station", String, "Yes", "No");
    return 1;
}
CMD:buybiz(playerid, params[])
{
	for(new i; i < MAX_BIZZ; i++)
	{
        if(!PlayerToPoint(10.0, playerid, BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ])) continue;

		if(BizzInfo[i][bOwned] != 0) return SCMF(playerid, -1, "This business is already occupied by Player %s", BizzInfo[i][bOwner]);
		if(GetPlayerBizz(playerid) != -1)  return SCMF(playerid, -1, "You already have a business {FFF74D}%s[%d]"c_white", Use /sellbiz to sell.", BizzInfo[GetPlayerBizz(playerid)][bMessage], GetPlayerBizz(playerid));

	 	format(String,322, ""c_white"Purchase of business: {1A8FA9}%s\n\n{43CD80}Information:\n"c_white"The government can revoke the business if:\n\
			\n1. You have debts on rent\n\nIf all conditions are met, there will be no issues with the business.\n\nPrice of the business: %d$\n{EEEED1}Do you agree with these terms?", BizzInfo[i][bMessage], BizzInfo[i][bBuyPrice]);

		SPD(playerid,51,DIALOG_STYLE_MSGBOX, !""c_server"Terms of the deal",String, "Yes", "No");

		player_enter_biz[playerid] = i;

		return 1;
	}

	return SendClientMessage(playerid, COLOR_GREY, "RyaHouse has no businesses with you.");
}

