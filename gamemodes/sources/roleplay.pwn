CMD:clothes(playerid, params[])
{
    new i = player_use_bizbar[playerid];
    if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 6 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
		if(BizzInfo[i][bLocked] == 1) return SCMF(playerid, COLOR_GREY, "The clothing store %s is not available!\n", BizzInfo[i][bMessage]);
		SPD(playerid, 125, DIALOG_STYLE_MSGBOX, !""c_server"Fitting room\n", ""c_white"What do you want to try on?\n", "Clothing\n", "Changed my mind\n");
	}
	return 1;
}

CMD:next(playerid)
{
	if(GetPVarInt(playerid, "VibClothes") == 0) return 1;

	new sex = p_info[playerid][pSex];

    player_choose_skin[playerid]++;

	if(sex == 1 && player_choose_skin[playerid] >= sizeof SkinMan) player_choose_skin[playerid] = 0;
	if(sex == 2 && player_choose_skin[playerid] >= sizeof SkinMale) player_choose_skin[playerid] = 0;

	new choose_id = player_choose_skin[playerid];

	new s_id = sex == 1 ? SkinMan[choose_id] : SkinMale[choose_id];

	SetPlayerSkin(playerid, gSkins[s_id][skinID]);

	return 1;
}

CMD:back(playerid)
{
    if(GetPVarInt(playerid, "VibClothes") == 0) return 1;

    new sex = p_info[playerid][pSex];

    player_choose_skin[playerid]--;

	if(player_choose_skin[playerid] <= -1) player_choose_skin[playerid] = (sex == 1 ? sizeof SkinMan  : sizeof SkinMale) - 1;

	new choose_id = player_choose_skin[playerid];

	new s_id = sex == 1 ? SkinMan[choose_id] : SkinMale[choose_id];

	SetPlayerSkin(playerid, gSkins[s_id][skinID]);

	return 1;
}

CMD:robbery(playerid)
{
    if(p_info[playerid][pMember] != 7) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this.");

	if(player_fuel_steal[playerid] == 100) return SendClientMessage(playerid, COLOR_GREY, "You cannot carry more fuel.\n");

	if(steal_timer[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "You are already robbing the gas station.\n");

	for(new i; i < MAX_aBIZZ; i++)
	{
	    if(GetPlayerDistanceFromPoint(playerid, BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ]) > 3.5) continue;
	    if(BizzAInfo[i][aGangAttack] != p_info[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Your gang has not attacked this gas station.\n");
	    if(BizzAInfo[i][aGangAttackState] != 2) return SendClientMessage(playerid, COLOR_GREY, "The preparation time has not yet elapsed.");

	    steal_timer[playerid] = -1;

		PlayerStealFuelFromStation(playerid, i);

		SetPlayerAttachedObject(playerid, 3, 1650, 6, 0.1179, 0.0150, 0.0719, 0.0000, -102.2999, 0.0999, 1.0000, 1.0000, 1.0000);

		return SendClientMessage(playerid, COLOR_GREEN, "You started stealing gasoline from gas stations!");
	}

	return SendClientMessage(playerid, COLOR_GREY, "There are no gas stations near you.");
}

CMD:azspos(playerid)
{
	new member = p_info[playerid][pMember];

    if(member != 7) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this.");

	for(new i; i < MAX_aBIZZ; i++)
	{
	    if(member != BizzAInfo[i][aGangAttack]) continue;

	    SetPlayerCheckpoint(playerid, BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ], 3);
		PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);

     	SetPVarInt(playerid, "GPS", 1);

		return SCMF(playerid, COLOR_GREEN, "Gas station %s[%d] is marked on the map.", BizzAInfo[i][aMessage], i);
	}

	return SendClientMessage(playerid, COLOR_GREY, "Your gang has not attacked any gas station!");
}

CMD:azswar(playerid)
{
	new member = p_info[playerid][pMember];

	if(fraction_steal_block != 0) return SCMF(playerid, COLOR_GREY, "Available in %d seconds.", fraction_steal_block);

	if(member != 7) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this.");

	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1) return SendClientMessage(playerid,COLOR_GREY,"You are not a Leader/deputy Leader.");// return SCMF(playerid, COLOR_GREY, "Available for %d+ ranks.", FracInfo[member][fRankMax] - 2);

	new players = 0;

	foreach(Player, i) if(p_info[i][pMember] == member) players++;

	if(players < 5) return SendClientMessage(playerid, COLOR_GREY, "There are less than 5 people in the faction.");

	new try_id = 0;

	SEARCH_ABIZZ:

	new fuel_id = random(TotalABizz);

	try_id++;

	if(try_id == 1000) return SendClientMessage(playerid, COLOR_GREY, "Could not find a gas station.");

	if(BizzAInfo[fuel_id][aGangAttack] != 0) goto SEARCH_ABIZZ;

	format(format_string, 144, "The biker club attacked gas station #%s[%d]. Use: /azspos to mark.", BizzAInfo[fuel_id][aMessage], fuel_id);
	SendFrac(member, 0x42B66FFF, format_string);
    SendFrac(member, 0x42B66FFF, "You have "c_white"two{42B66F} minutes for preparation.");

	BizzAInfo[fuel_id][aGangAttack] = member;
	BizzAInfo[fuel_id][aGangAttackState] = 1;
	BizzAInfo[fuel_id][aGangAttackTime] = 120;
	fraction_steal_block = 7200;

	return SetTimerEx("CheckFuelAttack", 1000, false, "i", fuel_id);
}

function CheckFuelAttack(fuel_id)
{
	new gang_attack = BizzAInfo[fuel_id][aGangAttack];

	if(BizzAInfo[fuel_id][aGangAttackTime] != 0) BizzAInfo[fuel_id][aGangAttackTime]--;

	//format(format_string, 96, "%d %d %d %d", fuel_id, BizzAInfo[fuel_id][aGangAttackState], BizzAInfo[fuel_id][aGangAttack], BizzAInfo[fuel_id][aGangAttackTime]);
	//SendClientMessageToAll(-1, format_string);

	if(BizzAInfo[fuel_id][aGangAttackState] == 1)
	{
	    new string[48];
	    format(string, 48, "TIME: %d", BizzAInfo[fuel_id][aGangAttackTime]);
		foreach(Player, i) if(p_info[i][pMember] == gang_attack) GameTextForPlayer(i, string, 1500, 4);

		if(BizzAInfo[fuel_id][aGangAttackTime] == 0)
		{
		    new players = 0;

			foreach(Player, i) if(p_info[i][pMember] == gang_attack && GetPlayerDistanceFromPoint(i, BizzAInfo[fuel_id][aAreaFillX], BizzAInfo[fuel_id][aAreaFillY], BizzAInfo[fuel_id][aAreaFillZ]) < 60.0) players++;

			if(players < 1)
			{
			    BizzAInfo[fuel_id][aGangAttack] = 0;

				format(format_string, 144, "The attack on the gas station was stopped, no one arrived at its territory.");
			    return SendFrac(gang_attack, 0x42B66FFF, format_string);
			}

			BizzAInfo[fuel_id][aGangAttackState] = 2;
		}
	}
	else if(BizzAInfo[fuel_id][aGangAttackState] == 2)
	{
	    new players = 0;

		foreach(Player, i) if(p_info[i][pMember] == gang_attack && GetPlayerDistanceFromPoint(i, BizzAInfo[fuel_id][aAreaFillX], BizzAInfo[fuel_id][aAreaFillY], BizzAInfo[fuel_id][aAreaFillZ]) < 60.0) players++;

		if(players == 0)
		{
		    BizzAInfo[fuel_id][aGangAttack] = 0;

			format(format_string, 144, "All Eezay gangs have left the gas station, the attack is stopped.");
		    return SendFrac(gang_attack, 0x42B66FFF, format_string);
		}
	}

    return SetTimerEx("CheckFuelAttack", 1000, false, "i", fuel_id);
}

CMD:bizwar(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

    if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-2) return SendClientMessage(playerid, COLOR_GREY, "Your rank is low.");

    if(!strlen(params))
	{
		SendClientMessage(playerid, -1, "/bizwar [place(0-2]");
		SendClientMessage(playerid, COLOR_GREY, "0 - Abandoned village");
		SendClientMessage(playerid, COLOR_GREY, "1 - Ruins");
		SendClientMessage(playerid, COLOR_GREY, "2 - Port");
		return 1;
	}

	new place_id = strval(params);

	new attack_id = p_info[playerid][pMember];

	if(BW_INFO[bw_attack] != 0) return SendClientMessage(playerid, COLOR_GREY, "The war for business has already begun.");

	for(new i; i < MAX_BIZZ; i++)
	{
		if(!PlayerToPoint(15.0, playerid, BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ])) continue;

		new owner_id = BizzInfo[i][bMafia];

		if(owner_id == 0)
		{
		    BizzInfo[i][bMafia] = attack_id;

            SaveBizzPer(i, "bMafia", attack_id);

            update_business_text(i);

			return SendClientMessage(playerid, COLOR_BLUE, "The business had no roof, you took it under protection.");
		}

		if(owner_id == attack_id) return SendClientMessage(playerid, COLOR_GREY, "You are already protecting this business.");

		BW_INFO[bw_attack] = attack_id;
		BW_INFO[bw_owner] = owner_id;
		BW_INFO[bw_time] = 720;
		BW_INFO[bw_place] = place_id;
		BW_INFO[bw_bizz] = i;
		BW_INFO[bw_doubledraw] = 0;
		for(new x; x < 2; x++) BW_INFO[bw_kills][x] = 0;

		BW_INFO[bw_zone] = GangZoneCreate(bw_place_pos[place_id][0],bw_place_pos[place_id][1],bw_place_pos[place_id][2],bw_place_pos[place_id][3]);

        GangZoneShowForAll(BW_INFO[bw_zone], TEAM_HIT_COLOR);

        CreateBizWarTD();

        TextDrawSetString(BW_INFO[bw_td][3], FracInfo[owner_id][fName]);
        TextDrawSetString(BW_INFO[bw_td][4], FracInfo[attack_id][fName]);

		foreach(Player, x)
		{
			if(p_info[x][pMember] != attack_id && p_info[x][pMember] != owner_id) continue;

			for(new j; j < 7; j++) TextDrawShowForPlayer(x, BW_INFO[bw_td][j]);
		}

		SetTimer("checkBW", 1000, false);

        format(format_string, 96, "You attacked business %s[%d], belonging to %s.", BizzInfo[i][bMessage], i, FracInfo[owner_id][fName]);
		SendFrac(attack_id, 0x4682B4AA, format_string);

		format(format_string, 96, "[Attention]: Your business %s[%d] was attacked by the mafia %s.", BizzInfo[i][bMessage], i, FracInfo[attack_id][fName]);
		SendFrac(owner_id, 0x4682B4AA, format_string);

		format(format_string, 96, "%s provoked a war over the business.", GN(playerid));
		SendFrac(attack_id, 0x4682B4AA, format_string);
		SendFrac(owner_id, 0x4682B4AA, format_string);

		format_string = "[BIZWAR] A zone has been created on the map, head there.";
		SendFrac(attack_id, -1, format_string);
		return SendFrac(owner_id, -1, format_string);
	}

	return SendClientMessage(playerid, COLOR_GREY, "You are far from the entrance to any business.");
}

function checkBW()
{
    BW_INFO[bw_time]--;

    GangZoneFlashForAll(BW_INFO[bw_zone], COLOR_RED);

	new place_id = BW_INFO[bw_place];
	new b_id = BW_INFO[bw_bizz];

    new gang_owner = BW_INFO[bw_owner];
	new gang_attack = BW_INFO[bw_attack];

	new str[16];

	format(str, 16, "~n~%s", Convert(BW_INFO[bw_time]));
	TextDrawSetString(BW_INFO[bw_td][2], str);

    new members[2];

    foreach(Player, i)
    {
        if(!PlayerToKvadrat(i,bw_place_pos[place_id][0],bw_place_pos[place_id][1],bw_place_pos[place_id][2],bw_place_pos[place_id][3])) continue;

        if(p_info[i][pMember] == gang_owner) members[0]++;
        if(p_info[i][pMember] == gang_attack) members[1]++;
    }

	TextDrawSetString(BW_INFO[bw_td][5], IntToString(members[0]));
	TextDrawSetString(BW_INFO[bw_td][6], IntToString(members[1]));

	if(BW_INFO[bw_time] == 0)
	{
        if(members[0] > members[1]) StopBizWar(1);
        else if(members[0] < members[1]) StopBizWar(2);
        else StopBizWar(0);

	    return printf("The war for business %s[%d] has been stopped.", BizzInfo[b_id][bMessage], b_id);
	}

	return SetTimer("checkBW", 1000, false);
}

stock StopBizWar(winner)
{
    new b_id = BW_INFO[bw_bizz];

    new gang_owner = BW_INFO[bw_owner];
	new gang_attack = BW_INFO[bw_attack];

	if(winner == 1)
	{
	    format(format_string, 96, "Your mafia protected the business from mafia %s.", FracInfo[gang_attack][fName]);
		SendFrac(gang_owner, 0x4682B4AA, format_string);

		format(format_string, 96, "You could not take over the business of mafia %s.", FracInfo[gang_owner][fName]);
		SendFrac(gang_attack, 0x4682B4AA, format_string);
	}
	else if(winner == 2)
	{
	    format(format_string, 96, "Your mafia lost the business to mafia %s.", FracInfo[gang_attack][fName]);
		SendFrac(gang_owner, 0x4682B4AA, format_string);

		format(format_string, 96, "Your mafia captured the business from mafia %s.", FracInfo[gang_owner][fName]);
		SendFrac(gang_attack, 0x4682B4AA, format_string);

		BizzInfo[b_id][bMafia] = gang_attack;

        update_business_text(b_id);

        SaveBizzPer(b_id, "bMafia", gang_attack);
	}
	else
	{
	    if(BW_INFO[bw_doubledraw] == 0)
	    {
		    format_string = "You are given a prior time of 2 minutes for the war, at the moment the score is equal.";
			SendFrac(gang_owner, 0x4682B4AA, format_string);
			SendFrac(gang_attack, 0x4682B4AA, format_string);

			BW_INFO[bw_time] = 120;
			BW_INFO[bw_doubledraw] = 1;

			return SetTimer("checkBW", 1000, false);
		}
		else
		{
		    format_string = "The prior time has passed, the score remains equal, the territory stays with the defense.";
			SendFrac(gang_owner, 0x4682B4AA, format_string);
			SendFrac(gang_attack, 0x4682B4AA, format_string);
		}
	}

	foreach(Player, x)
	{
		if(p_info[x][pMember] != gang_owner && p_info[x][pMember] != gang_attack) continue;

		for(new j; j < 7; j++) TextDrawHideForPlayer(x, BW_INFO[bw_td][j]);
	}

	for(new j; j < 7; j++) TextDrawDestroy(BW_INFO[bw_td][j]);

	BW_INFO[bw_attack] = 0;

	GangZoneDestroy(BW_INFO[bw_zone]);

	return 1;
}

cmd:capture(playerid)
{
	if(!IsAGang(playerid)) return SendClientMessage(playerid, col_white, !""c_error"This command is not accessible to you.");
/*	if(FracInfo[p_info[playerid][pMember]][fFreeze] == 1) return SendClientMessage(playerid, col_white, !""c_error"Your gang is frozen, you can't start taking over territory.");
*/
	text_string[0] = EOS;
	if(capture_kd > 0)
	{
	    format(text_string, sizeof(text_string), ""c_error"The capture will begin in "c_orange"%d minutes"c_white".", capture_kd);
		SendClientMessage(playerid, col_white, text_string);
		return 1;
	}
	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax] - 2) return SendClientMessage(playerid, col_white, !""c_error"This command is not accessible to you.");

	new gang_attack = p_info[playerid][pMember];
	if(IsGangInWar(gang_attack)) return SendClientMessage(playerid, col_white, !""c_error"At the moment there is a seizure of territory.");

	for(new i; i < MAX_ZONES; i++)
	{
		if(!PlayerToKvadrat(playerid, GZInfo[i][gPos][0], GZInfo[i][gPos][1], GZInfo[i][gPos][2], GZInfo[i][gPos][3])) continue;
		if(i == 6 || i == 68 || i == 66 || i == 73 || i == 89) return SendClientMessage(playerid, col_white, !""c_error"It is forbidden to attack the main territory of the gang.");
	/*	if(FracInfo[GZInfo[i][gFraction]][fFreeze] == 1) return SendClientMessage(playerid, col_white, !""c_error"This gang cannot be attacked, it's frozen.");*/
		if(GZInfo[i][gAttack] != 0) return SendClientMessage(playerid, col_white, !""c_error"There is already a war for this territory.");

		new gang_owner = GZInfo[i][gFraction];
		if(gang_owner == gang_attack) return SendClientMessage(playerid, col_white, !""c_error"You cannot capture your territory.");

		if(gang_owner == 0)
		{
		    GZInfo[i][gFraction] = gang_attack;

		    GangZoneHideForAll(GZInfo[i][gID]);
			GangZoneShowForAll(GZInfo[i][gID], GetGangZoneColor(i));

		    return SendClientMessage(playerid, col_white, !""c_info"You successfully took the territory under their control.");
		}
		if(IsGangInWar(gang_owner)) return SendClientMessage(playerid, col_white, !""c_error"At the moment there is a seizure of territory.");

		if(GetFractionMemberAmount(gang_attack) < 1) return SendClientMessage(playerid, col_white, !""c_error"You cannot attack this gang; you are too small.");
		if(GetFractionMemberAmount(gang_owner) < 1) return SendClientMessage(playerid, col_white, !""c_error"You cannot attack this gang; there are too few of them.");

        GZInfo[i][gAttack] = gang_attack;
        GZInfo[i][gTime] = 420;
		GZInfo[i][gDoubleDraw] = 0;

		for(new x; x < 2; x++) GZInfo[i][gKills][x] = 0;

        CreateCaptureTD(i);

        TextDrawSetString(GZInfo[i][gTD][14], FracInfo[gang_owner][fName]);
        TextDrawSetString(GZInfo[i][gTD][15], FracInfo[gang_attack][fName]);

		new color_gang_owner;
		switch(GZInfo[i][gFraction])
		{
			case FRACTION_BALLAS: color_gang_owner = 0xCC00FFAA;
			case FRACTION_VAGOS: color_gang_owner = 0xFFCD00AA;
			case FRACTION_GROVE: color_gang_owner = 0x009900AA;
			case FRACTION_AZTEC: color_gang_owner = 0x00B4E1AA;
			case FRACTION_RIFA: color_gang_owner = 0x6666FFAA;
		}

		TextDrawColor(GZInfo[i][gTD][10], color_gang_owner);
		TextDrawColor(GZInfo[i][gTD][11], color_gang_owner);

		new color_gang_attack;
		switch(GZInfo[i][gAttack])
		{
			case FRACTION_BALLAS: color_gang_attack = 0xCC00FFAA;
			case FRACTION_VAGOS: color_gang_attack = 0xFFCD00AA;
			case FRACTION_GROVE: color_gang_attack = 0x009900AA;
			case FRACTION_AZTEC: color_gang_attack = 0x00B4E1AA;
			case FRACTION_RIFA: color_gang_attack = 0x6666FFAA;
		}

		TextDrawColor(GZInfo[i][gTD][12], color_gang_attack);
		TextDrawColor(GZInfo[i][gTD][13], color_gang_attack);

        foreach(Player, x)
		{
			if(p_info[x][pMember] != gang_owner && p_info[x][pMember] != gang_attack) continue;
			for(new j; j < 18; j++) TextDrawShowForPlayer(x, GZInfo[i][gTD][j]);
		}

		Iter_Add(capture_zone_list, i);
		SetTimerEx("CheckGZ", 1000, false, "i", i);

		text_string[0] = EOS;
		format(text_string, sizeof(text_string), "%s started to capture the territory of gang %s.", FracInfo[gang_attack][fName], FracInfo[gang_owner][fName]);
		SendGangMessage(col_orange_red, text_string);

		format(text_string, sizeof(text_string), "%s %s[%d] provoked a territory capture.", FracRank[p_info[playerid][pMember]][p_info[playerid][pRank]], Name(playerid), playerid);
		SendGangMessage(col_orange_red, text_string);

		format(text_string, sizeof(text_string), "[A] %s started to capture the territory of gang %s.", FracInfo[gang_attack][fName], FracInfo[gang_owner][fName]);
		send_admin_message(col_grey, text_string);

		capture_kd = 40;
		return 1;
	}
	return SendClientMessage(playerid, col_white, !""c_error"You are not in a territory that can be captured.");
}

function CheckGZ(g_id)
{
    GZInfo[g_id][gTime]--;
    GangZoneFlashForAll(GZInfo[g_id][gID], 0xFF0000AA);

	new str[26];
	format(str, sizeof(str), "CAPTURE_TIME: %s", Convert(GZInfo[g_id][gTime]));
	TextDrawSetString(GZInfo[g_id][gTD][5], str);

    TextDrawSetString(GZInfo[g_id][gTD][17], IntToString(GZInfo[g_id][gKills][0]));
	TextDrawSetString(GZInfo[g_id][gTD][16], IntToString(GZInfo[g_id][gKills][1]));

	if(GZInfo[g_id][gTime] == 0)
	{
        if(GZInfo[g_id][gKills][0] > GZInfo[g_id][gKills][1]) StopWarGZ(g_id, 1);
        else if(GZInfo[g_id][gKills][0] < GZInfo[g_id][gKills][1]) StopWarGZ(g_id, 2);
        else StopWarGZ(g_id, 0);

	    return printf("The war for territory %d has been stopped.", g_id);
	}
	return SetTimerEx("CheckGZ", 1000, false, "i", g_id);
}

stock StopWarGZ(g_id, winner)
{
    new gang_owner = GZInfo[g_id][gFraction];
	new gang_attack = GZInfo[g_id][gAttack];

	new winner_id = winner == 2 ? gang_attack : winner == 1 ? gang_owner : 0;
	if(winner == 1)
	{
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), "[G] %s defended their territory.", FracInfo[gang_owner][fName]);
		SendGangMessage(col_orange_red, text_string);
	}
	else if(winner == 2)
	{
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), "[G] %s captured the territory %s.", FracInfo[gang_attack][fName], FracInfo[gang_owner][fName]);
		SendGangMessage(col_orange_red, text_string);

		GZInfo[g_id][gFraction] = gang_attack;
	}
	else
	{
	    if(GZInfo[g_id][gDoubleDraw] == 0)
	    {
			SendGangMessage(col_orange_red, "[G] Given a preliminary time for capture, at the moment the score is equal.");

			GZInfo[g_id][gTime] = 120;
			GZInfo[g_id][gDoubleDraw] = 1;

			return SetTimerEx("CheckGZ", 1000, false, "i", g_id);
		}
		else
		{
			text_string[0] = EOS;
			format(text_string, sizeof(text_string), "[G] %s defended their territory, the preparation time has elapsed.", FracInfo[gang_owner][fName]);
			SendGangMessage(col_orange_red, text_string);
		}
	}

	foreach(Player, x)
	{
		if(p_info[x][pMember] != gang_owner && p_info[x][pMember] != gang_attack) continue;
		for(new j; j < 18; j++) TextDrawHideForPlayer(x, GZInfo[g_id][gTD][j]);
	}
	Iter_Remove(capture_zone_list, g_id);
	for(new j; j < 18; j++) TextDrawDestroy(GZInfo[g_id][gTD][j]);

	GZInfo[g_id][gAttack] = 0;
	GangZoneStopFlashForAll(GZInfo[g_id][gID]);

	GangZoneHideForAll(GZInfo[g_id][gID]);
	GangZoneShowForAll(GZInfo[g_id][gID], GetGangZoneColor(g_id));
	SaveGZ(g_id);

	foreach(Player, playerid)
	{
	    if(p_info[playerid][pMember] != winner_id) continue;

	    if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_CAPTURE && player_quest_info[playerid][quest_status] == 1)
        {
            player_quest_info[playerid][quest_progress]++;

            if(player_quest_info[playerid][quest_progress] >= 1)
            {
                player_quest_info[playerid][quest_status] = 2;

                OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 2);

                SetTimerEx("SendPlayerQuestInfoSMS", 15000, false, "ii", playerid, 2);
            }
            else SCMF(playerid, COLOR_YELLOW, "[QUEST] You have won battles: %d/2", player_quest_info[playerid][quest_progress]);
        }
	}

	return 1;
}

