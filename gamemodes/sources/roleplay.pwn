		new classname[10];
		switch(autosaloncar[carid][autoClass])
		{
			case 0: strcat(classname, "economy");
			case 1: strcat(classname, "average");
			case 2: strcat(classname, "high");
			case 3: strcat(classname, "moto");
		}
		SetPVarInt(playerid, "car_number", modelid);

		format_string[0] = EOS;
		format(format_string, sizeof(format_string), "\
		"c_white"Transport name: "c_server"%s"c_white" [%s class]\n\
		"c_white"Transportation price: "c_green"%d$\n\
		"c_white"Maximum speed: "c_orange"%d km/h\n\
		"c_white"Fuel tank capacity: "c_orange"%.0f liters\n\
		"c_white"Model ID: "c_server"%d", VehicleNames[modelid], classname, car_info[modelid][car_price], VehStats[modelid][vMaxSpeed], VehStats[modelid][vMaxFuel], modelid + 400);
		SPD(playerid, 1243, DIALOG_STYLE_MSGBOX, !""c_server"Information", format_string, !"Purchase", !"Cancel");
		return 1;
