}

cmd:fullgwh(playerid)
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;

	for(new i, z = sizeof(wh_pickup); i < z; i++)
	{
	    if(wh_ammo_gang[i] < 30000) wh_ammo_gang[i] = 30000;
	    if(wh_weapon_gang[i] < 30000) wh_weapon_gang[i] = 30000;

	    UpdateGangWH3DTextLabel(i);
	}
	for(new i = 1; i < 5; i++)
	{
	    FracInfo[i][fBank][0] = 200000;
	    FracInfo[i][fBank][1] = 200000;
	}
	for(new i = 14; i < 16; i++)
	{
	    FracInfo[i][fBank][0] = 200000;
	    FracInfo[i][fBank][1] = 200000;
	}
	for(new i = 18; i < 20; i++)
	{
	    FracInfo[i][fBank][0] = 200000;
	    FracInfo[i][fBank][1] = 200000;
	}
	return SendClientMessage(playerid, col_white, !""c_sucess"You successfully opened the Organization's warehouses.");
}
