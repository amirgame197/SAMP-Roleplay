					if(p_info[playerid][pProducts][0] == 1) return SendClientMessage(playerid, -1, "You already have a mobile phone."), ProductsMenu(playerid);

			        SendClientMessage(playerid, -1, "You bought a mobile phone, use {03D7FF}/call, /sms."), SetPlayerChatBubble(playerid, "bought a mobile phone.",COLOR_NEWS,15.0,10000);

					GiveBusinessMoney(h, cena, 10);

					GivePlayerMoneyEx(playerid, -cena, "Phone.");
