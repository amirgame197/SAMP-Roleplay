			BizzAInfo[abizz][aOwned] = 1, BizzAInfo[abizz][aLocked] = 0, BizzAInfo[abizz][aPrice] = 50, BizzAInfo[abizz][aMoney] = 0, BizzAInfo[abizz][aRaschet] = 0, BizzAInfo[abizz][aSklad] = 1000;
			BizzAInfo[abizz][aOplata] = 1, BizzAInfo[abizz][aProducts] = 500, BizzAInfo[abizz][aSlet] = 0;
