			        if(p_info[playerid][pCash] < BizzInfo[h][bPrice]*2) return SCMF(playerid, -1, "You do not have enough money to purchase a SIM card, you need %d$", BizzInfo[h][bPrice]*2);

					SPD(playerid, 62, DIALOG_STYLE_INPUT, !""c_server"SIM card", ""c_white"Enter the desired number for purchase:\n", "Choose", "Back");
				}*/
				case 2:
				{
				    new cena = BizzInfo[h][bPrice] * 6;
				    if(p_info[playerid][pProducts][1] != 0) return SendClientMessage(playerid, -1, "You already have a Phonebook, use /book");
				    if(p_info[playerid][pCash] < cena) return SCMF(playerid, -1, "You do not have enough money to purchase a Phonebook, you need %d$", cena);
				    GivePlayerMoneyEx(playerid, -cena, "Phonebook");

				    GiveBusinessMoney(h, cena, 4);

				    SetPlayerChatBubble(playerid, "Bought a phone book",COLOR_NEWS,15.0,10000);
				    SendClientMessage(playerid, -1, "You bought a phone book, Use {03D7FF}/book");
