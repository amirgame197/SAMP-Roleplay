cmd:egun(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, weapon_ida, weapon_idb, weapon_idc, weapon_ammoa, weapon_ammob, weapon_ammoc; else return SendClientMessage(playerid, col_grey, !"Use: /agun [Player id] [Gun 1] [Gun 2] [Gun 3] [Ammo 1] [Ammo 2] [Ammo 3]");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(!(1 <= weapon_ida <= 46)) return SendClientMessage(playerid, col_white, !""c_error"Weapon IDs should be between 1 and 46.");
	if(!(1 <= weapon_ammoa <= 1000)) return SendClientMessage(playerid, col_white, !""c_error"The number of bullets should be between 1 and 1000.");
    if(!(1 <= weapon_idb <= 46)) return SendClientMessage(playerid, col_white, !""c_error"Weapon IDs should be between 1 and 46.");
	if(!(1 <= weapon_ammob <= 1000)) return SendClientMessage(playerid, col_white, !""c_error"The number of bullets should be between 1 and 1000.");
	if(!(1 <= weapon_idc <= 46)) return SendClientMessage(playerid, col_white, !""c_error"Weapon IDs should be between 1 and 46.");
	if(!(1 <= weapon_ammoc <= 1000)) return SendClientMessage(playerid, col_white, !""c_error"The number of bullets should be between 1 and 1000.");

	p_info[targetid][pAmmo][10] = weapon_ammoa;
	p_info[targetid][pAmmo][11] = weapon_ammob;
	p_info[targetid][pAmmo][12] = weapon_ammoc;
	p_info[targetid][pGun][10] = weapon_ida;
	p_info[targetid][pGun][11] = weapon_idb;
	p_info[targetid][pGun][12] = weapon_idc;
	GivePlayerWeapon(targetid, weapon_ida, weapon_ammoa);
	GivePlayerWeapon(targetid, weapon_idb, weapon_ammob);
	GivePlayerWeapon(targetid, weapon_idc, weapon_ammoc);
	return 1;
}

