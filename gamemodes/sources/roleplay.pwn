stock PlayerPlaySoundEx(sound, Float:x, Float:y, Float:z)
{
	foreach(new i : Player)
	{
		PlayerPlaySound(i, sound, x, y, z);
	}
	return 1;
}
stock SetPlayerHealthEx(playerid, Float:hp)
{
	SetPlayerHealth(playerid, hp);
	return 1;
}
stock UpdatePlayerSatiety(playerid, Float: satiety)
{
	if(satiety > 100) satiety = 100;
	if(satiety < 0) satiety = 0;

    p_info[playerid][pSatiety] = satiety;
	return 1;
}
forward CarryDelay(playerid);
