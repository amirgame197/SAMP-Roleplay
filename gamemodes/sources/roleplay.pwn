CMD:car(playerid)
{
	if(CarInfo[playerid][cModel][0] == 0 && CarInfo[playerid][cModel][1] == 0 && CarInfo[playerid][cModel][2] == 0)
	    return SendClientMessage(playerid, COLOR_GREY, "You don't have any transport.");

    String = "";

	new str[96];

	new count = 0;

	for(new i; i < MAX_PLAYER_VEHICLES; i++)
	{
	    if(CarInfo[playerid][cModel][i] == 0) continue;

		format(str, 96, ""c_server"[%d]\t"c_white"%s\t%s\n",
			i+1,
			VehicleNames[CarInfo[playerid][cModel][i]-400],
			player_home_car[playerid][i] == INVALID_VEHICLE_ID ? ("Not Loaded") : ("Loaded"));

		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, i);
	}

	return SPD(playerid, 4710, DIALOG_STYLE_TABLIST, !""c_server"Slot selection", String, "Choose", "Back");
}

alias:lights("lg")
CMD:lights(playerid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "You are not in the driver's seat.");

    new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsVehicleHaveFuel(vehicleid))
	{
	    new engine, lights, alarm, doors, bonnet, boot, objective;
		GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
    	return SetVehicleParamsEx(vehicleid, engine, !lights, alarm, doors, bonnet, boot, objective);
	}

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

    if(lights == 1)
	{
	    SetPlayerChatBubble(playerid, "You turned on the headlights",COLOR_PURPLE,30.0,10000);
		return SetVehicleParamsEx(vehicleid,engine,0,alarm,doors,bonnet,boot,objective);
	}

	new Float: health;
    GetVehicleHealth(vehicleid, health);

	if(health <= 350.0) return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Rydy", ""c_white"????.", "Close", "");

    SetPlayerChatBubble(playerid, "Started the engine",COLOR_PURPLE,30.0,10000);

	return SetVehicleParamsEx(vehicleid,engine,1,alarm,doors,bonnet,boot,objective);
}

alias:engine("en")
CMD:engine(playerid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "You are not in the driver's seat.");

    new vehicleid = GetPlayerVehicleID(playerid);

    if(CloseEngine(vehicleid)) return 1; //????????? ??? ?????????

	if(!IsVehicleHaveFuel(vehicleid))
	{
	    new engine, lights, alarm, doors, bonnet, boot, objective;
		GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
    	return SetVehicleParamsEx(vehicleid, !engine, lights, alarm, doors, bonnet, boot, objective);
	}

	if(Fuell[vehicleid] < 1.0)
	{
	    if(!IsAnyFamilyVehicle(vehicleid)) return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Error", ""c_white"There is no fuel in the vehicle.", "Close", "");
	    Fuell[vehicleid] = 100.0;
	}

	if(IsAGang(playerid) && veh_info[vehicleid][vFr] == FRACTION_LSPD) return 1; //?????? ?? ??????? ??? Quest?

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

    if(engine == 1)
	{
	    SetPlayerChatBubble(playerid, "Turned off the engine",COLOR_PURPLE,30.0,10000);
		return SetVehicleParamsEx(vehicleid,0,lights,alarm,doors,bonnet,boot,objective);
	}

	new Float: health;
    GetVehicleHealth(vehicleid, health);

	if(health <= 350.0)
	{
	    if(!IsAnyFamilyVehicle(vehicleid)) return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"UveHouse statement", ""c_white"The car is in critical condition.", "Close", "");
	}

	if(vehicle_owner_id[vehicleid] != INVALID_PLAYER_ID)
	{
	    new owner_id = vehicle_owner_id[vehicleid];

	    for(new x; x < MAX_PLAYER_VEHICLES; x++)
			if(vehicleid == player_home_car[owner_id][x] && player_car_keys[owner_id][x] == 0)
				return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"UveHouse statement", ""c_white"There are no keys in the ignition, use: /key or /en.", "Close", "");
	}

    SetPlayerChatBubble(playerid, "Started the engine",COLOR_PURPLE,30.0,10000);

	return SetVehicleParamsEx(vehicleid,1,lights,alarm,doors,bonnet,boot,objective);
}

CMD:trashinfo(playerid)
{
	if(p_info[playerid][pJob] != 4) return SendClientMessage(playerid, COLOR_GREY, "You can't work on the garbage truck!");

	new str[64], count = 0;

	command_text = ""c_white"";

	for(new i; i < MAX_TRASH; i++)
	{
	    if(trash_info[i][t_amount] < 40) continue;

	    if(count == 25) break;

	    format(str, 64, "[%d] Condition: %d/100\n", i, trash_info[i][t_amount]);
	    strcat(command_text, str);

	    count++;
	}

	strcat(command_text, "\nEnter the garbage bin number:");

	return SPD(playerid, 227, DIALOG_STYLE_INPUT, !""c_server"Layout of garbage bins", command_text, "Choose", "Close");
}
CMD:fishing(playerid)// ?????? ????
{
	if(player_job[playerid] != 4) return SendClientMessage(playerid,0xB4B5B7FF,"Error: You are not a fisherman.");
	if(GetPVarInt(playerid,"Fishing") == 1) return SendClientMessage(playerid,0xB4B5B7FF,"Error: You are already fishing.");
	if(!IsARibaMest(playerid)) return SendClientMessage(playerid,0xB4B5B7FF,"Error: You are not at the LS dock or far from the bait.");
	SetPVarInt(playerid,"Fishing",1);
	TogglePlayerControllableEx(playerid, 0);
	SetPVarInt(playerid,"Anti-Sbiv",gettime()+10);
	SendClientMessage(playerid,0x27C400FF, "You cast the bait, wait...");
	GameTextForPlayer(playerid,"~g~Waiting", 15000, 3);
	ApplyAnimation( playerid, "DEALER", "DEALER_DEAL", 4.1, 1, 1, 1, 1, 1 ,1);
	return 1;
}

alias:licenses("license")
CMD:licenses(playerid, params[])
{
    extract params -> new to_player; else return SendClientMessage(playerid, -1, "/licenses(/lic) [Player id]");

	if(!IsPlayerConnected(to_player))
		return SendClientMessage(playerid, 0x999999FF, "There is no such Player");

	if(!ProxDetectorS(4.0, playerid, to_player)) return SendClientMessage(playerid, COLOR_GREY,"Player is too far away.");

	if(GetPVarInt(playerid,"pLicTime") > gettime()) return SendClientMessage(playerid, COLOR_GREY, "Please wait a moment.");
	new str[86];

	String = "";

	format(str, 86, "%s\t"c_white"Driver's license %s\n", (p_info[playerid][pLicenses][0]) ? ("{FA8072}Yes") : ("{FF4500}No"));
	strcat(String, str);

	format(str, 86, "%s\t"c_white"Pilot license %s\n", (p_info[playerid][pLicenses][1]) ? ("{FA8072}Yes") : ("{FF4500}No"));
    strcat(String, str);

	format(str, 86, "%s\t"c_white"Watercraft license %s\n",(p_info[playerid][pLicenses][2]) ? ("{FA8072}Yes") : ("{FF4500}No"));
    strcat(String, str);

	format(str, 86, "%s\t"c_white"Weapon license %s\n",(p_info[playerid][pLicenses][3]) ? ("{FA8072}Yes") : ("{FF4500}No"));
    strcat(String, str);
	format(format_string, 40, "Licenses %s", Name(playerid));
	SPD(to_player, 0000, 0, format_string, String, "Okay", "");

	me_action(playerid, "showed their licenses");

	SetPVarInt(playerid, "pLicTime", gettime() + 15);
	return 1;
}

cmd:skill(playerid, params[])
{
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /skill [Player id]");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(!ProxDetectorS(5.0, playerid, targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player is too far away.");
    if(GetPVarInt(playerid, "pSkillTime") > gettime()) return SendClientMessage(playerid, col_white, !""c_error"Please do not spam..");

	dlobal_string[0] = EOS;
	format(dlobal_string, sizeof(dlobal_string), "\
	"c_white"Silenced Pistol\t\t"c_server"%s "c_white"%d%%/100%%\n\
	"c_white"Desert Eagle\t\t"c_server"%s "c_white"%d%%/100%%\n\
	"c_white"Shotgun\t\t"c_server"%s "c_white"%d%%/100%%\n\
	"c_white"MP5\t\t\t"c_server"%s "c_white"%d%%/100%%\n\
	"c_white"AK-47\t\t\t"c_server"%s "c_white"%d%%/100%%\n\
	"c_white"M4\t\t\t"c_server"%s "c_white"%d%%/100%%\n",
 	ToDevelopSkills(p_info[playerid][pGunSkill][0], 100 - p_info[playerid][pGunSkill][0]), p_info[playerid][pGunSkill][0],
	ToDevelopSkills(p_info[playerid][pGunSkill][1], 100 - p_info[playerid][pGunSkill][1]), p_info[playerid][pGunSkill][1],
	ToDevelopSkills(p_info[playerid][pGunSkill][2], 100 - p_info[playerid][pGunSkill][2]), p_info[playerid][pGunSkill][2],
	ToDevelopSkills(p_info[playerid][pGunSkill][3], 100 - p_info[playerid][pGunSkill][3]), p_info[playerid][pGunSkill][3],
	ToDevelopSkills(p_info[playerid][pGunSkill][4], 100 - p_info[playerid][pGunSkill][4]), p_info[playerid][pGunSkill][4],
	ToDevelopSkills(p_info[playerid][pGunSkill][5], 100 - p_info[playerid][pGunSkill][5]), p_info[playerid][pGunSkill][5]);
	SPD(targetid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Sath Maharat Aslahe Ha", dlobal_string, !"Close", !"");

	if(targetid != playerid)
	{
	    new string[40 + (-2 + MAX_PLAYER_NAME)];
		if(p_info[playerid][pSex] == 1)
		{
			format(string, sizeof(string), "showed their weapon skills %s", Name(targetid));
			me_action(playerid, string);
		}
		else
		{
 			format(string, sizeof(string), "showed her weapon skills %s", Name(targetid));
			me_action(playerid, string);
		}
	}
	else me_action(playerid, "is reviewing their weapon skills");

    SetPVarInt(playerid, "pSkillTime", gettime() + 5);
    return 1;
}

CMD:pass(playerid, params[])//0x999999FF
{
	extract params -> new to_player; else return SendClientMessage(playerid, -1, "/pass [Player id]");

	if(!IsPlayerConnected(to_player))
		return SendClientMessage(playerid, 0x999999FF, "There is no such Player");

	if(!ProxDetectorS(4.0, playerid, to_player)) return SendClientMessage(playerid, COLOR_GREY,"Player is too far away.");

	if(GetPVarInt(playerid,"pPassTime") > gettime()) return SendClientMessage(playerid, COLOR_GREY, "Please wait a moment...");

	new atext[8];
	if(p_info[playerid][pSex] == 1) atext = "Male";
	else atext = "Female";

	new htext[10];
	if(GetPlayerHouse(playerid) != -1) format(htext, sizeof(htext), "House #%d", GetPlayerHouse(playerid));
	else if(p_info[playerid][pHotel] != -1) format(htext, sizeof(htext), "Hotel #%d", p_info[playerid][pHotel]);
	else htext = "Homeless";


	new fmt_str[128];
	me_action(playerid, "showed his passport");

	format(fmt_str, sizeof fmt_str, "Name: %s  |  Age: %d  |  Floor: %s |  Residence: %s", Name(playerid), p_info[playerid][pLevel], atext, htext);
	SendClientMessage(to_player, 0xFFFFFFFF, fmt_str);

	format(fmt_str, sizeof fmt_str, "Job: %s  |  Organization/Position: %s / %s", NamesJob(playerid), FracInfo[p_info[playerid][pMember]][fName], FracRank[p_info[playerid][pMember]][p_info[playerid][pRank]]);
	SendClientMessage(to_player, 0xFFFFFFFF, fmt_str);

	format(fmt_str, sizeof fmt_str, "Phone: %d  |  Wanted Level: %d  |  Obedience: %d", p_info[playerid][pNumber], p_info[playerid][pWanted], p_info[playerid][pZakon]);
	SendClientMessage(to_player, 0xFFFFFFFF, fmt_str);

    SetPVarInt(playerid, "pPassTime", gettime() + 15);
	return 1;
}
