		{
			if(p_info[playerid][pMember] < 1) return 1;

			if(!response)
			{
			    if(!form_fraction[playerid]) return SendClientMessage(playerid, COLOR_GREY,"You haven't worn the uniform...");
			    if(p_info[playerid][pMember] == 3 && p_info[playerid][pRank] < 4) return SendClientMessage(playerid, COLOR_GREY, "You cannot take off the military uniform. Available from rank 4.");

				SendClientMessage(playerid, 0x20A9FFFF, "The workday is over...");
				SetPlayerSkinEx(playerid, p_info[playerid][pSkin]);
				form_fraction[playerid] = 0;
				SetPlayerArmour(playerid, 0), SetPlayerToTeamColor(playerid);
				//return ResetWeapons(playerid);
			}
			else
			{
				if(form_fraction[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY,"You have already put on the work uniform...");
				SendClientMessage(playerid, 0x20A9FFFF, "The workday has begun...");
				SetPlayerSkinEx(playerid, p_info[playerid][pFrSkin]);
				form_fraction[playerid] = p_info[playerid][pMember];
				SetPlayerToTeamColor(playerid);

				if(p_info[playerid][pJob] != 0) OnPlayerUpdateAccountsPer(playerid, "pJob", 0);
				p_info[playerid][pJob] = 0;
				return 1;
			}
		}
