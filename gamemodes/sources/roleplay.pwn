			    	if(p_info[playerid][pHeals] == 2) return SendClientMessage(playerid, -1, "You cannot buy more than 2 first-aid kits.");


			    	SetPlayerChatBubble(playerid, "Bought first-aid kits",COLOR_NEWS,15.0,10000);
			    	p_info[playerid][pHeals] ++;
					SendClientMessage(playerid, -1, "You bought a first-aid kit, Use {03D7FF}/healme");
					GivePlayerMoneyEx(playerid, -cena, "first-aid kit");
