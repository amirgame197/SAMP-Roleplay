			Sound upon entry:\t\t%s\n\
			"c_white"Status:\t\t\t\t%s",
			i, BizzInfo[i][bMessage], BizzInfo[i][bOwner], GetTownName(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY]), GetAreaName(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY]), GetMafiaName(BizzInfo[i][bMafia]), BizzInfo[i][bArenda], BizzInfo[i][bBuyPrice], BizzInfo[i][bEntranceCost], BizzInfo[i][bProducts], BizzInfo[i][bSklad],
			BizzInfo[i][bPrice], BizzInfo[i][bMoney], BizzInfo[i][bRaschet], BizzInfo[i][bOplata], text2, text1);

			if(BizzInfo[i][bSlet] > 0) format(tempstring,sizeof(tempstring),"\n\n{FFE569}Your business is described and is subject to sale to the state."), strcat(String,tempstring);
			else strcat(String,"\n\n{99FF00}To open the control panel for your business,\npress the 'change' button.");
			SPD(playerid,53,DIALOG_STYLE_MSGBOX, !""c_server"Business information", String, "Edit", "Back");
		}
	}
	return 1;
}

stock IsVehicleOccupiedMode(vehicleid)
{
	foreach(new i : Player)
		if(IsPlayerInVehicle(i,vehicleid)) return i;
	return -1;
}
stock IsVehicleHaveFuel(carid)
{
	if(IsABicycle(carid)) return 1;

	switch(GetVehicleModel(carid)) { case 462, 481, 488, 460, 509, 510: return 0; }

	return 1;
}
stock NoPerfomance(carid)
{
    switch(GetVehicleModel(carid)) { case 448, 461..463, 468, 481, 509, 510, 521..523, 581, 587: return 1; }

	return 0;
}
stock CloseEngine(carid)// NO DVIG
{
    switch(GetVehicleModel(carid)) { case 481, 460, 509, 510: return 1; }

	return 0;
}
function CompVehDel(playerid)
{
	CarInfo[playerid][cWheels][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cSpoiler][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cBumper1][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cBumper2][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cPaintJobs][p_info[playerid][pUseCar]] = 255;
	CarInfo[playerid][cNitro][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cHydrawlic][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cHood][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cRoof][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cSideskirt][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cLamps][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cExhaust][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cStereo][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cVentRight][p_info[playerid][pUseCar]] = 0;
	CarInfo[playerid][cVentLeft][p_info[playerid][pUseCar]] = 0;
	return 1;
}
function CompVeh(playerid,vehicleid)
{
	ChangeVehiclePaintjob(vehicleid,CarInfo[playerid][cPaintJobs][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cBumper1][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cBumper2][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cSpoiler][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cNitro][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cWheels][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cHydrawlic][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cHood][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cRoof][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cSideskirt][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cLamps][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cExhaust][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cStereo][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cVentRight][p_info[playerid][pUseCar]]);
	AddVehicleComponent(vehicleid,CarInfo[playerid][cVentLeft][p_info[playerid][pUseCar]]);
	//

	SetVehicleNumberPlate(vehicleid, VehicleNumberPlate[playerid][p_info[playerid][pUseCar]]);

	return 1;
}
stock DellTune(playerid)
{
	new p_car = GetPlayerVehicleID(playerid);
    RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_FRONT_BUMPER));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_REAR_BUMPER));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_SPOILER));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_NITRO));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_WHEELS));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_HYDRAULICS));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_HOOD));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_ROOF));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_SIDESKIRT));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_LAMPS));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_EXHAUST));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_STEREO));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_VENT_RIGHT));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_VENT_LEFT));

	ChangeVehicleColor(p_car,CarInfo[playerid][cColor1][p_info[playerid][pUseCar]], CarInfo[playerid][cColor2][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cBumper1][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cBumper2][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cSpoiler][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cNitro][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cWheels][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cHydrawlic][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cHood][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cRoof][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cSideskirt][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cLamps][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cExhaust][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cStereo][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cVentRight][p_info[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cVentLeft][p_info[playerid][pUseCar]]);
	return 1;
}

