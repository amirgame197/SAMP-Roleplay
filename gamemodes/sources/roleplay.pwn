  extract params -> new player:targetid, string:ban_reason[64]; else return SendClientMessage(playerid, col_grey, "Use: /sik [Player id][Cause]");
  if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");



    if(admin_level[targetid] > admin_level[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You have been banned by Administrator for rule violation.");

    new days[6];

  p_info[playerid][pAdmBan]++;
  OnPlayerUpdateAdminPer(playerid, "pAdmBan", p_info[playerid][pAdmBan]);

  text_string[0] = EOS;
    format(text_string, sizeof(text_string), "Administrator %s banned player %s (Permanently l %s)", Name(playerid), Name(targetid),days,ban_reason);
  SendClientMessageToAll(col_orange_red, text_string);
  AddAdminLog(playerid, text_string);

    BlockAccounts(Name(targetid), ban_reason, Name(playerid), gettime() + (86400 ));

    text_string[0] = EOS;
    format(text_string, 144, "[A] Last. IP: %s | Reg. IP: %s", GetPlayerIpEx(targetid), p_info[targetid][pIpReg]);
    send_admin_message(col_grey, text_string);
  return 1;
}

cmd:setbanip(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	extract params -> new string:player_ip[32], banip_day, string:reason[64]; else return SendClientMessage(playerid,-1, "Enter: /banip [IP address] [days] [Cause]");
    if(!(1 <= banip_day <= 30)) return SendClientMessage(playerid, col_white, !""c_error"Blocking an IP address is allowed for 1 to 30 days.");

	text_string[0] = EOS;
    mysql_format(dbHandle, text_string, sizeof(text_string), "SELECT * FROM `banips` WHERE `ipadress`='%e' AND `lockstate`='1' LIMIT 0, 1", player_ip);
	mysql_tquery(dbHandle, text_string, "player_banip", "dssdd", playerid, player_ip, reason, false, banip_day);
	return 1;
}

cmd:unwarn(playerid, params[])
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /unwarn [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(p_info[targetid][pWarn] == 0) return SendClientMessage(playerid, col_white, !""c_error"This player does not have any active warnings.");

    new dateban[3][6], count = 0;

    slobal_string[0] = EOS;
    strcat(slobal_string, ""c_server"Yes, there are penalties\t"c_server"Nick Administrator\t"c_server"Cause\n");
    for(new i; i < p_info[targetid][pWarn]; i++)
	{
 		TimestampToDate(WarnInfo[targetid][i][wWarnDate], dateban[i][0], dateban[i][1], dateban[i][2], dateban[i][3], dateban[i][4], dateban[i][5], 3);

		text_string[0] = EOS;
		format(text_string, sizeof(text_string), "%02d-%02d-%02d %02d:%02d\t%s\t%s\n", dateban[i][0], dateban[i][1], dateban[i][2], dateban[i][3], dateban[i][4], WarnInfo[params[0]][i][wAdminWarn], WarnInfo[params[0]][i][wReasonWarn]);
		strcat(slobal_string, text_string);

		SetPlayerListitemValue(playerid, count++, WarnInfo[playerid][i][wID]);
 	}
    SPD(playerid, 193, DIALOG_STYLE_TABLIST, !""c_server"Warning Information", slobal_string, !"Choose", !"Back");

	SetPVarInt(playerid, "SavePlayer", targetid);
    return 1;
}

cmd:unmute(playerid, params[])
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /unmute [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(p_info[targetid][mute] == 0) return SendClientMessage(playerid, col_white, !""c_error"This player does not have a chat ban.");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Administrator %s unblocked this player's chat %s.", Name(playerid), Name(targetid));
	SendClientMessageToAll(col_orange_red, text_string);

	p_info[targetid][mute] = 0;
	return 1;
}

cmd:unajail(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /unjail [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(!p_info[targetid][pPrison]) return SendClientMessage(playerid, col_white, !""c_error"The player is not in jail.");

    p_info[targetid][pPrison] = p_info[targetid][pMestoPrison] = 0;
    SaveGun(playerid);
    SpawnPlayer(targetid);

	text_string[0] = EOS;
    format(text_string, sizeof(text_string), "Admin %s[%d] has released Player %s[%d] from Prison.", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);
	AddAdminLog(playerid, text_string);
	return 1;
}

cmd:slap(playerid, params[])
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /slap [Player ID]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

	new Float:slx, Float:sly, Float:slz;
	GetPlayerPos(targetid, slx, sly, slz);
	SetPlayerPos(targetid, slx, sly, slz + 5);
	PlayerPlaySound(targetid, 1190, 0.0, 0.0, 0.0);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] threw Player %s[%d] up.", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:plveh(playerid, params[])
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid, model_id; else return SendClientMessage(playerid, col_grey, !"Use: /plveh [Player ID] [400-611]");
    if(model_id < 400 || model_id > 611) return SendClientMessage(playerid, col_white, !""c_error"ID ranges from 400 to 611.");
	if(GetPlayerState(targetid) != 1) return SendClientMessage(playerid, col_white, !""c_error"This player has a vehicle.");

	new Float:pl_posX, Float:pl_posY, Float:pl_posZ, Float:pl_posA;
	GetPlayerPos(targetid, pl_posX, pl_posY, pl_posZ);
	GetPlayerFacingAngle(targetid, pl_posA);

	if(p_t_info[targetid][plveh] != -1) DestroyVehicle(p_t_info[targetid][plveh]);

	p_t_info[targetid][plveh] = AddStaticVehicle(model_id, pl_posX, pl_posY, pl_posZ, pl_posA, random(100), random(100));
	veh_info[p_t_info[targetid][plveh]][vSost] = 100;
	veh_info[p_t_info[targetid][plveh]][vStatus] = 2;
	Fuell[p_t_info[targetid][plveh]] = MAX_VEHICLE_FUEL;

	SetVehicleVirtualWorld(p_t_info[targetid][plveh], GetPlayerVirtualWorld(targetid));
	LinkVehicleToInterior(p_t_info[targetid][plveh], GetPlayerInterior(targetid));
	PutPlayerInVehicle(targetid, p_t_info[targetid][plveh], 0);

	new lights, alarm, doors, bonnet, boot, objective;
	SetVehicleParamsEx(p_t_info[targetid][plveh], true, lights, alarm, doors, bonnet, boot, objective);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Admin %s[%d] has granted Player %s[%d] ID %d vehicle permissions.", Name(playerid), playerid, Name(targetid), targetid, p_t_info[targetid][plveh]);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:veh(playerid, params[])
{
   	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	extract params -> new vehicle_id, color_1, color_2; else return SendClientMessage(playerid, col_grey, !"Use: /veh [ID] [Color 1] [Color 2]");
	if(vehicle_id < 400 || vehicle_id > 611) return SendClientMessage(playerid, col_white, !""c_error"ID ranges from 400 to 611.");
	if(color_1 < 0 || color_1 > 255) return SendClientMessage(playerid, col_white, !""c_error"Color must be between 0 and 255.");
	if(color_2 < 0 || color_2 > 255) return SendClientMessage(playerid, col_white, !""c_error"Color must be between 0 and 255.");
	if(GetPlayerState(playerid) != 1) return SendClientMessage(playerid, col_white, !""c_error"You are in the vehicle already");

	new Float:pl_posX, Float:pl_posY, Float:pl_posZ;
	GetPlayerPos(playerid, pl_posX, pl_posY, pl_posZ);

	new adm_id = AddStaticVehicle(vehicle_id, pl_posX, pl_posY, pl_posZ, 0.0, color_1, color_2);
	veh_info[adm_id][vSost] = 100;
	veh_info[adm_id][vStatus] = 2;
	Fuell[adm_id] = MAX_VEHICLE_FUEL;

	PutPlayerInVehicle(playerid, adm_id, 0);

	new lights, alarm, bonnet, boot, objective;
	SetVehicleParamsEx(adm_id, true, lights, alarm, false, bonnet, boot, objective);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] Created Vehicle %s (%d) | ID: %d", Name(playerid), playerid, VehicleNames[vehicle_id - 400], vehicle_id, adm_id);
	send_admin_message(col_grey, text_string);

	VehicleCreate[adm_id] = true;
	return 1;
}

cmd:delveh(playerid,params[])
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, col_white, !""c_error"You are not in the vehicle.");

	new vehicleid = GetPlayerVehicleID(playerid);
    if(VehicleCreate[vehicleid] != true) return SendClientMessage(playerid, col_white, !""c_error"You need to be in the created vehicle.");
    DestroyVehicle(vehicleid);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] Deleted Vehicle | ID: %d", Name(playerid), playerid, vehicleid);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:delvehall(playerid)
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;

    new count = 0;
    for(new i; i < MAX_VEHICLES; i++)
    {
		if(!IsValidVehicle(i)) continue;
        if(!VehicleCreate[i]) continue;

		count++;
		DestroyVehicle(i);
    }
  	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] Deleted The All Vehcle (%d PC.)", Name(playerid), playerid, count);
	send_admin_message(col_grey, text_string);
	return 1;
}

