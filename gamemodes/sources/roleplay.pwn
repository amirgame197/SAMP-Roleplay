        			if(BizzAInfo[abizz][aSklad] >= 5000) {  updabizz[1] = "{22ff00}Purchased."; } else {  updabizz[1] = "{ff001c}50000$"; }
        			if(BizzAInfo[abizz][aSklad] == 10000) {  updabizz[2] = "{22ff00}Purchased."; } else {  updabizz[2] = "{ff001c}120000$."; }

                    format
