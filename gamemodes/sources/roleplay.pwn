cmd:aexit(playerid)
{
    if(!admin_level[playerid]) return 1;
    if(admin_logged[playerid] != 1) return SendClientMessage(playerid, col_white, !""c_error"You are not authorized in the Administrator panel.");

	Iter_Remove(admin_list, playerid);
	admin_logged[playerid] = 0;

    for(new x; x < 2; x++)
	{
		for(new i; i < 10; i++) TextDrawHideForPlayer(playerid, cheat_td[x][i]);
	}

	text_string[0] = EOS;
	format(format_string, 128, "[A] Administrator %s[%d] has exited from the Administrator panel.", Name(playerid), playerid);
	send_admin_message(col_grey, format_string);
	SetTagName(playerid);
	return 1;
}

