	        return SendClientMessage(playerid, COLOR_GREY, "Painting is unavailable for the next hour.");

	    if(p_info[playerid][pMember] == graffiti_fraction[index])
	        return SendClientMessage(playerid, COLOR_GREY, "Your gang already owns this graffiti.");

	    PlayerTextDrawTextSize(playerid, graffiti_player_td[playerid], 273.6195, 0.0000);

     	graffiti_player_id[playerid] = index;

	    graffiti_player_progress[playerid] = 0;
