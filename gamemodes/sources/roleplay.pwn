stock TuneMessage(playerid, str[])
{
	new string[2000];
	format(string, sizeof string, "{7FFF00}>> {AFAFAF}%s", str);
	SendClientMessage(playerid, -1, string);
	return 1;
}
/*--------------------------------------------------------------------*/
CMD:tune(playerid)
{
	if(InTunning[playerid]) return TuneMessage(playerid, "You are in tuning.");
	if(IsPlayerInRangeOfPoint(playerid, 10.0, 2187.4809, -1806.0251, 13.4106))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new use_car = GetPlayerUseHomeCar(playerid);
			if(use_car == -1) return SendClientMessage(playerid, col_white, !""c_error"You do not have a personal vehicle!");
			new vehicleid = GetPlayerVehicleID(playerid);
			if(IsABicycle(vehicleid) || IsAPlane(vehicleid) || IsABike(vehicleid)) return TuneMessage(playerid, "Only car models are allowed for tuning.");

			SetupTune(playerid, vehicleid);
			ShowTuneDialog(playerid);
			InTunning[playerid] = true;
		}
		else return TuneMessage(playerid, "You are not driving a car.");
	}
	else return TuneMessage(playerid, "You are not in this place.");
	return 1;
}
/*--------------------------------------------------------------------*/
stock AllowPaintJob(carid)
{
    switch(GetVehicleModel(carid))
	{
		case 562,565,559,561,560,575,534,567,536,535,576,558: return 1;
	}
	return 0;
}
