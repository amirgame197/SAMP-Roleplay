stock SetVehicleSpeed(vehicleid, Float:speed)
{
	if(speed <= 0) return 1;
    new Float:cr[3];
    GetVehicleVelocity(vehicleid, cr[0], cr[1], cr[2]);
    new Float:test = floatsqroot(floatadd(floatadd(floatpower(cr[0], 2), floatpower(cr[1], 2)),  floatpower(cr[2], 2))) * 100.0;
    new Float:dif =  speed / test;
    if(dif != 0 && test != 0) SetVehicleVelocity(vehicleid,cr[0]*dif,cr[1]*dif,cr[2]);// && GetPlayerPing(playerid) < 200
    return 1;
}

stock IsVehicleBackwordsDirection(vehicleid)
{
	new
		Float:x,
		Float:y,
		Float:z;

	if (GetVehicleVelocity(vehicleid, x, y, z))
	{
		new Float:z_angle;

		GetVehicleZAngle(vehicleid, z_angle);

		if (z_angle < 90.0) {
			if (x > 0.0 && y < 0.0)
				return 1;
		} else if (z_angle < 180.0) {
			if (x > 0.0 && y > 0.0)
				return 1;
		} else if (z_angle < 270.0) {
			if (x < 0.0 && y > 0.0)
				return 1;
		} else {
			if (x < 0.0 && y < 0.0)
				return 1;
		}
	}
	return 0;
}

stock GetVehicleSpeed(vehicleid)
{
	new Float:ST[4];
	GetVehicleVelocity(vehicleid,ST[0],ST[1],ST[2]);

	ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 100.0;
	return floatround(ST[3]);
}

stock SpeedVehicle(playerid)
{
	new Float:ST[4];
	if(IsPlayerInAnyVehicle(playerid)) GetVehicleVelocity(GetPlayerVehicleID(playerid),ST[0],ST[1],ST[2]);
	else GetPlayerVelocity(playerid,ST[0],ST[1],ST[2]);

	ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 100.0;
	return floatround(ST[3]);
}

stock MySQLConnect()
{
    new MySQLOpt: option_id = mysql_init_options();
	mysql_set_option(option_id, AUTO_RECONNECT, true);
	dbHandle = mysql_connect("127.0.0.1", "root", "", DB_NAME, option_id);

    LoadVehicles();

	mysql_set_charset(DB_NAME);

    LoadBizz();

	mysql_tquery(dbHandle, !"SELECT * FROM `taxi_bizz`", "Load Taxi Business", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `fraction` ORDER BY `fID` ASC", "Load Fractions", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `bizz_fuel`", "Load a Business", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `enters`", "LoadEnters", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `actors`", "LoadActors", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `atms`", "LoadAtms", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `others`", "LoadOthers", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `gangzone`", "LoadGangZones", "");
    mysql_tquery(dbHandle, !"SELECT * FROM `graffiti`", "LoadGraffiti", "");
    mysql_tquery(dbHandle, !"SELECT * FROM `elecations`", "LoadElecations", "");
    mysql_tquery(dbHandle, !"SELECT * FROM `fraction_wh`", "LoadFractionWH", "");
    mysql_tquery(dbHandle, !"SELECT * FROM `house`", "LoadHouse", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `hotels`", "LoadHotels", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `car_settings`", "load_car_settings", "");
	mysql_tquery(dbHandle, !"SELECT * FROM `family` ORDER BY `family`.`fam_id` ASC", "load_family");
	mysql_tquery(dbHandle, !"SELECT * FROM `anticheat_settings`", "load_anticheat");

    mysql_tquery(dbHandle, "UPDATE `accounts` SET `pLogin` = 0");

	for(new x; x < MAX_HOSPITALS; x++)
	{
	    for(new i; i < MAX_HOSPITAL_BEDS; i++)
		{
		    text_string[0] = EOS;
			format(text_string, sizeof(text_string), "Bed #%d\nStatus: "c_server"free\n"c_white"Use: "c_server"ALT", i + 1);
			Koika[x][i] = CreateDynamic3DTextLabel(text_string, col_white, LoadKoika[i][0], LoadKoika[i][1], LoadKoika[i][2] - 1.0, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, hospital_worlds[x], 8);
		}
	}
	printf("[MySQL R41-3]: HOSPITALS LOADED!: %d", MAX_HOSPITALS);

 	new hour, minute, second;
    gettime(hour, minute, second);
	SetWorldTime(hour);

	if(minute == 0 && second >= 11 && second <= 16) pay_day = 0;
   	if(minute == 0 && second >= 0 && second <= 10) pay_day = 1;

	SetTimer("second_timer", 1000, 1);
	SetTimer("minute_timer", 60000, 1);
	return 1;
}

function OnPlayerCheckBanIP(playerid, ipadress[])
{
	new rows;
 	cache_get_row_count(rows);
    if(rows)
    {
   		new lockstate_ip;
        cache_get_value_name_int(0, "lockstate", lockstate_ip);

        if(lockstate_ip == 1)
        {
	  		new banipadress[MAX_IP_ADRESS], banipreason[64], banipadmin[MAX_PLAYER_NAME];

	        cache_get_value_name(0, "ipadress", banipadress,MAX_IP_ADRESS);
	        cache_get_value_name(0, "reason", banipreason,64);
	        cache_get_value_name(0, "admin", banipadmin,MAX_PLAYER_NAME);

	        new banipdate, banipunbandate;
			cache_get_value_name_int(0, "date", banipdate);
	        cache_get_value_name_int(0, "unbandate", banipunbandate);

	        if(gettime() >= banipunbandate)
	        {
	            mysql_format(dbHandle, MySQLStr, 144, "DELETE FROM `banips` WHERE `ipadress` = '%e' AND `lockstate` = '1'", ipadress), mysql_tquery(dbHandle, MySQLStr, "", "");

				CheckPlayerAccount(playerid);
	        }
	        else
	        {

		        SCMF(playerid,COLOR_RED,"Attention! Your IP address: [%s] has been blocked!", banipadress);

				new dateban[6];
				TimestampToDate(banipdate,dateban[0],dateban[1],dateban[2],dateban[3],dateban[4],dateban[5], 3);

				new dateunban[6];
				TimestampToDate(banipunbandate,dateunban[0],dateunban[1],dateunban[2],dateunban[3],dateunban[4],dateunban[5], 3);

				format(String,sizeof(String), ""c_white"Cause: %s.\nBlocked by Administrator: %s.\nDate of blocking: %02d/%02d/%02d %02d:%02d:%02d.\nDate of unblocking: %02d/%02d/%02d %02d:%02d:%02d.", banipreason, banipadmin, dateban[0],dateban[1],dateban[2],dateban[3],dateban[4],dateban[5], dateunban[0],dateunban[1],dateunban[2],dateunban[3],dateunban[4],dateunban[5]);
				SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Your IP address is blocked!",String, "Back", "");
				Kick(playerid);
			}
		}
		else
		{
			CheckPlayerAccount(playerid);

			//if(mysql_errno()) return MysqlErrorMessage(playerid);
		}
    }
    else
    {
   		CheckPlayerAccount(playerid);

		//if(mysql_errno()) return MysqlErrorMessage(playerid);
    }
	return 1;
}

function LoadMyWarns(playerid)
{
    new rows;
	cache_get_row_count(rows);

	if(!rows) return p_info[playerid][pWarn] = 0; // no warns

	p_info[playerid][pWarn] = rows;

	for(new i; i < rows; i++)
	{
	    cache_get_value_name_int(i, "wID", WarnInfo[playerid][i][wID]);
 		cache_get_value_name(i, "wReasonWarn", WarnInfo[playerid][i][wReasonWarn], 32);
 		cache_get_value_name(i, "wAdminWarn", WarnInfo[playerid][i][wAdminWarn], 32);
 		cache_get_value_name_int(i, "wWarnDate", WarnInfo[playerid][i][wWarnDate]);
 		cache_get_value_name_int(i, "wUnWarnDate", WarnInfo[playerid][i][wUnWarnDate]);

 		if(gettime() >= WarnInfo[playerid][i][wUnWarnDate])
		{
 			p_info[playerid][pWarn]--;
  			format(MySQLStr, 96, "DELETE FROM `warninfo` WHERE `plID` = %d AND `wID` = %d", p_info[playerid][pID], WarnInfo[playerid][i][wID]), mysql_tquery(dbHandle, MySQLStr, "", "");
			mysql_tquery(dbHandle, MySQLStr, "", "");
			SCMF(playerid, -1, "Warning #%d has been removed from your account!", i+1);
		}
	}
	return 1;
}

function OnPlayerCheckBanAcc(playerid)
{
 	new rows;
 	cache_get_row_count(rows);
    if(rows)
    {
   		new lockstate;
        cache_get_value_name_int(0, "lockstate", lockstate);

        if(lockstate == 1)
        {
            new nameplayer[MAX_PLAYER_NAME], nameadmin[MAX_PLAYER_NAME], reason[64];

            new data, unbandate;

            cache_get_value_name(0, "nameplayer", nameplayer,MAX_PLAYER_NAME);
	        cache_get_value_name(0, "nameadmin", nameadmin,MAX_PLAYER_NAME);
	        cache_get_value_name(0, "reason", reason,64);

	        cache_get_value_name_int(0, "date", data);
	        cache_get_value_name_int(0, "unbandate", unbandate);

	        if(gettime() >= unbandate)
	        {
	            format(MySQLStr, 144, "DELETE FROM `banlog` WHERE `nameplayer` = '%s'", nameplayer);
				mysql_tquery(dbHandle, MySQLStr);
			}
			else
			{
			    text_string[0] = EOS;
				format(text_string, sizeof(text_string), "Attention! Your account: [%s] is blocked!", Name(playerid));
				new dateban[6];
				TimestampToDate(data,dateban[0],dateban[1],dateban[2],dateban[3],dateban[4],dateban[5], 3);

				new dateunban[6];
				TimestampToDate(unbandate,dateunban[0],dateunban[1],dateunban[2],dateunban[3],dateunban[4],dateunban[5], 3);

				format(String,sizeof(String),
					""c_white"Cause: %s.\nBlocked Administrator: %s.\n\
					blocking_date: %02d/%02d/%02d %02d:%02d:%02d.\n\
				 	unlock_date: %02d/%02d/%02d %02d:%02d:%02d.",
					reason, nameadmin,
					dateban[0],dateban[1],dateban[2],dateban[3],dateban[4],dateban[5],
					dateunban[0],dateunban[1],dateunban[2],dateunban[3],dateunban[4],dateunban[5]
				);

				SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Your account is blocked!",String, "Back", "");
				KickWithMessage(playerid, COLOR_RED, text_string);
			}
		}
	}
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "SELECT * FROM `accounts` WHERE `pID`='%d' LIMIT 1", p_info[playerid][pID]);
	mysql_tquery(dbHandle, text_string, "load_user", "d", playerid);
	return 1;
}

function player_banip(playerid, ipadress[], reason[], bool:iplocktype, days)
{
    new rows;
    cache_get_row_count(rows);
    if(rows) return SendClientMessage(playerid, -1, !""c_error"The IP address is already blocked.");

    switch(iplocktype)
	{
	    case 0:
	    {
	        text_string[0] = EOS;
		   	format(text_string, sizeof(text_string), "[A] %s[%d] has blocked IP address %s for %d days. Cause: %s", Name(playerid), playerid, ipadress, days, reason);
			send_admin_message(col_grey, text_string);
			AddAdminLog(playerid, text_string);

			player_block_banip(ipadress, reason, Name(playerid), gettime() + (86400 * days));
	    }
	    default:
	    {
	        text_string[0] = EOS;
	        format(text_string, sizeof(text_string), "[A] %s[%d] has permanently blocked IP address %s. Cause: %s", Name(playerid), playerid, ipadress, reason);
			send_admin_message(col_grey, text_string);
			AddAdminLog(playerid, text_string);

			player_block_banip(ipadress, reason, Name(playerid), 2147483647);
	    }
   	}
	return 1;
}

function player_block_banip(ipadress[], reason[], admin[], unbandate)
{
	slobal_string[0] = EOS;
	mysql_format(dbHandle, slobal_string, 350, "INSERT INTO `banips` (`ipadress`,`reason`,`admin`,`date`,`unbandate`,`lockstate`) VALUES ('%e','%e','%e','%d','%d','1')", ipadress, reason, admin, gettime(), unbandate);
	mysql_query(dbHandle, slobal_string);

	foreach(new i: Player)
	{
		if(!strcmp(GetPlayerIpEx(i), ipadress))
		{
		    SendClientMessage(i, col_white, !""c_error"Your IP address has been blocked, please re-enter to obtain information.");
			Kick(i);
		}
	}
	return 1;
}

function BlockAccounts(name[], reason[], admin[], unbandate)
{
	mysql_format(dbHandle, MySQLStr, 412, "INSERT INTO `banlog` (`nameplayer`, `reason`, `nameadmin`, `date`, `unbandate`, `lockstate`) VALUES ('%e', '%e', '%e', '%d', '%d', '1')", name, reason, admin, gettime(), unbandate);
	mysql_tquery(dbHandle, MySQLStr, "", "");

	foreach(new i: Player) if(!strcmp(name, Name(i))) Kick(i);
	return 1;
}

function player_check_unbanip(playerid, ipadress[])
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendClientMessage(playerid, col_white, !""c_error"The IP address is not blocked.");

	text_string[0] = EOS;
    mysql_format(dbHandle, text_string, sizeof(text_string), "DELETE FROM `banips` WHERE `ipadress`='%e' AND `lockstate`='1'", ipadress);
	mysql_query(dbHandle, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] unblocked the IP address %s.", Name(playerid), playerid, ipadress);
	send_admin_message(col_grey, text_string);
    AddAdminLog(playerid, text_string);
	return 1;
}

function player_check_unban(playerid, name[])
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendClientMessage(playerid, col_white, !""c_error"The Nick you specified does not exist or the account is not blocked.");

	text_string[0] = EOS;
    mysql_format(dbHandle, text_string, sizeof(text_string), "DELETE FROM `banlog` WHERE `nameplayer`='%e' AND `lockstate`='1'", name);
	mysql_query(dbHandle, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] unblocked the account %s.", Name(playerid), playerid, name);
	send_admin_message(col_grey, text_string);
    AddAdminLog(playerid, text_string);
	return 1;
}

function OnPlayerDataLoaded(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    cache_get_value_name(0, "pPassword", p_info[playerid][pPassword], 64);
     	cache_get_value_name(0, "pass_salt", p_info[playerid][pass_salt], 6);
	    cache_get_value_name_int(0, "pID", p_info[playerid][pID]);

	    SetPVarInt(playerid, "LoginOgran", 60);
	    dialog_authorization(playerid);

	    SetPlayerVirtualWorld(playerid, playerid + 1);
	}
	else
	{
	    SetPVarInt(playerid, "LoginOgran", 120);
	   	dialog_registration(playerid);

	   	SetPlayerVirtualWorld(playerid, playerid + 1);
	}
SetPlayerCameraPos(playerid,1023.000,-1116.000,70.000);
    SetPlayerCameraLookAt(playerid,1032.000,-1121.000,68.000);
	return 1;
}

stock dialog_registration(playerid)
{
    SPD(playerid, 2, DIALOG_STYLE_INPUT, !""c_server"Register", !""c_white"Welcome to "c_server""SERVERNAME""c_white".\nPlease enter your password.\n:\n\n"c_grey"� Your password must be between 6 and 16 characters.\n� Please do not share this password with anyone.\n� Do not forget your password.", !"Okay", !"Cancel");
	return 1;
}

stock dialog_referal(playerid)
{
	SPD(playerid, 4, DIALOG_STYLE_INPUT, !""c_server"Important", !"\
	"c_white"Do you have a code?!\n\
	"c_white"If you have it, enter it and get VIP."c_server""SERVER_CHANNEL""c_white".", !"Yes", !"No");
	return 1;
}

stock dialog_authorization(playerid)
{
	format_string[0] = EOS;
    format(format_string, sizeof(format_string), ""c_white"Welcome to "c_server""SERVERNAME""c_white".\n\n"c_white"Player "c_server"%s"c_white"You have successfully connected.\n"c_white"Enter your password:", Name(playerid));
	SPD(playerid, 1, DIALOG_STYLE_INPUT, !""c_server"Login", format_string, !"OK", !"Cancel");
	return 1;
}

