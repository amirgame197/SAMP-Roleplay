stock CheckHospitalHealth(playerid)
{
	if(GetPVarInt(playerid, "p_dead") == 1)
	{
		new Float:hp;
		GetPlayerHealth(playerid, hp);
		if(hp < 80) return SendClientMessage(playerid, col_white, !""c_error"You cannot leave the hospital in this condition.");

		if(player_lecenie[playerid] != -1) PlayerLeaveHospitalBed(playerid);
		DeletePVar(playerid, !"p_dead");
	}
	return 0;
}

