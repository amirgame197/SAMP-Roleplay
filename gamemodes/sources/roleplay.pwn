/*--------------------------------------------------------------------*/
forward SetWheels(playerid, Opt);
public SetWheels(playerid, Opt)
{
	if(GetPlayerMoney(playerid) >= 900)
	{
		GivePlayerMoneyEx(playerid, -900, "Tuning");
		new vehicleid = GetPlayerVehicleID(playerid);
		new use_car = GetPlayerUseHomeCar(playerid);
		switch(Opt)
		{
			case 0: AddVehicleComponent(vehicleid, 1025), CarInfo[playerid][cWheels][use_car] = 1025;
			case 1: AddVehicleComponent(vehicleid, 1074), CarInfo[playerid][cWheels][use_car] = 1074;
			case 2: AddVehicleComponent(vehicleid, 1076), CarInfo[playerid][cWheels][use_car] = 1076;
			case 3: AddVehicleComponent(vehicleid, 1078), CarInfo[playerid][cWheels][use_car] = 1078;
			case 4: AddVehicleComponent(vehicleid, 1081), CarInfo[playerid][cWheels][use_car] = 1081;
			case 5: AddVehicleComponent(vehicleid, 1082), CarInfo[playerid][cWheels][use_car] = 1082;
			case 6: AddVehicleComponent(vehicleid, 1085), CarInfo[playerid][cWheels][use_car] = 1085;
			case 7: AddVehicleComponent(vehicleid, 1096), CarInfo[playerid][cWheels][use_car] = 1096;
			case 8: AddVehicleComponent(vehicleid, 1097), CarInfo[playerid][cWheels][use_car] = 1097;
			case 9: AddVehicleComponent(vehicleid, 1098), CarInfo[playerid][cWheels][use_car] = 1098;
			case 10: AddVehicleComponent(vehicleid, 1084), CarInfo[playerid][cWheels][use_car] = 1084;
			case 11: AddVehicleComponent(vehicleid, 1073), CarInfo[playerid][cWheels][use_car] = 1073;
			case 12: AddVehicleComponent(vehicleid, 1075), CarInfo[playerid][cWheels][use_car] = 1075;
			case 13: AddVehicleComponent(vehicleid, 1077), CarInfo[playerid][cWheels][use_car] = 1077;
			case 14: AddVehicleComponent(vehicleid, 1079), CarInfo[playerid][cWheels][use_car] = 1079;
			case 15: AddVehicleComponent(vehicleid, 1080), CarInfo[playerid][cWheels][use_car] = 1080;
			case 16: AddVehicleComponent(vehicleid, 1083), CarInfo[playerid][cWheels][use_car] = 1083;
		}

