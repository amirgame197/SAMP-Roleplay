CMD:trashunload(playerid)
{
    if(p_info[playerid][pJob] != 4) return 1;

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;

    new vehicleid = GetPlayerVehicleID(playerid);

    if(veh_info[vehicleid][vFr] != 4) return SendClientMessage(playerid, COLOR_GREY, "You're not in the garbage truck!");

    if(trash_vehicle_amount[vehicleid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "The garbage truck is empty!");

    new salary = trash_vehicle_amount[vehicleid] * 10;
    new partner_id = GetPlayerInVehicleSeat(vehicleid, 1);
    if(partner_id != INVALID_PLAYER_ID && p_info[partner_id][pJob] == 4)
    {
        new partner_salary = salary / 2;

		GivePlayerPayCheck(partner_id, partner_salary);

		SCMF(partner_id, -1, "You unloaded the garbage truck, Earned: {91d29a}$%d.", partner_salary);

		salary /= 2;
    }

    GivePlayerPayCheck(playerid, salary);

	SCMF(playerid, -1, "You unloaded the garbage truck, Earned: {91d29a}$%d.", salary);

	if(partner_id != INVALID_PLAYER_ID)
	{
	    SendClientMessage(playerid, -1, "The payment was split between you and your partner!");
	    SendClientMessage(partner_id, -1, "The payment was split between you and your partner!");
	}
	DisablePlayerCheckpoint(playerid);
	UpdateVehicleTrashInfo(vehicleid, -trash_vehicle_amount[vehicleid]);
	return 1;
}

CMD:collectorunload(playerid)
{
    if(p_info[playerid][pJob] != 5) return 1;

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;

    new vehicleid = GetPlayerVehicleID(playerid);
    if(veh_info[vehicleid][vFr] != 5) return SendClientMessage(playerid, COLOR_GREY, "You're not in the cash collection vehicle!");

    if(collector_vehicle_amount[vehicleid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "The cash collection vehicle is empty!");

    new salary = collector_vehicle_amount[vehicleid] * 36;
    new partner_id = GetPlayerInVehicleSeat(vehicleid, 1);
    if(partner_id != INVALID_PLAYER_ID && p_info[partner_id][pJob] == 5)
    {
        new partner_salary = salary / 2;

		GivePlayerPayCheck(partner_id, partner_salary);

		SCMF(partner_id, -1, "You unloaded the cash collection vehicle, Earned: {91d29a}$%d.", partner_salary);

		salary /= 2;
    }

    GivePlayerPayCheck(playerid, salary);

	SCMF(playerid, -1, "You unloaded the cash collection vehicle, Earned: {91d29a}$%d.", salary);

	if(partner_id != INVALID_PLAYER_ID)
	{
	    SendClientMessage(playerid, -1, "The payment was split between you and your partner!");
	    SendClientMessage(partner_id, -1, "The payment was split between you and your partner!");
	}
	DisablePlayerCheckpoint(playerid);
	UpdateVehicleCollectorInfo(vehicleid, -collector_vehicle_amount[vehicleid]);
	return 1;
}

cmd:fuel(playerid)
{
	if(player_enter_fuel[playerid] > 0)	SPD(playerid,57,DIALOG_STYLE_LIST, !""c_server"Gas station", ""c_white"[1] Refuel the vehicle\n[2] Buy a canister\n[3] Information about the gas station", "Choose", "Back");
	return 1;
}

CMD:drive(playerid, params[])
{
    if(p_info[playerid][pMember] < 1) return 1;
    if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1) return SendClientMessage(playerid,COLOR_GREY,"You are not the Leader/deputy of the organization!");
    if(!form_fraction[playerid]) return SendClientMessage(playerid,COLOR_GREY,"You haven't put on the work uniform.");

    SPD(playerid, 205, DIALOG_STYLE_LIST, !""c_server"Faction vehicle management", ""c_white"1. Refuel all vehicles\n2. Major repairs of vehicles\n3. Delivery of vehicles to base", "Choose", "Close");
	return 1;
}

CMD:mycheck(playerid)
{
    GetPlayerNetworkStats(playerid, String, 400); // get your own networkstats
    return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !""c_server"My NetworkStats", String, "Okay", "");
}

CMD:check(playerid)
{
    GetNetworkStats(String, 400); // get the servers networkstats
    return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !""c_server"Server Network Stats", String, "Close", "");
}

CMD:warninfo(playerid, params[])
{
	if(!p_info[playerid][pWarn]) return SendClientMessage(playerid, COLOR_GREY, "You have no active warnings!");

	String = "";
	strcat(String, "{ffff00}Date and time\t\tWho issued\t\tCause\n\n");
	new str[164];

	new dateban[3][6];
    for(new i; i < p_info[playerid][pWarn]; i++)
	{
 		TimestampToDate(WarnInfo[playerid][i][wWarnDate],dateban[i][0],dateban[i][1],dateban[i][2],dateban[i][3],dateban[i][4],dateban[i][5], 3);

		format(str, 164, ""c_white"%02d-%02d-%02d %02d:%02d:%02d\t%s\t%s\n", dateban[i][0], dateban[i][1], dateban[i][2], dateban[i][3], dateban[i][4], dateban[i][5], WarnInfo[playerid][i][wAdminWarn], WarnInfo[playerid][i][wReasonWarn]);
		strcat(String, str);
	}
	if(!GetPVarInt(playerid, "Inform")) SendClientMessage(playerid, 0x98FB98FF, "Warnings are automatically removed after 7 days from the time of issuance.");
	SetPVarInt(playerid, "Inform", 1);
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !""c_server"Warning Information", String, "Close", "");
	return 1;
}

CMD:book(playerid, params[])
{
    if(p_info[playerid][pProducts][1] == 0) return SendClientMessage(playerid, COLOR_GREY, "You have no phone book; you can purchase one at the store 24/7.");

    format(MySQLStr, 144, "SELECT `nName`, `nNumber`, `nID`, `plID` FROM `book` WHERE `plID` = %d", p_info[playerid][pID]);
	mysql_tquery(dbHandle, MySQLStr, "Load My Number", "d", playerid);
	return 1;
}

function ShowPlayerOffLeaders(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendClientMessage(playerid, col_white, !""c_error"The list of leaders is empty.");

    new count = 0, names[MAX_PLAYER_NAME], leader, fwarn, sql_id;

    slobal_string[0] = EOS;
    for(new i = 0; i < rows; i++)
    {
        cache_get_value_int(i, "pID", sql_id);
        cache_get_value_name(i, "pName", names, MAX_PLAYER_NAME);
    	cache_get_value_int(i, "pLeader", leader);
    	cache_get_value_int(i, "pfWarn", fwarn);

		text_string[0] = EOS;
        format(text_string, sizeof(text_string), "%s\t\t%s\t%d/3\n", names, FracInfo[leader][fName], fwarn);
		strcat(slobal_string, text_string);

		SetPlayerListitemValue(playerid, count++, sql_id);
	}
	return SPD(playerid, 195, DIALOG_STYLE_TABLIST, !""c_white"List of leaders"c_green"[offline]", slobal_string, !"Choose", !"Close");
}

CMD:take(playerid, params[])
{
	if(!IsACop(playerid)) return 1;

	if(p_info[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREY, "Licenses/items can only be confiscated from rank 3.");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1,"Enter: /take [Player id]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline!");
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in!");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(!ProxDetectorS(3.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY,"Player must be near the House with you.");

	SPD(playerid, 185, DIALOG_STYLE_LIST, !""c_server"Panel", ""c_white"1. Confiscate driver's license\n2. Confiscate flying license\n3. Confiscate watercraft license\n4. Confiscate weapons license\n5. Confiscate Metal and Cartridges\n6. Confiscate Drugs\n7. Confiscate weapons", "Accept", "Back");
	player_take_player[playerid] = params[0];
	return 1;
}
CMD:frisk(playerid, params[])
{
	if(!IsACop(playerid)) return 1;
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, -1,"Enter: /frisk [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(!ProxDetectorS(8.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY,"You must be near the House with Player.");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY,"You cannot frisk yourself.");
    me_action(playerid,"Before putting on the gloves.");
	SCMF(playerid, -1, " %s", (p_info[params[0]][pDrugs])?("| Drugs.") : ("| Empty pocket."));
    SCMF(playerid, -1, " %s", (p_info[params[0]][pMetall])?("| Metal.") : ("| Empty pocket."));
    SCMF(playerid, -1, " %s", (p_info[params[0]][pPatron])?("| Cartridges.") : ("| Empty pocket."));
    SCMF(params[0], COLOR_GREY, "Officer %s[%d] is searching you.", Name(playerid), playerid);
    format(String, 64, "%s searched %s.", Name(playerid) ,Name(params[0])), ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	PlayerPlaySound(playerid, 5600, 0.0, 0.0, 0.0), PlayerPlaySound(params[0], 5600, 0.0, 0.0, 0.0);
	SetPlayerSpecialAction(params[0],SPECIAL_ACTION_HANDSUP);
	ApplyAnimation(playerid, "POLICE","Cop Traffic Stop",4.0,0,0,0,0,0);
	return 1;
}

alias:report("rep")
cmd:report(playerid)
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);

	SPD(playerid, 9948, DIALOG_STYLE_INPUT, !""c_server"Contact the Admin.", !"\
	"c_white"Please describe your problem in the field below.\n\
	"c_yellow"Admin: We will respond to you soon.", !"Send", !"Cancel");
    return 1;
}

cmd:ask(playerid)
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);

	SPD(playerid, 9945, DIALOG_STYLE_INPUT, !"Connection to game assistants", !"\
	"c_white"Enter your question for game assistants.\n\
	"c_yellow"Attention: messages of a non-gaming nature will result in chat blocking.", !"Send", !"Cancel");
	return 1;
}

CMD:todo(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
    if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid,-1,"Enter: /todo [text] * [action]");
	if(strfind(params, "*", true) == -1) return SendClientMessage(playerid,-1,"Enter: /todo [text] * [action]");

 	new arrCoords[2][128];
  	sscanf(params[0],"p<*>s[128]s[128]",arrCoords[0],arrCoords[1]);

   	if(p_info[playerid][pSex] == 1) format(String, 244, "- %s {DD90FF} said %s, %s",arrCoords[0], Name(playerid), arrCoords[1]);
    else format(String, 244, "- %s {DD90FF} said %s, %s",arrCoords[0], Name(playerid), arrCoords[1]);
    ProxDetector(20.0, playerid, String, COLOR_RAZGOVOR1,COLOR_RAZGOVOR2,COLOR_RAZGOVOR3,COLOR_RAZGOVOR4,COLOR_RAZGOVOR5);
	return 1;
}
CMD:try(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, -1, "Enter: /try [action]");
	if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_LIGHTRED, format_string);
		return 1;
	}
	new randomchik = RandomEx(0,2);
	format(String, 188, "{DD90FF}%s %s %s", Name(playerid), params[0], (!randomchik)?("{63C600}| Successfully") : ("{FF6600}| Unsuccessful"));
	ProxDetector(20.0, playerid, String, 0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFA);
	return 1;
}

cmd:me(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
    extract params -> new string:me_text[128]; else return SendClientMessage(playerid, col_grey, !"Use: /me [action]");
	if(CheckIP(me_text))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, col_white, !""c_error"You have received a chat block for advertising violations.");

		text_string[0] = EOS;
		format(text_string, sizeof(text_string), "Ad views: %s | %s[%d]", me_text, Name(playerid), playerid);
		send_admin_message(col_orange_red, text_string);
		return 1;
	}
	me_action(playerid, me_text);
	return 1;
}


CMD:do(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, -1,"Enter: /do [action]");
	if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_LIGHTRED, format_string);
		return 1;
	}
	format(String, 188, "%s (%s)", params[0], Name(playerid));
  	ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
  	SetPlayerChatBubble(playerid,params[0],0xDD90FFFF,20.0,10000);
	return 1;
}

alias:n("b")
CMD:n(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, -1,"Enter: /n(/b) [text]");
	if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_LIGHTRED, format_string);
		return 1;
	}
	format(String, 188, "(( %s[%d]: %s ))",Name(playerid),playerid,params[0]);
 	ProxDetector(20.0, playerid, String,0xCCCC99FF,0xCCCC99FF,0xCCCC99FF,0xCCCC99FF,0xCCCC99FF);
 	SetPlayerChatBubble(playerid, params[0], 0x999999FF, 20.0, 10000);
	return 1;
}
CMD:w(playerid,params[])
{
	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(sscanf(params,"s[144]",params[0])) return SendClientMessage(playerid,-1,"Enter: /w [message]");

    format(String, 188, "%s[%d] whispers: %s", Name(playerid), playerid, params[0]);
	ProxDetector(5.0, playerid, String, 0xACCE90FF,0xACCE90FF,0xACCE90FF,0xACCE90FF,0xACCE90FF);
 	SetPlayerChatBubble(playerid, params[0], 0xACCE90FF, 5.0, 10000);
	return 1;
}
CMD:s(playerid, params[])
{
	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, -1,"Enter: /s [text]");
	if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_LIGHTRED, format_string);
		return 1;
	}
	format(String, 188, "%s[%d] shouted: %s", Name(playerid), playerid, params[0]);
	ProxDetector(40.0,playerid, String,-1,-1,-1,-1,-1);
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid, "ON_LOOKERS", "shout_01",1000.0,0,0,0,0,0,1);
	SetPlayerChatBubble(playerid, params[0],-1,40.0,10000);
	return 1;
}

cmd:voff(playerid,params[])
{
	if(!p_info[playerid][pVip] || admin_level[playerid] < 1) return SendClientMessage(playerid, col_grey, !"The given feature is available to Players with VIP privileges.");

	if(GetPVarInt(playerid, "vroff"))
	{
		DeletePVar(playerid, "vroff");
		SendClientMessage(playerid, col_white, !"You have successfully connected to the VIP chat.");
	}
	else
	{
		SetPVarInt(playerid, "vroff", true);
		SendClientMessage(playerid, col_white, !"You have successfully disconnected from the VIP chat.");
	}
	return 1;
}

stock SendVipMessage(color, str[])
{
	foreach(new i : Player)
	{
		if(!p_info[i][pVip]) continue;
		if(GetPVarInt(i,"vroff")) continue;
		SendClientMessage(i, color, str);
	}
	return 1;
}
CMD:v(playerid,params[])
{
	if(!p_info[playerid][pVip]) return SendClientMessage(playerid,0xafafafff,"The given feature is only available to VIP Players.");
	if(p_info[playerid][mute] > 0) return SendClientMessage(playerid,0xafafafff,"You are banned from the chat.");
	if(isnull(params) || strlen(params) > 144) return SendClientMessage(playerid,0xafafafff,"/v [?????]");
	if(admin_level[playerid] == 0) format(format_string, 128, "[VIP] %s[%d]: "c_white"%s",Name(playerid),playerid,params);
	else if(admin_level[playerid] >= 1) format(format_string, 128, "[VIP] Administrator %s[%d]: "c_white"%s",Name(playerid),playerid,params);
	SendVipMessage(0x1E90FFff, format_string);
	return 1;
}
CMD:unfwarn(playerid, params[])
{
	if(!p_info[playerid][pMember]) return 1;
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, -1,"Enter: /unfwarn [playerid]");
    if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
 	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]) return SendClientMessage(playerid,COLOR_GREY,"Only the Leader of the organization can remove your warnings.");
	if(p_info[playerid][pMember] != p_info[params[0]][pMember]) return SendClientMessage(playerid,COLOR_GREY,"The player is not part of your organization!");
	if(p_info[params[0]][pfWarn] <= 0) return SendClientMessage(playerid, COLOR_GREY,"This player has no warnings!");
	p_info[params[0]][pfWarn] -= 1;

	SCMF(params[0], 0x56FB4EFF, "Leader %s(%d) has removed your warning (%d/3).", Name(playerid), playerid, p_info[params[0]][pfWarn]);
	SCMF(playerid, 0x56FB4EFF, "You have removed %s(%d) You govern (%d/3)", Name(params[0]), params[0], p_info[params[0]][pfWarn]);
	return 1;
}

CMD:gov(playerid, params[])
{
    if(!IsACop(playerid) && !IsAArmy(playerid) && !IsAMedic(playerid) && p_info[playerid][pMember] != FRACTION_MAYOR) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this.");

	if(player_gag[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are gagged, you cannot speak.") & 0;
	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1) return SendClientMessage(playerid,COLOR_GREY,"You are not the Leader/deputy of the organization!");

	if(sscanf(params, "s[128]",params[0])) return SendClientMessage(playerid, -1,"Enter: /gov [text]");
    if(CheckIP(params[0]))
	{
	    format(format_string, sizeof(format_string), "[A] The leader of the faction %s (%s) was removed from office due to advertising misconduct.",Name(playerid), FracInfo[p_info[playerid][pMember]][fName]);
		send_admin_message(COLOR_GREY, format_string);
		p_info[playerid][setspawn] = 1, p_info[playerid][pMember] = 0;
    	p_info[playerid][pRank] = 0, p_info[playerid][pfWarn] = 0;
		form_fraction[playerid] = 0, SetPlayerToTeamColor(playerid);
		SetPlayerSkinEx(playerid, p_info[playerid][pSkin]);

		SavePlayerFraction(playerid);

		format(String, 322, ""c_white"You were removed from the position of Administrator for advertising third-party projects.\nIf an error occurred - take a screenshot of this dialog window\nand send it to the administration.\n\nText sent in /gov: %s", params[0]);
		SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !""c_server"Misconduct in advertising", String, "Close", "");
		return 1;
	}
    format(format_string, sizeof(format_string), "Government news: %s[%d]: [%s] %s", Name(playerid), playerid, FracInfo[p_info[playerid][pMember]][fTag], params[0]);
	SendClientMessageToAll(0x3A5FCDFF, format_string);
	return 1;
}

CMD:fwarn(playerid, params[])
{
	if(!p_info[playerid][pMember]) return 1;
	if(sscanf(params, "us[128]",params[0],params[1])) return SendClientMessage(playerid, -1,"Enter: /fwarn [playerid] [Cause]");
    if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
 	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(params[0] == playerid) return SendClientMessage(playerid, -1,"You can't give a warning to yourself!");
	if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1) return SendClientMessage(playerid,COLOR_GREY,"You are not a leader / deputy leader!");
	if(p_info[playerid][pMember] != p_info[params[0]][pMember]) return SendClientMessage(playerid,COLOR_GREY,"The player is not in your organization!");
	if(p_info[playerid][pRank] <= p_info[params[0]][pRank] || p_info[params[0]][pLeader] > 0) return SendClientMessage(playerid,COLOR_GREY,"You can't give a warning to this player!");

	if(p_info[params[0]][pfWarn] == 2)
	{
	    SCMF(params[0], 0xB4B5B7FF, "%s(%d) fired you from the organization (%s). Cause: %s (3 warnings)", Name(playerid), playerid, FracInfo[p_info[playerid][pMember]][fName], params[1]);
		SCMF(playerid, 0xB4B5B7FF, "You fired %s(%d) from the organization (%s). Cause: Has 3 warnings", Name(params[0]), params[0], FracInfo[p_info[playerid][pMember]][fName]);
		p_info[params[0]][pMember] = 0, p_info[params[0]][pRank] = 0, p_info[params[0]][pfWarn] = 0;
		form_fraction[params[0]] = 0;
		SetPlayerArmour(playerid, 0), //ResetWeapons(params[0]);
		SetPlayerSkinEx(params[0], p_info[params[0]][pSkin]);
		SetPlayerToTeamColor(params[0]);

		SavePlayerFraction(params[0]);
	}
	else
	{
		p_info[params[0]][pfWarn] += 1;
		SCMF(params[0], 0xB4B5B7FF, "%s(%d) You have given you a warning (%d/3). Cause: %s", Name(playerid), playerid, p_info[params[0]][pfWarn], params[1]);
        SCMF(playerid, 0xB4B5B7FF, "You have given %s(%d) a warning (%d/3). Cause: %s", Name(params[0]), params[0], p_info[params[0]][pfWarn], params[1]);
	}
	return 1;
}
CMD:clear(playerid, params[])
{
	if(!IsACop(playerid)) return 1;
	if(sscanf(params, "us[32]", params[0], params[1])) return  SendClientMessage(playerid, -1,"Enter: /clear [playerid] [Cause]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(!ProxDetectorS(5.0, playerid, params[0]) || params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY,"The player before should be with you");
	if(GetPVarInt(params[0],"robshoporbank")) return SendClientMessage(playerid, COLOR_RED, !""c_error"You cannot use it for a robber!");

	me_action(playerid,"opened the PDA and accessed the wanted database");
	me_action(playerid,"deleted the case on the previous suspect from the database");
	SCMF(params[0], 0x20A9FFFF, "%s removed you from the wanted list. Cause: %s", Name(playerid), params[1]);

	p_info[params[0]][pWanted] = 0;
	SetPlayerWantedLevel(params[0], 0);

	foreach(new i : Player)
	{
		if(IsACop(i)) SCMF(i, 0xFEBC41AA, "Informs: %s. Before the target was caught, %s was removed from the wanted list. Cause: %s", Name(playerid), Name(params[0]), params[1]), PlayerPlaySound(i, 41603, 0.0, 0.0, 0.0);
	}
	return 1;
}
CMD:break(playerid, params[])
{
    if(!IsACop(playerid) || !IsAArmy(playerid)) return 1;
 	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,COLOR_GREY, "You installed the object from the car!");
   	if(GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid,COLOR_GREY, "You cannot place objects in the interior!");

	if(p_info[playerid][pObject] > 0)
	{
	    DestroyDynamic3DTextLabel(p_info[playerid][pDText]);
	    DestroyDynamicObject(p_info[playerid][pObject]);
	    p_info[playerid][pObject] = 0;
	    return SendClientMessage(playerid, -1, "The object has been successfully removed!");
 	}
    SPD(playerid,184,DIALOG_STYLE_LIST, !""c_server"List of objects",""c_white"[1] Barrage #1\n[2] Barrage #2\n[3] Barrage #3\n[4] Barrage #4", "Choose","Close");
    return 1;
}
CMD:find(playerid,params[])
{
	if(!IsACop(playerid)) return 1;
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid,-1,"Enter: /find [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Error: Player is not logged in");//+;
	if(params[0] == playerid) return SendClientMessage(playerid,-1,"You indicated their ID");
	if(admin_level[params[0]] > 0) return SendClientMessage(playerid,COLOR_GREY,"The player is an administrator. Cannot be used on administrator.");

	if(player_search_player[playerid] != -1) return SCMF(playerid, COLOR_GREY, "Spying on player %s[%d] terminated!", Name(player_search_player[playerid]), player_search_player[playerid]), player_search_player[playerid] = -1;
	if(GetPlayerVirtualWorld(params[0]) != 0) return SendClientMessage(playerid,COLOR_GREY,"Wanted is in the interior or at an event!");
	if(GetPlayerInterior(params[0]) != 0) return SendClientMessage(playerid,COLOR_GREY,"Wanted is in the interior");

	player_search_player[playerid] = params[0];
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !""c_server"Satellite connection...", ""c_white"You started tracking the criminal.\nThe GPS tag will be updated every second.\n\nTo turn off satellite, enter the command again...", "Close", "");
	return 1;
}

CMD:aeject(playerid, params[])
{
	if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, -1,"Enter: /aeject [playerid]");
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY,"The person is far from you!");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY,"You cannot drag yourself into the vehicle!");
	if(!p_info[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY,"The person is not a criminal.");

	if(GetPlayerState(params[0]) == PLAYER_STATE_ONFOOT) return SendClientMessage(playerid, COLOR_GREY, "Player is not in the vehicle.");

	RemovePlayerFromVehicle(params[0]);

	SCMF(playerid, -1, "You forcibly dragged {AFEEEE}%s[%d]"c_white" from the vehicle.", Name(params[0]), params[0]);
	SCMF(params[0], 0xFF4500ff, "%s[%d] You dragged You from transport.", Name(playerid), playerid);

	format(String, 64, "%s dragged %s from transport.");
	SetPlayerChatBubble(playerid, String, COLOR_PURPLE,15.0,10000);

	me_action(playerid, "You dragged criminal Nick from transport.");
	return 1;
}

CMD:ceject(playerid, params[])
{
	if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
	if(!IsPoliceVehicle(GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY, "You are not in a patrol car!");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, -1,"Enter: /ceject [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, COLOR_GREY,"The Player is AFK.");//+
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY,"A person is far from You or is already in a vehicle!");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY,"You cannot drag yourself into the vehicle!");
	if(!p_info[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY,"The person is not a criminal.");

	if(GetPlayerVehicleID(params[0]) != GetPlayerVehicleID(playerid)) return SendClientMessage(playerid, COLOR_GREY, "This player is not a passenger.");

	if(PlayerToPoint(15.0, playerid, 1568.4247,-1694.7701,5.8906)) SetPPos(params[0],255.0321,86.6862,1002.4453, 4.2000, 6, 1, false); //LSPD
	else if(PlayerToPoint(15.0, playerid, -303.6902,1533.2164,75.3594)) SetPPos(params[0],200.0141,158.2397,1003.0234, 92.4368, 3, 2, false); //FBI
	else if(PlayerToPoint(15.0, playerid, -1594.2098,716.1427,-4.9063)) SetPPos(params[0],216.4706,120.8032,999.0156,271.5949, 10, 2, false); //SFPD
	else if(PlayerToPoint(15.0, playerid, 2296.9668,2451.5178,10.8203)) SetPPos(params[0],200.0141,158.2397,1003.0234, 92.4368, 3, 8, false); //LVPD
	else if(PlayerToPoint(15.0, playerid, 1802.3367,-1575.2223,13.3954)) SetPPos(params[0],255.0321,86.6862,1002.4453, 4.2000, 6, 1, false); //FP
    else if(PlayerToPoint(15.0, playerid, 630.5706,-576.3085,16.5942)) SetPPos(params[0],255.0321,86.6862,1002.4453, 4.2000, 6, 2, false); //RCPD
	else return SendClientMessage(playerid, COLOR_GREY, "You are far from the entrance to any precinct or FBI.");

	SCMF(playerid, -1, "You forcibly dragged criminal Nick {AFEEEE}%s[%d]."c_white" to the precinct.", Name(params[0]), params[0]);
	SCMF(params[0], 0xFF4500ff, "%s[%d] forcibly dragged You to the precinct.", Name(playerid), playerid);
	format(String, 64, "%s forcibly dragged %s to the precinct.");
	SetPlayerChatBubble(playerid, String, COLOR_PURPLE,15.0,10000);
	me_action(playerid, "forcibly dragged criminal Nick to the precinct.");
	return 1;
}
CMD:music(playerid, params[])
	{
	SendClientMessage(playerid, 0x17fc03, "[Radio-System] Radio Has Started!");
	SPD(playerid, 3698, DIALOG_STYLE_LIST, !""c_server"Select Music:", !"\
	Bezanam Naft Dar Biad\n\
	Arom Mikony Hal Bede Mano\n\
	Ye Rroz\n\
	Binol\n\
	Shad(Remix)\n\
	Soon\n\
	Soon\n\
	Pirbod Ghayegh", !"Choose", !"Close");
	return 1;
	}
CMD:smusic(playerid, params[])
{
StopAudioStreamForPlayer(playerid);
SendClientMessage(playerid, 0x17fc03, "[Radio-System] The Radio Went Silent!");
}
CMD:cput(playerid, params[])
{
	if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
	if(!IsPoliceVehicle(GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY, "You are not in a patrol car!");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, -1,"Enter: /cput [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, COLOR_GREY,"The Player is AFK.");//+
	if(!ProxDetectorS(5.0, playerid, params[0]) || GetPlayerState(params[0]) != PLAYER_STATE_ONFOOT) return SendClientMessage(playerid, COLOR_GREY,"A person is far from You or is already in a vehicle!");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY,"You cannot drag yourself into the vehicle!");
	if(!p_info[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY,"The person is not a criminal.");
	if(follow_id[params[0]] != INVALID_PLAYER_ID)
	{
		ClearAnimations(params[0], true);
        follow_id[params[0]] = INVALID_PLAYER_ID;
	}
	foreach(new i : Player)
	{
		if(IsPlayerInVehicle(i, GetPlayerVehicleID(playerid)) && GetPlayerVehicleSeat(i) == 1) return SendClientMessage(playerid, COLOR_GREY,"The seat in the car is already taken!");
	}
	PutPlayerInVehicle(params[0], GetPlayerVehicleID(playerid), 2);
	SetPlayerArmedWeapon(params[0], 0);
	SCMF(playerid, -1, "You forcibly dragged criminal Nick {AFEEEE}%s[%d]."c_white" into the car", Name(params[0]), params[0]);
	me_action(playerid, "opened the car door");
	SCMF(params[0], 0xFF4500ff, "%s[%d] forcibly dragged you into the car", Name(playerid), playerid);
	format(String, 64, "%s forcibly dragged %s into the car");
	SetPlayerChatBubble(playerid, String, COLOR_PURPLE,15.0,10000);
	me_action(playerid, "forcibly dragged the criminal Nick into the car");
	return 1;
}
CMD:ram(playerid, params[])
{
    if(IsACop(playerid) || (admin_level[playerid] > 1 || admin_logged[playerid]))
    {
        for(new i; i < max_houses; i++)
    	{
        	if(!PlayerToPoint(3.0, playerid, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez])) continue;

			if(HouseInfo[i][hLock] == 0) return SendClientMessage(playerid, -1, "The doors of this house are open.");

			SetPlayerChatBubble(playerid,"broke into the house.",COLOR_PURPLE,15.0,10000);
			PlayerEnterToHouse(playerid, i);
			me_action(playerid,"broke into the locked house.");

			return 1;
		}
	}
	return 1;
}
CMD:wanted(playerid, params[])
{
	if(!IsACop(playerid)) return 1;
	new sctring[128];
	String = "";

    foreach(new i : Player)
	{
		if(p_info[i][pWanted] == 0) continue;

	    if(p_info[i][pWanted] > 4)
		{
		    //String = "{FF8300}Federal wanted list:"c_white"\n\n";
	    	format(sctring, 128, ""c_white"%s[%d]\t\t|\t"c_white"Wanted level: {FF8300}%d\n",Name(i), i, p_info[i][pWanted]);
	    	strcat(String,sctring);
	    }
	    else
	    {
	        format(sctring, 128, ""c_white"%s[%d]\t\t|\t"c_white"Wanted level: {FF8300}%d\n",Name(i), i, p_info[i][pWanted]);
	    	strcat(String,sctring);
		}
   	}
	if(strlen(sctring) > 1)
	{
		SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !""c_server"Wanted", String, "Close", "");
		me_action(playerid,"before they became and opened the IDC");
	 	me_action(playerid,"entered the database of wanted persons");
	}
	else SendClientMessage(playerid, 0xB4B5B7FF,"There are no wanted persons in the PC.");
	return 1;
}
CMD:arrest(playerid, params[])
{
    if(!IsACop(playerid)) return 1;
	if(sscanf(params, "u",params[0],params[1])) return SendClientMessage(playerid, -1,"Enter: /arrest [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(!ProxDetectorS(4.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY,"The player is not with you");
	if(p_info[params[0]][pWanted] < 1) return SendClientMessage(playerid, COLOR_GREY,"The person is not wanted");

	new place = 0;
	new time = (p_info[params[0]][pWanted]*10)*60;

	if(PlayerCuffed[params[0]])
	{
		GameTextForPlayer(params[0],"~g~uncuffed", 5000, 3);
		if(IsPlayerAttachedObjectSlotUsed(params[0], 8)) RemovePlayerAttachedObject(params[0], 8);
		SetPlayerSpecialAction(params[0], 0);
		PlayerCuffed[params[0]] = 0;
	}
	if(PlayerToPoint(25.0, playerid, 1562.3345,-1692.6257,5.8906,185.9420) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0) //LSPD
	{
		SetPPos(params[0], 264.4681,77.5466,1001.0391, 0.0, 6, 1, false);
		place = 1;
	}
	else if(PlayerToPoint(30.0, playerid, 1280.4729,-812.2542,83.4390,356.1955) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0) // FBI
	{
		SetPPos(params[0],198.4545,161.8394,1003.0300, 0.0, 3, 2, false);
		place = 2;
	}
	else if(PlayerToPoint(15.0, playerid, 217.0850,120.8270,999.0156) && GetPlayerInterior(playerid) == 10 && GetPlayerVirtualWorld(playerid) == 2) //SFPD
	{
		SetPPos(params[0], 219.2213,109.6325,999.0156,100.2528, 10, 2, false);
		place = 3;
	}
	else if(PlayerToPoint(15.0, playerid, 200.2648,158.2574,1003.0234) && GetPlayerInterior(playerid) == 3 && GetPlayerVirtualWorld(playerid) == 8) //LVPD
	{
		SetPPos(params[0], 198.4545,161.8394,1003.0300, 0.0, 3, 8, false);
		place = 4;
	}
	else if(PlayerToPoint(15.0, playerid, 1802.3367,-1575.2223,13.3954) && GetPlayerInterior(playerid) == 6 && GetPlayerVirtualWorld(playerid) == 1) //FP
	{
		SetPPos(params[0], 264.4681,77.5466,1001.0391, 0.0, 6, 1, false);
		place = 1;
	}
	else if(PlayerToPoint(15.0, playerid, 254.8287,86.7825,1002.4453) && GetPlayerInterior(playerid) == 6 && GetPlayerVirtualWorld(playerid) == 2) //RCPD
	{
		SetPPos(params[0], 264.4681,77.5466,1001.0391, 0.0, 6, 2, false);
		place = 5;
	}
	else return SendClientMessage(playerid, COLOR_GREY,"You should be near the detention cells.");

	SetPlayerPrison(params[0], place, time);

	//ResetWeapons(params[0]);
	TogglePlayerControllableEx(params[0], 1);

	SCMF(playerid, 0xFFFF00FF, "You planted %s[%d] for %d seconds", Name(params[0]), params[0], time);
    SCMF(params[0], 0xFFFF00FF, "%s[%d] planted you for %d seconds", Name(playerid), playerid, time);
	GivePlayerPayCheck(playerid, 300);
	p_info[params[0]][pWanted] = 0;
	PlayerCuffed[params[0]] = 0;
	if(follow_id[params[0]] != INVALID_PLAYER_ID)
	{
		ClearAnimations(params[0], true);
        follow_id[params[0]] = INVALID_PLAYER_ID;
	}
	me_action(playerid,"removed the handcuffs from the suspect");
	me_action(playerid,"sent the criminal to the Fuck axaxaxaxax");
	return 1;
}

CMD:eject(playerid, params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,COLOR_GREY,"You should be driving the vehicle.");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1,"Enter: /eject [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(params[0] == playerid || !IsPlayerInVehicle(params[0],GetPlayerVehicleID(playerid))) return 1;

	SCMF(params[0], 0x6BB3FFAA, "%s[%d] has ejected You from the vehicle", Name(playerid), playerid);
    SCMF(playerid, 0x6BB3FFAA, "You have ejected %s[%d] from the vehicle", Name(params[0]), params[0]);
	RemovePlayerFromVehicleEx(params[0]);
	return 1;
}

CMD:heal(playerid, params[])
{
    if(!IsAMedic(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
    if(p_info[playerid][pMember] != form_fraction[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You have not started your workday.");
	if(sscanf(params, "dd",params[0],params[1])) return SendClientMessage(playerid, -1, "Enter: /heal [id] [price]");
	if(params[1] < 700 || params[1] > 3500) return SendClientMessage(playerid,0xafafafff,"You cannot specify less than $700 and more than $3500.");
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"[Error] You indicated your own ID.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GRAD1, "You are too far away.");
	//if(!PlayerToPoint(55.0,playerid,-628.1243,-922.2409,1436.8002)) return SendClientMessage(playerid, COLOR_GREY, "Available only in the hospital.");

	format(format_string,sizeof(format_string), ""c_white"%s %s[%d] offers you quick treatment for %d$\n\n\tDo you agree?",FracRank[p_info[playerid][pMember]][p_info[playerid][pRank]],Name(playerid),playerid,params[1]);
	SPD(params[0],221,DIALOG_STYLE_MSGBOX, !""c_server"Treatment", format_string, "Yes", "No");
	HealOffer[params[0]] = playerid;
	HealPrice[params[0]] = params[1];
	format(format_string,128,"You offered {27C400}%s"c_white" quick treatment for {27C400}%d$"c_white"",Name(params[0]),params[1]);
	SendClientMessage(playerid, -1, format_string);

	return 1;
}
CMD:ad(playerid, params[])
{
    if(p_info[playerid][pLogin] == 0) return 1;
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
    if(p_info[playerid][pLevel] < 2) return SendClientMessage(playerid, COLOR_GREY, "You can submit advertisements having 2 game levels!");
    if(p_info[playerid][pProducts][0] == 0) return SendClientMessage(playerid, COLOR_GREY, "You do not have a mobile phone.");
    if(advert_block[playerid] > gettime()) return SendClientMessage(playerid,COLOR_GREY,"Less than a minute has passed since the last message was sent.");
    //if(lNews[playerid] == 1) return SendClientMessage(playerid, -1, "First, turn on the radio.");
    if(sscanf(params, "s[60]", params[0])) return SendClientMessage(playerid, -1, "Enter: /ad [text]");
    if(strfind(params[0], "{", true) != -1) return SendClientMessage(playerid,-1,"You entered a forbidden character! ({)");
    if(p_info[playerid][pSummaNumber] < 200) return SendClientMessage(playerid, -1, "Insufficient funds on the phone balance!");

    for(new i; i<MAX_ADVERTS; i++)
    {
		if(AdvertInfo[i][aName]!=0) continue;

		format(AdvertInfo[i][aName],24,GN(playerid));
		format(AdvertInfo[i][aText],128,params[0]);
        AdvertInfo[i][aNumber]=p_info[playerid][pNumber];
	    p_info[playerid][pSummaNumber] -= 200;
	    format(format_string,80,"[SA News] An announcement has been received in the editorial office from "c_white"%s[%d]",GN(playerid),playerid);
	    SendFrac(6,COLOR_GREEN,format_string);

	    advert_block[playerid] = gettime() + 60;

	    SendClientMessage(playerid, COLOR_WHITE, "Your announcement has been sent for review, $200 has been deducted from your phone.");
		return SendClientMessage(playerid, COLOR_GREEN, "Please wait while it is being edited by the editorial staff!");
	}
	return SendClientMessage(playerid,COLOR_GREY,"There are many announcements accumulated in the studio, please wait while they are reviewed.");
}

CMD:npanel(playerid)
{
    if(p_info[playerid][pMember] != FRACTION_NEWS) return SendClientMessage(playerid, COLOR_GREY, "Only available to NEWS staff.");

	if(p_info[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREY, "Available from rank 2.");

    if(!form_fraction[playerid]) return SendClientMessage(playerid,COLOR_GREY,"You haven't started the working day!");

	new vehicleid = GetPlayerVehicleID(playerid);

    if(PlayerToPoint(15.0, playerid, 171.5635,-117.0707,1076.5861) ||
		vehicleid != INVALID_VEHICLE_ID && veh_info[vehicleid][vFr] == FRACTION_NEWS)
	{
	    format(format_string, 144, "- %s broadcast\n- Invite a guest\n- Remove a guest", !player_news_live[playerid] ? ("Start") : ("Finish"));
	    return SPD(playerid, 3723, DIALOG_STYLE_LIST, !""c_server"News menu", format_string, "Choose", "Close");
	}

	return SendClientMessage(playerid, COLOR_GREY, "You are far from the broadcasting center or not in the NEWS transport.");
}

CMD:edit(playerid)
{
    if(p_info[playerid][pMember] != FRACTION_NEWS) return SendClientMessage(playerid, COLOR_GREY, "Only available to NEWS staff.");
	if(p_info[playerid][pRank] < 2) return SendClientMessage(playerid,0xafafafff,"Editing announcements is possible with the responsibility of 'RadiotechNick'");
	if(form_fraction[playerid] == 0) return SendClientMessage(playerid,COLOR_GREY,"You haven't started the working day!");
    AdvertList(playerid);
    return 1;
}
