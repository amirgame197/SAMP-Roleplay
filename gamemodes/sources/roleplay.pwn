forward Qalion(playerid);
public Qalion(playerid)
{
	DestroyObject(Dood);
    Qaliontime[playerid] = 0;
}
/*--------------------------------------------------------------------*/
stock GetName(playerid)
{
		new Name[MAX_PLAYER_NAME];
	GetPlayerName(playerid, Name, sizeof(Name));
	return Name;

}
/*--------------------------------------------------------------------*/
returnGPCI(playerid)
{
	new
		szSerial[41];

	gpci(playerid, szSerial, sizeof(szSerial));
	return szSerial;
}
/*--------------------------------------------------------------------*/
function GetClientVersion(playerid)
{
	if(strcmp("ED40ED0E8089CC44C08EE9580F4C8C44EE8EE990", returnGPCI(playerid), true))
	{ 
		Client[playerid] = false; 
		player_mobile[playerid] = false;
	} else { 
		Client[playerid] = true; 
		player_mobile[playerid] = true;
	}
	return 1;
}
/*--------------------------------------------------------------------*/
function SetTagName(playerid)
{
	new tag[32], tagadmin[32], tagleader[32], tagvip[32];
	new SetNameZade[160];
    if(Client[playerid]) //Android
    {
    	format(tag, sizeof(tag), "");
    }
    else if(!Client[playerid]) { //PC
    	format(tag, sizeof(tag), "[PC]");
    }
    if(p_info[playerid][pLeader] >= 1)
    {
        format(tagleader, sizeof(tagleader), "[L]");
    }
    else if(p_info[playerid][pLeader] == 0) format(tagleader, sizeof(tagleader), "");
   	if(p_info[playerid][pVip])
	{
	   format(tagvip, sizeof(tagvip), "[V]");
	}
    else if(!p_info[playerid][pVip]) format(tagvip, sizeof(tagvip), "");
	if(admin_logged[playerid] == 1)
    {
        format(tagadmin, sizeof(tagadmin), "[A]");
    }
    else if(!admin_logged[playerid]) format(tagadmin, sizeof(tagadmin), "");
	format(SetNameZade, sizeof(SetNameZade), "%s%s%s%s%s", GetNameClean(playerid), tag, tagleader, tagadmin, tagvip);
	SetPlayerName(playerid, SetNameZade);
	return 1;
}
stock SubDel(string[], sub_string[]) // by Sreyas
{
    new i, j, beg = -1, bool:flag;
    while (string[i] != '\0')
    {
        j = 0;
        flag = true;

        if (sub_string[0] == string[i])
        {
            beg = i;
            while (sub_string[j] != '\0' && string[i] != '\0')
            {
                if (sub_string[j] != string[i])
                    flag = false;
                i++;
                j++;
            }
            if (flag)
            {
                for (j = i, i = beg; string[i] != '\0'; i++, j++)
                    string[i] = string[j];
                i = -1; // Reset to start from the beginning
            }
        }
        i++;
    }
}

stock GetNameClean(playerid)
{
    new name[24];
    GetPlayerName(playerid, name, sizeof(name));
    SubDel(name, "[A]");
    SubDel(name, "[V]");
    SubDel(name, "[L]");
    SubDel(name, "[PC]");
    return name;
}

/*--------------------------------------------------------------------
CheckTagName(playerid)
{
	new plName[MAX_PLAYER_NAME + 1], idx = 0;
	GetPlayerName(playerid, plName, sizeof(plName));
	if(strfind(plName, "[") == -1 || strfind(plName, "]") == -1) return false;
	for(new i; i < sizeof(ClientTags); i++)
	{
        if(isnull(ClientTags[i])) continue;
		idx = strfind(plName, ClientTags[i]);
		if(idx != -1)
		{
			strdel(plName, idx, idx + strlen(ClientTags[i]) + 1);
			if(strlen(plName) < 3) return false;
			SetPlayerName(playerid, plName);
			return true;
		}
	}
	return 1;
}
--------------------------------------------------------------------*/
stock GetCharacterName(playerid)
{
	if((strlen(GetName(playerid)) > MAX_PLAYER_NAME-6))
	{
		SCMKick(playerid, COLOR_RED, "[Server]: {FFFFFF}You can only use 3 to 18 characters in your nickname.");
	}
	return 1;
}
/*--------------------------------------------------------------------*/
stock SCMKick(playerid, color, string[])
{
	if(IsPlayerConnected(playerid))
	{
		SendClientMessage(playerid, color, string);
		SetTimerEx("KickEx", 50, 0, "i", playerid);
	}
	return 1;
}
/*--------------------------------------------------------------------*/
function KickEx(playerid)
{
	Kick(playerid);
	return 1;
}
/*--------------------------------------------------------------------*/

stock RemovePlayerFromVehicleEx(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerState(playerid) != PLAYER_STATE_PASSENGER) return 0;

	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);

		vehicle_driver[vehicleid] = INVALID_PLAYER_ID;
	}

    new Float: x, Float: y, Float: z;

    GetPlayerPos(playerid, x, y, z);

    return SetPlayerPos(playerid, x + 1.5, y + 1.5, z);
}

stock _CreateVehicle(modelid, Float:x, Float:y, Float:z, Float:rotation, color1, color2, respawn_delay, addsiren = 0)
{
	new vehicleid = CreateVehicle(modelid, x, y, z, rotation, color1, color2, respawn_delay, addsiren);

	ClearVehicleData(vehicleid);

	veh_info[vehicleid][vModel] = modelid;
    veh_info[vehicleid][vColors1] = color1;
    veh_info[vehicleid][vColors2] = color1;
    veh_info[vehicleid][vFuel] = 100.0;
    VehicleCreate[vehicleid] = false;

	return vehicleid;
}
#if defined _ALS_CreateVehicle
    #undef CreateVehicle
#else
    #define _ALS_CreateVehicle
#endif
#define CreateVehicle _CreateVehicle

stock _AddStaticVehicle(modelid, Float:spawn_x, Float:spawn_y, Float:spawn_z, Float:angle, color1, color2)
{
	new vehicleid = AddStaticVehicle(modelid, spawn_x, spawn_y, spawn_z, angle, color1, color2);

    ClearVehicleData(vehicleid);

	veh_info[vehicleid][vModel] = modelid;
    veh_info[vehicleid][vColors1] = color1;
    veh_info[vehicleid][vColors2] = color1;
    VehicleCreate[vehicleid] = false;

	return vehicleid;
}
#if defined _ALS_AddStaticVehicle
    #undef AddStaticVehicle
#else
    #define _ALS_AddStaticVehicle
#endif
#define AddStaticVehicle _AddStaticVehicle

stock _DestroyVehicle(vehicleid)
{
	if(vehicleid == INVALID_VEHICLE_ID) return 0;

	if(attachobject_car[vehicleid] != 0)
	{
	    DestroyDynamicObject(attachobject_car[vehicleid]);
	    attachobject_car[vehicleid] = 0;
	}

	veh_info[vehicleid][vModel] = 0;
    DestroyVehicle(vehicleid);

    return 1;
}
#if defined _ALS_DestroyVehicle
    #undef DestroyVehicle
#else
    #define _ALS_DestroyVehicle
#endif
#define DestroyVehicle _DestroyVehicle

stock _AddStaticVehicleEx(modelid, Float:spawn_x, Float:spawn_y, Float:spawn_z, Float:angle, color1, color2, respawn_delay, addsiren=0)
{
	new vehicleid = AddStaticVehicleEx(modelid, spawn_x, spawn_y, spawn_z, angle, color1, color2, respawn_delay, addsiren);

    ClearVehicleData(vehicleid);

	veh_info[vehicleid][vModel] = modelid;
    veh_info[vehicleid][vColors1] = color1;
    veh_info[vehicleid][vColors2] = color1;
    veh_info[vehicleid][vFuel] = 100.0;
    VehicleCreate[vehicleid] = false;

	return vehicleid;
}
#if defined _ALS_AddStaticVehicleEx
    #undef AddStaticVehicleEx
#else
    #define _ALS_AddStaticVehicleEx
#endif
#define AddStaticVehicleEx _AddStaticVehicleEx

stock ClearVehicleData(vehicleid)
{
    vehicle_rent_owner[vehicleid] = INVALID_PLAYER_ID;
	vehicle_driver[vehicleid] = INVALID_PLAYER_ID;
	quest_vehicle_owner[vehicleid] = INVALID_PLAYER_ID;
}

