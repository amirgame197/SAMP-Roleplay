			format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) Detected usage of cheat: FlyHack (in vehicle)",GetName(playerid),playerid);
			send_admin_message(COLOR_RED,sath);
			AntiCheatKickWithDesync(playerid, code);
   			}
            case 32: // CarJack
            {
                new
                    Float:x,
                    Float:y,
                    Float:z;

                AntiCheatGetPos(playerid, x, y, z);
                return SetPlayerPos(playerid, x, y, z);
            }
            case 2: // Teleport Hack
            {
            	format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) Detected usage of cheat: Teleport Hack",GetName(playerid),playerid);
				send_admin_message(COLOR_RED,sath);
                new
                    Float:x,
                    Float:y,
                    Float:z;
                AntiCheatGetPos(playerid, x, y, z);
                return SetPlayerPos(playerid, x, y, z);
            }
            case 6: // Teleport Hack (Pickups)
            {
            	format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) Detected usage of cheat: Teleport (Pickups)",GetName(playerid),playerid);
				send_admin_message(COLOR_RED,sath);
            }
            case 3: // Teleport Hack (In Vehicle)
            {
            	format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) Detected usage of cheat: Teleport (In Vehicle)",GetName(playerid),playerid);
				send_admin_message(COLOR_RED,sath);
            }
            case 11: // Health Hack (In Vehicle)
            {
            	format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) has been caught using cheat: Health Hack (In Vehicle)",GetName(playerid),playerid);
				send_admin_message(COLOR_RED,sath);
            }
            case 12: // Teleport Hack (onfoot)
            {
            	format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) has been caught using cheat: Health Hack (on foot)",GetName(playerid),playerid);
				send_admin_message(COLOR_RED,sath);
            }
            case 9: // SpeedHack (onfoot)
            {
            	format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) has been caught using cheat: Speed Hack (on foot)",GetName(playerid),playerid);
				send_admin_message(COLOR_RED,sath);
            }
            case 10: // SpeedHack (In Vehicle)
            {
            	format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) has been caught using cheat: Speed Hack (In Vehicle)",GetName(playerid),playerid);
				send_admin_message(COLOR_RED,sath);
            }
            case 13: // Armour Hack
            {
            	format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) has been caught using cheat: Armour Hack",GetName(playerid),playerid);
