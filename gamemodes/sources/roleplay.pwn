{
    foreach(new i : Player)
    {
        if(70 <= p_info[i][pJob] <= 72)
        {
            SendClientMessage(i, color, msg);
       	}
   	}
   	return 1;
}
stock SendRazvozMessage(color, msg[])
{
    foreach(new i : Player)
    {
        if(p_info[i][pJob] == 1)
        {
            SendClientMessage(i, color, msg);
       	}
   	}
   	return 1;
}
stock BankDialog(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
	ApplyAnimation(playerid, "CRIB", "CRIB_Use_Switch",4.0,0,0,0,0,0);
	SPD(playerid, 112, DIALOG_STYLE_INPUT, !""c_server"Bank", "[1] My accounts\n[2] {E5D81E}Open new account", "Choose", "Close");
	return 1;
}

function player_registration(playerid)
{
    p_info[playerid][pID] = cache_insert_id();
    p_info[playerid][pSatiety] = 100;
    p_info[playerid][pHeals] = 2;
	cskin[playerid] = 0;
	p_info[playerid][pLogin] = 1;
	p_info[playerid][pWater] = 100; //cMoney
	OnPlayerUpdateAccountsPer(playerid, "pWater", p_info[playerid][pWater]);
	p_info[playerid][cMoney] = 500; //cMoney
	OnPlayerUpdateAccountsPer(playerid, "cMoney", p_info[playerid][cMoney]);
	p_info[playerid][pHungry] = 100;
	OnPlayerUpdateAccountsPer(playerid, "pHungry", p_info[playerid][pHungry]);
	GetClientVersion(playerid);
	SetTimerEx("Set Tag Name", 1000, 0, "i", playerid);
	for(new i;i<2;i++) PlayerTextDrawShow(playerid, HungerTD[playerid][i]);
	PlayerTextDrawShow(playerid, WaterTD[playerid]);
	SetPlayerHealthEx(playerid, 100);

	SendClientMessage(playerid, col_white, !""c_serv"You have successfully completed registration in "c_server""SERVERNAME""c_white".");
	SendClientMessage(playerid, col_white, !""c_serv"Have a good time in "c_server"\""SERVERNAME"\""c_white".");
	SendClientMessage(playerid, col_white, !""c_serv"To complete server quests, use:"c_server"/quest");

	p_info[playerid][setspawn] = 0;
	SpawnPlayer(playerid);

	p_info [ playerid ] [ pRouble ] += bonus_donate ;
    OnPlayerUpdateAccountsPer(playerid, "pRouble", p_info[playerid][pRouble]);
	p_info [ playerid ] [ pLevel ] = bonus_level ;
	OnPlayerUpdateAccountsPer(playerid, "pLevel", p_info[playerid][pLevel]);
	GivePlayerMoneyEx(playerid, bonus_money, "registration");

	return 1;
}

function CameraBihind(playerid) return SetCameraBehindPlayer(playerid);

stock StartSpectate(playerid, specid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
 	{
  		GetPlayerPos(playerid, TeleportDest[playerid][0], TeleportDest[playerid][1], TeleportDest[playerid][2]);
    	TeleportDestNoFloat[playerid][0] = GetPlayerInterior(playerid);
     	TeleportDestNoFloat[playerid][1] = GetPlayerVirtualWorld(playerid);
  	}
	if(IsPlayerInAnyVehicle(specid))
	{
		SetPlayerInterior(playerid, GetPlayerInterior(specid));
		SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(specid));
		TogglePlayerSpectating(playerid, 1);
		PlayerSpectateVehicle(playerid, GetPlayerVehicleID(specid));
		gSpectateID[playerid] = specid;
	}
	else
	{
		SetPlayerInterior(playerid, GetPlayerInterior(specid));
		SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(specid));
		TogglePlayerSpectating(playerid, 1);
		PlayerSpectatePlayer(playerid, specid);
		gSpectateID[playerid] = specid;
	}
	return 1;
}

stock StopSpectate(playerid)
{
	TogglePlayerSpectating(playerid, 0);
	gSpectateID[playerid] = INVALID_PLAYER_ID;
	return 1;
}

stock pay_day_time()
{
    new hour, minute, sec;
	gettime(hour, minute, sec);

    foreach(new i: Player)
	{
	    if(!p_info[i][pLogin]) continue;

        PlayerPlaySound(i, 17803, 0.0, 0.0, 0.0);
	    p_info[i][pZakon]++;

		if(IsAGang(i) || IsAMafia(i))
		{
			if(beg_quest_info[i][b_quest_id] == QUEST_TYPE_GANG && beg_quest_info[i][b_quest_status] == 1)
			{
			    beg_quest_info[i][b_quest_progress] ++;
			    OnPlayerUpdateAccountsPer(i, "b_quest_progress", beg_quest_info[i][b_quest_progress]);

			    if(beg_quest_info[i][b_quest_progress] >= 4)
			    {
			        SendClientMessage(i, col_white, !""c_yellow"Quest:"c_white"You completed the quest 'Bandit'. Use:"c_server"/quest"c_white", to receive an award.");
			        beg_quest_info[i][b_quest_status] = 2;
			        OnPlayerUpdateAccountsPer(i, "b_quest_status", 2);
			    }
			}
			if(beg_quest_info[i][b_quest_id] == QUEST_TYPE_MAF && beg_quest_info[i][b_quest_status] == 1)
			{
			    beg_quest_info[i][b_quest_progress] ++;
			    OnPlayerUpdateAccountsPer(i, "b_quest_progress", beg_quest_info[i][b_quest_progress]);

			    if(beg_quest_info[i][b_quest_progress] >= 4)
			    {
			        SendClientMessage(i, col_white, !""c_yellow"Quest:"c_white"You completed the quest 'Mafiosi'. Use:"c_server"/quest"c_white", to receive an award.");
			        beg_quest_info[i][b_quest_status] = 2;
			        OnPlayerUpdateAccountsPer(i, "b_quest_status", 2);
			    }
			}
		}

		if(beg_quest_info[i][b_quest_id] == QUEST_TYPE_ZAKON && beg_quest_info[i][b_quest_status] == 1)
		{
		    if(p_info[i][pZakon] >= 50)
		    {
		        SendClientMessage(i, col_white, !""c_yellow"Quest:"c_white"You completed the quest 'Law Abiding'. Use:"c_server"/quest"c_white", to receive an award.");
		        beg_quest_info[i][b_quest_status] = 2;
		        OnPlayerUpdateAccountsPer(i, "b_quest_status", 2);
		    }
		}

		text_string[0] = EOS;
        SendClientMessage(i, col_white, "������ ["c_yellow"Bank check"c_white"] ������");
		format(text_string, sizeof(text_string), "Current time: "c_yellow"%02d:%02d", hour, minute);
		SendClientMessage(i, col_white, text_string);

		new salary = p_info[i][pPayCheck];
		if(p_info[i][pLevel] <= 3)
		{
		    new posobie = 100 + random(500);
			format(text_string, sizeof(text_string), "Unemployment benefits: "c_green"%d$", posobie);
			SendClientMessage(i, col_white, text_string);
			GivePlayerBankEx(i, posobie, "benefit");
		}

		if(p_info[i][pVip] == 3) salary *= 2;

		format(text_string, sizeof(text_string), "Salary: "c_green"%d$", salary);
		SendClientMessage(i, col_white, text_string);
		GivePlayerBankEx(i, salary, "salary");

		format(text_string, sizeof(text_string), "Current balance: "c_green"%d$", p_info[i][pBank]);
		SendClientMessage(i, col_white, text_string);

		GameTextForPlayer(i, "~w~PayDay", 5000, 1);
		SendClientMessage(i, col_white, !"����������������������");

	    new exp_amount = 1;
		if(p_info[i][pVip] == 3)
		{
		    exp_amount++;
		    SendClientMessage(i, col_white, !"You received "c_server"x2 salary"c_white" and "c_server"x2 EXP"c_white" due to VIP account.");
		}

		if(bonus_exp) exp_amount++;

		GivePlayerExp(i, exp_amount);

		if(p_info[i][pWanted] > 0)
		{
			p_info[i][pWanted]--;
			SetPlayerWantedLevel(i, p_info[i][pWanted]);
		}
		if(p_info[i][pPayCheck] > 0) OnPlayerUpdateAccountsPer(i, "pPayCheck", 0);
		p_info[i][pPayCheck] = 0;

		if(GetPlayerHouse(i) != -1)
		{
			if(HouseInfo[GetPlayerHouse(i)][hOplata] <= 2) SendClientMessage(i, col_white, !""c_info"You have few paid days left for House.");
		}
		if(GetPlayerBizz(i) != -1)
		{
			if(BizzInfo[GetPlayerBizz(i)][bOplata] <= 2) SendClientMessage(i, col_white, !""c_info"You have few paid days left for business.");
		}
        if(GetPlayerABizz(i) != 0)
		{
			if(BizzAInfo[GetPlayerABizz(i)][aOplata] <= 2) SendClientMessage(i, col_white, !""c_info"You have few paid days left for Gas station.");
		}
        GameTextForPlayer(i, "~w~PayDay", 5000, 1);

		p_info[i][pInGameHourSeconds] = 0;

		text_string[0] = EOS;
		format(text_string, sizeof(text_string), "SELECT * FROM `promocode_activation` WHERE `account_id`='%d' AND `promo_hour`='0' AND `promo_accept`='0'", p_info[i][pID]);
		mysql_tquery(dbHandle, text_string, "bonus_promocode", "d", i);
	}
	format(format_string, 188, "UPDATE `accounts` SET `pInGameHourSeconds`='0', `last_hour`='%d' WHERE `pLogin`='1'", hour);
	mysql_tquery(dbHandle, format_string);
	return 1;
}

stock CheckGoogleAuthenticator(playerid)
{
    if(p_info[playerid][pCheckGoogle] == 1)
	{
		if(strcmp(GetPlayerIpEx(playerid), p_info[playerid][pIp]))
		{
            SetPlayerInterior(playerid, 0);
			SetPlayerFacingAngle(playerid, 179.5547);
			SetPlayerCameraPos(playerid, -1817.0808, 1112.9937, 235.4244);
			SetPlayerCameraLookAt(playerid, -1816.5471, 949.6590, 235.4244);
			TogglePlayerControllableEx(playerid, 0);

            SPD(playerid,137,DIALOG_STYLE_INPUT, !""c_server"Google Authenticator", ""c_white"The security system requests the input of the authentication code.\n\nOpen the 'Google Authenticator' app on your smartphone and enter the code.\nRemember that the code updates in the app every 30 seconds...", "Entry", "Back");
			return 1;
		}
	}
	if(p_info[playerid][pCheckGoogle] == 2)
	{
 		SetPlayerInterior(playerid, 0);
		SetPlayerFacingAngle(playerid, 179.5547);
		SetPlayerCameraPos(playerid, -1817.0808, 1112.9937, 235.4244);
		SetPlayerCameraLookAt(playerid, -1816.5471, 949.6590, 235.4244);
		TogglePlayerControllableEx(playerid, 0);

		SPD(playerid,137,DIALOG_STYLE_INPUT, !""c_server"Google Authenticator", ""c_white"The security system requests the input of the authentication code.\n\nOpen the 'Google Authenticator' app on your smartphone and enter the code.\nRemember that the code updates in the app every 30 seconds...", "Entry", "Back");
		return 1;
	}
	return 1;
}

stock LoadAccounts(playerid)
{
    if(p_info[playerid][pCheckGoogle] == 1 && GetPVarInt(playerid, "AllowPutCode") == 0)
	{
		if(strcmp(GetPlayerIpEx(playerid), p_info[playerid][pIp]))
		{
            SetPlayerInterior(playerid, 0);
			SetPlayerFacingAngle(playerid, 179.5547);
			SetPlayerCameraPos(playerid, -1817.0808, 1112.9937, 235.4244);
			SetPlayerCameraLookAt(playerid, -1816.5471, 949.6590, 235.4244);
			TogglePlayerControllableEx(playerid, 0);

            SPD(playerid,137,DIALOG_STYLE_INPUT, !""c_server"Google Authenticator", ""c_white"The security system requires you to enter the authentication code.\n\nOpen the 'Google Authenticator' app on your smartphone and enter the code\nRemember that the time on your smartphone must be Moscow time...", "Entry", "Back");
			return 1;
		}
	}
	if(p_info[playerid][pCheckGoogle] == 2 && GetPVarInt(playerid, "AllowPutCode") == 0)
	{
 		SetPlayerInterior(playerid, 0);
		SetPlayerFacingAngle(playerid, 179.5547);
		SetPlayerCameraPos(playerid, -1817.0808, 1112.9937, 235.4244);
		SetPlayerCameraLookAt(playerid, -1816.5471, 949.6590, 235.4244);
		TogglePlayerControllableEx(playerid, 0);

		SPD(playerid,137,DIALOG_STYLE_INPUT, !""c_server"Google Authenticator", ""c_white"The security system requires you to enter the authentication code.\n\nOpen the 'Google Authenticator' app on your smartphone and enter the code\nRemember that the time on your smartphone must be Moscow time...", "Entry", "Back");
		return 1;
	}
    format(MySQLStr, 188, "UPDATE `accounts` SET `pIp` = '%s', `pLogin` = 1 WHERE `pID` = %d", GetPlayerIpEx(playerid), p_info[playerid][pID]);
	mysql_tquery(dbHandle, MySQLStr);

	p_info[playerid][pLogin] = 1;

    for(new i;i<2;i++) PlayerTextDrawShow(playerid, HungerTD[playerid][i]);
    PlayerTextDrawShow(playerid, WaterTD[playerid]);
	format(MySQLStr, 128, "SELECT * FROM `notifications` WHERE `user_id` = %d", GetPlayerAccountID(playerid));
	mysql_tquery(dbHandle, MySQLStr, "Show Player Notifications", "d", playerid);

	format(MySQLStr, 128, "SELECT * FROM `admin` WHERE `Name`='%s' LIMIT 1", Name(playerid));
	mysql_tquery(dbHandle, MySQLStr, "is_player_admin", "d", playerid);

	if(GetPlayerHouse(playerid) != -1) { if(HouseInfo[GetPlayerHouse(playerid)][hOplata] <= 3 && HouseInfo[GetPlayerHouse(playerid)][hSlet] == 0) SendClientMessage(playerid, 0xFFE569FF, "You have few paid days left for the house."); }
	if(GetPlayerBizz(playerid) != -1) { if(BizzInfo[GetPlayerBizz(playerid)][bOplata] <= 3 && BizzInfo[GetPlayerBizz(playerid)][bSlet] == 0) SendClientMessage(playerid, 0xFFE569FF, "You have few paid days left for the business."); }
	if(GetPlayerABizz(playerid)) { if(BizzAInfo[GetPlayerABizz(playerid)][aOplata] <= 2 && BizzAInfo[GetPlayerABizz(playerid)][aSlet] == 0) SendClientMessage(playerid, 0xFFE569FF, "You have few paid days left for the gas station."); }
	if(p_info[playerid][pText] == 1) p_info[playerid][pText] = 0, SendClientMessage(playerid, COLOR_LIGHTRED, "You received a warning while offline, more details /warninfo");
	if(p_info[playerid][pText] == 3 && p_info[playerid][pfWarn] > 0) p_info[playerid][pText] = 0, SCMF(playerid, COLOR_LIGHTRED, "You received a warning as the leader of the faction %d/3", p_info[playerid][pfWarn]);
	if(p_info[playerid][pText] == 4) p_info[playerid][pText] = 0, SendClientMessage(playerid, COLOR_LIGHTRED, "You were removed from the leadership of the faction while offline.");

	if(p_info[playerid][pMestoPrison] >= 1 || p_info[playerid][pPrison] >= 1)
	{
	    if(p_info[playerid][pMestoPrison] == 1) // LSPD
	    {
			t_SetPlayerPos(playerid, 264.4681,77.5466,1001.0391);
			SetPlayerInterior(playerid, 6), SetPlayerVirtualWorld(playerid, 1);
		}
		else if(p_info[playerid][pMestoPrison] == 2) // FBI
		{
			t_SetPlayerPos(playerid,198.4545,161.8394,1003.0300);
			SetPlayerInterior(playerid, 3), SetPlayerVirtualWorld(playerid, 2);
		}
		else if(p_info[playerid][pMestoPrison] == 3) // PRISON
		{
		    t_SetPlayerPos(playerid, 3518.8623,1075.6036,17.1577);
			SetPlayerInterior(playerid, 0), SetPlayerVirtualWorld(playerid, 1);
		}
		SetCameraBehindPlayer(playerid);
		//ResetWeapons(playerid);
	}

    if(p_info[playerid][pVipTime] > 0)
	{
		new current_date = getdate(year, month, day);
		new time_left = p_info[playerid][pVipTime] - current_date;
		if(time_left <= 0)
		{
			SendClientMessage(playerid, COLOR_YELLOW, "Your status has expired!");
			p_info[playerid][pVip] = p_info[playerid][pVipTime] = 0;
			OnPlayerUpdateAccountsPer(playerid, "pVIP", p_info[playerid][pVip]);
			OnPlayerUpdateAccountsPer(playerid, "pVipTime", p_info[playerid][pVipTime]);
		}
	}

	SetTimerEx("Update player data after login.", 3000, false, "i", playerid);

    if(p_info[playerid][pLevel] <= 3) SendClientMessage(playerid, col_white, !""c_serv"To complete server quests, use:"c_server"/quest");

	if(GetPVarInt(playerid, "e_time") > gettime() && GetPVarFloat(playerid, "e_X") != 0.0 && GetPVarFloat(playerid, "e_Y") != 0.0 && GetPVarFloat(playerid, "e_Z") != 0.0 && p_info[playerid][pPrison] == 0)

	SpawnPlayer(playerid);
	GetClientVersion(playerid);
	SetTimerEx("Set Tag Name", 1000, 0, "i", playerid);
	return 1;
}

stock GetMonthName(months)
{
    new monthname_str[10];

	switch(months)
	{
		case 1: monthname_str = "January";
		case 2: monthname_str = "February";
		case 3: monthname_str = "March";
		case 4: monthname_str = "April";
		case 5: monthname_str = "May";
		case 6: monthname_str = "June";
		case 7: monthname_str = "July";
		case 8: monthname_str = "August";
		case 9: monthname_str = "September";
		case 10: monthname_str = "October";
		case 11: monthname_str = "November";
		case 12: monthname_str = "December";
	}

	return monthname_str;
}
stock GetWeekDayName(UTC)
{
    new weekday_str[15];
    switch(((gettime()+UTC*3600)/86400)%7)
    {
        case 0: weekday_str = "Thursday";
		case 1: weekday_str = "Friday";
		case 2: weekday_str = "Saturday";
		case 3: weekday_str = "Sunday";
		case 4: weekday_str = "Monday";
		case 5: weekday_str = "Tuesday";
		case 6: weekday_str = "Wednesday";
    }
    return weekday_str;
}

