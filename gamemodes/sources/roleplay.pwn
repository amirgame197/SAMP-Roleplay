	return 1;
}
stock ShowABizz(playerid, i)
{
    new text1[30], tempstring[64];
	if(BizzInfo[i][bLocked]) text1 = "{ff0000}Station closed";
	else text1 = "{00CC33}Station open";

    format(String, sizeof(String), "\
    "c_white"Business number:\t\t# %d\n\
    Name:\t\t\t{CD950C}Gas station '%s'\n\
	"c_white"Owner:\t\t\t%s\n\n\
	City / region:\t\t%s\n\
	Area:\t\t\t\t%s\n\
 	Roof:\t\t\t\t%s\n\
 	Basement rent:\t\t%d$ per day\n\
	Government price:\t\t%d$\n\n\
	Fuel quantity:\t\t%d from %d L\n\
	Fuel price:\t\t%d$ per L\n\
	Gas stations balance:\t\t%d$\n\
	Earnings today:\t\t%d$\n\
	business rented for:\t\t%d/20 days\n\
	"c_white"Status:\t\t\t\t%s",
	i, BizzAInfo[i][aMessage], BizzAInfo[i][aOwner], GetTownName(BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY]), GetAreaName(BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY]), GetMafiaName(BizzAInfo[i][aMafia]), BizzAInfo[i][aArenda], BizzAInfo[i][aBuyPrice], BizzAInfo[i][aProducts],
	BizzAInfo[i][aSklad], BizzAInfo[i][aPrice], BizzAInfo[i][aMoney], BizzAInfo[i][aRaschet], BizzAInfo[i][aOplata], text1);

	if(BizzInfo[i][bSlet] > 0) format(tempstring,sizeof(tempstring),"\n\n{FFE569}Your business is described and is subject to sale to the state."), strcat(String,tempstring);
	else strcat(String,"");
	SPD(playerid,66,DIALOG_STYLE_MSGBOX, !""c_server"Fuel station information", String, "Edit", "Back");
	return 1;
}

