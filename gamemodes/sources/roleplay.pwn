stock IsPlayerGovermentWork(playerid)
{
	if((IsACop(playerid) || IsAMedic(playerid) || IsAArmy(playerid) || p_info[playerid][pMember] == FRACTION_NEWS || p_info[playerid][pMember] == FRACTION_MAYOR) && form_fraction[playerid]) return 1;

	return 0;
}

stock PlayerWinPlayerDice(winner, loser, value_1, winner_dice, loser_dice)
{
    new percent = value_1 / 100,
		cash = value_1;

    new b_id = player_enter_biz[winner];

	GiveBusinessMoney(b_id, percent, 0);

	SendClientMessage(winner, 0x66CC33FF, "Congratulations, you won!");
	GivePlayerMoneyEx(winner, cash, "Game of dice (You won)");

	SendClientMessage(loser, 0xFF5533FF, "Unfortunately, you lost.");
	GivePlayerMoneyEx(loser, -value_1, "Game of dice (lost)");

	format(format_string, 32, "You rolled: %d", winner_dice);
	SetPlayerChatBubble(winner, format_string, 0x66CC33FF, 20.0, 2000);

	format(format_string, 32, "You rolled: %d", loser_dice);
	SetPlayerChatBubble(loser, format_string, 0xFF5533FF, 20.0, 2000);
}

stock SetPlayerMoneyCase(playerid)
{
	if(!p_info[playerid][pMoneyCase]) return 0;
	if(p_info[playerid][pCash] < 10000000) return 0;

    SetPlayerAttachedObject(playerid, 6, 1210, 5, 0.2940, 0.0739, 0.0000, -2.7999, -96.5000, 1.9999, 1.0000, 1.0000, 1.0000);
    return 1;
}

stock RemovePlayerMoneyCase(playerid)
