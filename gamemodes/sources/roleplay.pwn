CMD:f(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);

    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Not allowed government bonus.");

    if(!p_info[playerid][pMember]) return SendClientMessage(playerid, -1, "To use the chat of The organization, you need to be a member!");
	if(sscanf(params, "s[128]",params[0])) return SendClientMessage(playerid, -1, "Enter: /f [text]");

	format(format_string, sizeof(format_string), "* [F] %s[%d]: %s", Name(playerid), playerid, params[0]);
	foreach(new i : Player) if(p_info[playerid][pMember] == p_info[i][pMember]) SendClientMessage(i, 0x93aa00AA,format_string);

	return 1;
}

CMD:fn(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);

    if(!p_info[playerid][pMember]) return SendClientMessage(playerid, -1, "To use the faction chat, you need to be a member of The organization!");
	if(sscanf(params, "s[128]",params[0])) return SendClientMessage(playerid, -1, "Enter: /fn [text]");

	format(format_string, sizeof(format_string), "* [F] %s[%d]: (( %s ))", Name(playerid), playerid, params[0]);
	foreach(new i : Player) if(p_info[playerid][pMember] == p_info[i][pMember]) SendClientMessage(i, 0x93aa00AA,format_string);

	return 1;
}

cmd:leave(playerid, params[])
{
    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, col_white, !""c_error"Can't use command in transport.");

	if(player_news_live[playerid])
	{
	    format(format_string, 144, "[R] %s[%d] left the air independently.", Name(playerid), playerid);
        SendFrac(FRACTION_NEWS, COLOR_GREEN, format_string);

	    SendClientMessage(playerid, COLOR_WHITE, "You left the air.");
	    player_news_live[playerid] = false;
	}
	if(p_info[playerid][pJob] != 0)
	{
		format(String, 96, ""c_white"You are sure you want to quit your job '%s'?", NamesJob(playerid));
		SPD(playerid,153,DIALOG_STYLE_MSGBOX, !""c_server"Dismissal from work", String, "Yes", "No");
	}
	return 1;
}

CMD:time(playerid, params[])
{
	if(p_info[playerid][pClock] == 0) return SendClientMessage(playerid, COLOR_GREY, "You don't have time. Buy from the 24/7 store.");

	SCMF(playerid, COLOR_YELLOW, "Play Time One Hour Ago: %s", ConvertSeconds(p_info[playerid][pInGameHourSeconds]));

	new game_seconds = p_info[playerid][pInGameSeconds];

    new hours = floatround(game_seconds / 3600);
	new mins = floatround((game_seconds / 60) - (hours * 60));

 	new hour,minuite,second;
    gettime(hour,minuite,second);

	format(format_string, 64, "%02i %s %d~n~%d:%02i~n~%02i:%02i",
	    year, GetMonthName(month), day, hour, minuite, hours, mins);

	GameTextForPlayer(playerid, format_string, 3000, 1);

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"COP_AMBIENT","Coplook_watch",4.1,0,0,0,0,0,1);
	format(String, 48, "%s has looked at the time.", Name(playerid));
	ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);

	if(p_info[playerid][pPrison] > 0) SCMF(playerid, COLOR_ISPOLZUY, "You have %d seconds left.", p_info[playerid][pPrison]);
	return 1;
}

