cmd:setanim(playerid, params[])
{
	new anim_id = strval(params);

	if(anim_id == 1) ApplyAnimation(playerid, "BASEBALL","Bat_4",4.0,0,1,1,0,0);
	else if(anim_id == 2) ApplyAnimation(playerid, "PED","eat_gum",4.0,0,1,1,0,0);
	else if(anim_id == 3) ApplyAnimation(playerid, "SCRATCHING","sclng_l",4.0,0,1,1,0,0);
	else if(anim_id == 4) ApplyAnimation(playerid, "CAR_CHAT","CAR_Sc4_BL",4.0,0,1,1,0,0);
	else if(anim_id == 5) ApplyAnimation(playerid, "PAULNMAC","WANK_LOOP",4.0,1,1,1,0,0);
	else if(anim_id == 6) ApplyAnimation(playerid, "Ryder","RYD_Beckon_02",4.0,1,1,1,0,0);
	else if(anim_id == 7) ApplyAnimation(playerid, "Ryder","RYD_Beckon_03",4.0,1,1,1,0,0);
	else SendClientMessage(playerid, -1, "/setanim [1-6]");
	return 1;
}

stock SetPlayerFaceToPoint(playerid, Float:X, Float:Y)
{
	new Float:angle;
	new Float:misc = 5.0;
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	angle = 180.0-atan2(x-X,y-Y);
	angle += misc;
	misc *= -1;
	SetPlayerFacingAngle(playerid, angle+misc);
	return 1;
}
stock GoPlayerAnimation(playerid, Float:X, Float:Y, Float:Z)
{
	if(IsPlayerInAnyVehicle(playerid)) return 0;
	if(IsPlayerInRangeOfPoint(playerid, 2.0, X, Y, Z))
	{
		ApplyAnimation(playerid, "PED", "IDLE_STANCE", 4.1, 0, 1, 1, 0, 0, 1);
		return 1;
	}
	else if(IsPlayerInRangeOfPoint(playerid, 4.0, X, Y, Z))
	{
		ApplyAnimation(playerid, "PED", "WALK_PLAYER", 4.1, 0, 1, 1, 0, 0, 1);
		return 2;
	}
	else if(IsPlayerInRangeOfPoint(playerid, 7.0, X, Y, Z))
	{
		ApplyAnimation(playerid, "PED", "RUN_GANG1", 4.1, 0, 1, 1, 0, 0, 1);
		return 3;
	}
	ApplyAnimation(playerid, "PED", "SPRINT_PANIC", 4.1, 0, 1, 1, 0, 0, 1);
	return 4;
}
stock ShiftCords(&Float:x, &Float:y,Float:a, Float:distance)
{
	x += (distance * floatsin(-a, degrees));
	y += (distance * floatcos(-a, degrees));
	return 1;
}

stock PlayerExitFromClothesShop(playerid)
{
    SetPlayerSkin(playerid, p_info[playerid][pSkin]);

    TogglePlayerControllableEx(playerid, 1);

	new use_bizbar = player_use_bizbar[playerid];

	SetPVarInt(playerid, "next_area", gettime() + 3);

	t_SetPlayerPos(playerid, BizzInfo[use_bizbar][bBarX], BizzInfo[use_bizbar][bBarY], BizzInfo[use_bizbar][bBarZ]);
	SetPlayerInterior(playerid, BizzInfo[use_bizbar][bInterior]);
	SetPlayerVirtualWorld(playerid, BizzInfo[use_bizbar][bVirtualWorld]);

	SetCameraBehindPlayer(playerid);

    DeletePVar(playerid, "VibClothes");
	cskin[playerid] = -1;

	return 1;
}

function PlayerStealFuelFromStation(playerid, fuel_id)
{
	if(player_fuel_steal[playerid] == 100)
	{
	    steal_timer[playerid] = -1;
	    ClearAnimations(playerid);

	    return SendClientMessage(playerid, COLOR_GREEN, "You finished stealing fuel.");
	}

	format(format_string, 32, "FUEL: %d/100", player_fuel_steal[playerid]);
	GameTextForPlayer(playerid, format_string, 3300, 4);

    SetPlayerFaceToPoint(playerid, BizzAInfo[fuel_id][aAreaFillX], BizzAInfo[fuel_id][aAreaFillY]);

    ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.0, 0, 0, 0, 0, 0,1);

	player_fuel_steal[playerid] += 5;

	return steal_timer[playerid] = SetTimerEx("PlayerStealFuelFromStation", 3000, false, "ii", playerid, fuel_id);
}

stock SetPlayerSchoolPoint(playerid)
{
	new road_id = player_road_id[playerid];

	new next_id = (road_id + 1) == sizeof school_road ? sizeof school_road - 1 : road_id + 1;

	SetPlayerRaceCheckpoint(playerid,
		road_id != next_id ? 0 : 1,
		school_road[road_id][0],
		school_road[road_id][1],
		school_road[road_id][2] - 1.0,
		school_road[next_id][0],
		school_road[next_id][1],
		school_road[next_id][2],
		3.0);
}
stock GetNearestRadar(areaid)
{
	for(new i=0;i<MAX_RADARS;i++)
	{
		if(areaid == radar_info[i][radar_area]) return i;
	}
	return -1;
}

stock update_int_sql(playerid, field[], data)
{
	new query_string[128];
	format(query_string, sizeof(query_string), "UPDATE `accounts` SET `%s`='%d' WHERE `pID`='%d' LIMIT 1", field, data, p_info[playerid][pID]);
	mysql_query(dbHandle, query_string);
	return 1;
}

stock update_int_mysql(playerid, column[], value)
{
	new query[256];
	mysql_format(dbHandle, query, sizeof query, "UPDATE accounts SET %s = '%d' WHERE pID = '%d' LIMIT 1", column, value, p_info[playerid][pID]);
	mysql_query(dbHandle, query);
	return 1;
}

stock GetGangZoneColor(g_id)
{
	new zx;
	switch(GZInfo[g_id][gFraction])
	{
		case FRACTION_BALLAS: zx = 0xCC00FFAA;
		case FRACTION_VAGOS: zx = 0xFFCD00AA;
		case FRACTION_GROVE: zx = 0x009900AA;
		case FRACTION_AZTEC: zx = 0x00B4E1AA;
		case FRACTION_RIFA: zx = 0x6666FFAA;
		default: zx = 0xFEFEFEAA;
	}
	return zx;
}

stock GetFractionMemberAmount(bandid)
{
	new np;
	foreach (new i : Player) if(p_info[i][pMember] == bandid) np++;

	return np;
}

stock PlayerToKvadrat(playerid,Float:min_x,Float:min_y,Float:max_x,Float:max_y)
{
	new Float:xxp,Float:yyp,Float:zzp;
	GetPlayerPos(playerid, xxp, yyp, zzp);
	if((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return 1;
	return 0;
}

stock IsGangInWar(gang_id)
{
	foreach(new i : capture_zone_list)
	{
		if(GZInfo[i][gFraction] == gang_id) return 1;
		if(GZInfo[i][gAttack] == gang_id) return 1;
	}

	return 0;
}

stock StartRace()
{
    race_state = 1;
    race_time = 301;

    race_finish_id = 0;
}

stock UpdatePlayerRaceMark(playerid)
{
    new mark_id = player_race_mark[playerid];
    if(mark_id >= sizeof(race_mark_pos)) return 0;
	new Float: x = race_mark_pos[mark_id][0],
		Float: y = race_mark_pos[mark_id][1],
		Float: z = race_mark_pos[mark_id][2],
		Float: x2 = mark_id != sizeof race_mark_pos - 1 ? race_mark_pos[mark_id+1][0] : 0.0,
		Float: y2 = mark_id != sizeof race_mark_pos - 1 ? race_mark_pos[mark_id+1][1] : 0.0,
		Float: z2 = mark_id != sizeof race_mark_pos - 1 ? race_mark_pos[mark_id+1][2] : 0.0;

    //SCMF(playerid, -1, "%d(%d) %f %f %f %f %f %f", mark_id, sizeof race_mark_pos, x, y, z, x2, y2, z2);

	SetPlayerRaceCheckpoint(playerid, mark_id != sizeof race_mark_pos - 1 ? 0 : 1, x, y, z, x2, y2, z2, 5.0);
	return 1;
}

stock PlayerLeaveRace(playerid)
{
	player_race_reg{playerid} = 0;

	DisablePlayerRaceCheckpoint(playerid);

	if(player_race_vehicle[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(player_race_vehicle[playerid]);
    player_race_vehicle[playerid] = INVALID_VEHICLE_ID;
}

stock GetRacePlayersAmount()
{
    new count = 0;

    foreach(Player, i) if(player_race_reg{i}) count++;

    return count;
}

stock show_tune_engine(playerid)
{
	slobal_string[0] = EOS;
	for(new i; i < 5; i++)
	{
	    new vehicleid = GetPlayerVehicleID(playerid);
		new installed = veh_info[vehicleid][vEngineTune][i];

		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\t"c_green"%d$"c_white"\t%s\n", i + 1, engine_ptune[i], engine_ptune_price[i], installed ? (""c_green"Available") : (""c_orange_red"Not available"));
		strcat(slobal_string, text_string);
	}
	strcat(slobal_string, ""c_server"[6]"c_white"Remove modifications\t"c_green"200,000$\n"c_server"[7]"c_white"Repaint the vehicle\t"c_green"15,000$");
	return SPD(playerid, 4619, DIALOG_STYLE_TABLIST, !""c_server"Engine performance", slobal_string, !"Purchase", !"Close");
}

stock show_tune_brake(playerid)
{
    slobal_string[0] = EOS;
	for(new i; i < 5; i++)
	{
	    new vehicleid = GetPlayerVehicleID(playerid);
		new installed = veh_info[vehicleid][vBrakeTune][i];

        text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\t"c_green"%d$"c_white"\t%s\n", i + 1, brake_ptune[i], brake_ptune_price[i], installed ? (""c_green"Available") : (""c_orange_red"Not available"));
		strcat(slobal_string, text_string);
	}
	strcat(slobal_string, ""c_server"[6]"c_white"Remove modifications\t"c_green"200,000$\n"c_server"[7]"c_white"Repaint the vehicle\t"c_green"15,000$");
	return SPD(playerid, 4629, DIALOG_STYLE_TABLIST, !""c_server"Braking system", slobal_string, !"Purchase", !"Close");
}

stock SavePlayerPerfomanceTune(playerid)
{
	format(command_text, 312, "UPDATE `accounts` SET `engine_tune` = '%d,%d,%d,%d,%d|%d,%d,%d,%d,%d|%d,%d,%d,%d,%d' WHERE `pID` = %d",
	player_engine_tune[playerid][0][0],player_engine_tune[playerid][0][1],player_engine_tune[playerid][0][2],player_engine_tune[playerid][0][3],player_engine_tune[playerid][0][4],
	player_engine_tune[playerid][1][0],player_engine_tune[playerid][1][1],player_engine_tune[playerid][1][2],player_engine_tune[playerid][1][3],player_engine_tune[playerid][1][4],
	player_engine_tune[playerid][2][0],player_engine_tune[playerid][2][1],player_engine_tune[playerid][2][2],player_engine_tune[playerid][2][3],player_engine_tune[playerid][2][4],
	p_info[playerid][pID]);

	mysql_tquery(dbHandle, command_text);

	format(command_text, 312, "UPDATE `accounts` SET `brake_tune` = '%d,%d,%d,%d,%d|%d,%d,%d,%d,%d|%d,%d,%d,%d,%d' WHERE `pID` = %d",
	player_brake_tune[playerid][0][0],player_brake_tune[playerid][0][1],player_brake_tune[playerid][0][2],player_brake_tune[playerid][0][3],player_brake_tune[playerid][0][4],
	player_brake_tune[playerid][1][0],player_brake_tune[playerid][1][1],player_brake_tune[playerid][1][2],player_brake_tune[playerid][1][3],player_brake_tune[playerid][1][4],
	player_brake_tune[playerid][2][0],player_brake_tune[playerid][2][1],player_brake_tune[playerid][2][2],player_brake_tune[playerid][2][3],player_brake_tune[playerid][2][4],
	p_info[playerid][pID]);

	mysql_tquery(dbHandle, command_text);

	return printf("Saved Performance Tuning %s", Name(playerid));
}

