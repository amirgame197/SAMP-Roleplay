	SetPlayerPos(playerid, pl_posX, pl_posY, pl_posZ);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] teleported to the vehicle (ID: %d)", Name(playerid), playerid, vehicle_id);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:getcar(playerid, params[])
{
	if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
	extract params -> new vehicle_id; else return SendClientMessage(playerid, col_grey, !"Use: /getcar [vehicle id]");
	if(!(0 <= vehicle_id <= MAX_VEHICLES - 1))
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"Vehicle IDs must be between 0 and %d", MAX_VEHICLES - 1);
		return SendClientMessage(playerid, col_white, text_string);
	}
	new Float:veh_posX, Float:veh_posY, Float:veh_posZ;
	GetPlayerPos(playerid, veh_posX, veh_posY, veh_posZ);
	SetVehicleVirtualWorld(vehicle_id, GetPlayerVirtualWorld(playerid));
	SetVehiclePos(vehicle_id, veh_posX - 4, veh_posY, veh_posZ + 1);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] teleported vehicle (ID: %d) to themselves", Name(playerid), playerid, vehicle_id);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:recar(playerid, params[])
{
	if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
