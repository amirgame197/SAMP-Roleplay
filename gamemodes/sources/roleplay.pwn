	    if(familymaxveh > 7) return SendClientMessage(playerid,COLOR_GREY,"The maximum number of family cars is 7.");
	    if(ffamilyveh1 == 1)
	    {
	    text_string[0] = EOS;
        format(text_string, sizeof(text_string), "familyveh/%s.ini", family_info[family_id - 1][fam_name]);
