stock putqalion(playerid)
{
	new Float:x1,Float:y1,Float:z1;
	GetPlayerPos(playerid,x1,y1,z1);
	Object = CreateObject(19187 , x1 , y1 , z1 , 0.000008 , 0.000025 , -147.861420); //Hookah
	SetObjectMaterial(Object , 1 , 18996 , "mattextures" , "lava1" , 0); //Hookah
	SetObjectMaterial(Object , 0 , 18996 , "mattextures" , "lava1" , 0); //Hookah
	Object1 = CreateObject(2726 , x1-0.017334 , y1-0.017456 , z1-0.390076, 0.000000 , 179.999985 , 3.438703); //Hookah
	SetObjectMaterial(Object1 , 0 , 2592 , "ab_veg" , "ab_slotBase" , -1); //Hookah
