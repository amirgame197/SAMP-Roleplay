stock GetPlayerFreeCarSlot(playerid)
{
	for(new i; i < MAX_PLAYER_VEHICLES; i++) if(CarInfo[playerid][cModel][i] == 0) return i;

	return -1;
}
stock IsAFamilyVehicle(family_id, vehicleid)
{
    for(new i; i < MAX_FAMILY_VEHICLE; i++) if(vehicleid == family_info[family_id][fam_veh][i]) return 1;
    return 0;
}
stock IsAnyFamilyVehicle(vehicleid)
{
    for(new i; i < MAX_FAMILY; i++)
	{
	    for(new b; b < MAX_PLAYER_VEHICLES; b++) if(vehicleid == family_info[i][fam_veh][b]) return 1;
	}
	return 0;
}
stock GetFamilyFreeCarSlot(family_id)
{
	for(new i; i < MAX_FAMILY_VEHICLE; i++)
	{
		if(family_info[family_id][fam_veh][i] == 0)
		{
			printf("FreeSlot:%d",i);
		 	return i;
	 	}
	}

	return -1;
}

stock PlayerInFVehicle(playerid)
{
    new family_id = p_info[playerid][family]-1;
	//if(IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][0]) || IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][1]) || IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][2]) || IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][3]) || IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][4]) || IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][5]) || IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][6]) || IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][7])) return 1;
    for(new i; i < MAX_FAMILY_VEHICLE; i++) if(IsPlayerInVehicle(playerid, family_info[family_id][fam_veh][i]))  return 1;
	return 0;
}
stock PlayerFVehicle(playerid)
{
    new family_id = p_info[playerid][family];
	for(new i; i < MAX_FAMILY_VEHICLE; i++) if(IsPlayerInVehicle(playerid, family_info[family_id-1][fam_veh][i])) return i;

	return -1;
}
stock FamilyHaveVehicle(family_id)
{
    for(new i; i < MAX_FAMILY_VEHICLE; i++) if(family_info[family_id-1][fam_veh][i] != 0) return 1;

	return 0;
}
