stock BulletTazer(playerid, suspectid)
{
	if(GetPVarInt(suspectid, "fTazzer") != 0) return SendClientMessage(playerid, COLOR_GREY, "Player is already subdued, Use /cuff to put on handcuffs.") & 0;

	SCMF(playerid, -1, "You subdued Player %s[%d] for 15 seconds.", Name(suspectid), suspectid);
    format(String, 96, "%s subdued %s with a taser.", Name(playerid), Name(suspectid));
	ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);

	TogglePlayerControllableEx(suspectid, 0);
  	ApplyAnimation(suspectid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0);
  	timer_tazer[suspectid] = SetTimerEx("ClearFreeze", 15000, false, "d", suspectid);

	SetPVarInt(suspectid, "fTazzer", 1);
  	SPD(suspectid, 0, DIALOG_STYLE_MSGBOX, !""c_server"You have been incapacitated by a taser.", ""c_white"You have been incapacitated by a stun gun.\nYou will be unable to move for 15 seconds.", "Close", "");
	return 0;
}
