public OnVehicleRespray(playerid, vehicleid, color1, color2)
{
	new use_car = GetPlayerUseHomeCar(playerid);

    if(use_car == -1 || GetPlayerInterior(playerid) != 0) return 1;
    TuneCost[playerid] = 0, NewColor[playerid][0] = color1, NewColor[playerid][1] = color2;
	new bumper1 = GetVehicleComponentInSlot(use_car, CARMODTYPE_FRONT_BUMPER);
	new bumper2 = GetVehicleComponentInSlot(use_car, CARMODTYPE_REAR_BUMPER);
	new spoiler = GetVehicleComponentInSlot(use_car, CARMODTYPE_SPOILER);
	new nitro = GetVehicleComponentInSlot(use_car, CARMODTYPE_NITRO);
	new wheels = GetVehicleComponentInSlot(use_car, CARMODTYPE_WHEELS);
	new gydra = GetVehicleComponentInSlot(use_car, CARMODTYPE_HYDRAULICS);
	new hood = GetVehicleComponentInSlot(use_car, CARMODTYPE_HOOD);
	new roof = GetVehicleComponentInSlot(use_car, CARMODTYPE_ROOF);
	new sideskirt = GetVehicleComponentInSlot(use_car, CARMODTYPE_SIDESKIRT);
	new lamps = GetVehicleComponentInSlot(use_car, CARMODTYPE_LAMPS);
	new exhaust = GetVehicleComponentInSlot(use_car, CARMODTYPE_EXHAUST);
	new stereo = GetVehicleComponentInSlot(use_car, CARMODTYPE_STEREO);
	new v_right = GetVehicleComponentInSlot(use_car, CARMODTYPE_VENT_RIGHT);
	new v_left = GetVehicleComponentInSlot(use_car, CARMODTYPE_VENT_LEFT);

	new str[124];

	command_text = ""c_white"Tuning has been installed on your vehicle:\n";

	if(CarInfo[playerid][cColor1][use_car]!=color1) TuneCost[playerid]+=5000, strcat(command_text,"\nPrimary color. Price: 5000$");
	if(CarInfo[playerid][cColor2][use_car]!=color2) TuneCost[playerid]+=2500, strcat(command_text,"\nBefore Floor color. Price: 2500$");
	if(CarInfo[playerid][cBumper1][use_car]!=bumper1) TuneCost[playerid]+=VehicleComponent[bumper1-1000][cCost], format(str,64,"\nFront bumper(%s). Price: %d$",VehicleComponent[bumper1-1000][cName],VehicleComponent[bumper1-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cBumper2][use_car]!=bumper2) TuneCost[playerid]+=VehicleComponent[bumper2-1000][cCost], format(str,64,"\nRear bumper(%s). Price: %d$",VehicleComponent[bumper2-1000][cName],VehicleComponent[bumper2-1000][cCost]), strcat(command_text,str);
    if(CarInfo[playerid][cSpoiler][use_car]!=spoiler) TuneCost[playerid]+=VehicleComponent[spoiler-1000][cCost], format(str,64,"\nSpoiler(%s). Price: %d$",VehicleComponent[spoiler-1000][cName],VehicleComponent[spoiler-1000][cCost]), strcat(command_text,str);
    if(CarInfo[playerid][cNitro][use_car]!=nitro) TuneCost[playerid]+=VehicleComponent[nitro-1000][cCost], format(str,64,"\nNitro(%s). Price: %d$",VehicleComponent[nitro-1000][cName],VehicleComponent[nitro-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cWheels][use_car]!=wheels) TuneCost[playerid]+=VehicleComponent[wheels-1000][cCost], format(str,64,"\nWheels(%s). Price: %d$",VehicleComponent[wheels-1000][cName],VehicleComponent[wheels-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cHydrawlic][use_car]!=gydra) TuneCost[playerid]+=VehicleComponent[gydra-1000][cCost], format(str,64,"\nHydraulics(%s). Price: %d$",VehicleComponent[gydra-1000][cName],VehicleComponent[gydra-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cHood][use_car]!=hood) TuneCost[playerid]+=VehicleComponent[hood-1000][cCost], format(str,64,"\nHood(%s). Price: %d$",VehicleComponent[hood-1000][cName],VehicleComponent[hood-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cRoof][use_car]!=roof) TuneCost[playerid]+=VehicleComponent[roof-1000][cCost], format(str,64,"\nRoof (%s). Price: %d$",VehicleComponent[roof-1000][cName],VehicleComponent[roof-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cSideskirt][use_car]!=sideskirt) TuneCost[playerid]+=VehicleComponent[sideskirt-1000][cCost], format(str,64,"\nSkirt(%s). Price: %d$",VehicleComponent[sideskirt-1000][cName],VehicleComponent[sideskirt-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cLamps][use_car]!=lamps) TuneCost[playerid]+=VehicleComponent[lamps-1000][cCost], format(str,64,"\nLights (%s). Price: %d$",VehicleComponent[lamps-1000][cName],VehicleComponent[lamps-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cExhaust][use_car]!=exhaust) TuneCost[playerid]+=VehicleComponent[exhaust-1000][cCost], format(str,64,"\nExhaust (%s). Price: %d$",VehicleComponent[exhaust-1000][cName],VehicleComponent[exhaust-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cStereo][use_car]!=stereo) TuneCost[playerid]+=VehicleComponent[stereo-1000][cCost], format(str,64,"\nStereo (%s). Price: %d$",VehicleComponent[stereo-1000][cName],VehicleComponent[stereo-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cVentRight][use_car]!=v_right) TuneCost[playerid]+=VehicleComponent[v_right-1000][cCost], format(str,64,"\nRight ventilation (%s). Price: %d$",VehicleComponent[v_right-1000][cName],VehicleComponent[v_right-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cVentLeft][use_car]!=v_left) TuneCost[playerid]+=VehicleComponent[v_left-1000][cCost], format(str,64,"\nLeft ventilation (%s). Price: %d$",VehicleComponent[v_left-1000][cName],VehicleComponent[v_left-1000][cCost]), strcat(command_text,str);

	format(str,80,"\n\nTotal cost of all components will be {43CD80}%d$",TuneCost[playerid]), strcat(command_text,str);
	format(str,80,""c_white"Press 'Buy' to save the tuning or 'Cancel' to abort.");

	if(TuneCost[playerid]) SPD(playerid,49,DIALOG_STYLE_MSGBOX, !""c_server"Saving tuning",command_text,"Purchase","Decline");
	return 1;
}

