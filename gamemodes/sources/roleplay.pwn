cmd:getonline(playerid, params[])
{
	if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /getonline [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

	text_string[0] = EOS;
    format(text_string, sizeof(text_string), "SELECT * FROM `online_log` WHERE `user_id`='%d' ORDER BY `id` DESC LIMIT 30", GetPlayerAccountID(targetid));
    new Cache: result = mysql_query(dbHandle, text_string);

    new rows = cache_num_rows();
    if(!rows) return SendClientMessage(playerid, col_white, !""c_error"Online statistics for Player Not found.");

	slobal_string[0] = EOS;
    strcat(slobal_string, ""c_server"Yes\t"c_server"Time\t"c_server"Time in AFK\n");
    for(new i; i < rows; i++)
    {
        new play_day[16], in_game, in_afk;
        cache_get_value_name(i, "day", play_day);
        cache_get_value_int(i, "play_time", in_game);
        cache_get_value_int(i, "afk_time", in_afk);

		text_string[0] = EOS;
        format(text_string, sizeof(text_string), ""c_white"%s\t%s\t%s\n", play_day, convert_time(in_game), convert_time(in_afk));
        strcat(slobal_string, text_string);
    }
    cache_delete(result);

    return SPD(playerid, 0000, DIALOG_STYLE_TABLIST, Name(targetid), slobal_string, !"Close", !"");
}

