				        SendClientMessage(playerid, col_white, !""c_yellow"Quest:"c_white" You completed the quest 'Purchase of Phone'. Use: "c_server"/quest"c_white", to receive an award.");
				        beg_quest_info[playerid][b_quest_status] = 2;
				        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
					}
   				}
   				case 1:
				{
					if(p_info[playerid][pProducts][0] == 0) return SendClientMessage(playerid, COLOR_GREY, "You do not have a Phone.");

				    return SPD(playerid, 62, DIALOG_STYLE_INPUT, !""c_server"Purchase of a number", ""c_white"Enter the desired number for purchase\n\n{66CC00}Note:"c_white"\n- The number must consist of 6 digits.\n- The number cannot start with '0'", "Input", "Cancel");
				}
			   /*	case 2:
