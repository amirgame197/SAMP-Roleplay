	if(areaid == duel_area)
	{
	    if(!IsAGang(playerid)) return SendClientMessage(playerid, col_white, !""c_error"Leave, you are not welcome here.");

		slobal_string[0] = text_string[0] = EOS;
	    for(new i, z = sizeof(duel_weapons_id); i < z; i++)
	    {
	        format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\n", i + 1, duel_weapons_name[i]);
	        strcat(slobal_string, text_string);
