cmd:admins(playerid)
{
	if(!admin_level[playerid] && !p_info[playerid][pVip]) return 1;

	new admins_online = 0, admin_rang[21], status[24];
	dlobal_string[0] = EOS;
	foreach(new i: admin_list)
 	{
		switch(admin_level[i])
		{
		    case 1: admin_rang = "Helper";
		    case 2: admin_rang = "Admin New";
		    case 3: admin_rang = "Admin Simple";
		    case 4: admin_rang = "Admin Senior";
		    case 5: admin_rang = "Admin Expert";
		    case 6: admin_rang = "Head of Staff";
			case 7: admin_rang = "Project Manager";
			case 8: admin_rang = "Founder";
		}
		if(player_mobile[i] == true) status = ""c_yellow"[Phone]";
		else status = ""c_server"[PC]";

		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_white"%d\t%s\t%s\t%s%s\n", i, Name(i), admin_rang, status, afk_time[playerid] > 2 ? ("AFK") : (""));
		strcat(dlobal_string, text_string);
		admins_online++;
	}
	if(admins_online > 0) SPD(playerid, 0000, DIALOG_STYLE_TABLIST, !""c_white"Admins "c_green"[Online]", dlobal_string, !"Close", !"");
	else SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_white"Admins "c_green"[Online]", !""c_white"No Admin is Online", !"Close", !"");
	return 1;
}

