stock MenuAtms(playerid)
{
	new atm = GetPlayerUseListitem(playerid);

    ApplyAnimation(playerid, "CRIB", "CRIB_Use_Switch",4.0,0,0,0,0,0);
    if(atm != 0) PlayerPlaySoundEx(4203, AtmsInfo[atm][aObjectPosX], AtmsInfo[atm][aObjectPosY], AtmsInfo[atm][aObjectPosZ]);
	return SPD(playerid,73,DIALOG_STYLE_LIST, !""c_server"BANKING SERVICES", ""c_white"[1] WITHDRAW FROM ACCOUNT\n[2] DEPOSIT TO ACCOUNT\n[3] ACCOUNT BALANCE\n[4] WITHDRAW FROM BUSINESS ACCOUNT\n[5] DEPOSIT TO BUSINESS ACCOUNT\n[6] PURCHASE PHONE CHARGE\n[7] CARD TO CARD", "Choose", "Back");
}

stock OprDialog(playerid)
{
    String = "";
    strcat(String, "[1] Account information\n[2] Withdraw money\n[3] Deposit money\n[4] Rename account\n[5] Change PIN code");
    if(p_info[playerid][pLevel] >= 4) strcat(String, "6. Transfer money to another account");
 	SPD(playerid,116,DIALOG_STYLE_LIST, !""c_server"List of operations", String, "Choose", "Back");
 	return 1;
}

stock PlayerMuted(playerid)
{
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_error"Your chat is blocked | "c_orange"%s", convert_time(p_info[playerid][mute]));
	SendClientMessage(playerid, col_white, text_string);

	SetPlayerChatBubble(playerid, "Trying to say something..", col_orange_red, 15.0, 5000);
	return 1;
}

forward bus_stop(playerid);
public bus_stop(playerid)
{
	busPos{playerid}++;
	SetNextCP(playerid,busPos{playerid});
	return 1;
}

stock SetNextCP(playerid,pos)
{
	if(pos < 0) return 0;

	new type = 0;
	if(p_info[playerid][pJob] == 2)
	{
	    new route = player_route_id[playerid];
		GivePlayerPayCheck(playerid, 15);
		if(gBusCPs[route][pos][0] == gBusCPs[route][pos+1][0] && gBusCPs[route][pos][1] == gBusCPs[route][pos+1][1]) type = 1;
		SetPlayerRaceCheckpoint(playerid,type,gBusCPs[route][pos][0],gBusCPs[route][pos][1],gBusCPs[route][pos][2],gBusCPs[route][pos+1][0],gBusCPs[route][pos+1][1],gBusCPs[route][pos+1][2],4.0);
	}
	else if(p_info[playerid][pJob] == 3)
	{
	    new route = player_route_id[playerid];
		p_t_info[playerid][pWorkSalary] += 30;

		if(gUborkaCPs[route][pos][0] == gUborkaCPs[route][pos + 1][0] && gUborkaCPs[route][pos][1] == gUborkaCPs[route][pos + 1][1]) type = 1;
		SetPlayerRaceCheckpoint(playerid, type, gUborkaCPs[route][pos][0], gUborkaCPs[route][pos][1], gUborkaCPs[route][pos][2], gUborkaCPs[route][pos + 1][0], gUborkaCPs[route][pos + 1][1], gUborkaCPs[route][pos + 1][2], 4.0);
	}
	return 1;
}

stock spawned_bus(playerid)
{
    DisablePlayerRaceCheckpoint(playerid);
    SetVehicleToRespawn(p_t_info[playerid][pBusID]);
    player_route_id[playerid] = 0;
    SendClientMessage(playerid, -1, "You have completed the workday. Salary will be credited to you in the new hour.");//GetPVarInt(playerid, #busMoney));
    SendClientMessage(playerid,0xafafafff,"Salary will be credited to your account on payday.");
    busPos{playerid} = 0;
    if(p_t_info[playerid][bus_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(p_t_info[playerid][bus_text]);
		p_t_info[playerid][bus_text] = Text3D:INVALID_3DTEXT_ID;
	}
	p_t_info[playerid][pBusID] = 0;
	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
    return 1;
}

stock spawned_uborka(playerid)
{
    DisablePlayerRaceCheckpoint(playerid);
    SetVehicleToRespawn(p_t_info[playerid][puborkacar]);
    player_route_id[playerid] = 0;

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_info"You have completed the workday. Salary: "c_green"%d$", p_t_info[playerid][pWorkSalary]);
    SendClientMessage(playerid, col_white, text_string);

    GivePlayerMoneyEx(playerid, p_t_info[playerid][pWorkSalary], "street cleaner salary");
    uborkaPos{playerid} = 0;

	if(p_t_info[playerid][uborka_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(p_t_info[playerid][uborka_text]);
		p_t_info[playerid][uborka_text] = Text3D:INVALID_3DTEXT_ID;
	}

    p_t_info[playerid][puborkacar] = 0;
    p_t_info[playerid][pWorkSalary] = 0;
	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
    return 1;
}

stock OnlineJobTaxi(bizz)//???
{
	new null = 0;
    foreach(new i : Player) if(p_info[i][pJob] == bizz) null ++;
	return null;
}
