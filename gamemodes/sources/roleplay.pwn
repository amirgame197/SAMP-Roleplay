}

stock StartElecation()
{
	elecation_enter[0] = CreatePickup(1318, 23, 1403.0417,-35.7121,1000.9287, 2);
	elecation_enter[1] = CreatePickup(1318, 23, 1390.1262,-20.8928,2001.4272, 5);

	elecation_bulletin = CreatePickup(1239, 23, 1386.4092,-22.4811,2001.4272, 5);
	elecation_vote = CreatePickup(1239, 23, 1382.1768,-18.8566,2001.4272, 5);

	elecation_3d[0] = CreateDynamic3DTextLabel("Ballots", -1, 355.3703,197.3750,1014.1875, 10.0);
	elecation_3d[1] = CreateDynamic3DTextLabel("Voting", -1, 339.3915,189.2679,1014.1797, 10.0);
}

stock StopElecation()
{
	for(new i; i < 2; i++)
	{
	    DestroyDynamic3DTextLabel(elecation_3d[i]);
		DestroyPickup(elecation_enter[i]);
	}

	DestroyPickup(elecation_bulletin);
	DestroyPickup(elecation_vote);
}

