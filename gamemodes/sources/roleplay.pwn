forward ServerTDCCV();
public ServerTDCCV()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        new Colorss[] = {0x91d29aFF, 0xFF8282AA, 0x33AAFFFF, 0x940000AA, 0x33CCFFAA, 0x03fce7FF, 0xFFC100FF, 0xFF9A00FF, 0xFF7400FF, 0xFF4D00FF, 0xFF0000FF};//Untuk warna yang diinginkan//Colors what you want
        TextDrawHideForPlayer(i,SERVERTD[3]);
        TextDrawColor(SERVERTD[3],Colorss[random(sizeof(Colorss))]);
        TextDrawShowForPlayer(i,SERVERTD[3]);
        SetTimer("TextdrawColorChange", 100, 0);
    }
}
forward ServerTDCC();
public ServerTDCC()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        new Colorss[] = {0x91d29aFF, 0xFF8282AA, 0x33AAFFFF, 0x940000AA, 0x33CCFFAA, 0x03fce7FF, 0xFFC100FF, 0xFF9A00FF, 0xFF7400FF, 0xFF4D00FF, 0xFF0000FF};//Untuk warna yang diinginkan//Colors what you want
        TextDrawHideForPlayer(i,SERVERTD[4]);
        TextDrawColor(SERVERTD[4],Colorss[random(sizeof(Colorss))]);
        TextDrawShowForPlayer(i,SERVERTD[4]);
        SetTimer("TextdrawColorChange", 100, 0);
    }
}


forward Hacking(playerid);
public Hacking(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid, 5.0, 147.97, -1962.98, 3.77))
	{
	ClearAnimations(playerid);
 	GivePlayerMoneyEx(playerid, 20000, "You hacked the system for $20,000.");
  	SendClientMessage(playerid, COLOR_YELLOW, "[Rob System] You are hacking the system and giving $20,000!");
  	} else SendClientMessage(playerid, COLOR_ABOL, "[Rob System] Hacking failed.");
  	ClearAnimations(playerid);
	return 1;
}








cmd:levelall(playerid, params[])
{
    if(admin_level[playerid] < 8) return 1;
    extract params -> new level; else return SendClientMessage(playerid, col_grey, !"CMD: /levelall [level]");

    for (new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(IsPlayerConnected(i) && p_info[i][pLogin] != 0)
        {
                    p_info[i][pLevel] += level;
  SetPlayerScore(i, p_info[i][pLevel]);
  update_int_sql(i, "pLevel", p_info[i][pLevel]);
        }
  }

  text_string[0] = EOS;
  format(text_string, sizeof(text_string), ""c_info"Admin "c_server"%s"c_white" give level all : "c_green"%d$",Name(playerid), level);
  SendClientMessage(playerid, col_white, text_string);
  return 1;
}
cmd:moneyall(playerid, params[])
{
    if(admin_level[playerid] < 8) return 1;
    extract params -> new give_money; else return SendClientMessage(playerid, col_grey, !"CMD: /moneyall [Money]");

    for (new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(IsPlayerConnected(i) && p_info[i][pLogin] != 0)
        {
          GivePlayerMoneyEx(i, give_money, "givemoney");
          SendClientMessage(i, -1 , "You Give Money");
    }
  }

  text_string[0] = EOS;
  format(text_string, sizeof(text_string), ""c_info"Admin "c_server"%s"c_white" give money all : "c_green"%d$",Name(playerid), give_money);
  SendClientMessage(playerid, col_white, text_string);
  return 1;

}
CMD:gotoxyz(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
