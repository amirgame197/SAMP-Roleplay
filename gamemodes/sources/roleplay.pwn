stock ALogin(playerid)
{
	if(!strcmp(p_info[playerid][pAdminKey], "0", true)) return SPD(playerid, 6, DIALOG_STYLE_INPUT, !""c_server"Password registration", ""c_white"Enter the desired password to access the admin panel:\n\n- The password must not contain Russian characters\n- The password must be between 4 and 12 characters long.", "Enter", "Back");
	else SPD(playerid, 7, DIALOG_STYLE_INPUT, !""c_server"Administrator", !""c_white"Enter the Admin Password:", !"OK", !"Cancel");
	return 1;
}

stock Trucker_StopJob(playerid)
{
	if(IsPlayerInAnyVehicle(playerid)) RemovePlayerFromVehicleEx(playerid);

	if(rent_job_vehicle[playerid] != INVALID_VEHICLE_ID) SetVehicleToRespawn(rent_job_vehicle[playerid]);
	p_t_info[playerid][pTrucker_Unit] = 0;
	p_t_info[playerid][pTrucker] = -1;
	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;

	p_t_info[playerid][pTrucker_Access] = false;
	return 1;
}

@timerforplayerhsh();
@timerforplayerhsh()
{
    new stringdate[30],year,month,day,hours,minutes,seconds;
    getdate(year, month, day);
    gettime(hours, minutes, seconds);
    format(stringdate, sizeof stringdate, "%d-%s%d-%s%d/%02d:%02d:%02d", day, ((month < 10) ? ("0") : ("")), month, (year < 10) ? ("0") : (""), year, hours, minutes, seconds);
    TextDrawSetString(Datum, stringdate);
    return 1;
}

@TruckerTimer(playerid);
@TruckerTimer(playerid)
{
	new newcar = GetPlayerVehicleID(playerid);
	TogglePlayerControllable(playerid, true);

	DisablePlayerCheckpoint(playerid);

	switch(p_t_info[playerid][pTrucker])
	{
		case 0:
		{
			p_t_info[playerid][pTrucker] = 1;

			SendClientMessage(playerid, col_white, !""c_info"Truck loaded, head to the unloading area.");

			new str[64];
			format(str, sizeof str, "Cargo quantity: "c_server"%d/%d", p_t_info[playerid][pTrucker_Unit], MAX_UNIT);

			if(gruz_3d[newcar] == Text3D:0)
				gruz_3d[newcar] = CreateDynamic3DTextLabel(str, col_white, 0.0, 0.0, 0.0, 15.0, INVALID_PLAYER_ID, rent_job_vehicle[playerid]);
			else
				UpdateDynamic3DTextLabelText(gruz_3d[newcar], col_white, str);

			new index = sizeof(trucker_checkpoints) - 1;
			SetPlayerCheckpoint(playerid, trucker_checkpoints[index][0], trucker_checkpoints[index][1], trucker_checkpoints[index][2], 10.0);
		}
		case 1:
		{
			p_t_info[playerid][pTrucker] = -1;

			new money = p_t_info[playerid][pTrucker_Unit] * UNIT_PRICE;
			GivePlayerMoneyEx(playerid, money + floatround(money * SALARY_PRECENTAGE), "unloading cargo");
			p_t_info[playerid][pTrucker_Unit] = 0;

			text_string[0] = EOS;
			format(text_string, sizeof(text_string), ""c_info"Unloading completed, you earned: "c_green"%d$", money + floatround(money * SALARY_PRECENTAGE));
			SendClientMessage(playerid, col_white, text_string);

			new str[64];
			format(str, sizeof(str), "Cargo quantity: "c_server"%d/%d", p_t_info[playerid][pTrucker_Unit], MAX_UNIT);
			UpdateDynamic3DTextLabelText(gruz_3d[newcar], col_white, str);

			SPD(playerid, 231, DIALOG_STYLE_LIST, !""c_server"Warehouse selection", !""c_server"[1]"c_white"Arms factory\n"c_server"[2]"c_white"Mine\n"c_server"[3]"c_white"Sawmill\n", !"Choose", !"Cancel");
		}
	}
	return 1;
}

stock Pilot_StopJob(playerid) {
	if(IsPlayerInAnyVehicle(playerid))
		RemovePlayerFromVehicleEx(playerid);
	p_t_info[playerid][pPilot_Access] = false;
	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
	p_t_info[playerid][pPilot] =
	p_t_info[playerid][pPilot_Checkpoint] = 0;
	return 1;
}

