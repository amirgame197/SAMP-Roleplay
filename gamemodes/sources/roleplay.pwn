			format(sath,sizeof(sath),"[Av-AntiCheat] %s(%d) Detected usage of cheat: FlyHack (on foot)",GetName(playerid),playerid);
			send_admin_message(COLOR_RED,sath);
			AntiCheatKickWithDesync(playerid, code);
   			}
 			case 8:// Anti-FlyHack (in vehicle)
