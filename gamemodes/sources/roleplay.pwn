cmd:infoip(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
	extract params -> new string:player_ip[32]; else return SendClientMessage(playerid, col_grey, !"Use: /getipinfo [IP address].");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "infernorp123.000webhostapp.com/geo/index.php?ip=%s", player_ip);
    return HTTP(playerid, HTTP_GET, text_string, "", "player_infoip");
}

