stock GetPlayerGangWHID(playerid)
{
	switch(p_info[playerid][pMember])
	{
	    case FRACTION_BALLAS: return 0;
		case FRACTION_VAGOS: return 1;
		case FRACTION_GROVE: return 2;
		case FRACTION_AZTEC: return 3;
		case FRACTION_RIFA: return 4;

		case FRACTION_YAKUZA: return 5;
		case FRACTION_COLUMBIA: return 6;
		case FRACTION_RUMAFIA: return 7;

		case FRACTION_BIKER: return 8;
	}

	return -1;
}

