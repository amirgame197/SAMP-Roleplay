    format(format_string, 188, "[Central Radio] %s[%d] Is Committing Jewelry Theft.", Name(playerid), playerid);
    SendFrac(1, 0x42B66FFF, format_string);
    format(format_string, 188, "[Central Radio] %s[%d] Is Committing Jewelry Theft.", Name(playerid), playerid);
    SendFrac(2, 0x42B66FFF, format_string);
    GivePlayerMoneyEx(playerid, 25000, "You Stole Jewelry Worth $25,000!");
    SendClientMessage(playerid, COLOR_GREEN, !""c_green"Rob Jewelry System | You Stole From Jewelry.");
    p_info[playerid][pWanted] = 6;
   	SetPlayerWantedLevel(playerid, 5);
   	ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
    ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
}
    else
{
    SendClientMessage(playerid, COLOR_RED, !""c_error"Rob Jewelry System Command Error");
}

    return 1;
}
