cmd:srep(playerid, params[])
{
    if(!admin_level[playerid] || !admin_logged[playerid]) return 1;
	for(new i; i < max_question; i++)
	{
		if(question_player[i] != -1)
		{
			if(question_slot[i] == 1) continue;

			new dialog_string[400];
			format(dialog_string, sizeof(dialog_string), "\
			"c_white"Question from %s[%d]\n\n\
			"c_server"%s\n", Name(question_player[i]), question_player[i], question_text[i]);
			SPD(playerid, 9946, DIALOG_STYLE_INPUT, !""c_server"Question", dialog_string, !"Accept", !"Cancel");

			question_id[playerid] = i;
			question_slot[i] = 1;

			format_string[0] = EOS;
			format(format_string, sizeof(format_string), ""c_info"Game assistant %s has started processing your question", Name(playerid));
			SendClientMessage(question_player[i], col_white, format_string);
			return 1;
		}
	}
	return SendClientMessage(playerid, col_white, !""c_error"At the moment, the list of questions is empty.");
}

cmd:ans(playerid, params[])
{
    if(!admin_level[playerid] || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, string:ans_text[128]; else return SendClientMessage(playerid, col_grey, "Use: /ans [Player id] [text]");
	if(!IsPlayerConnected(targetid) || playerid == targetid) return SendClientMessage(playerid, col_grey, !"Player not found.");

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "Administrator %s: %s", Name(playerid), ans_text);
    SendClientMessage(targetid, 0xFF9945FF, text_string);

	format(text_string, sizeof(text_string), "Administrator %s[%d] for %s[%d]: %s", Name(playerid), playerid, Name(targetid), targetid, ans_text);
	send_admin_message(0xFF9945FF, text_string);

	p_info[playerid][pAdmRep] = p_info[playerid][pAdmRepDay] += 1;

	if(admin_level[playerid])
	{
		format(text_string, sizeof(text_string), "UPDATE `admin` SET `pAdmRep`='%d',`pAdmRepDay`='%d' WHERE `Name`='%s'", p_info[playerid][pAdmRep], p_info[playerid][pAdmRepDay], Name(playerid));
		mysql_query(dbHandle, text_string);
	}
	PlayerPlaySound(targetid, 1085, 0.0, 0.0, 0.0);
	return 1;
}

