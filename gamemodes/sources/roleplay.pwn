CMD:leaders(playerid, params[])// Leader?
{
    format(MySQLStr, 244, "SELECT acc.`pName`, acc.`pLeader`, acc.`pNumber` FROM `accounts` acc WHERE acc.`pLeader` > 0 AND NOT EXISTS (SELECT * FROM `admin` adm WHERE acc.pName = adm.Name)");
	return mysql_tquery(dbHandle, MySQLStr, "OnMySQL_Query","dd", playerid, 28);
}

CMD:members(playerid, params[])
{
	if(!p_info[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "You are not part of a faction.");

	new want_text[188], count = 0;
	new m_id = p_info[playerid][pMember];

	String = "";

    foreach(new i:Player)
    {
        if(p_info[i][pMember] != m_id) continue;

		new rank = p_info[i][pRank];

		format(want_text, 188, ""c_white"Level: %d | ????: %s(%d) | ???: %s | Name: %s[%d]\n",
			p_info[i][pLevel], FracRank[m_id][rank], p_info[i][pRank], p_info[i][pNumber] ? IntToString(p_info[i][pNumber]) : ("No"), Name(i), i);

		strcat(String, want_text);

		count++;
    }

    if(count == 0) strcat(String, ""c_white"Information not found");

	return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Eezay The organization online", String, "Close", "");
}

alias:setspawn("changespawn", "spa")
cmd:setspawn(playerid)
{
    SPD(playerid, 8, DIALOG_STYLE_LIST, !""c_server"Choose Your Spawn Location", !""c_server"[1]"c_white" At the station\n"c_server"[2]"c_white" In your own House\n"c_server"[3]"c_white" organization's base\n"c_server"[4]"c_white" In the hotel\n"c_server"[5]"c_white" In the family House", !"Choose", !"Cancel");
	return 1;
}

CMD:changeskin(playerid, params[])
{
	if(p_info[playerid][pMember] == 0) return SendClientMessage(playerid,COLOR_GREY,"You are not part of a faction.");
    if(p_info[playerid][pRank] < FracInfo[p_info[playerid][pMember]][fRankMax]-1) return SendClientMessage(playerid,COLOR_GREY,"before only to Leader and Deputy.");

	if(sscanf(params, "ud",params[0],params[1])) return SCMF(playerid, -1, "Enter: /changeskin [playerid] [0 - %d]", FracInfo[p_info[playerid][pMember]][fSkinKolvo]-1);

	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(p_info[playerid][pMember] != p_info[params[0]][pMember]) return SendClientMessage(playerid,COLOR_GREY,"The person is not from your faction.");
	if(params[1] > FracInfo[p_info[params[0]][pMember]][fSkinKolvo]-1 || params[1] < 0) return SCMF(playerid, COLOR_GREY, "In your organization, there are only %d skins. Use from 0 to %d", FracInfo[p_info[params[0]][pMember]][fSkinKolvo], FracInfo[p_info[params[0]][pMember]][fSkinKolvo]-1);
	if(!IsAMafia(playerid) && !IsAGang(playerid) && form_fraction[params[0]] == 0) return SendClientMessage(playerid, COLOR_GREY, "Player is not in work uniform.");

	SetPlayerSkinEx(params[0], FracInfo[p_info[params[0]][pMember]][fSkin][params[1]]);
	p_info[params[0]][pFrSkin] = FracInfo[p_info[params[0]][pMember]][fSkin][params[1]];

	SCMF(params[0], 0x1CCCE6FF, "Leader of the faction %s[%d] changed your skin to %d-th.", Name(playerid), playerid, params[1]);
    SCMF(playerid, 0x1CCCE6FF, "You changed skin %s[%d] to %d-th.", Name(params[0]), params[0], params[1]);

	return 1;
}

cmd:pay(playerid, params[])
{
	extract params -> new player:targetid, pay_cash; else return SendClientMessage(playerid, col_grey, !"Use: /pay [Player id] [amount]");
	if(!IsPlayerConnected(targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
	if(!p_info[targetid][pLogin]) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(afk_time[targetid] >= 2) return SendClientMessage(playerid, col_white, !""c_error"The player is AFK.");
	if(!ProxDetectorS(5.0, playerid, targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player is too far away.");
	if(pay_cash < 1 || pay_cash > 100000) return SendClientMessage(playerid, col_white, !""c_error"The amount must be in the range from $1 to $100,000.");
	if(pay_cash > p_info[playerid][pCash]) return SendClientMessage(playerid, col_white, !""c_error"You do not have enough funds.");

	GivePlayerMoneyEx(playerid, -pay_cash, "Transfer Player");
	GivePlayerMoneyEx(targetid, pay_cash, "Transfer Player");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You successfully transferred "c_green"%d$"c_white" Player "c_server"%s", pay_cash, Name(targetid));
	SendClientMessage(playerid, col_white, text_string);

	format(text_string, sizeof(text_string), ""c_info""c_server"%s"c_white" transferred to you "c_green"%d$", Name(playerid), pay_cash);
	SendClientMessage(targetid, col_white, text_string);

	new string[90];
	format(string, sizeof(string), "has withdrawn the money and transferred it to %s.", Name(targetid));
	me_action(playerid, string);
	return 1;
}

cmd:plist(playerid)
{
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "SELECT `promo_name`,`promo_hour` FROM `promocode_activation` WHERE `account_id`='%d' AND `promo_accept`='0'", p_info[playerid][pID]);
	new Cache:result = mysql_query(dbHandle, text_string);

    new rows = cache_num_rows();
    if(!rows) return SendClientMessage(playerid, col_white, !""c_error"You have no active promo codes.");

    dlobal_string[0] = format_string[0] = EOS;
    for(new i; i < rows; i++)
    {
		new promo_name[64], promo_hour;
		cache_get_value_name(i, "promo_name", promo_name);
		cache_get_value_name_int(i, "promo_hour", promo_hour);

		format(format_string, sizeof(format_string), "%s\t"c_yellow"%s\n", promo_name, convert_cmd_time(promo_hour));
		strcat(dlobal_string, format_string);
    }
	SPD(playerid, 0000, DIALOG_STYLE_TABLIST, !""c_server"List of promo codes", dlobal_string, !"Close", !"");

	cache_delete(result);
	return 1;
}

