CMD:sellskin(playerid,params[])
{
    new i = player_enter_biz[playerid];
	if(!PlayerToPoint(15.0, playerid,BizzInfo[i][bExitX], BizzInfo[i][bExitY], BizzInfo[i][bExitZ]) || BizzInfo[i][bType] != 6)
		return SendClientMessage(playerid, COLOR_GREY, "You are not in the clothing store!");

	if(GetPlayerSkin(playerid) != p_info[playerid][pSkin]) return SendClientMessage(playerid, COLOR_GREY, "You are not in the main outfit.");

    if(sscanf(params,"ii",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/sellskin [Player id] [amount]");
    if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	//if(IsACop(params[0])) return SendClientMessage(playerid,0xafafafff,"Player Flooricy");
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"You cannot use this on yourself.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid,COLOR_GREY,"The player should be with you beforehand.");

	if(GetPlayerSkin(params[0]) != p_info[params[0]][pSkin]) return SendClientMessage(playerid, COLOR_GREY, "Player is not in the main outfit.");

	if(!(1 <= params[1] <= 1000000)) return SendClientMessage(playerid, COLOR_GREY, "Enter amounts from 1 to 1,000,000$");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "The player already has an incoming trade request!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_SELLSKIN, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "You offered %s an exchange of clothing with his payment: $%d", Name(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s offered you an exchange of clothing with your payment: $%d", Name(playerid), params[1]);

    return SendClientMessage(params[0], -1, "To agree, press Y(/accept) or for refusal, N(/cancel).");
}

CMD:ticket(playerid,params[])
{
	if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Only available to government structures.");

    if(sscanf(params,"iis[64]",params[0], params[1], params[2])) return SendClientMessage(playerid, 0xafafafff, "/ticket [Player id] [amount] [Cause]");
    if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(IsACop(params[0])) return SendClientMessage(playerid,0xafafafff,"Player Flooricy");
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"You cannot equip weapons on yourself.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid,COLOR_GREY,"The player should be with you beforehand.");

	if(!(1 <= params[1] <= 50000)) return SendClientMessage(playerid, COLOR_GREY, "Only amounts from $1 to $50,000 are allowed.");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "The player already has an incoming trade request!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_TICKET, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "You sent a request %s for the amount of $%d. Cause: %s", Name(params[0]), params[1], params[2]);
	SCMF(params[0], 0x6BB3FFAA, "%s sent you a request for the amount of $%d. Cause: %s", Name(playerid), params[1], params[2]);

    return SendClientMessage(params[0], -1, "To agree, press Y(/accept) or for refusal, N(/cancel).");
}

CMD:gt(playerid,params[])
{
    if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Only available to government structures.");

    if(sscanf(params,"i",params[0])) return SendClientMessage(playerid, 0xafafafff, "/gotome [Player id]");
    if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid,0xafafafff, "Player offline");
	if(IsACop(params[0])) return SendClientMessage(playerid,0xafafafff,"Player Flooricy");
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"You can't put handcuffs on yourself.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid,COLOR_GREY,"The player should be with you beforehand.");
	if(IsACop(params[0])) return SendClientMessage(playerid, COLOR_GREY,"You can't handcuff a lawyer.");
	if(!PlayerCuffed[params[0]]) return SendClientMessage(playerid, COLOR_GREY,"Player not in handcuffs");
	if(!p_info[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY,"Man is not a criminal");
	if(GetPlayerState(params[0]) != PLAYER_STATE_ONFOOT) return SendClientMessage(playerid, COLOR_GREY, "The Player is not on foot.");

    if(follow_id[params[0]] != INVALID_PLAYER_ID)
	{
		ClearAnimations(params[0], true);
        follow_id[params[0]] = INVALID_PLAYER_ID;
        SendClientMessage(playerid, COLOR_BLUE, "You turned off walking for Player.");
	}
	else
	{
		follow_id[params[0]] = playerid;

		SCMF(playerid,-1,"You started arresting Player: {FF7F50}%s[%d]", Name(params[0]),params[0]);
		SendClientMessage(playerid,-1,"Use {FF7F50}/gt"c_white" again to cancel the arrest");

		me_action(playerid,"took the offender by the hand");
		me_action(playerid,"handcuffed the offender");
		me_action(playerid,"led a criminal with him");
		SPD(params[0], 0, DIALOG_STYLE_MSGBOX, !""c_server"Attention!", ""c_white"You have been rendered harmless\nThe police officer started your arrest!", "Close", "");
	}
	return 1;
}
CMD:cuff(playerid, params[])
{
	if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1,"Enter: /cuff [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The player is AFK.");//+
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"You cannot cuff yourself.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid,COLOR_GREY,"The player should be with you beforehand.");
	if(IsACop(params[0])) return SendClientMessage(playerid, COLOR_GREY,"You can't handcuff a lawyer.");
	if(PlayerCuffed[params[0]]) return SendClientMessage(playerid, COLOR_GREY,"Player already in handcuffs");
	if(!p_info[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY,"Man is not a criminal");
	if(p_info[params[0]][pPrison] > 0) return SendClientMessage(playerid, COLOR_GREY, "Player is in jail");

    TogglePlayerControllable(params[0], false);

	if(GetPVarInt(params[0], "fTazzer"))
	{
		KillTimer(timer_tazer[params[0]]);
		DeletePVar(params[0], "fTazzer");
	}
	SCMF(params[0], 0xEAC700FF, "%s handcuffed you", Name(playerid));
	SCMF(playerid, 0xEAC700FF, "You handcuffed %s", Name(params[0]));
	GameTextForPlayer(params[0],"~r~cuffed", 5000, 3);
	SetPlayerAttachedObject(params[0], 8, 19418, 6, -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035, 0.891999, 1.000000, 1.168000);
	SetPlayerSpecialAction(params[0],SPECIAL_ACTION_CUFFED);
	TogglePlayerControllableEx(params[0], 0);
	PlayerCuffed[params[0]] = 1;
	return 1;
}
CMD:uncuff(playerid, params[])
{
	if(!IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, -1,"Enter: /uncuff [playerid]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1,"Player offline");//+
	if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;
	//if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The player is AFK.");//+
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"Incorrect Player ID");
	if(!PlayerCuffed[params[0]]) return SendClientMessage(playerid, COLOR_GREY,"Player not in handcuffs");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid,COLOR_GREY,"The player should be with you beforehand.");

    TogglePlayerControllable(params[0], true);

	GameTextForPlayer(params[0],"~g~uncuffed", 5000, 3);
	SCMF(playerid, 0xEAC700FF, "You have uncuffed %s", Name(params[0]));
	if(IsPlayerAttachedObjectSlotUsed(params[0], 8)) RemovePlayerAttachedObject(params[0], 8);
	SetPlayerSpecialAction(params[0], 0);
	TogglePlayerControllableEx(params[0], 1);
	PlayerCuffed[params[0]] = 0;
	return 1;
}

alias:megaphone("m")
CMD:megaphone(playerid,params[])
{
    if(!IsACop(playerid) && !IsAArmy(playerid)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
    if(sscanf(params, "s[128]",params[0])) return SendClientMessage(playerid, -1, "Enter: (/m)egaphone [text]");
    if(player_gos_time[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY, "You cannot write in the megaphone more than once every 5 seconds!");

    new vehicleid = GetPlayerVehicleID(playerid);

	if(veh_info[vehicleid][vFr] != p_info[playerid][pMember]) return SendClientMessage(playerid,COLOR_GREY,"You must be in a patrol car!");
	format(String, 188, "[Megaphone] %s %s[%d]: %s", FracRank[p_info[playerid][pMember]][p_info[playerid][pRank]], Name(playerid), playerid, params[0]);
	ProxDetector(80.0, playerid, String,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW);

	player_gos_time[playerid] = 5;

	return 1;
}
CMD:r(playerid,params[])
{
	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);

	if(player_gag[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are gagged, you cannot speak.") & 0;

	if(!form_fraction[playerid] || IsAGang(playerid) || IsAMafia(playerid)) return SendClientMessage(playerid,COLOR_GREY,"You are not part of The Organization or you are not wearing the uniform");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, -1,"Enter: /r [text]");

    if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, 188, "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_GREY, format_string);
		return 1;
	}
	if(form_fraction[playerid] >= 1 && !IsAGang(playerid) && !IsAMafia(playerid))
	{
	    format(format_string, 188, "[R] %s %s[%d]: %s", FracRank[p_info[playerid][pMember]][p_info[playerid][pRank]], Name(playerid), playerid, params);
	    SendFrac(p_info[playerid][pMember], 0x42B66FFF, format_string);
		return 1;
	}
	else return SendClientMessage(playerid,COLOR_GREY,"You do not have access to this command");
}

CMD:rn(playerid,params[])
{
	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);

	if(player_gag[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are gagged, you cannot speak.") & 0;

	if(!form_fraction[playerid] || IsAGang(playerid) || IsAMafia(playerid)) return SendClientMessage(playerid,COLOR_GREY,"You are not part of The Organization or you are not wearing the uniform");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, -1,"Enter: /r [text]");

    if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, 188, "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_GREY, format_string);
		return 1;
	}
	if(form_fraction[playerid] >= 1 && !IsAGang(playerid) && !IsAMafia(playerid))
	{
	    format(format_string, 188, "[R] %s %s[%d]: (( %s ))", FracRank[p_info[playerid][pMember]][p_info[playerid][pRank]], Name(playerid), playerid, params);
	    SendFrac(p_info[playerid][pMember], 0x42B66FFF, format_string);
		return 1;
	}
	else return SendClientMessage(playerid,COLOR_GREY,"You do not have access to this command");
}

CMD:rj(playerid,params[])
{
	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(rent_job_vehicle[playerid] == INVALID_VEHICLE_ID) return SendClientMessage(playerid,COLOR_GREY,"You are not renting a work vehicle.");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, -1,"Enter: /rj [text]");

    if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, 188, "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_GREY, format_string);
		return 1;
	}

    format(format_string, 188, "[RJ] %s[%d]: %s", Name(playerid), playerid, params);
    return SendFrac(p_info[playerid][pJob], 0x42B66FFF, format_string);
}
CMD:d(playerid, params[])
{
	if(!IsACop(playerid) && !IsAArmy(playerid) && !IsAMedic(playerid) && p_info[playerid][pMember] != FRACTION_MAYOR) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this.");

	if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
	if(player_gag[playerid]) return SendClientMessage(playerid, COLOR_GREY, "You are gagged, you cannot speak.") & 0;
	if(!form_fraction[playerid]) return SendClientMessage(playerid,COLOR_GREY,"You haven't put on the uniform.");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, -1,"Enter: /d [text]");
	if(player_gos_time[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY, "The line is busy... Please wait!");

	if(CheckIP(params[0]))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, COLOR_LIGHTRED, "You have received a chat ban for advertising.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Ad views: [ %s ]", Name(playerid),playerid,params[0]);
		send_admin_message(COLOR_GREY, format_string);
		return 1;
	}
	player_gos_time[playerid] = 5;
	format(format_string, sizeof(format_string), "[%s] %s %s[%d]: %s", FracInfo[p_info[playerid][pMember]][fTag], FracRank[p_info[playerid][pMember]][p_info[playerid][pRank]], Name(playerid), playerid ,params);
	SendTeamMessage(COLOR_ALLDEPT, format_string);
	return 1;
}

