CMD:ecar(playerid)
{
new vehicleId = GetPlayerVehicleID(playerid);
//new Seat = GetPlayerVehicleSeat(playerid);
if (IsPlayerInAnyVehicle(playerid))
   {
      if (GetVehicleModel(vehicleId) == 508) // 508 Journey
  	{
    	//if (Seat != 1) return SendClientMessage(playerid, COLOR_RED, "[Error] You must be seated in the passenger seat.");
      	//{
		SetPlayerPos(playerid, 2233.64,-1115.26,1050.88);
		SetPlayerInterior(playerid, 5);
		SetPlayerVirtualWorld(playerid, vehicleId);
		SendClientMessage(playerid, COLOR_GREEN, "Use /exitcar to get out.");
		//}
   	}
   	else SendClientMessage(playerid, COLOR_RED, "[Error] You are not in a journey!");
}
    else SendClientMessage(playerid, COLOR_RED, "[Error] You are not driving a car.");
return 1;
}
CMD:exitcar(playerid)
{
	new Virtual = GetPlayerVirtualWorld(playerid);
	new Float: vehX, Float: vehY, Float: vehZ;
	if(IsPlayerInRangeOfPoint(playerid, 1, 2233.6353,-1115.2631,1050.8828))
	{
		GetVehiclePos(Virtual, vehX, vehY, vehZ);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);
		SetPlayerPos(playerid, vehX, vehY+2, vehZ);
		SendClientMessage(playerid, COLOR_RED, "You have exited the journey.");
    }
}
