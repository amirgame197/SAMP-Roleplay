stock save_family_settings(family_id)
{
    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "UPDATE `family` SET `fam_settings`='%d|%d|%d|%d|%d|%d|%d' WHERE `fam_id`='%d' LIMIT 1", family_info[family_id - 1][fam_settings][0], family_info[family_id - 1][fam_settings][1], family_info[family_id - 1][fam_settings][2], family_info[family_id - 1][fam_settings][3], family_info[family_id - 1][fam_settings][4], family_info[family_id - 1][fam_settings][5], family_info[family_id - 1][fam_settings][6], family_id);
 	mysql_query(dbHandle, text_string);
 	return 1;
}

