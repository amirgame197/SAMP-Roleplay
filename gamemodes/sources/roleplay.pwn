function LoadFractions()
{
	new rows;
	cache_get_row_count(rows);

	new result_string[600];

	for(new i = 1; i < rows; i++)
	{
	    cache_get_value_name(i, "fName", FracInfo[i][fName], 32);
        cache_get_value_name(i, "fTag", FracInfo[i][fTag], 16);

	    cache_get_value_name_float(i, "fSpawnX", FracInfo[i][fSpawn][0]);
	    cache_get_value_name_float(i, "fSpawnY", FracInfo[i][fSpawn][1]);
	    cache_get_value_name_float(i, "fSpawnZ", FracInfo[i][fSpawn][2]);
	    cache_get_value_name_float(i, "fSpawnFA", FracInfo[i][fSpawn][3]);

	    cache_get_value_name_int(i, "fInt", FracInfo[i][fInt]);
	    cache_get_value_name_int(i, "fVw", FracInfo[i][fVw]);
	    cache_get_value_name_int(i, "fSkin1", FracInfo[i][fSkin][0]);
	    cache_get_value_name_int(i, "fSkin2", FracInfo[i][fSkin][1]);
	    cache_get_value_name_int(i, "fSkin3", FracInfo[i][fSkin][2]);
	    cache_get_value_name_int(i, "fSkin4", FracInfo[i][fSkin][3]);
	    cache_get_value_name_int(i, "fSkin5", FracInfo[i][fSkin][4]);
	    cache_get_value_name_int(i, "fSkin6", FracInfo[i][fSkin][5]);
	    cache_get_value_name_int(i, "fSkin7", FracInfo[i][fSkin][6]);
	    cache_get_value_name_int(i, "fSkin8", FracInfo[i][fSkin][7]);
	    cache_get_value_name_int(i, "fSkin9", FracInfo[i][fSkin][8]);
	    cache_get_value_name_int(i, "fSkinKolvo", FracInfo[i][fSkinKolvo]);
	    cache_get_value_name_int(i, "fRankMax", FracInfo[i][fRankMax]);
	    cache_get_value_name_int(i, "fLevel", FracInfo[i][fLevel]);

	    cache_get_value_name_int(i, "fBank0", FracInfo[i][fBank][0]); // Metal
	    cache_get_value_name_int(i, "fBank1", FracInfo[i][fBank][1]); // Cartridges
	    cache_get_value_name_int(i, "fBank2", FracInfo[i][fBank][2]); // Cartridges

	    cache_get_value_name(i, "fRankName", result_string, 600);
	    SplitString(result_string, FracRank[i], ',');

	    cache_get_value_name(i, "fSalary",result_string);
		sscanf(result_string, "p<,>a<i>[16]", FracInfo[i][fSalary]);

        cache_get_value_name_int(i, "fFreeze", FracInfo[i][fFreeze]);

	    TotalFrac++;
 	}

    UpdateArmyWarehouse3D(FRACTION_ARMY_LS);
    UpdateArmyWarehouse3D(FRACTION_ARMY_SF);
    UpdateArmyWarehouse3D(FRACTION_ARMY_LV);

 	return printf("[MySQL R41-3]: Faction is Loading: %d.", TotalFrac);
}
function LoadActors()
{
	new rows;
	cache_get_row_count(rows);
    new ActorText[2] = { 0x6495EDFF, 0xF7ED00FF };
	if(!rows) return print("[MySQL R41-3]: No actors to load!");

 	for(new i = 1; i <= rows; i++)
	{
	    cache_get_value_name_int(i-1, "aID", ActorInfo[i][aID]);
	    cache_get_value_name_int(i-1, "aModel", ActorInfo[i][aModel]);
	    cache_get_value_name_int(i-1, "aVirtualWorld", ActorInfo[i][aVirtualWorld]);
	    cache_get_value_name_int(i-1, "aColor", ActorInfo[i][aColor]);
	    cache_get_value_name_int(i-1, "aStatus", ActorInfo[i][aStatus]);
        cache_get_value_name_float(i-1, "aPosX", ActorInfo[i][aPosX]);
        cache_get_value_name_float(i-1, "aPosY", ActorInfo[i][aPosY]);
        cache_get_value_name_float(i-1, "aPosZ", ActorInfo[i][aPosZ]);
        cache_get_value_name_float(i-1, "aPosA", ActorInfo[i][aPosA]);
        cache_get_value_name(i-1, "aName", ActorInfo[i][aName], 32);

		if(ActorInfo[i][aStatus] > 0 && ActorInfo[i][aStatus] < 20)
		{
  			ActorInfo[i][aID] = CreateActor(ActorInfo[i][aModel], ActorInfo[i][aPosX], ActorInfo[i][aPosY], ActorInfo[i][aPosZ], ActorInfo[i][aPosA]);

			CreateDynamic3DTextLabel(ActorInfo[i][aName], ActorText[ActorInfo[i][aColor]], ActorInfo[i][aPosX], ActorInfo[i][aPosY], ActorInfo[i][aPosZ] + 1.2, 5.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, ActorInfo[i][aVirtualWorld], -1);
			ActorInfo[i][aAreaActors] = CreateDynamicSphere(ActorInfo[i][aPosX], ActorInfo[i][aPosY], ActorInfo[i][aPosZ], 3.5);
			SetActorVirtualWorld(ActorInfo[i][aID], ActorInfo[i][aVirtualWorld]);
		}
		else
		{
			ActorInfo[i][aID] = CreateActor(ActorInfo[i][aModel], ActorInfo[i][aPosX], ActorInfo[i][aPosY], ActorInfo[i][aPosZ], ActorInfo[i][aPosA]);
			SetActorVirtualWorld(ActorInfo[i][aID], ActorInfo[i][aVirtualWorld]);
			CreateDynamic3DTextLabel(ActorInfo[i][aName], ActorText[ActorInfo[i][aColor]], ActorInfo[i][aPosX], ActorInfo[i][aPosY], ActorInfo[i][aPosZ] + 1.2, 5.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, ActorInfo[i][aVirtualWorld], -1);

			if(ActorInfo[i][aStatus] == 255) ActorInfo[i][aAreaActors] = CreateDynamicSphere(ActorInfo[i][aPosX], ActorInfo[i][aPosY], ActorInfo[i][aPosZ], 15.0);
			else ActorInfo[i][aAreaActors] = CreateDynamicSphere(ActorInfo[i][aPosX], ActorInfo[i][aPosY], ActorInfo[i][aPosZ], 3.5);
		}
		TotalActor++;
	}
	printf("[MySQL R41-3]: ACTORS LOADED: %d", TotalActor);
	return 1;
}

stock LoadVehicles()
{
    for(new i = 1, z = sizeof standart_vehicle; i < z; i++) if(standart_vehicle[i][vSpawnDelay] == 0) standart_vehicle[i][vSpawnDelay] = 600;

 	for(new i = 1, z = sizeof standart_vehicle; i < z; i++)
	{
		CreateVehicle(standart_vehicle[i][vModel], standart_vehicle[i][vX], standart_vehicle[i][vY], standart_vehicle[i][vZ]+0.3, standart_vehicle[i][vFa], standart_vehicle[i][vColors1], standart_vehicle[i][vColors2], standart_vehicle[i][vSpawnDelay]);

		LinkVehicleToInterior(i, standart_vehicle[i][vInt]);
		SetVehicleVirtualWorld(i, standart_vehicle[i][vWorld]);
		SetVehicleParamsEx(i,0,0,0,0,0,0,0);

		veh_info[i][vFuel] = standart_vehicle[i][vFuel];
		veh_info[i][vSost] = standart_vehicle[i][vSost];

		veh_info[i][vInt] = standart_vehicle[i][vInt];
		veh_info[i][vWorld] = standart_vehicle[i][vWorld];

		veh_info[i][vFr] = standart_vehicle[i][vFr];
		veh_info[i][vStatus] = standart_vehicle[i][vStatus];

		veh_info[i][vRentCena] = standart_vehicle[i][vRentCena];
		veh_info[i][vBuyCena] = standart_vehicle[i][vBuyCena];

		if(standart_vehicle[i][vFuel] < 20.0) Fuell[i] = 50.0;
		else Fuell[i] = standart_vehicle[i][vFuel];
		SetVehicleParamsEx(i,0,0,0,0,0,0,0);
	}
	return printf("Actors have loaded: %d.", sizeof standart_vehicle);
}

stock LoadMyCar(playerid, c_id = -1, type = 0)
{
	new hotel_id = p_info[playerid][pHotel];
    new h = GetPlayerHouse(playerid);
    if(h == -1) h = GetPlayerHouseLodger(playerid);
	new car;

	if(c_id == -1) c_id = p_info[playerid][pUseCar];

	if(player_home_car[playerid][c_id] != INVALID_VEHICLE_ID) DestroyVehicleEx(player_home_car[playerid][c_id]);
	if(CarInfo[playerid][cHeal][c_id] <= 300) CarInfo[playerid][cHeal][c_id] = 1000;

	if(type == 0)
	{
	    car = CreateVehicle(CarInfo[playerid][cModel][c_id], player_car_park[playerid][c_id][0], player_car_park[playerid][c_id][1], player_car_park[playerid][c_id][2], player_car_park[playerid][c_id][3], CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
	    SetVehicleVirtualWorld(car, 0);
	    LinkVehicleToInterior(car, 0);
	}
	if(type == 2)
	{
	    new Float:x, Float:y, Float:z, vw, inter;
    	GetPlayerPos(playerid, x, y, z);
    	vw = GetPlayerVirtualWorld(playerid);
    	inter = GetPlayerInterior(playerid);
	    car = CreateVehicle(CarInfo[playerid][cModel][c_id], x, y, z, 0.0, CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
	    SetVehicleVirtualWorld(car, vw);
	    LinkVehicleToInterior(car, inter);
	}
	if(type != 2 && type != 0)
	{
	    if(h == -1 && hotel_id == -1) return 1;

		if(hotel_id != -1)
		{
		    car = CreateVehicle(CarInfo[playerid][cModel][c_id], 1304.3055,-1377.3057,13.6739,178.5732, CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
		}
		else car = CreateVehicle(CarInfo[playerid][cModel][c_id], HouseInfo[h][hCarx],HouseInfo[h][hCary],HouseInfo[h][hCarz],HouseInfo[h][hCarc], CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
	}

    SetVehicleHealth(car, CarInfo[playerid][cHeal][c_id]);

	Fuell[car] = CarInfo[playerid][cFuel][c_id];
	Milliage[car] = CarInfo[playerid][cProbeg][c_id];
	CompVeh(playerid, car);

	new engine, lights, alarm, bonnet, boot, objective;
	SetVehicleParamsEx(car,engine,lights,alarm,CarInfo[playerid][cLock][c_id],bonnet,boot,objective);

	veh_info[car][vStatus] = 2;

    veh_info[car][vEngineTune] = player_engine_tune[playerid][c_id];
  	veh_info[car][vBrakeTune] = player_brake_tune[playerid][c_id];

	UpdateVehicleDamageStatus(car, CarInfo[playerid][cDamagePanel][c_id], CarInfo[playerid][cDamageDoors][c_id], CarInfo[playerid][cDamageLights][c_id], CarInfo[playerid][cDamageTires][c_id]);

    vehicle_owner_id[car] = playerid;

	player_home_car[playerid][c_id] = car;
	player_car_keys[playerid][c_id] = 1;

	return 1;
}

function LoadMyNumber(playerid)
{
    new rows;
	cache_get_row_count(rows);

    String = "";
    if(!rows) return SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Error!", ""c_white"There are no entries in the address book.\n\nTo record any player's number\nUse LMB in the menu TAB", "Close", "");

    new satr[124];
	for(new i = 0; i < rows; i++)
	{
	    cache_get_value_name_int(i, "nID", NumberInfo[playerid][i][nID]);
	    cache_get_value_name_int(i, "plID", NumberInfo[playerid][i][plID]);
 		cache_get_value_name(i, "nName", NumberInfo[playerid][i][numName], 64);
 		cache_get_value_name_int(i, "nNumber", NumberInfo[playerid][i][nNumber]);

		format(satr,sizeof(satr),""c_white"%s - tel. %d\n", NumberInfo[playerid][i][numName], NumberInfo[playerid][i][nNumber]);
		strcat(String,satr);
	}
	SPD(playerid,188,DIALOG_STYLE_INPUT, !""c_server"Phone book", String, "Choose", "Back");
	return 1;
}
stock t_SetPlayerPos(playerid, Float:x,Float:y,Float:z)
{
    pDialog [ playerid ]  = false;
	TogglePlayerControllableEx(playerid, 0);
	SetTimerEx("ClearFreeze", 1000, false, "d", playerid);
	return SetPlayerPos(playerid, x,y,z);
}
stock UpdatePickupHouse(h)
{
	if(HouseInfo[h][hOwned] == 0)
	{
		DestroyDynamicMapIcon(HouseInfo[h][hMIcon]), DestroyPickup(HouseInfo[h][hPickup]);
		if(HouseInfo[h][hKlass] == 5) HouseInfo[h][hPickup] = CreatePickup(1273, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		else HouseInfo[h][hPickup] = CreatePickup(1273, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		HouseInfo[h][hMIcon] = CreateDynamicMapIcon(HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], 31, -1, 0, -1, -1);
	}
	if(HouseInfo[h][hOwned] == 1)
	{
		DestroyDynamicMapIcon(HouseInfo[h][hMIcon]), DestroyPickup(HouseInfo[h][hPickup]);
		if(HouseInfo[h][hSlet] == 2) HouseInfo[h][hPickup] = CreatePickup(19522, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		else if(HouseInfo[h][hKlass] == 5) HouseInfo[h][hPickup] = CreatePickup(19522, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		else HouseInfo[h][hPickup] = CreatePickup(19522, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		HouseInfo[h][hMIcon] = CreateDynamicMapIcon(HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], 32, -1, 0, -1, -1);
	}
	return 1;
}
function SaveHouseAll() { for(new i; i < max_houses; i++) { if(HouseInfo[i][hOwned] == 1) SaveHouse(i); } } // house
function SaveBizzAll() { for(new b; b < TotalBizz; b++) SaveBizz(b); } // bizz
function SaveABizzAll() { for(new b; b <= TotalABizz; b++) SaveABizz(b); } // azc

stock SaveAllServers()
{
	new time = GetTickCount();
    SaveHouseAll();
    SaveBizzAll();
    SaveABizzAll();
    return printf("[MySQL R41-3]: All server data has been successfully saved in %d ms.", GetTickCount()-time);
}

stock CheckTextDay()
{
    new textday[36], year, month, day;
	getdate(year, month, day);
	switch(day)
	{
	    case 0: textday = "days";
	    case 1,21: textday = "day";
	    case 2..4,22..24: textday = "days";
	    case 5,25..40: textday = "days";
	}
	return textday;
}
function ClearFreeze(playerid)
{
    if(GetPVarInt(playerid, "fTazzer"))
	{
		TogglePlayerControllableEx(playerid, 1);
		ClearAnimations(playerid);
		DeletePVar(playerid, "fTazzer");
		SendClientMessage(playerid, COLOR_GREY, "You have come to your senses...");
	}
    else TogglePlayerControllableEx(playerid, 1);
    return 1;
}
function UnfreezeLoadTexture(playerid)
{
	//for(new i; i < 4; i++)PlayerTextDrawHide(playerid, load_texture[i]);
 	TogglePlayerControllableEx(playerid, 1);
  	return 1;
}
function FillCars(playerid,finbenz,benz)
{
	new b = player_enter_fuel[playerid];
	if(b == 0) return TogglePlayerControllableEx(playerid, true), KillTimer(FillTimer[playerid]), SetPVarInt(playerid, "FillSost", 0);

	Fuell[GetPlayerVehicleID(playerid)] += 5.0;
	if(finbenz <= Fuell[GetPlayerVehicleID(playerid)])
	{
		Fuell[GetPlayerVehicleID(playerid)] = finbenz;

		GivePlayerMoneyEx(playerid, -(BizzAInfo[b][aPrice]*benz), "refueling the vehicle");

		GiveFuelMoney(b, BizzAInfo[b][aPrice]*benz, benz / 4);

		KillTimer(FillTimer[playerid]);
		TogglePlayerControllableEx(playerid, true);
		SetPVarInt(playerid, "FillSost", 0);
		PlayerPlaySoundEx(0, BizzAInfo[b][aAreaFillX], BizzAInfo[b][aAreaFillY], BizzAInfo[b][aAreaFillZ]);
		SCMF(playerid, -1, " You successfully refueled your vehicle by %d liters for %d$", benz, BizzAInfo[b][aPrice]*benz);
	}
	return 1;
}
stock TextDrawKey(playerid, text[])
{
	for(new y; y < 3; y++) PlayerTextDrawShow(playerid, UseLAlt[playerid][y]);
	PlayerTextDrawSetString(playerid, UseLAlt[playerid][0], text), PlayerTextDrawColor(playerid, UseLAlt[playerid][0], -1);
	PlayerPlaySound(playerid, 45400, 0.0, 0.0, 0.0);
   	return 1;
}

stock GetPlayerHouseLodger(playerid)
{
	for(new i; i < max_houses; i++)
	{
	    if(!HouseInfo[i][hOwned]) continue;

	    for(new x; x < MAX_HOUSE_LODGERS; x++) if(!strcmp(house_lodgers[i][x], Name(playerid), true)) return i;
 	}

 	return -1;
}

stock GetPlayerHouse(playerid)
{
	for(new i; i < max_houses; i++)
	{
	    if(HouseInfo[i][hOwned] && !strcmp(HouseInfo[i][hOwner], Name(playerid), true)) return i;
 	}
 	return -1;
}

stock GetPlayerBizz(playerid)
{
	for(new i; i < TotalBizz; i++) if(BizzInfo[i][bOwned] && !strcmp(BizzInfo[i][bOwner], Name(playerid), true)) return i;
 	return -1;
}

stock GetPlayerABizz(playerid)
{
	new abizz = 0;
	for(new i = 1; i <= TotalABizz; i++)
	{
	    if(BizzAInfo[i][aOwned] && !strcmp(BizzAInfo[i][aOwner], Name(playerid), true)) abizz = i;
 	}
 	return abizz;
}

stock ShowAdminStats(playerid, params)
{
	format(String, sizeof String, "\
	"c_white"Name of Administrator:\t\t\t{1A8FA9}%s\n"c_white"Administrative level:\t\t%d LVL\nAppointed Administrator:\t\t%s\n\n\
	{B8B2CF}Statistics:\n\
	"c_white"Replies to the report:\t\t{BDCF5B}%d (%d)\n\
	"c_white"You have been given gags:\t\t{BDCF5B}%d PC\n\
	"c_white"Incarcerated:\t\t{BDCF5B}%d people\n\
	"c_white"Kiknuto:\t\t\t{BDCF5B}%d people\n\
	"c_white"Brewed:\t\t\t{BDCF5B}%d people\n\
	"c_white"Banned:\t\t\t{BDCF5B}%d people",
	Name(params), admin_level[params], p_info[params][pDataNaz], p_info[params][pAdmRepDay], p_info[params][pAdmRep], p_info[params][pAdmMute], p_info[params][pAdmPrison], p_info[params][pAdmKick],
	p_info[params][pAdmWarn], p_info[params][pAdmBan]);

	//

	format(String, sizeof String, "%s\n\n\
	{B8B2CF}Time:\n"c_white"Time in the game today:\t\t{FAEC3E}%s\n"c_white"AFK for today:\t\t{F5C327}%s",
 		String, ConvertSeconds(p_info[params][pInGameSeconds]), ConvertSeconds(p_info[params][pInGameAFKSeconds]));

	return SPD(playerid,0000,DIALOG_STYLE_MSGBOX, !""c_server"Statistics Administrator", String, "Close", "");
}

stock show_stats(playerid, params)
{
	if(p_info[params][pLogin] == 0) return 1;
	new str[324];

	new atext[8];
	if(p_info[params][pSex] == 1) atext = "Male";
	else atext = "Female";

	new htext[32], h_id = GetPlayerHouse(params);
	/*if(GetPlayerHouse(params) != -1) htext = "Homeless";
	else format(htext, sizeof(htext), "House #%d", GetPlayerHouse(params));*/
	if(h_id != -1) format(htext, sizeof(htext), "House ?%d ($%d)", h_id, HouseInfo[h_id][hValue]);
	else if(p_info[playerid][pHotel] != -1) format(htext, sizeof(htext), "Hotel #%d", p_info[playerid][pHotel]);
	else htext = "Homeless";

	new btext[64], b_id = GetPlayerBizz(params);
	if(b_id == -1) btext = "No";
	else format(btext, sizeof(btext), "%s ($%d)", BizzInfo[b_id][bMessage], BizzInfo[b_id][bMoney]);

	new azctext[64], a_id = GetPlayerABizz(params);
	if(a_id == 0) azctext = "No";
	else format(azctext, sizeof(azctext), "%s ($%d)", BizzAInfo[a_id][aMessage], BizzAInfo[a_id][aMoney]);

	new drank[20];
	switch(p_info[params][pLevel])
	{
 		case 1..2: drank = "Newbie";
 		case 3..5: drank = "Beginning";
	 	case 6..11: drank = "Sure";
	 	case 12..15: drank = "Player Constant";
	 	case 16..20: drank = "Mastered";
	 	case 21..25: drank = "Grandfather";
	 	default: drank = "Veteran";
	}

	if(p_info[params][pLeader]) drank = "Leader";
	if(admin_level[params]) drank = "Administrator";

	new infofrac[32];
	if(p_info[params][pMember] == 0) infofrac = "-";
	else format(infofrac, sizeof(infofrac), "%s", FracInfo[p_info[params][pMember]][fName]);

	new infojob[64];
	if(p_info[params][pJob] == 0 && p_info[params][pMember] == 0) infojob = "Unemployed";
	else if(p_info[params][pJob] != 0) format(infojob, sizeof(infojob), "%s", NamesJob(params));
	else if(p_info[params][pMember] != 0) format(infojob, sizeof(infojob), "%s", FracRank[p_info[params][pMember]][p_info[params][pRank]]);

	String = "";
	format(str, sizeof(str), "\
	"c_white"Name:\t\t\t\t{1A8FA9}%s\n\
	"c_white"Level:\t\t\t%d (%d from %d)\n\
	Money on hand:\t\t%d$\n\
	Money in the bank:\t\t%d$\n\
	Phone number:\t\t%d\n\
	Phone account:\t\t%d$\n\
	Obedience:\t\t%d\n\
	Wanted level:\t\t%d\n\
	Drugs:\t\t\t%d g\n\
	Cartridges:\t\t\t%d pcs\n\
	Metal:\t\t\t%d kg\n\
	Gender:\t\t\t\t%s\n\
	Addiction:\t\t\t%d\n",
	Name(params), p_info[params][pLevel], p_info[params][pExp], (p_info[params][pLevel] + 1) * 2, p_info[params][pCash], p_info[params][pBank], p_info[params][pNumber],
	p_info[params][pSummaNumber], p_info[params][pZakon], p_info[params][pWanted], p_info[params][pDrugs],
	p_info[params][pPatron], p_info[params][pMetall], atext, p_info[playerid][pDrugDep]);
	strcat(String,str);

 	format(str, sizeof(str), "\
	Organization:\t\t\t%s\n\
	Job / beforelack:\t\t%s\n\n\
	Residence:\t\t\t%s\n\
	Business:\t\t\t%s\n\
    Gas station:\t\t\t\t%s\n\n\
    Game status:\t\t%s\n\
	Warnings:\t\t%d from 3\n\
	VIP Status:\t\t\t%s"c_white"\n\
	Played without AFK: %s\n",
 		infofrac, infojob, htext, btext, azctext, drank, p_info[params][pWarn], VipNames(params),
 		ConvertSeconds(p_info[params][pInGameSeconds] - p_info[params][pInGameAFKSeconds]));

	strcat(String,str);

	if(admin_level[playerid])
	{
	    strcat(String, "\nTransport:\n\n");

		for(new i; i < MAX_PLAYER_VEHICLES; i++)
		{
		    new model = CarInfo[params][cModel][i];
		    new price = CarInfo[params][cCost][i];

		    if(model == 0)
		    {
		        format(str, 48, "[%d] Empty\n", i + 1);
			    strcat(String, str);
		    }
		    else
			{
				format(str, 48, "[%d] %s ($%d)\n", i + 1, VehicleNames[model - 400], price);
			    strcat(String, str);
			}
		}

     	format(str, 324,
	        "\nPlayed in a day: %s\n\
			AFK in a day: %s\n\
			Played in the last hour: %s\n\n\
			Device: %s",
			ConvertSeconds(p_info[params][pInGameSeconds]),
			ConvertSeconds(p_info[params][pInGameAFKSeconds]),
			ConvertSeconds(p_info[params][pInGameHourSeconds]),
			IsPlayerMobile(params) ? ("Phone") : ("PC"));

		strcat(String ,str);
	}

	SPD(playerid,0,DIALOG_STYLE_MSGBOX, !""c_server"Statistics Player",String, "Close", "");
	return 1;
}
stock ShowStatsBizz(playerid, i)
{
    SetPVarInt(playerid, "CheckStatsBizz",i);
    format(MySQLStr, 96, "SELECT * FROM `bizz_stats` WHERE `bID` = %d", i);
	mysql_tquery(dbHandle, MySQLStr, "OnMySQL_Query","dd", playerid, 3);
	return 1;
}
stock ShowStatsABizz(playerid, i)
{
    SetPVarInt(playerid, "CheckStatsABizz",i);
    format(MySQLStr, 96, "SELECT * FROM `bizz_astats` WHERE `aID` = %d", i);
