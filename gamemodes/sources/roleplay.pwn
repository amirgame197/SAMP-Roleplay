            if(aesa > 45.00  && aesa <= 120.00) p_info[playerid][pObject] = CreateDynamicObject(objid,xesa-0.7,yesa,zesa-0.3,0,0,aesa);
            if(aesa > 120.00 && aesa <= 220.00) p_info[playerid][pObject] = CreateDynamicObject(objid,xesa,yesa-0.7,zesa-0.3,0,0,aesa);
