cmd:promo(playerid)
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;

    new Cache: result = mysql_query(dbHandle, "SELECT `s_promo`,`s_hour`,`s_promo_used` FROM `server_promocode` WHERE 1");
    new rows = cache_num_rows();

    dlobal_string[0] = format_string[0] = EOS;
    new promo_name[64], promo_hour, promo_useds;
    for(new i; i < rows; i++)
    {
        cache_get_value(i, "s_promo", promo_name);
        cache_get_value_int(i, "s_hour", promo_hour);
        cache_get_value_int(i, "s_promo_used", promo_useds);

        format(format_string, sizeof(format_string), ""c_white"%s\t"c_yellow"%s\t%d\n", promo_name, convert_cmd_time(promo_hour), promo_useds);
        strcat(dlobal_string, format_string);
    }
    cache_delete(result);

    return SPD(playerid, 0000, DIALOG_STYLE_TABLIST, !""c_server"List of promo codes", dlobal_string, !"Choose", !"Close");
}

