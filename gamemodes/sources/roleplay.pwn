	    ini_setInteger(FMVEHFILE,"ffamilyveh3",0);
        ini_getInteger(FMVEHFILE,"ffamilyveh3",ffamilyveh3);
	    ini_setInteger(FMVEHFILE,"ffamilyveh4",0);
	    ini_getInteger(FMVEHFILE,"ffamilyveh4",ffamilyveh4);
	    ini_setInteger(FMVEHFILE,"ffamilyveh5",0);
	    ini_getInteger(FMVEHFILE,"ffamilyveh5",ffamilyveh5);
	    ini_setInteger(FMVEHFILE,"ffamilyveh6",0);
	    ini_getInteger(FMVEHFILE,"ffamilyveh6",ffamilyveh6);
	    ini_setInteger(FMVEHFILE,"ffamilyveh7",0);
	    ini_getInteger(FMVEHFILE,"ffamilyveh7",ffamilyveh7);
	    ini_closeFile(FMVEHFILE);
	    }
	    else
	    {
	    text_string[0] = EOS;
        format(text_string, sizeof(text_string), "familyveh/%s.ini", family_info[family_id - 1][fam_name]);
        new FMVEHFILE = ini_openFile(text_string);
	    ini_getInteger(FMVEHFILE,"familyvehs",familymaxveh);
