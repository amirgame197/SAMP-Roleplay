public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
        new Float:health;
    new Float:hx, Float:hy, Float:hz;
	GetObjectPos(Object, hx, hy, hz);
 	if(newkeys & KEY_WALK)
 	{
 	    if(Qaliontime[playerid] == 1) return SCM(playerid, COLOR_MATINRED, "Wait 10 seconds, then use again");
		if(IsPlayerInRangeOfPoint(playerid, 2.5, hx, hy, hz))
		{
		    new Float:x1,Float:y1,Float:z1;
			GetPlayerPos(playerid,x1,y1,z1);
			Dood = CreateObject(18736, x1, y1-6, z1, 0.0000, 0.0000, 0.0000);
			ApplyAnimation(playerid, "SMOKING", "M_smk_in", 4.0, 0, 0, 0, 0, 0);
			SetTimerEx("Qalion", 10000, 0, "i", playerid);
			Qaliontime[playerid]= 1;
			GetPlayerHealth(playerid,health);
			if(health < 100)
			{
		 	SetPlayerHealth(playerid,health+5);
			}
		 	else SCM(playerid, COLOR_MATINRED, "Excessive consumption is dangerous");
	 	}
	 	}
	switch(GetPlayerState(playerid))
	{
	    case PLAYER_STATE_ONFOOT:
		{
	    	if(PRESSED(KEY_SECONDARY_ATTACK) || PRESSED(KEY_JUMP) || PRESSED(KEY_FIRE) || PRESSED(KEY_SPRINT) || PRESSED(KEY_CROUCH) || PRESSED(KEY_CROUCH))
	    	{
		/*	if(player_job[playerid] == 2 && IsPlayerAttachedObjectSlotUsed(playerid, 1))
				{
					SendClientMessage(playerid, col_white, !""c_error"You dropped the box. Please try again.");

                    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
					RemovePlayerAttachedObject(playerid, 1);
					DisablePlayerCheckpoint(playerid);
					DeletePVar(playerid, "gruzchiki_cps");

					new rand = random(10);
					SetPlayerCheckpoint(playerid, work_pos_gruzchiki[rand][0], work_pos_gruzchiki[rand][1], work_pos_gruzchiki[rand][2], 1);
					SetPVarInt(playerid, "gruzchiki_cp", rand);
					return 1;
				}
			    if(player_take_trash[playerid] != -1)
			    {
			        RemovePlayerAttachedObject(playerid, 4);
			        player_take_trash[playerid] = -1;
			        SendClientMessage(playerid, COLOR_RED, "You dropped the trash, go pick it up again.");
			    }*/
			 }
			 if PRESSED(KEY_CROUCH)
			 {
		    	if(IsPlayerInRangeOfPoint(playerid, 10.0, 2509.4097,-2637.0315,13.6453))
             SendClientMessage(playerid,COLOR_BLUE,"[H] IS IN YOUR SETTINGS 15 TIMES OPENED");
             SetObjectRot (lsmove, 0.00000, 00.00000, -18.84001 );
             SetObjectRot (lsmove1, 0.00000, 00.00000, -18.84001 );
             SetObjectRot (lsmove2, 0.00000, 00.00000, -18.84001 );
             SetObjectRot (lsmove3, 0.00000, 00.00000, -18.84001 );
             SetObjectRot (lsmove4, 0.00000, 00.00000, -18.84001 );
             SetObjectRot (lsmove5, 0.00000, 00.00000, -18.84001 );
             SetObjectRot (lsmove6, 0.00000, 00.00000, -18.84001 );
             SetObjectRot (lsmove7, 0.00000, 00.00000, -18.84001 );
             SetTimer("newrot", 10000, false);
	    	}
			if(p_t_info[playerid][p_animation] == true && newkeys & KEY_SPRINT)
			{
				ClearAnimations(playerid);
				p_t_info[playerid][p_animation] = false;
				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
				return 1;
			}
		    if(GetPlayerWeapon(playerid) == 41 && IsAGang(playerid))
			{
			    if(PRESSED(KEY_FIRE)) SetPVarInt(playerid, "ColorFire", 1);
			    if(RELEASED(KEY_FIRE)) DeletePVar(playerid, "ColorFire");
			}

			if(RELEASED(KEY_SPRINT))
			{
			    if(player_rob_id[playerid] != -1)
				{
				    if(player_rob_progress[playerid] > 0)
				    {
				        player_rob_progress[playerid] = 0;
				        PlayerStopTryOpenDoor(playerid);
				        SendClientMessage(playerid, col_white, !""c_error"You broke the paperclip, please try again.");
				    }
				}
			}
		    if(GetPVarInt(playerid, !"p_dead") == 1)
		    {
		        new Float:shealth;
			    GetPlayerHealth(playerid, shealth);

			    if(shealth < 100 && player_lecenie[playerid] == -1)
				{
				    for(new i; i < MAX_HOSPITAL_BEDS; i++)
					{
				    	if(!PlayerToPoint(2, playerid, LoadKoika[i][0], LoadKoika[i][1], LoadKoika[i][2])) continue;

				    	new h_id = GetPlayerHospitalID(playerid);
			    	    if(zKoika[h_id][i] > 0) return SendClientMessage(playerid, col_white, !""c_error"The bed is already occupied by another person.");
			        	zKoika[h_id][i] = 1;

						text_string[0] = EOS;
						format(text_string, sizeof(text_string), "Bed ?%d\nPatient: "c_server"%s", i + 1, Name(playerid));
			        	UpdateDynamic3DTextLabelText(Koika[h_id][i], col_white, text_string);

			        	SendClientMessage(playerid, col_white, !""c_info"You have occupied the bed, resting will help you recover faster.");

			            player_lecenie[playerid] = i;
						TogglePlayerControllable(playerid, false);

						SetPlayerPos(playerid, LoadKoika[i][0], LoadKoika[i][1], LoadKoika[i][2]);
						SetPlayerFacingAngle(playerid, LoadKoika[i][3]);

						ApplyAnimation(playerid, !"CRACK", !"Crckidle2", 4.1, 1, 0, 0, 0, 0, 0);
						break;
					}
				}
		    }
		}
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && pDialog [ playerid ] == false)
	{
	    new vehicleid = GetPlayerVehicleID(playerid);

	    if(vehicleid && (PRESSED(KEY_SPRINT) || PRESSED(KEY_JUMP)))
	    {
	        new Float: health;
		    GetVehicleHealth(vehicleid, health);

            new engine, lights, alarm, doors, bonnet, boot, objective;
	        GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);

        	if(engine && Fuell[vehicleid] < 1.0 && IsVehicleHaveFuel(vehicleid))
        	{
				if(!IsAnyFamilyVehicle(vehicleid)) SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"UveHouse statement", ""c_white"There is no fuel in the transport.", "Close", "");
			}

            if(vehicle_owner_id[vehicleid] != INVALID_PLAYER_ID)
			{
			    new owner_id = vehicle_owner_id[vehicleid];

		        for(new x; x < MAX_PLAYER_VEHICLES; x++)
					if(vehicleid == player_home_car[owner_id][x] && player_car_keys[owner_id][x] == 0)
						SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"UveHouse statement", ""c_white"There are no keys in the ignition, Use: /key or /car.", "Close", "");
		    }
		}
	}

	if(!IsPlayerMobile(playerid) && PRESSED(KEY_JUMP | KEY_SPRINT) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) return 1;

    if(GetPVarInt(playerid, "Anti-Sbiv") > gettime()) return 1;

	if(steal_timer[playerid] != -1)
	{
		KillTimer(steal_timer[playerid]);
		steal_timer[playerid] = -1;

		ClearAnimations(playerid);
		SendClientMessage(playerid, col_white, !""c_error"You interrupted the fuel theft.");
	}

	if(PRESSED(KEY_WALK))
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	    {
	        for(new i, h = sizeof gate_open_pos; i < h; i++)
	        {
	            if(!PlayerToPoint(3.0, playerid, gate_open_pos[i][0], gate_open_pos[i][1], gate_open_pos[i][2])) continue;

				if(i == 0 && !IsAArmy(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Only the army has access before.");
				if(i == 1 && !IsAArmy(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Only the army has access before.");
				if(i == 2 && !IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Access is only before the Floor.");
				if(i == 3 && !IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Only the army has access before.");
				if(i == 4 && !IsACop(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Only the army has access before.");
				if(i == 5 && !IsAArmy(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Only the army has access before.");

				new Float: x, Float: y, Float: z;
				GetObjectPos(gate_obj[i], x, y, z);

	            if(gate_state[i]) MoveObject(gate_obj[i], x, y, z - 0.004, 0.004, gate_close_pos[i][3], gate_close_pos[i][4], gate_close_pos[i][5]);
	            if(!gate_state[i]) MoveObject(gate_obj[i], x, y, z + 0.004, 0.004, gate_open_pos[i][3], gate_open_pos[i][4], gate_open_pos[i][5]);

	            gate_state[i] = !gate_state[i];
	            break;
	        }
	    }
		if(player_rob_id[playerid] != -1)
	    {
	        new rob_id = player_rob_id[playerid],
				h_id = rob_info[rob_id][r_house];

			if(h_id != -1 && HouseInfo[h_id][hLock] == 1 && PlayerToPoint(1.5, playerid, HouseInfo[h_id][hEntrancex], HouseInfo[h_id][hEntrancey], HouseInfo[h_id][hEntrancez]))
			{
				if(p_info[playerid][pClip] == 0)
				    return SendClientMessage(playerid, COLOR_GREY, "You do not have paperclips to pick the lock.");

				new vehicleid = rob_info[rob_id][r_vehicleid];

				new Float: dist = GetVehicleDistanceFromPoint(vehicleid, HouseInfo[h_id][hEntrancex], HouseInfo[h_id][hEntrancey], HouseInfo[h_id][hEntrancez]);

				if(dist > 30.0)
				    return SendClientMessage(playerid, COLOR_GREY, "The transport for the furniture is far from the needed house.");

				SetPlayerFaceToPoint(playerid, HouseInfo[h_id][hEntrancex], HouseInfo[h_id][hEntrancey]);

				player_rob_progress[playerid] = 1;

				TogglePlayerControllable(playerid, false);

			    p_info[playerid][pClip]--;

			    OnPlayerUpdateAccountsPer(playerid, "pClip", p_info[playerid][pClip]);

			    return SendClientMessage(playerid, -1, "You started hacking House.");
			}

	        if(GetPVarInt(playerid, "take_house_item") == 0)
	        {
		        for(new i; i < MAX_ROB_ITEMS; i++)
		        {
		            if(!IsPlayerInDynamicArea(playerid, rob_house_area[i])) continue;

		            h_id = player_enter_home[playerid];

		            if(rob_house_obj[h_id][i] == 0) continue;

		            if(rob_obj_taked[h_id][i] == true) return 1;

		            if(rob_info[rob_id][r_loaded] >= 12) return SendClientMessage(playerid, COLOR_GREY, "There is no more space in the van.");

		            SetPVarInt(playerid, "take_house_item", i + 1);

		        	ApplyAnimation(playerid,"CARRY","lift up",1.0,0,1,1,0,0,1);

		        	rob_obj_taked[h_id][i] = true;

		        	SetPlayerFaceToPoint(playerid, rob_item_pos[i][0], rob_item_pos[i][1]);

		        	SetPlayerAttachedObject(playerid, 7, rob_attach_model[i], 5,
												rob_attach_pos[i][0],rob_attach_pos[i][1],rob_attach_pos[i][2],
												rob_attach_pos[i][3],rob_attach_pos[i][4],rob_attach_pos[i][5],
												rob_attach_pos[i][6],rob_attach_pos[i][7],rob_attach_pos[i][8]);

		        	DestroyDynamicObject(rob_house_obj[h_id][i]);

		        	SetTimerEx("Player Use Carry Animation", 1500, false, "i", playerid);

		        	return SendClientMessage(playerid, 0xBC8F8Fff, "You picked up the item, head to "c_white"the van{BC8F8F} and Use: "c_white"ALT{BC8F8F} at the baggageNick.");
				}
			}

			if(GetPVarInt(playerid, "take_house_item") != 0)
			{
			    new vehicleid = rob_info[rob_id][r_vehicleid];

			    new Float: old_x, Float: old_y, Float: old_z, Float: a;

			    GetVehiclePos(vehicleid, old_x, old_y, old_z);
			    GetVehicleZAngle(vehicleid, a);

			    new Float: x = old_x,
					Float: y = old_y;

			    GetXYInFront(x, y, a, -3.5);

			    if(PlayerToPoint(1.5, playerid, x, y, old_z))
			    {
			        SetPlayerFaceToPoint(playerid, old_x, old_y);

			        DeletePVar(playerid, "take_house_item");

			        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

			        ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);

			        RemovePlayerAttachedObject(playerid, 7);

					rob_info[rob_id][r_loaded] ++;

					if(rob_info[rob_id][r_loaded] == 10) SetTimerEx("Send Player Rob Cop Notify", 10000, false, "i", rob_id);

					format(format_string, 64, "[ROB]: Loaded items: "c_white"%d/12", rob_info[rob_id][r_loaded]);
					SendMessageToRobPlayers(rob_id, 0x6495EDff, format_string);
			    }
			}
	    }

	    if(p_info[playerid][pJob] == WORK_TYPE_PIZZA)
	    {
		    new pizza_veh = GetNearestVehicle(playerid);

		    if(veh_info[pizza_veh][vFr] == WORK_TYPE_PIZZA)
		    {
		        if(GetPVarInt(playerid, "take_pizza"))
		        {
					if(pizza_veh_have{pizza_veh} == 1) return SendClientMessage(playerid, COLOR_GREY, "There is already pizza in the scooter.");

					pizza_veh_have{pizza_veh} = 1;

					DeletePVar(playerid, "take_pizza");

					SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
					RemovePlayerAttachedObject(playerid, 4);

					SendClientMessage(playerid, -1, "You {"#cGREEN"} took"c_white"pizza in hand.");

                    if(pizza_player_house[playerid] == -1) SendClientMessage(playerid, COLOR_GREEN, "The house is marked on the map, deliver the pizza there.");

					UpdatePlayerPizzaMark(playerid);
				}
				else
				{
				    if(pizza_veh_have{pizza_veh} == 0) return SendClientMessage(playerid, COLOR_GREY, "There is no pizza in the scooter.");

				    SendClientMessage(playerid, -1, "You {"#cRED"You have loaded."c_white"pizza in the scooter.");

				    pizza_veh_have{pizza_veh} = 0;

				    SetPVarInt(playerid, "take_pizza", 1);

					SetPlayerAttachedObject(playerid, 4, 2814, 6, 0.0579, -0.0310, -0.1430, -108.9999, -13.1000, -2.0999, 1.0000, 1.0000, 1.0000);

			        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
				}
		    }
		}
	}

	if(PRESSED(KEY_CTRL_BACK) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    if(PlayerToPoint(10.0, playerid, 1403.5734,1564.4446,1168.9860))
	    {
		    new vehicleid = GetPlayerVehicleID(playerid);

		    SetVehiclePos(vehicleid, 1552.7804,-1390.0651,14.0234);
		    SetVehicleZAngle(vehicleid, 268.1776);

		    SetPlayerInterior(playerid, 0);
			LinkVehicleToInterior(vehicleid, 0);

			SetPlayerVirtualWorld(playerid, 0);
			SetVehicleVirtualWorld(vehicleid, 0);
		}
	}

	if(PRESSED(KEY_YES))
	{
	    pc_cmd_accept(playerid);
	}
	if(PRESSED(KEY_NO))
	{
		pc_cmd_cancel(playerid);
	}

	if(PRESSED(KEY_SPRINT))
	{
	    if(player_enter_home[playerid] != -1)
        {
	        new i = player_enter_home[playerid];

	        if(!HouseInfo[i][hUpdAD]) return 1;

	        new h_class = HouseInfo[i][hKlass];

	        if(PlayerToPoint(1.5, playerid, house_exit[h_class][0], house_exit[h_class][1], house_exit[h_class][2])) pc_cmd_exit(playerid);
		}

		if(IsARibaMest(playerid)) pc_cmd_fishing(playerid);

	    if(p_info[playerid][pJob] == 4 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    	{
    	    if(player_take_trash[playerid] != -1)
			{
				new vehicleid = GetNearestVehicleID(playerid, 8.0);
				if(vehicleid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, "Nearby house with a bin has no garbage truck!");

				new t_id = player_take_trash[playerid];
				new Float: dist = GetVehicleDistanceFromPoint(vehicleid, trash_info[t_id][t_pos][0], trash_info[t_id][t_pos][1], trash_info[t_id][t_pos][2]);

				if(dist < 3.0) return SendClientMessage(playerid, COLOR_GREY, "The garbage collector is too close to the trash can.");

    			if(veh_info[vehicleid][vFr] == 4)
				{
				    if(trash_vehicle_amount[vehicleid] + 10 > 500) return SendClientMessage(playerid, COLOR_GREY, "Garbage truck loaded, head to the dump and unload the trash.");

				    new Float: pos_x, Float: pos_y, Float: pos_z;
				    GetVehiclePos(vehicleid, pos_x, pos_y, pos_z);
					GetXYInFrontOfVehicle(vehicleid, pos_x, pos_y, -4.0);

                    if(IsPlayerInRangeOfPoint(playerid, 1.5, pos_x, pos_y, pos_z))
					{
						UpdateVehicleTrashInfo(vehicleid, 10);

						RemovePlayerAttachedObject(playerid, 4);

						player_take_trash[playerid] = -1;

                        GivePlayerPayCheck(playerid, 150);

                        new owner_id = trash_vehicle_owner[vehicleid];
                        if(owner_id != INVALID_PLAYER_ID && trash_vehicle_amount[vehicleid] == 500)
                        {
                            SetPlayerCheckpoint(owner_id, -1892.6698,-1671.4285,23.0156, 3);
							PlayerPlaySound(owner_id, 1139, 0.0, 0.0, 0.0);
							SendClientMessage(owner_id, -1, "Garbage truck loaded, head to the unloading location.");
							SendClientMessage(owner_id, -1, "The location is marked on the map with a {ff0000}red "c_white"marked.");
							SetPVarInt(playerid, "GPS", 1);
                        }

						SendClientMessage(playerid, -1, "You loaded the trash into the garbage truck, go get another bag.");

						TogglePlayerControllable(playerid, false);

						SetCameraBehindPlayer(playerid);

						ApplyAnimation(playerid, "CAR_CHAT","CAR_Sc4_BL",4.0,0,1,1,0,0);

						SetTimerEx("ClearFreeze", 2000, false, "d", playerid);
					}
				}
			}

	        if(player_take_trash[playerid] == -1)
	        {
				for(new i; i < MAX_TRASH; i++)
				{
				    if(!IsPlayerInRangeOfPoint(playerid,2.0, trash_info[i][t_pos][0], trash_info[i][t_pos][1], trash_info[i][t_pos][2])) continue;

                    new vehicleid = GetNearestVehicleID(playerid, 30.0);
					if(vehicleid == INVALID_VEHICLE_ID || veh_info[vehicleid][vFr] != 4) return SendClientMessage(playerid, COLOR_GREY, "Nearby house with a bin has no garbage truck!");
					new Float: dist = GetVehicleDistanceFromPoint(vehicleid, trash_info[i][t_pos][0], trash_info[i][t_pos][1], trash_info[i][t_pos][2]);

					if(dist < 6.0) return SendClientMessage(playerid, COLOR_GREY, "The garbage collector is too close to the trash can.");

				    if(trash_info[i][t_amount] < 10) return SendClientMessage(playerid, COLOR_GREY, "The trash can is empty!");

				    UpdateTrashAmount(i, -10);

				    player_take_trash[playerid] = i;

					SetPlayerFaceToPoint(playerid, trash_info[i][t_pos][0], trash_info[i][t_pos][1]);

                    TogglePlayerControllable(playerid, false);

					SetCameraBehindPlayer(playerid);

					ApplyAnimation(playerid, "CAR_CHAT","CAR_Sc4_BL",4.0,0,1,1,0,0);

					SetTimerEx("ClearFreeze", 2000, false, "d", playerid);

					SetPlayerAttachedObject(playerid, 4, 1265, 5, 0.1860, -0.0290, -0.0360, 0.0000, -102.8999, 0.0000, 0.3240, 0.3300, 0.6430);

				    SendClientMessage(playerid, -1, "You picked up the trash, drop it into the garbage truck! (Enter /drop - to drop)");
				    SendClientMessage(playerid, -1, ""c_server"[Hint]: "c_white"To drop the trash into the garbage truck, use the key: {FFA54F}*Run*"c_white"by default: {FFA54F}*SPACE*");

				    break;
				}
			}
		}

		if(p_info[playerid][pJob] == 5 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
 		{
		    if(player_take_collector[playerid] != -1)
			{
				new vehicleid = GetNearestVehicleID(playerid, 6.0);
				if(vehicleid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, "There is no armored truck at the ATM location!");

				new c_id = player_take_collector[playerid];
				new Float: dist = GetVehicleDistanceFromPoint(vehicleid, AtmsInfo[c_id][aObjectPosX], AtmsInfo[c_id][aObjectPosY], AtmsInfo[c_id][aObjectPosZ]);

				if(dist < 3.0) return SendClientMessage(playerid, COLOR_GREY, "The garbage collector is too close to the trash can.");

				if(veh_info[vehicleid][vFr] == 5)
				{
				    if(collector_vehicle_amount[vehicleid] + 10 > 200) return SendClientMessage(playerid, COLOR_GREY, "The armored truck is loaded, head to the Central Bank and unload the packages.");

				    new Float: pos_x, Float: pos_y, Float: pos_z;
				    GetVehiclePos(vehicleid, pos_x, pos_y, pos_z);
					GetXYInFrontOfVehicle(vehicleid, pos_x, pos_y, -4.0);

		            if(IsPlayerInRangeOfPoint(playerid, 1.5, pos_x, pos_y, pos_z))
					{
						UpdateVehicleCollectorInfo(vehicleid, 10);

						RemovePlayerAttachedObject(playerid, 4);

						player_take_collector[playerid] = -1;

		                GivePlayerPayCheck(playerid, 20);

		                new owner_id = collector_vehicle_owner[vehicleid];
		                if(owner_id != INVALID_PLAYER_ID && collector_vehicle_amount[vehicleid] == 200)
						{
		                    SetPlayerCheckpoint(owner_id, 1361.3215,-1658.9114,13.3828, 3);
							PlayerPlaySound(owner_id, 1139, 0.0, 0.0, 0.0);
							SendClientMessage(owner_id, -1, "You have completely loaded the armored truck, head to the unloading location.");
							SendClientMessage(owner_id, -1, "The location is marked on the map with a {ff0000}red "c_white"marked.");
							SetPVarInt(playerid, "GPS", 1);
		                }

						TogglePlayerControllable(playerid, false);
                        SetTimerEx("ClearFreeze", 2000, false, "d", playerid);

                        SetCameraBehindPlayer(playerid);

						SendClientMessage(playerid, -1, "You dropped a bag into the armored truck, a bonus has been added to your salary.");
						ApplyAnimation(playerid, "CAR_CHAT","CAR_Sc4_BL",4.0,0,1,1,0,0);
					}
				}
			}

		    if(player_take_collector[playerid] == -1)
		    {
				for(new i=1; i <= TotalAtms; i++)
				{
				    if(!IsPlayerInRangeOfPoint(playerid,2.0,  AtmsInfo[i][aObjectPosX], AtmsInfo[i][aObjectPosY], AtmsInfo[i][aObjectPosZ])) continue;
				    //if(!IsPlayerInRangeOfPoint(playerid,15.0,AtmsInfo[i][aAreaEnters])) continue;
		            new vehicleid = GetNearestVehicleID(playerid, 30.0);

		            if(vehicleid == INVALID_VEHICLE_ID || veh_info[vehicleid][vFr] != 5) return SendClientMessage(playerid, COLOR_GREY, "There is no armored truck at the ATM location!");

		            new Float: dist = GetVehicleDistanceFromPoint(vehicleid, AtmsInfo[i][aObjectPosX], AtmsInfo[i][aObjectPosY], AtmsInfo[i][aObjectPosZ]);

					if(dist < 6.0) return SendClientMessage(playerid, COLOR_GREY, "The service vehicle is too close to the ATM.");

				    if(AtmsInfo[i][c_amount] < 10) return SendClientMessage(playerid, COLOR_GREY, "This ATM has no money, go to another one!");

				    UpdateCollectorAmount(i, -10);

				    player_take_collector[playerid] = i;

				    SetPlayerFaceToPoint(playerid, AtmsInfo[i][aObjectPosX], AtmsInfo[i][aObjectPosY]);

					SetPlayerAttachedObject(playerid, 4, 1550, 1, 0.0000, -0.2339, 0.0000, 0.0000, 89.6999, 170.1999, 1.0000, 1.0000, 1.0000);

                    TogglePlayerControllable(playerid, false);
                    SetTimerEx("ClearFreeze", 2000, false, "d", playerid);

                    SetCameraBehindPlayer(playerid);

				    SendClientMessage(playerid, COLOR_GREEN, "You took the money, drop it into the van!");
				    ApplyAnimation(playerid, "CAR_CHAT","CAR_Sc4_BL",4.0,0,1,1,0,0);

				    break;
				}
			}
		}
	}
 	if((newkeys & KEY_FIRE) || (newkeys & KEY_HANDBRAKE) || (newkeys & KEY_CROUCH) || (newkeys & KEY_ACTION))
    {
        if(p_t_info[playerid][pWork] == 1 && IsPlayerAttachedObjectSlotUsed(playerid, 4))
        {
        	ClearAnimations(playerid);
        	ApplyAnimation(playerid, !"CARRY", !"crry_prtial", 4.1, 0, 1, 1, 1, 1);
        	return 1;
        }
	}

	if(PRESSED(KEY_YES) && player_enter_fuel[playerid] > 0)
	{
	    return SPD(playerid,57,DIALOG_STYLE_LIST, !""c_server"Gas station", ""c_white"[1] Refuel the vehicle\n[2] Buy a canister\n[3] Information about the gas station", "Choose", "Back");
 	}

	if(newkeys & 17 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
  		pc_cmd_engine(playerid);
		return 1;
	}
	if(PRESSED(KEY_AIM))
	{
 		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && pDialog[playerid] == false && IsPlayerInGreenZone(playerid))
	     if(p_info[playerid][pMember] != FRACTION_LSPD)
	     if(p_info[playerid][pMember] != FRACTION_SFPD)
	     if(p_info[playerid][pMember] != FRACTION_LVPD)
	     if(p_info[playerid][pMember] != FRACTION_MAYOR)
	     if(p_info[playerid][pMember] != FRACTION_FBI)
		{
		SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Warning", !""c_white"Fighting/shooting is prohibited in this area.\n\n{AFAFAF}In case of repeated violations, you may be kicked.", "Close", "");
        ApplyAnimation(playerid, !"FAT", !"IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1);
        }
        return 0;
	}
	if(PRESSED(KEY_FIRE))
	{
	     if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && pDialog[playerid] == false && IsPlayerInGreenZone(playerid))
	     if(p_info[playerid][pMember] != FRACTION_LSPD)
	     if(p_info[playerid][pMember] != FRACTION_SFPD)
	     if(p_info[playerid][pMember] != FRACTION_LVPD)
	     if(p_info[playerid][pMember] != FRACTION_MAYOR)
	     if(p_info[playerid][pMember] != FRACTION_FBI)
		{
		SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Warning", !""c_white"You cannot hit anyone here.\n\n{AFAFAF}If you do it again, you may get kicked.", "Okay", "");
        ApplyAnimation(playerid, !"FAT", !"IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1);
        }
	     if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;

		 new vehicleid = GetPlayerVehicleID(playerid);
		 if(IsABicycle(vehicleid)) return 1;

         new engine, lights, alarm, doors, bonnet, boot, objective;
		 GetVehicleParamsEx(GetPlayerVehicleID(playerid), engine, lights, alarm, doors, bonnet, boot, objective);

		 if(lights == 0)
			SetVehicleParamsEx(GetPlayerVehicleID(playerid), engine, 1, alarm, doors, bonnet, boot, objective);
		 else
			SetVehicleParamsEx(GetPlayerVehicleID(playerid), engine, 0, alarm, doors, bonnet, boot, objective);

		 PlayerPlaySound(playerid, 4604, 0.0, 0.0, 0.0);
	}
	return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
	return 1;
}

public OnPlayerUpdate(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid != INVALID_VEHICLE_ID && Fuell[vehicleid] < 1.0 && SpeedVehicle(playerid) != 0)
	{
		new Float:veh_posX, Float:veh_posY, Float:veh_posZ;
	    GetVehiclePos(vehicleid, veh_posX, veh_posY, veh_posZ);
		SetVehiclePos(vehicleid, veh_posX, veh_posY, veh_posZ);
	}

    afk_tick[playerid]++;
	return 1;
}


public OnPlayerStreamIn(playerid, forplayerid)
{
	return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
	return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
	return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
if(dialogid == DIALOG_HOOKAH)
	{
	    if(response)
	    {
	        switch(listitem)
	        {
         		case 0:
	            {
	            if(QalionPuted[playerid]== 0)
	            {
	            putqalion(playerid);
	            QalionPuted[playerid]= 1;
	            }
	            else SCM(playerid, COLOR_MATINRED, "You have already left the hookah.");
	            }
           		case 1:
	            {
				if(QalionPuted[playerid]==1)
				{
				takeqalion();
				QalionPuted[playerid]= 0;
				}
			 	else SCM(playerid, COLOR_MATINRED, "You have already taken the hookah.");
	            }
			}
		}
	}
	for(new i, z = strlen(inputtext); i < z; i++) if(inputtext[i] == '%') strdel(inputtext, i, i + 1);
	pDialog[playerid]  = false;

	#if DEBUG_STATUS == true
		printf("Player %s just completed dialog number %d", Name(playerid), dialogid);
	#endif

    switch(dialogid)
	{
	    case d_main_accessories: {
			if(!response) return 1;
			if(listitem == 0) {
				new string[42];
				dlobal_string[0] = EOS;
				strcat(dlobal_string, ""c_server"Please choose an accessory slot\n");
				for(new j = 0; j < 9; j ++) {
					if(p_info[playerid][accessories][j] == 0)
					{
						strcat(dlobal_string, "{828282}- Empty\n");
					}
					else {
						format(string, 42, "{ffffff}- %s\n", get_accessorie_name(p_info[playerid][accessories][j]));
						strcat(dlobal_string, string);
					}
				}
				SPD(playerid, d_main_accessories, DIALOG_STYLE_LIST, ""c_server"Accessories", dlobal_string, "Choose", "Back");
				return 1;
			}
			if(p_info[playerid][accessories][listitem - 1] == 0) {
				SendClientMessage(playerid, -1, !"- The accessory slot is empty.");
				new string[42];
				dlobal_string[0] = EOS;
				strcat(dlobal_string, ""c_server"Please choose an accessory slot\n");
				for(new j = 0; j < 9; j ++) {
					if(p_info[playerid][accessories][j] == 0)
					{
						strcat(dlobal_string, "{828282}- Empty\n");
					}
					else {
						format(string, 42, "{ffffff}- %s\n", get_accessorie_name(p_info[playerid][accessories][j]));
						strcat(dlobal_string, string);
					}
				}
				SPD(playerid, d_main_accessories, DIALOG_STYLE_LIST, ""c_server"Accessories", dlobal_string, "Choose", "Back");
				return 1;

			}
			SetPVarInt(playerid, "acc_listitem", listitem - 1);
			SPD(playerid, d_use_accessories, DIALOG_STYLE_LIST, ""c_server"Accessories", "{828282}- {FFFFFF}Wear\n{828282}- {FFFFFF}Remove\n{828282}- {FFFFFF}Drop", "Choose", "Back");
		}
		case d_use_accessories: {
			if(!response) {
				DeletePVar(playerid, "acc_listitem");
				new string[42];
				dlobal_string[0] = EOS;
				strcat(dlobal_string, ""c_server"Please choose an accessory slot\n");
				for(new j = 0; j < 9; j ++) {
					if(p_info[playerid][accessories][j] == 0)
					{
						strcat(dlobal_string, "{828282}- Empty\n");
					}
					else {
						format(string, 42, "{ffffff}- %s\n", get_accessorie_name(p_info[playerid][accessories][j]));
						strcat(dlobal_string, string);
					}
				}
				SPD(playerid, d_main_accessories, DIALOG_STYLE_LIST, ""c_server"Accessories", dlobal_string, "Choose", "Back");
				return 1;
			}
			new item_id = GetPVarInt(playerid, "acc_listitem");
			switch(listitem) {
				case 0: {
					p_info[playerid][accessories_used][item_id] = 1;
					GiveItem(playerid, p_info[playerid][accessories][item_id]);
					new query[136];
					format(query, sizeof(query), "UPDATE `accounts` SET `u_accessories_used`='%d|%d|%d|%d|%d%d|%d|%d|%d' WHERE `pID` = '%d'",
					p_info[playerid][accessories_used][0], p_info[playerid][accessories_used][1], p_info[playerid][accessories_used][2],
					p_info[playerid][accessories_used][3], p_info[playerid][accessories_used][4], p_info[playerid][accessories_used][5],
					p_info[playerid][accessories_used][6], p_info[playerid][accessories_used][7], p_info[playerid][accessories_used][8],
					p_info[playerid][pID]);
					mysql_tquery(dbHandle, query);
					SendClientMessage(playerid, -1, !"- Accessory successfully worn by the character.");
				}
				case 1: {
					p_info[playerid][accessories_used][item_id] = 0;
					for(new i = 5; i < 10; i ++) {
						if(IsPlayerAttachedObjectSlotUsed(playerid, i)) RemovePlayerAttachedObject(playerid, i);
					}
					for(new j = 0; j < 9; j ++) {
						if(p_info[playerid][accessories_used][j] == 0) continue;
						GiveItem(playerid, p_info[playerid][accessories][j]);
					}
					new query [ 136 ] ;
					format(query, sizeof(query), "UPDATE `accounts` SET `u_accessories_used`='%d|%d|%d|%d|%d%d|%d|%d|%d' WHERE `pID` = '%d'",
					p_info[playerid][accessories_used][0], p_info[playerid][accessories_used][1], p_info[playerid][accessories_used][2],
					p_info[playerid][accessories_used][3], p_info[playerid][accessories_used][4], p_info[playerid][accessories_used][5],
					p_info[playerid][accessories_used][6], p_info[playerid][accessories_used][7], p_info[playerid][accessories_used][8],
					p_info[playerid][pID]);
					mysql_tquery(dbHandle, query);
					SendClientMessage(playerid, -1, !"- Accessory successfully removed from the character.");
				}
				case 2: {
					p_info[playerid][accessories_used][item_id] = 0;
					p_info[playerid][accessories][item_id] = 0;
