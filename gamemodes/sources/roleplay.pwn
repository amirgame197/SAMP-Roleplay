CMD:giveheal(playerid,params[])
{
    if(sscanf(params,"ui",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/giveheal [Player id] [amount]");
    if(p_info[params[0]][pLogin] == 0) return SendClientMessage(playerid, -1,"Player is not logged in");//+;

	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"The Player is AFK.");//+
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_GREY,"You cannot use this on yourself.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid,COLOR_GREY,"The player should be with you beforehand.");

	if(!(1 <= params[1] <= 2)) return SendClientMessage(playerid, COLOR_GREY, "From 1 to 2.");

	if(p_info[playerid][pHeals] < params[1]) return SendClientMessage(playerid, COLOR_GREY, "You do not have that many first-aid kits.");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "The player already has an incoming trade request!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_GIVEHEALS, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "You offered %s to take %d first-aid kits from you.", Name(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s offered you to take %d first-aid kits from him.", Name(playerid), params[1]);

    return SendClientMessage(params[0], -1, "To agree, press Y(/accept) or for refusal, N(/cancel).");
}

CMD:givemask(playerid,params[])
