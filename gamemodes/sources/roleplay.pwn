        Attach3DTextLabelToVehicle(famveh3d, famveh, 0.0, 0.0, 0.0);
	    SendClientMessage(playerid,COLOR_BLUE,"Car created. Use: /park.");
	    SetPVarInt(playerid,"family vehicle",1);
	    FMVEHFILE = ini_openFile(text_string);
