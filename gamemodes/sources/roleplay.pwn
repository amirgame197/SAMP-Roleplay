cmd:fpanel(playerid)
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;

	new count = 0;
	dlobal_string[0] = EOS;
    for(new i = 1; i < MAX_FRACTIONS; i++)
	{
        text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\n", i, GetFractionName(i));
	    strcat(dlobal_string, text_string);

	    SetPlayerListitemValue(playerid, count++, i);
	}
	SPD(playerid, 9516, DIALOG_STYLE_LIST, !""c_server"Editing organizations", dlobal_string, !"Choose", !"Close");
	return 1;
}

cmd:alog(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
    extract params -> new string:name_player[24]; else return SendClientMessage(playerid, col_grey, !"Use: /alog [Player Nick]");

    new sql_id = GetPlayerSqlIDByName(name_player);
	if(sql_id == INVALID_SQL_ID) return SendClientMessage(playerid, col_white, !""c_error"Player with that Nickname not found.");

    player_mysql_params[playerid] = sql_id;
 	player_mysql_page[playerid] = 0;
	return ShowPlayerAdminLog(playerid);
}

cmd:addnotify(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new string:name_player[24], string:notify_text[144]; else return SendClientMessage(playerid, col_grey, !"Use: /addnotify [Player Nick] [text]");

	new sql_id = GetPlayerSqlIDByName(name_player);
	if(sql_id == INVALID_SQL_ID) return SendClientMessage(playerid, col_grey, !""c_error"Player with that Nickname not found.");

	format_string[0] = EOS;
	mysql_format(dbHandle, format_string, sizeof(format_string), "INSERT INTO `notifications` (`user_id`,`text`) VALUES ('%d','%e')", sql_id, notify_text);
	mysql_query(dbHandle, format_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You left a message for Player "c_server"%s"c_white".", name_player);
	SendClientMessage(playerid, col_white, text_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"Text: "c_orange"%s", notify_text);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}

cmd:asellhouse(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new asell_house; else return SendClientMessage(playerid, col_grey, !"Use: /asellhouse [House #]");
	if(!(0 <= asell_house <= max_houses - 1)) //new i = GetPlayerHouse(playerid);
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"House numbers must be from 0 to %d.", max_houses - 1);
		return SendClientMessage(playerid, col_white, text_string);
	}

	strmid(HouseInfo[asell_house][hOwner], "None", 0, strlen("None"), 64);
    HouseInfo[asell_house][hOwned] = 0;
	HouseInfo[asell_house][hHel] = 0;
	HouseInfo[asell_house][hLock] = 0;
	HouseInfo[asell_house][hUpdAD] = 0;
	HouseInfo[asell_house][hUpdHel] = 0;
	HouseInfo[asell_house][hUpdSub] = 0;
	HouseInfo[asell_house][hUpdStore] = 0;
	HouseInfo[asell_house][hSlet] = 0;
	HouseInfo[asell_house][hOplata] = 0;

	DestroyHouseStore(asell_house);
	DestroyDynamic3DTextLabel(healtext[asell_house]);

	if(HouseInfo[asell_house][hAreaHeal] != 0) DestroyDynamicPickup(HouseInfo[asell_house][hAreaHeal]);
	UpdatePickupHouse(asell_house);
	SaveHouse(asell_house);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You successfully sold the House."c_server"#%d", asell_house);
    return SendClientMessage(playerid, col_white, text_string);
}

cmd:creategarage(playerid, params[])
{
	if(admin_level[playerid] < 8) return 1;
	extract params -> new h_cgarage; else return SendClientMessage(playerid, col_grey, !"Use: /creategarage [House #]");

    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    HouseInfo[h_cgarage][hGaragex] = x;
	HouseInfo[h_cgarage][hGaragey] = y;
	HouseInfo[h_cgarage][hGaragez] = z;

    //CreatePickup(1239, 23, HouseInfo[h_cgarage][hGaragex], HouseInfo[h_cgarage][hGaragey], HouseInfo[h_cgarage][hGaragez],-1);

    new strla[444];
	format(strla, 244, "{FFC900}Garage\nClass: {FFFFFF}%d\n{FFC900}House : {FFFFFF}#%d\n{FFC900}Owner : {FFFFFF}%s \n{FFFFFF}Use {FFC900}/garage{FFFFFF} to enter",HouseInfo[h_cgarage][hKlass],HouseInfo[h_cgarage][hOwner],h_cgarage);
    HouseInfo[h_cgarage][gLabel] = Create3DTextLabel(strla, 0xFFFFFFFF,  HouseInfo[h_cgarage][hGaragex], HouseInfo[h_cgarage][hGaragey], HouseInfo[h_cgarage][hGaragez], 25.0000, 0, 1);
	//UpdatePickupHouse(h_cgarage);
	SaveHouse(h_cgarage);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You have successfully created a garage house."c_server"#%d", h_cgarage);
    return SendClientMessage(playerid, col_white, text_string);
}

cmd:garage(playerid, params[])
{
	new h_id = GetPlayerHouse(playerid);

    if(h_id == -1) return SendClientMessage(playerid, COLOR_GREY, "You do not have a house.");
    if(HouseInfo[h_id][hGaragex] == 0 && HouseInfo[h_id][hGaragey] == 0 && HouseInfo[h_id][hGaragez] == 0) return SendClientMessage(playerid, COLOR_GREY, "You do not have a garage.");

	if(PlayerToPoint(20.0, playerid, 1381.8062,-41.4943,1001.0511)) //Exit
	{
    	    if(IsPlayerInAnyVehicle(playerid))
    	    {
    	        new vehicleid = GetPlayerVehicleID(playerid);
				SetVehiclePos(vehicleid, HouseInfo[h_id][hGaragex], HouseInfo[h_id][hGaragey], HouseInfo[h_id][hGaragez]);
				SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), 0);
				SetPlayerVirtualWorld(playerid, 0);
				RepairVehicle(GetPlayerVehicleID(playerid));
    	    }
         	else SetPPos(playerid, HouseInfo[h_id][hGaragex], HouseInfo[h_id][hGaragey], HouseInfo[h_id][hGaragez], 0.0, 0,  0, false);

	}

	if(PlayerToPoint(4.0, playerid, HouseInfo[h_id][hGaragex], HouseInfo[h_id][hGaragey], HouseInfo[h_id][hGaragez])) //Enter
	{
	    if(HouseInfo[h_id][hKlass] == 0) //Class 1
		{
		        if(IsPlayerInAnyVehicle(playerid))
	    	    {
	    	        new vehicleid = GetPlayerVehicleID(playerid);
					SetVehiclePos(vehicleid, 1381.8062,-41.4943,1001.0511 + 1);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), HouseInfo[h_id][hID]);
					SetPlayerVirtualWorld(playerid, HouseInfo[h_id][hID]);
					RepairVehicle(GetPlayerVehicleID(playerid));
	    	    }
	         	else SetPPos(playerid, 1381.8062,-41.4943,1001.0511, 0.0, 0,  HouseInfo[h_id][hID], true);
		}

		if(HouseInfo[h_id][hKlass] == 1) //Class 2
		{
		        if(IsPlayerInAnyVehicle(playerid))
	    	    {
	    	        new vehicleid = GetPlayerVehicleID(playerid);
					SetVehiclePos(vehicleid, 1381.8062,-41.4943,1001.0511 + 1);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), HouseInfo[h_id][hID]);
					SetPlayerVirtualWorld(playerid, HouseInfo[h_id][hID]);
					RepairVehicle(GetPlayerVehicleID(playerid));
	    	    }
	         	else SetPPos(playerid, 1381.8062,-41.4943,1001.0511, 0.0, 0,  HouseInfo[h_id][hID], true);
		}

		if(HouseInfo[h_id][hKlass] == 2) //Class 3
		{
		        if(IsPlayerInAnyVehicle(playerid))
	    	    {
	    	        new vehicleid = GetPlayerVehicleID(playerid);
					SetVehiclePos(vehicleid, 1381.8062,-41.4943,1001.0511 + 1);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), HouseInfo[h_id][hID]);
					SetPlayerVirtualWorld(playerid, HouseInfo[h_id][hID]);
					RepairVehicle(GetPlayerVehicleID(playerid));
	    	    }
	         	else SetPPos(playerid, 1381.8062,-41.4943,1001.0511, 0.0, 0,  HouseInfo[h_id][hID], true);
		}

		if(HouseInfo[h_id][hKlass] == 3) //Class 4
		{
		        if(IsPlayerInAnyVehicle(playerid))
	    	    {
	    	        new vehicleid = GetPlayerVehicleID(playerid);
					SetVehiclePos(vehicleid, 1381.8062,-41.4943,1001.0511 + 1);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), HouseInfo[h_id][hID]);
					SetPlayerVirtualWorld(playerid, HouseInfo[h_id][hID]);
					RepairVehicle(GetPlayerVehicleID(playerid));
	    	    }
	         	else SetPPos(playerid, 1381.8062,-41.4943,1001.0511, 0.0, 0,  HouseInfo[h_id][hID], true);
		}

		if(HouseInfo[h_id][hKlass] == 4) //Class 5
		{
		        if(IsPlayerInAnyVehicle(playerid))
	    	    {
	    	        new vehicleid = GetPlayerVehicleID(playerid);
					SetVehiclePos(vehicleid, 1381.8062,-41.4943,1001.0511 + 1);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), HouseInfo[h_id][hID]);
					SetPlayerVirtualWorld(playerid, HouseInfo[h_id][hID]);
					RepairVehicle(GetPlayerVehicleID(playerid));
	    	    }
	         	else SetPPos(playerid, 1381.8062,-41.4943,1001.0511, 0.0, 0,  HouseInfo[h_id][hID], true);
		}

		if(HouseInfo[h_id][hKlass] == 5) //Class 6
		{
		        if(IsPlayerInAnyVehicle(playerid))
	    	    {
	    	        new vehicleid = GetPlayerVehicleID(playerid);
					SetVehiclePos(vehicleid, 1381.8062,-41.4943,1001.0511 + 1);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), HouseInfo[h_id][hID]);
					SetPlayerVirtualWorld(playerid, HouseInfo[h_id][hID]);
					RepairVehicle(GetPlayerVehicleID(playerid));
	    	    }
	         	else SetPPos(playerid, 1381.8062,-41.4943,1001.0511, 0.0, 0,  HouseInfo[h_id][hID], true);
		}

		if(HouseInfo[h_id][hKlass] == 6) //Class 7
		{
		        if(IsPlayerInAnyVehicle(playerid))
	    	    {
	    	        new vehicleid = GetPlayerVehicleID(playerid);
					SetVehiclePos(vehicleid, 1381.8062,-41.4943,1001.0511 + 1);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), HouseInfo[h_id][hID]);
					SetPlayerVirtualWorld(playerid, HouseInfo[h_id][hID]);
					RepairVehicle(GetPlayerVehicleID(playerid));
	    	    }
	         	else SetPPos(playerid, 1381.8062,-41.4943,1001.0511, 0.0, 0,  HouseInfo[h_id][hID], true);
		}

	}

	return 1;
}

cmd:asellbiz(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new asell_biz; else return SendClientMessage(playerid, col_grey, !"Use: /asellbiz [Business #]");

	if(!(0 <= asell_biz <= MAX_BIZZ - 1))
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The valid business numbers are from 0 to %d.", MAX_BIZZ - 1);
	    return SendClientMessage(playerid, col_white, text_string);
	}

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "DELETE FROM `bizz_stats` WHERE `bID`='%d'", asell_biz);
	mysql_tquery(dbHandle, text_string);

	if(BizzInfo[asell_biz][bUpdHeal] != 0) DestroyDynamicPickup(BizzInfo[asell_biz][bPickupHeal]);

	BizzInfo[asell_biz][bPrice] = 50;
	BizzInfo[asell_biz][bSklad] = 1000;

    BizzInfo[asell_biz][bOwned] =
	BizzInfo[asell_biz][bLocked] =
	BizzInfo[asell_biz][bMoney] =
	BizzInfo[asell_biz][bRaschet] =
	BizzInfo[asell_biz][bOplata] =
	BizzInfo[asell_biz][bEntranceCost] =
	BizzInfo[asell_biz][bSlet] =
	BizzInfo[asell_biz][bUpdHeal] =
	BizzInfo[asell_biz][bUpdSub] =
	BizzInfo[asell_biz][bUpdMusic] =
	BizzInfo[asell_biz][bPhone] =
	BizzInfo[asell_biz][bProcent] =
	BizzInfo[asell_biz][bSotrud] = 0;

	strmid(BizzInfo[asell_biz][bOwner], "None", 0, strlen("None"), 32);

	update_business_text(asell_biz);
	SaveBizz(asell_biz);

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_sucess"You have successfully sold the business."c_server"%s [ #%d ]", BizzInfo[asell_biz][bMessage], asell_biz);
    return SendClientMessage(playerid, col_white, text_string);
}

cmd:asellfuel(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new asell_fuel; else return SendClientMessage(playerid, col_grey, !"Use: /asellfuel [Gas Station #]");

	if(!(0 <= asell_fuel <= MAX_BIZZ - 1))
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"The valid gas station numbers are from 0 to %d.", MAX_aBIZZ - 1);
	    return SendClientMessage(playerid, col_white, text_string);
	}

	BizzAInfo[asell_fuel][aOwned] = 0;
	SaveABizzPer(asell_fuel, "aOwned", 0);

	format_string[0] = EOS;
	format(format_string, sizeof(format_string), "{0099FF}Gas station '%s'\n"c_white"Price per liter: %d$\n\n{EBBD00}The gas station is for sale\nPrice: %d$\n{66CC00}/buyfuelst to buy",BizzAInfo[asell_fuel][aMessage], BizzAInfo[asell_fuel][aPrice], BizzAInfo[asell_fuel][aBuyPrice]);
	Update3DTextLabelText(BizzAInfo[asell_fuel][aLabel], -1, format_string);

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_sucess"You have successfully sold the gas station."c_server"%s [ #%d ]", BizzAInfo[asell_fuel][aMessage], asell_fuel);
    return SendClientMessage(playerid, col_white, text_string);
}

cmd:bonus(playerid)
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_white"x2 EXP\t%s\n"c_white"x2 Donate\t%s", bonus_exp ? (""c_green"Enabled") : (""c_orange_red"You are included"), _bonus_donate ? (""c_green"Enabled") : (""c_orange_red"You are included"));
