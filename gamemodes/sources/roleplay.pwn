cmd:setauninvite(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid, string:reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /auninvite [Player id] [Reason].");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(!p_info[targetid][pMember]) return SendClientMessage(playerid, col_white, !""c_error"The Player is not a member of The organization.");
	if(p_info[targetid][pLeader] > 0) return SendClientMessage(playerid, col_white, !""c_error"The Player is the leader of The organization.");

  	if(targetid == playerid)
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_info"You have successfully removed your leadership of The organization."c_server"%s", FracInfo[p_info[targetid][pMember]][fName]);
	    SendClientMessage(playerid, col_white, text_string);
	}

	if(targetid != playerid)
	{
	    text_string[0] = EOS;
    	format(text_string, sizeof(text_string), "[A] %s[%d] fired Player %s[%d] from The organization %s. Reason: %s", Name(playerid), playerid, Name(targetid), targetid, FracInfo[p_info[targetid][pMember]][fName], reason);
		send_admin_message(col_grey, text_string);

		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white"You have been fired from The organization %s. Reason: "c_orange"%s", Name(playerid), FracInfo[p_info[targetid][pMember]][fName], reason);
		SendClientMessage(targetid, col_white, text_string);
	}

    p_info[targetid][pLeader] =
    p_info[targetid][pMember] =
    p_info[targetid][pRank] =
    p_info[targetid][pfWarn] =
	form_fraction[targetid] =
	p_info[targetid][setspawn] = 0;

	SetPlayerSkinEx(targetid, p_info[targetid][pSkin]);
	SetPlayerToTeamColor(targetid);

	SavePlayerFraction(targetid);
	return 1;
}

cmd:freezepanel(playerid)
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;

    new
		status_freeze_ballas[28],
		status_freeze_vagos[28],
		status_freeze_grove[28],
		status_freeze_aztec[28],
		status_freeze_rifa[28];

	if(FracInfo[FRACTION_BALLAS][fFreeze] == 1) status_freeze_ballas = ""c_orange_red"Frozen.";
	else status_freeze_ballas = ""c_green"Unfrozen.";

	if(FracInfo[FRACTION_VAGOS][fFreeze] == 1) status_freeze_vagos = ""c_orange_red"Frozen.";
	else status_freeze_vagos = ""c_green"Unfrozen.";

	if(FracInfo[FRACTION_GROVE][fFreeze] == 1) status_freeze_grove = ""c_orange_red"Frozen.";
	else status_freeze_grove = ""c_green"Unfrozen.";

	if(FracInfo[FRACTION_AZTEC][fFreeze] == 1) status_freeze_aztec = ""c_orange_red"Frozen.";
	else status_freeze_aztec = ""c_green"Unfrozen.";

	if(FracInfo[FRACTION_RIFA][fFreeze] == 1) status_freeze_rifa = ""c_orange_red"Frozen.";
	else status_freeze_rifa = ""c_green"Unfrozen.";

    slobal_string[0] = EOS;
	format(slobal_string, 300, ""c_white"East Side Ballas\t%s\n"c_white"Los Santos Vagos\t%s\n"c_white"Grove Street\t%s\n"c_white"Varrios Los Aztecas\t%s\n"c_white"The Rifa\t%s", status_freeze_ballas, status_freeze_vagos, status_freeze_grove, status_freeze_aztec, status_freeze_rifa);
	return SPD(playerid, 8421, DIALOG_STYLE_TABLIST, ""c_server"Status of freezing", slobal_string, !"Choose", !"Close");
}
