	        if(p_info[playerid][pCash] < BizzInfo[bizz][bEntranceCost]) return SendClientMessage(playerid, -1, "You do not have enough money to enter.");

			GivePlayerMoneyEx(playerid, -BizzInfo[bizz][bEntranceCost], "Entering business."),

	        GiveBusinessMoney(bizz, BizzInfo[bizz][bEntranceCost], 0);

	        SetPVarInt(playerid, "EntrancePaymentBizz", bizz);

