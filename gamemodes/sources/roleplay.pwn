CMD:t(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return PlayerMuted(playerid);
    if(!(70 <= p_info[playerid][pJob] <= 72)) return SendClientMessage(playerid, COLOR_GREY, "You are not a taxi driver.");

	if(sscanf(params, "s[64]",params)) return SendClientMessage(playerid, -1, "Enter: /t [text]");
	format(format_string, sizeof(format_string), "[T] %s[%d]: %s", Name(playerid), playerid, params), SendTaxiMessage(0xF2E800FF, format_string);
	return 1;
}

