		sscanf(result_string, "p<,>a<i>[3]", CarInfo[playerid][cStereo]);

		cache_get_value_name(0, "cVentRight",result_string);
		sscanf(result_string, "p<,>a<i>[3]", CarInfo[playerid][cVentRight]);

		cache_get_value_name(0, "cVentLeft",result_string);
		sscanf(result_string, "p<,>a<i>[3]", CarInfo[playerid][cVentLeft]);

		cache_get_value_name(0, "cSost",result_string);
		sscanf(result_string, "p<,>a<i>[3]", CarInfo[playerid][cSost]);

		cache_get_value_name(0, "cPaintJobs",result_string);
		sscanf(result_string, "p<,>a<i>[3]", CarInfo[playerid][cPaintJobs]);

		new tune_string[MAX_PLAYER_VEHICLES][32];

		cache_get_value_name(0, "engine_tune", result_string);
		SplitString(result_string, tune_string, '|');
		for(new i; i < MAX_PLAYER_VEHICLES; i++) sscanf(tune_string[i], "p<,>a<i>[5]",player_engine_tune[playerid][i]);

		cache_get_value_name(0, "brake_tune", result_string);
		SplitString(result_string, tune_string, '|');
		for(new i; i < MAX_PLAYER_VEHICLES; i++) sscanf(tune_string[i], "p<,>a<i>[5]",player_brake_tune[playerid][i]);

     	cache_get_value_name(0, "car_park", result_string);
		SplitString(result_string, tune_string, '|');
		for(new i; i < MAX_PLAYER_VEHICLES; i++) sscanf(tune_string[i], "p<,>a<f>[4]",player_car_park[playerid][i]);

     	for(new i; i < MAX_PLAYER_VEHICLES; i++)
     	{
     	    new bool: need_save = false;

	     	if(CarInfo[playerid][cModel][i] != 0 && player_car_park[playerid][i][0] == 0.0)
	     	{
	     	    new rand = random(sizeof default_park_pos);

	     	    player_car_park[playerid][i][0] = default_park_pos[rand][0];
	     	    player_car_park[playerid][i][1] = default_park_pos[rand][1];
	     	    player_car_park[playerid][i][2] = default_park_pos[rand][2];
	     	    player_car_park[playerid][i][3] = 0.0;

	     	    need_save = true;
	     	}

	     	if(need_save) SavePlayerCarPark(playerid);
		}

		if(p_info[playerid][family])
		{
		    new familyid = p_info[playerid][family];
			Iter_Add(family_players[familyid], playerid);
		}

		new last_date[16];
		cache_get_value_name(0, "pOnline", last_date, 16);

		new now_date = getdate(), last_curdate;

		cache_get_value_int(0, "last_curdate", last_curdate);

		if(last_curdate != now_date)
		{
			format(format_string, 144, "INSERT INTO `online_log` (`user_id`,`day`,`play_time`,`afk_time`) VALUES (%d,'%s',%d,%d);", GetPlayerAccountID(playerid), last_date, p_info[playerid][pInGameSeconds], p_info[playerid][pInGameAFKSeconds]);
		    mysql_tquery(dbHandle, format_string);

			p_info[playerid][pInGameSeconds] = p_info[playerid][pInGameAFKSeconds] = 0;

		    format(format_string, 244, "UPDATE `accounts` SET `pInGameSeconds` = 0, `pInGameAFKSeconds` = 0, `last_curdate` = %d, `pOnline` = '%02i.%02i.%d' WHERE `pID` = %d", now_date, day, month, year, GetPlayerAccountID(playerid));
		    mysql_tquery(dbHandle, format_string);

		    OnPlayerUpdateAdminPer(playerid, "pAdmRepDay", 0);
		}

		new hour, minute, second;
		gettime(hour, minute, second);

		new last_hour;
		cache_get_value_int(0, "last_hour", last_hour);

		if(hour != last_hour)
		{
			p_info[playerid][pInGameHourSeconds] = 0;

		    format(format_string, 188, "UPDATE `accounts` SET `pInGameHourSeconds` = 0, `last_hour` = %d WHERE `pID` = %d", hour, GetPlayerAccountID(playerid));
		    mysql_tquery(dbHandle, format_string);
		}

		foreach(new i : capture_zone_list)
		{
		    if(p_info[playerid][pMember] != GZInfo[i][gFraction] && p_info[playerid][pMember] != GZInfo[i][gAttack]) continue;
			for(new j; j < 18; j++) TextDrawShowForPlayer(playerid, GZInfo[i][gTD][j]);
			break;
		}

		if(BW_INFO[bw_time] != 0 && (p_info[playerid][pMember] == BW_INFO[bw_attack] || p_info[playerid][pMember] == BW_INFO[bw_owner]))
		{
		    for(new j; j < 8; j++) TextDrawShowForPlayer(playerid, BW_INFO[bw_td][j]);
		}

		if(p_info[playerid][pLevel] > 1 && election_status && !p_info[playerid][pElecVote])
		{
			SendClientMessage(playerid, 0x33AAFFFF, "Attention!"c_white"You are holding presidential elections in the state!");
			SendClientMessage(playerid, -1, "You can vote in the Government building {D4D4D4}(/gps > Public Places > Administration of the President)");
		}

		CreatePlayeDrugMark(playerid);

		UpdatePlayerQuestData(playerid);

  		format(MySQLStr, 96, "SELECT * FROM `warninfo` WHERE `plID` = %d", p_info[playerid][pID]); // LoadWarns
		mysql_tquery(dbHandle, MySQLStr, "Load My Warnings", "d", playerid);

 		LoadAccounts(playerid);
		SetTagName(playerid);
  	}
  	else SendClientMessage(playerid, COLOR_GREY, "A critical error has occurred, please inform the server administration.");
  	return 1;
}

function ShowPlayerNofitications(playerid)
{
    new rows;
	cache_get_row_count(rows);

	if(!rows) return 1;

	new text[244];

	for(new i; i < rows; i++)
	{
	    cache_get_value_name(0, "text", text);

	    SCMF(playerid, COLOR_YELLOW, "[Notification] "c_white"%s", text);
	}

	format(format_string, 144, "DELETE FROM `notifications` WHERE `user_id` = %d", GetPlayerAccountID(playerid));
	mysql_tquery(dbHandle, format_string);

	return 1;
}

function is_player_admin(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    cache_get_value_name(0, "pAdminKey", p_info[playerid][pAdminKey], 16);
	    cache_get_value_name(0, "pDataNaz", p_info[playerid][pDataNaz], 32);

     	cache_get_value_int(0, "pAdmin", admin_level[playerid]);
     	cache_get_value_int(0, "pAdmRep", p_info[playerid][pAdmRep]);
     	cache_get_value_int(0, "pAdmRepDay", p_info[playerid][pAdmRepDay]);
     	cache_get_value_int(0, "pAdmKick", p_info[playerid][pAdmKick]);
     	cache_get_value_int(0, "pAdmBan", p_info[playerid][pAdmBan]);
     	cache_get_value_int(0, "pAdmWarn", p_info[playerid][pAdmWarn]);
     	cache_get_value_int(0, "pAdmPrison", p_info[playerid][pAdmPrison]);
     	cache_get_value_int(0, "pAdmMute", p_info[playerid][pAdmMute]);

      	admin_level[playerid] = admin_level[playerid];
      	ToAdminHasi[playerid] = true;

 	}
 	else admin_level[playerid] = admin_logged[playerid] = 0;
}

stock OnPlayerUpdateAccounts(playerid)
{
    if(p_info[playerid][pLogin] == 0) return 1;

	static string[256];

    MySQLStr = "";

    format(string, 256, "UPDATE `accounts` SET `pSatiety` = '%.3f', `u_setspawn` = %d, `pJob` = %d",
 	p_info[playerid][pSatiety], p_info[playerid][setspawn], p_info[playerid][pJob]);
	strcat(MySQLStr, string);

	format(string, 188, ", `pPatron` = %d, `pMetall` = %d, `pUseCar` = %d, `pInGameHourSeconds` = %d",
 	p_info[playerid][pPatron], p_info[playerid][pMetall], p_info[playerid][pUseCar], p_info[playerid][pInGameHourSeconds]);
    strcat(MySQLStr, string);

	format(string, 256, ", `pNumber` = %d, `pSummaNumber` = %d, `pLaw` = %d, `pWanted` = %d, `pfWarn` = %d",
 	p_info[playerid][pNumber], p_info[playerid][pSummaNumber], p_info[playerid][pZakon], p_info[playerid][pWanted], p_info[playerid][pfWarn]);
    strcat(MySQLStr, string);

	format(string, 256, ", `pMuted` = %d, `pUpdPlayer` = '%d,%d,%d,0,0'",
 	p_info[playerid][mute], p_info[playerid][pUpdPlayer][0], p_info[playerid][pUpdPlayer][1], p_info[playerid][pUpdPlayer][2]);
    strcat(MySQLStr, string);

	format(string, 256, ", `pPrison` = %d, `pMestoPrison` = %d, `pInGameSeconds` = %d, pInGameAFKSeconds = %d",
 	p_info[playerid][pPrison], p_info[playerid][pMestoPrison], p_info[playerid][pInGameSeconds], p_info[playerid][pInGameAFKSeconds]);
    strcat(MySQLStr, string);

	if(player_duel_start[playerid] != true)
	{
	    for(new i; i < 13; i++) GetPlayerWeaponData(playerid, i, p_info[playerid][pGun][i], p_info[playerid][pAmmo][i]);
	    //ResetPlayerWeapons(playerid);

		format(string, 128, ", `pGun`='%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d'",
		p_info[playerid][pGun][0], p_info[playerid][pGun][1], p_info[playerid][pGun][2], p_info[playerid][pGun][3], p_info[playerid][pGun][4], p_info[playerid][pGun][5],
	    p_info[playerid][pGun][6], p_info[playerid][pGun][7], p_info[playerid][pGun][8], p_info[playerid][pGun][9], p_info[playerid][pGun][10], p_info[playerid][pGun][11], p_info[playerid][pGun][12]);
	    strcat(MySQLStr, string);

	   	format(string, 128, ", `pAmmo`='%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d'",
		p_info[playerid][pAmmo][0], p_info[playerid][pAmmo][1], p_info[playerid][pAmmo][2], p_info[playerid][pAmmo][3], p_info[playerid][pAmmo][4], p_info[playerid][pAmmo][5], p_info[playerid][pAmmo][6],
		p_info[playerid][pAmmo][7], p_info[playerid][pAmmo][8], p_info[playerid][pAmmo][9], p_info[playerid][pAmmo][10], p_info[playerid][pAmmo][11], p_info[playerid][pAmmo][12], p_info[playerid][pID]);
		strcat(MySQLStr, string);
	}

	format(string, 188, ", `pGunSkill` = '%d,%d,%d,%d,%d,%d', `pText` = %d, `pHeals` = %d, `pFrSkin` = %d",
	p_info[playerid][pGunSkill][0], p_info[playerid][pGunSkill][1], p_info[playerid][pGunSkill][2], p_info[playerid][pGunSkill][3], p_info[playerid][pGunSkill][4], p_info[playerid][pGunSkill][5], p_info[playerid][pText], p_info[playerid][pHeals], p_info[playerid][pFrSkin]);
    strcat(MySQLStr, string);

	format(string, 256, ", `pRouble` = %d, `pVip` = %d, `pVipTime` = %d WHERE `pID` = %d",
	p_info[playerid][pRouble], p_info[playerid][pVip], p_info[playerid][pVipTime], p_info[playerid][pID]);
    strcat(MySQLStr, string);

	mysql_tquery(dbHandle, MySQLStr);

    if(GetPlayerBizz(playerid) != -1) SaveBizz(GetPlayerBizz(playerid));
    if(GetPlayerABizz(playerid) != 0) SaveABizz(GetPlayerABizz(playerid));
    if(GetPlayerHouse(playerid) != 0) SaveHouse(GetPlayerHouse(playerid));

	SaveCars(playerid);

	return 1;
}

stock OnPlayerUpdateAdminPer(i, per[], per1) return format(MySQLStr, 188, "UPDATE `admin` SET `%s` = %d WHERE `Name` = '%s' LIMIT 1", per, per1, Name(i)), mysql_tquery(dbHandle, MySQLStr, "", "");
stock OnPlayerUpdateAccountsPer(i, per[], per1) return format(MySQLStr, 144, "UPDATE `accounts` SET `%s` = %d WHERE `pID` = %d LIMIT 1", per, per1, p_info[i][pID]), mysql_tquery(dbHandle, MySQLStr, "", "");
stock SaveABizzPer(i, per[], per1) return format(MySQLStr, 144, "UPDATE `bizz_fuel` SET `%s` = %d WHERE `aID` = %d LIMIT 1", per, per1, i), mysql_tquery(dbHandle, MySQLStr, "", "");

stock SaveBizzPer(i, per[], per1)
{
    if(BizzInfo[i][bEntranceX] == 0.0) return 0;

	format(MySQLStr, 144, "UPDATE `bizz` SET `%s`='%d' WHERE `bID` = %d LIMIT 1", per, per1, i);
	mysql_tquery(dbHandle, MySQLStr);
	return 1;
}

stock SaveHousePer(i, per[], per1) return format(MySQLStr, 144, "UPDATE `house` SET `%s` = %d WHERE `hID` = %d LIMIT 1", per, per1, i), mysql_tquery(dbHandle, MySQLStr, "", "");
