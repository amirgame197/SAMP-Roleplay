//=============================


PlayAudioStreamForPlayer(playerid, "http://dl.mp3");
TextDrawHideForPlayer(playerid, DScreen0[playerid]);
	TextDrawHideForPlayer(playerid, DScreen1[playerid]);
	TextDrawHideForPlayer(playerid, DScreen2[playerid]);
	TextDrawHideForPlayer(playerid, DScreen3[playerid]);
	TextDrawHideForPlayer(playerid, DScreen4[playerid]);
	TextDrawHideForPlayer(playerid, DScreen5[playerid]);
