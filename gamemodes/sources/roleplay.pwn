	TextDrawHideForPlayer(playerid, IntroLogo[1]);
	TextDrawHideForPlayer(playerid, IntroLogo[2]);
	TextDrawHideForPlayer(playerid, IntroLogo[3]);
	TextDrawHideForPlayer(playerid, IntroLogo[4]);
	TextDrawHideForPlayer(playerid, IntroLogo[5]);
	TextDrawHideForPlayer(playerid, IntroLogo[6]);
	TextDrawHideForPlayer(playerid, IntroLogo[7]);
	TextDrawHideForPlayer(playerid, IntroLogo[8]);
	TextDrawHideForPlayer(playerid, IntroLogo[9]);
    TextDrawHideForPlayer(playerid, IntroLogo[10]);
	ResetPlayerWeapons(playerid);
	for(new i; i < 13; i++)
	{
		if(p_info[playerid][pGun][i])
		{
			GivePlayerWeapon(playerid, p_info[playerid][pGun][i], p_info[playerid][pAmmo][i]);
		}
	}
  /*GivePlayerWeapon(playerid, p_info[playerid][pGun][0], p_info[playerid][pAmmo][0]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][1], p_info[playerid][pAmmo][1]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][2], p_info[playerid][pAmmo][2]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][3], p_info[playerid][pAmmo][3]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][4], p_info[playerid][pAmmo][4]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][5], p_info[playerid][pAmmo][5]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][6], p_info[playerid][pAmmo][6]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][7], p_info[playerid][pAmmo][7]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][8], p_info[playerid][pAmmo][8]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][9], p_info[playerid][pAmmo][9]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][10], p_info[playerid][pAmmo][10]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][11], p_info[playerid][pAmmo][11]);
	GivePlayerWeapon(playerid, p_info[playerid][pGun][12], p_info[playerid][pAmmo][12]);*/  //Naparidn gun ha riding by

    killer_id[playerid] = INVALID_PLAYER_ID;
	pDialog[playerid] = false;
    if(p_info[playerid][pSkin] == -1) return SkinChar(playerid);
	if(p_info[playerid][pLogin] != 1) return Kick(playerid);

    SetPlayerSkills(playerid);
	PreloadAnimLibs(playerid);

	if(player_bag[playerid])
	{
	    player_bag[playerid] = false;
	    TextDrawHideForPlayer(playerid, black_display[playerid]);
	}

    player_gag[playerid] = false;

	if(player_tie[playerid])
	{
	    TogglePlayerControllable(playerid, true);
		player_tie[playerid] = false;
	}

    if(GetPVarInt(playerid, "VibClothes") != 0)
    {
        SetPlayerPos(playerid,216.7040,-98.6638,1005.2578);
		SetPlayerFacingAngle(playerid, 89.1646);

		SetPlayerCameraPos(playerid, 213.9831, -98.6852, 1005.1337);
		SetPlayerCameraLookAt(playerid, 214.9816, -98.6917, 1005.0933);

		SetPlayerVirtualWorld(playerid,playerid);
		SetPlayerInterior(playerid,15);

		return 1;
	}
	if(GetPVarInt(playerid, "LoginOgran") != -1) SetPVarInt(playerid, "LoginOgran", -1);
	SetPlayerScore(playerid, p_info[playerid][pLevel]);

    SetPlayerMoneyCase(playerid);

	SetPlayerToTeamColor(playerid);
    if(p_t_info[playerid][pWork]) p_t_info[playerid][pWork] = 0;

	SetPlayerSpawn(playerid);
	return 1;
}

stock SetPlayerSpawn(playerid)
{
    if(p_info[playerid][pMember] && p_info[playerid][pFrSkin])
	{
		SetPlayerSkinEx(playerid,p_info[playerid][pFrSkin]);
		form_fraction[playerid] = p_info[playerid][pMember];
	}
	else
	{
	    SetPlayerSkinEx(playerid, p_info[playerid][pSkin]);
	    form_fraction[playerid] = 0;
	}

	if(ToAdminHasi[playerid])
	{
     SetPPos(playerid, -819.6500, 501.0020, 1359.4139, 269.9915, 1, 0, false);
     }

	if(GetPVarInt(playerid, "Dm_Zone"))
	{
		SetPlayerHealth(playerid, 100.0);
		new rand = random(sizeof player_spawn_dm);
	SetPPos(playerid, player_spawn_dm[rand][0],player_spawn_dm[rand][1],player_spawn_dm[rand][2], player_spawn_dm[rand][3], 0, 0, false);
      SetPlayerInterior(playerid, 10);
     GivePlayerWeapon(playerid, 24, 200);
    GivePlayerWeapon(playerid, 30, 700);
	SetPlayerArmour(playerid, 100);
	SetPlayerHealth(playerid, 100);
		SendClientMessage(playerid, col_yellow, " ");

		return 1;
	}

    if(GetPVarInt(playerid, "spawn after duel"))
    {
	    SetPlayerHealth(playerid, 100.0);
		SetPPos(playerid, 2385.6812, -1506.1160, 24.0000, 359.4910, GetPlayerInterior(playerid), 0, false);

        DeletePVar(playerid, "spawn after duel");
	    return 1;
    }

	if(GetPVarInt(playerid, "EPLAYER"))
	{
	    SetPPos(playerid, GetPVarFloat(playerid,"e_X"), GetPVarFloat(playerid,"e_Y"), GetPVarFloat(playerid,"e_Z"), 0.0, GetPVarInt(playerid,"e_Int"), GetPVarInt(playerid,"e_Virt"), false);

		DeletePVar(playerid, "e_X");
		DeletePVar(playerid, "e_Y");
		DeletePVar(playerid, "e_Z");
		DeletePVar(playerid, "e_Int");
		DeletePVar(playerid, "e_Virt");
		DeletePVar(playerid, "e_time");
		DeletePVar(playerid, "EPLAYER");
		return 1;
	}

    if(GetPVarInt(playerid, !"p_dead") == 2) DeletePVar(playerid, !"p_dead");

	if(GetPVarInt(playerid, !"p_dead") == 1)
	{
		SetPPos(playerid, -628.0311, -920.1096, 1436.1736, 359.0371, 8, 6, true);
		SetPlayerHealthEx(playerid, 100.0);
		SendClientMessage(playerid, col_white, !""c_info"You were dead.");
		return 1;
 	}


    if(GetPVarFloat(playerid, "spec_X"))
    {
		SetPlayerPos(playerid, GetPVarFloat(playerid, "spec_X"), GetPVarFloat(playerid, "spec_Y"), GetPVarFloat(playerid, "spec_Z"));
		SetPlayerInterior(playerid, GetPVarInt(playerid, "spec_int"));
        SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "spec_world"));

        DeletePVar(playerid, "spec_X");
        DeletePVar(playerid, "spec_Y");
        DeletePVar(playerid, "spec_Z");
        DeletePVar(playerid, "spec_int");
        DeletePVar(playerid, "spec_world");
		return 1;
    }

	if(p_info[playerid][pPrison] > 0)
	{
	    switch(p_info[playerid][pMestoPrison])
	    {
			case 2: SetPPos(playerid, 198.4545, 161.8394, 1003.0300, 0.0, 3, 2, false); // FBI
			case 3: SetPPos(playerid, 219.2213, 109.6325, 999.0156, 0.0, 10, 2, false); // SFPD
			case 4: SetPPos(playerid, 198.4545, 161.8394, 1003.0300, 0.0, 3, 8, false); // LVPD
			default: SetPPos(playerid, 264.4681, 77.5466, 1001.0391, 0.0, 6, 1, false); // LSPD
		}
		SetCameraBehindPlayer(playerid);
		//ResetWeapons(playerid);
		return 1;
	}

    if(p_info[playerid][pWanted] >= 1) SetPlayerWantedLevel(playerid, p_info[playerid][pWanted]);

	new house = -1;
    new hotel_id = p_info[playerid][pHotel];
	if(GetPlayerHouse(playerid) != -1) house = GetPlayerHouse(playerid);
	if(GetPlayerHouseLodger(playerid) != -1) house = GetPlayerHouseLodger(playerid);

	if(house == -1 && p_info[playerid][setspawn] == 1) p_info[playerid][setspawn] = 0;
	if(p_info[playerid][pMember] == 0 && p_info[playerid][setspawn] == 2) p_info[playerid][setspawn] = 0;
	if(hotel_id == -1 && p_info[playerid][setspawn] == 3) p_info[playerid][setspawn] = 0;
	if(p_info[playerid][family] == 0 && p_info[playerid][setspawn] == 4) p_info[playerid][setspawn] = 0;

	if(p_info[playerid][setspawn] == 1) return PlayerEnterToHouse(playerid, house, 1);
	if(p_info[playerid][setspawn] == 2)
 {
     new member = p_info[playerid][pMember];
	 SetPPos(playerid, FracInfo[member][fSpawn][0], FracInfo[member][fSpawn][1], FracInfo[member][fSpawn][2], FracInfo[member][fSpawn][3], FracInfo[member][fInt], FracInfo[member][fVw], true);
	 return 1;
	}
	if(p_info[playerid][setspawn] == 3) return PlayerEnterToHotelNumber(playerid, hotel_id);

	if(p_info[playerid][setspawn] == 4 && p_info[playerid][family] >= 1)
	{
	    if(family_info[p_info[playerid][family] - 1][fam_house] != 0)
		{
			new h_id = family_info[p_info[playerid][family] - 1][fam_house];
			PlayerEnterToHouse(playerid, h_id, 1);
			return 1;
		}
	}

	new rand = random(sizeof player_spawn_pos);
	SetPPos(playerid, player_spawn_pos[rand][0],player_spawn_pos[rand][1],player_spawn_pos[rand][2], player_spawn_pos[rand][3], 0, 0, false);
  	return 1;
}
stock dropgun(playerid)
{
		if(GetPlayerState(playerid) != PLAYER_STATE_WASTED || GetPlayerState(playerid) == PLAYER_STATE_DRIVER ||GetPlayerState(playerid) == PLAYER_STATE_PASSENGER ) return 1;
        new GunID = GetPlayerWeapon(playerid);
        new GunAmmo = GetPlayerAmmo(playerid);
        if(GunID > 0 && GunAmmo != 0)
        {
            new f = MAX_OBJ+1;
            for(new a = 0; a < MAX_OBJ; a++)
            {
                if(dGunData[a][ObjPos][0] == 0.0)
                {
                    f = a;
                    break;
                }
            }
            if(f > MAX_OBJ)  return 1;
			if(GunAmmo >= 300)
			{
				if(GunAmmo-300 < 1) RemovePlayerWeapon(playerid, GunID);
				else SetPlayerAmmo(playerid,GunID,GunAmmo-300);
				GunAmmo = 300;
			}
			else RemovePlayerWeapon(playerid, GunID);
			SetPlayerArmedWeapon(playerid, 0);
			dGunData[f][ObjData][0] = GunID;
			dGunData[f][ObjData][1] = GunAmmo;
            GetPlayerPos(playerid, dGunData[f][ObjPos][0], dGunData[f][ObjPos][1], dGunData[f][ObjPos][2]);
            new playerVW = GetPlayerVirtualWorld(playerid);
            dGunData[f][VW] = playerVW;
			dGunData[f][ObjID] = CreateDynamicPickup(GunObjects[GunID], 23, dGunData[f][ObjPos][0], dGunData[f][ObjPos][1], dGunData[f][ObjPos][2], dGunData[f][VW]);
			new bufferr[200];
			format(bufferr, sizeof(bufferr), "{FFC900}Drop\n{FFFFFF}%s's weapon\n%s\nAmmo : %i\nPress ALT or use /pgun to pick", GN(playerid), GunNames[dGunData[f][ObjData][0]], dGunData[f][ObjData][1]);
  			dGunData[f][Label] = Create3DTextLabel(bufferr, 0xFFFFFFFF, dGunData[f][ObjPos][0], dGunData[f][ObjPos][1], dGunData[f][ObjPos][2], 25.0000, dGunData[f][VW], 0);
		}
		return 1;
}
public OnPlayerDeath(playerid, killerid, reason)
{
	//dropgun(playerid);
	//SaveGun(playerid);
	//TextDrawShowForPlayer(playerid, DScreen0[playerid]);
	//TextDrawShowForPlayer(playerid, DScreen1[playerid]);
	//TextDrawShowForPlayer(playerid, DScreen2[playerid]);
	//TextDrawShowForPlayer(playerid, DScreen3[playerid]);
	//TextDrawShowForPlayer(playerid, DScreen4[playerid]);
	//TextDrawShowForPlayer(playerid, DScreen5[playerid]);

    if(killer_id[playerid] != INVALID_PLAYER_ID)
	{
		killerid = killer_id[playerid];
		reason = killer_weapon[playerid];
	}

	if(player_fuel_steal[playerid] != 0) RemovePlayerAttachedObject(playerid, 3);

    follow_id[playerid] = INVALID_PLAYER_ID;

	if(player_take_collector[playerid] != -1) RemovePlayerAttachedObject(playerid, 4);

    RemovePlayerAmmoBox(playerid, true);

	if(player_rob_id[playerid] != -1)
	{
	    new rob_id = player_rob_id[playerid];

	    format(format_string, 96, "[ROB]: "c_white"%s {6495ED}failed the task.", Name(playerid));
	    SendMessageToRobPlayers(rob_id, 0x6495EDff, format_string);

    	PlayerStopRobbery(playerid);
	}

    RemovePlayerMask(playerid);
	PlayerLoseDuel(playerid);
	RemovePlayerFromContainer(playerid);
	DestroyDeliveryObject(playerid);

    foreach(Player, i) if(!IsPlayerMobile(i) && admin_level[i]) SendDeathMessageToPlayer(i, killerid, playerid, reason);

    if(player_race_reg{playerid}) PlayerLeaveRace(playerid);

	if(killerid != INVALID_PLAYER_ID && player_reg_pb[playerid] != -1 && player_reg_pb[killerid] != -1 && player_reg_pb[playerid] != player_reg_pb[killerid])
	{
		player_kills_pb[killerid]++;

		if(player_reg_pb[killerid] == 0) pb_blue_kills++;
		if(player_reg_pb[killerid] == 1) pb_red_kills++;

		foreach(Player, i)
			if(player_reg_pb[i] != -1)
   				SendDeathMessageToPlayer(i, killerid, playerid, reason);
	}

    player_fuel_steal[playerid] = 0;

	if(killerid != INVALID_PLAYER_ID)
	{
		if(IsACop(killerid) && p_info[playerid][pWanted])
		{
			new place = 0;

		    if(p_info[killerid][pMember] == FRACTION_LSPD) place = 1;
		    else if(p_info[killerid][pMember] == FRACTION_FP) place = 1;
			else if(p_info[killerid][pMember] == FRACTION_FBI) place = 2;
			else if(p_info[killerid][pMember] == FRACTION_SFPD) place = 3;
			else if(p_info[killerid][pMember] == FRACTION_LVPD) place = 4;
            else if(p_info[killerid][pMember] == FRACTION_RCPD) place = 5;

			SetPlayerPrison(playerid, place, (p_info[playerid][pWanted]*10)*60);

			SetPlayerWantedLevel(playerid, 0);

			SCMF(killerid, 0xFFFF00FF, "You sentenced %s[%d] to %d seconds.", Name(playerid), playerid, p_info[playerid][pPrison]);
		    SCMF(playerid, 0xFFFF00FF, "%s[%d] sentenced you to %d seconds.", Name(killerid), killerid, p_info[playerid][pPrison]);

			GivePlayerPayCheck(killerid, 300);
			p_info[playerid][pWanted] = 0;
			PlayerCuffed[playerid] = 0;

			if(follow_id[playerid] != INVALID_PLAYER_ID)
			{
				ClearAnimations(playerid, true);
		        follow_id[playerid] = INVALID_PLAYER_ID;
			}
		}

	    if(IsAArmy(playerid) && player_quest_info[killerid][quest_id] == GQUEST_TYPE_KEYSTEAL && player_quest_info[killerid][quest_status] == 1)
        {
            new Float: x, Float: y, Float: z;

            GetPlayerPos(playerid, x, y, z);
            if(player_quest_info[killerid][quest_pickup_id] != 0) DestroyDynamicPickup(player_quest_info[killerid][quest_pickup_id]);
            player_quest_info[killerid][quest_pickup_id] = CreateDynamicPickup(1581, 23, x, y, z, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), killerid);
        }
		foreach(new i : capture_zone_list)
		{
			if(!PlayerToKvadrat(playerid, GZInfo[i][gPos][0], GZInfo[i][gPos][1], GZInfo[i][gPos][2], GZInfo[i][gPos][3])) continue;
			if(!PlayerToKvadrat(killerid, GZInfo[i][gPos][0], GZInfo[i][gPos][1], GZInfo[i][gPos][2], GZInfo[i][gPos][3])) continue;

			new gang_killer = p_info[killerid][pMember],
				gang_killed = p_info[playerid][pMember];

            if(gang_killer == GZInfo[i][gFraction] && gang_killed == GZInfo[i][gAttack]) GZInfo[i][gKills][0]++;
			if(gang_killer == GZInfo[i][gAttack] && gang_killed == GZInfo[i][gFraction]) GZInfo[i][gKills][1]++;

			text_string[0] = EOS;
			format(text_string, sizeof(text_string), "[G] %s[%d] killed the opponent %s[%d].", Name(killerid), killerid, Name(playerid), playerid);
			SendFrac(gang_killer, col_green, text_string);

			format(text_string, sizeof(text_string), "[G] %s[%d] killed a teammate %s[%d].", Name(killerid), killerid, Name(playerid), playerid);
			SendFrac(gang_killed, col_orange_red, text_string);
		}
	}

    if(!GetPVarInt(playerid, "p_dead"))
    {
        SetPVarInt(playerid, "p_dead", 1);
        if(IsAGang(playerid)) SetPVarInt(playerid, "p_dead", 2);
        if(p_info[playerid][pPrison] > 0) SetPVarInt(playerid, "p_dead", 2);
    }

    PlayerLeaveHospitalBed(playerid);

    if(rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
	{
		SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
		player_jobvehicle_time[playerid] = 0;
		rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
	}

	DisablePlayerCheckpoint(playerid);
    DisablePlayerRaceCheckpoint(playerid);
	return 1;
}

public OnVehicleSpawn(vehicleid)
{
    if(veh_info[vehicleid][vStatus] == 1) Fuell[vehicleid] = MAX_VEHICLE_FUEL;

	if(taxi_veh_3d[vehicleid] != Text3D:0)
	{
		DestroyDynamic3DTextLabel(taxi_veh_3d[vehicleid]);
        taxi_veh_3d[vehicleid] = Text3D:0;
	}

	if(army_veh_pickup[vehicleid] != 0)
	{
	    army_veh_amount[vehicleid] = 0;

	    DestroyDynamic3DTextLabel(army_veh_3d[vehicleid]);
	    DestroyDynamicPickup(army_veh_pickup[vehicleid]);
	    army_veh_pickup[vehicleid] = 0;
	}

    pizza_veh_have{vehicleid} = 0;

	if(bd_veh_obj[vehicleid] != 0)
	{
	    DestroyDynamicObject(bd_veh_obj[vehicleid]);
	    bd_veh_obj[vehicleid] = 0;
	}

    for(new i; i < 5; i++) veh_info[vehicleid][vEngineTune][i] = veh_info[vehicleid][vBrakeTune][i] = 0;

    ClearVehicleData(vehicleid);

    if(veh_info[vehicleid][vFr] == 4)
    {
        trash_vehicle_owner[vehicleid] = INVALID_PLAYER_ID;
        trash_vehicle_amount[vehicleid] = 0;

		if(_:trash_vehicle_3d[vehicleid] != 0)
		{
		    DestroyDynamic3DTextLabel(trash_vehicle_3d[vehicleid]);
			trash_vehicle_3d[vehicleid] = Text3D:0;
		}
	}
	if(veh_info[vehicleid][vFr] == 5)
    {
        collector_vehicle_owner[vehicleid] = INVALID_PLAYER_ID;
        collector_vehicle_amount[vehicleid] = 0;
	}

	if(gruz_3d[vehicleid] != Text3D:0)
	{
	    DestroyDynamic3DTextLabel(gruz_3d[vehicleid]);
		gruz_3d[vehicleid] = Text3D:0;
	}

    //??????
	foreach(new i: Player)
	{
	    if(vehicleid == rent_vehicle_id[i])
        {
            rent_vehicle_id[i] = INVALID_VEHICLE_ID;
            vehicle_rent_owner[vehicleid] = INVALID_PLAYER_ID;

            DestroyVehicle(vehicleid);

            break;
        }

        if(p_t_info[i][pBusID] == vehicleid)
        {
            p_t_info[i][pBusID] = 0;
         	player_route_id[i] = 0;
            busPos{i} = 0;
            SendClientMessage(i, 0xafafafff, "Your working vehicle has been towed!");
            break;
        }
        else if(p_t_info[i][puborkacar] == vehicleid)
        {
            p_t_info[i][puborkacar] = 0;
         	player_route_id[i] = 0;
            uborkaPos{i} = 0;
            SendClientMessage(i, 0xafafafff, "Your working vehicle has been towed!");
            break;
        }
	}
	SetVehicleParamsEx(vehicleid,0,0,0,0,0,0,0);
	return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
    new driver = VehiclePlayer(vehicleid);

    for(new i; i < MAX_ROBBS; i++)
    {
        if(rob_info[i][r_vehicleid] != vehicleid) continue;

        SendMessageToRobPlayers(i, 0x6495EDff, "[ROB]: "c_white"The vehicle {6495ED}exploded, the heist has failed.");

        for(new x; x < 2; x++) if(rob_info[i][r_player][x] != INVALID_PLAYER_ID) PlayerStopRobbery(rob_info[i][r_player][x]);
    }

    if(driver != -1) // Floor????? ?? Player ??? ??? ?????, ???? -1 ?? ?????
    {
        new value = 500 + random(3500);

        new u_car = p_info[driver][pUseCar];

        GivePlayerMoneyEx(driver, -value, "car repair");
        SCMF(driver, -1, "Your personal vehicle was damaged. The repair cost was {43CD80}%d$.", value);

		CarInfo[driver][cHeal][u_car] = 1000.0;
		CarInfo[driver][cDamagePanel][u_car] = 0, CarInfo[driver][cDamageDoors][u_car] = 0;
		CarInfo[driver][cDamageLights][u_car] = 0, CarInfo[driver][cDamageTires][u_car] = 0;
		return 1;
   	}
    foreach(new i : Player)
	{
        if(vehicleid == rent_vehicle_id[i])
        {
            rent_vehicle_id[i] = INVALID_VEHICLE_ID;
            vehicle_rent_owner[vehicleid] = INVALID_PLAYER_ID;

            DestroyVehicle(vehicleid);
        }

		if(vehicleid == rent_job_vehicle[i] && p_t_info[i][pTrucker] != -1)
		{
			SendClientMessage(i, -1, !"Your truck has been destroyed!");
	   		Trucker_StopJob(i);
	   		DisablePlayerCheckpoint(i);
	   		break;
		}
		if(vehicleid == rent_job_vehicle[i] && p_t_info[i][pPilot] != 0)
		{
			SendClientMessage(i, -1, !"Your plane has been destroyed!");
			p_t_info[i][pPilot] =
	   		p_t_info[i][pPilot_Checkpoint] = 0;
	   		//p_t_info[i][pPilotPlaneID] = -1;
	   		rent_job_vehicle[i] = INVALID_VEHICLE_ID;
	   		DisablePlayerRaceCheckpoint(i);
   			break;
		}
	}
	return 1;
}

public OnPlayerText(playerid, text[])
{
    if(p_info[playerid][pLogin] == 0) return 0;
    if(GetPVarInt(playerid, "Anti-Sbiv") > gettime()) return 0;
    if(player_gag[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You have a gag in your mouth, you cannot speak.") & 0;

	if(strlen(text) > 90) return 0;
    if(p_info[playerid][mute] > 0)
	{
	    SetPlayerChatBubble(playerid, "In fact, due to the flood, you have been muted.", col_orange_red, 15.0, 10000);
 		PlayerMuted(playerid);
 		SetPVarInt(playerid, "AntiFlood",  gettime() + 1);
 		return 0;
 	}

	for(new i; i < SMILE_COUNT; i ++)
	{
		if(!strcmp(text, SmileInfo[i][smInput], false))
		{
			if(p_info[playerid][pSex] == 1) me_action(playerid, SmileInfo[i][smOutput_M]);
			else me_action(playerid, SmileInfo[i][smOutput_F]);
			return 0;
		}
	}

 	if(CheckIP(text))
	{
		p_info[playerid][mute] = 600;
		SendClientMessage(playerid, col_white, !""c_error"You have received a chat block for advertising violations.");

		text_string[0] = EOS;
		format(text_string, sizeof(text_string), "[A] %s[%d] | Ad impressions: %s", Name(playerid), playerid, text);
		return send_admin_message(col_orange_red, text_string) & 0;
	}

	if(player_news_live[playerid])
	{
		text_string[0] = EOS;
		if(p_info[playerid][pMember] == FRACTION_NEWS)
			format(text_string, sizeof(text_string), ""c_orange"[LIVE]"c_white" %s[%d]: %s", Name(playerid),playerid, text);
		else
			format(text_string, sizeof(text_string), ""c_orange"[LIVE]"c_white" Guest %s[%d]: %s", Name(playerid), playerid, text);
		return SendClientMessageToAll(col_white, text_string) & 0;
	}

    if(Mobile[playerid] != -1)
	{
		if(IsPlayerConnected(Mobile[playerid]) && Mobile[Mobile[playerid]] == playerid)
		{
		    text_string[0] = EOS;
		    format(text_string, sizeof(text_string), "[Phone] %s[%d]: %s", Name(playerid), playerid, text);
		    SendClientMessage(Mobile[playerid], col_yellow, text_string);
		}
        ProxDetector(10.0, playerid, text, COLOR_FADE1, COLOR_FADE2, COLOR_FADE3, COLOR_FADE4, COLOR_FADE5);
		return 0;
	}

    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && GetPVarInt(playerid, "fTazzer") == 0)
	{
 		new animation = random(4);
		switch(animation)
		{
			case 0: ApplyAnimation(playerid, !"GHANDS", !"GSIGN5", 4.1, 0, 1, 1, 1, 1, 1);
			case 1: ApplyAnimation(playerid, !"GHANDS", !"GSIGN4", 4.1, 0, 1, 1, 1, 1, 1);
			case 2: ApplyAnimation(playerid, !"GHANDS", !"GSIGN1", 4.1, 0, 1, 1, 1, 1, 1);
			case 3: ApplyAnimation(playerid, !"PED", !"IDLE_CHAT", 4.1, 0, 1, 1, 1, 1, 1);
		}
		SetTimerEx("ClearAnim", 100 * strlen(text), false, "d", playerid);
	}

	SetPlayerChatBubble(playerid, text, 0x6495EDFF, 18.0, 5000);

	format(format_string, 188, "- %s (%s)[%d]", text, Name(playerid), playerid);
    ProxDetector(20.0, playerid, format_string, COLOR_RAZGOVOR1, COLOR_RAZGOVOR2, COLOR_RAZGOVOR3, COLOR_RAZGOVOR4, COLOR_RAZGOVOR5);
    //
	return 0;
}

public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
    new Float: carhp;
    GetVehicleHealth(vehicleid, carhp);

	for(new i; i < MAX_PLAYER_VEHICLES; i++)
	{
	    if(GetPlayerVehicleID(playerid) == player_home_car[playerid][i])
		{
			new panels, doors1, lights1, tires;
			if(player_veh_damage[playerid] == 0)
			{
				if(carhp > 300 && carhp < 700)
				{
					if(CarInfo[playerid][cSost][i] > 0) return CarInfo[playerid][cSost][i] --;
					player_veh_damage[playerid] = 5;
				}
			}
			GetVehicleDamageStatus(vehicleid, panels, doors1, lights1, tires);

			CarInfo[playerid][cDamagePanel][i] = panels;
			CarInfo[playerid][cDamageDoors][i] = doors1;
			CarInfo[playerid][cDamageLights][i] = lights1;
			CarInfo[playerid][cDamageTires][i] = tires;
			CarInfo[playerid][cHeal][i] = carhp;
			return 1;
		}
	}

	if(IsPlayerInAnyVehicle(playerid))
    {
        new v = GetPlayerVehicleID(playerid);

		if(veh_info[v][vFr] != 0)
		{
	    	if(player_veh_damage[playerid] == 0)
			{
		    	if(carhp > 300 && carhp < 600)
				{
					if(veh_info[v][vSost] > 0) veh_info[v][vSost] -= 1;
                    player_veh_damage[playerid] = 5;
				}
			}
		}
	}
	return 1;
}

public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	#if DEBUG_STATUS == true
		printf("Player %s just used the command \"%s\"", Name(playerid), cmd);
	#endif

    if(!p_info[playerid][pLogin]) return 0;

	if(p_info[playerid][pMember] == FRACTION_NEWS)
		for(new i; i < MAX_ADVERTS; i++)
			if(AdvertInfo[i][aEditor] == playerid)
				AdvertInfo[i][aEditor] = INVALID_PLAYER_ID;

    if(GetPVarInt(playerid,"Anti-Sbiv") > gettime())
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"You cannot use commands yet."c_orange"%d seconds"c_white".", GetPVarInt(playerid, "Anti-Sbiv") - gettime());
	    SendClientMessage(playerid, col_white, text_string);
		return 0;
    }
    return 1;
}

public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(result != 1)
    {
		text_string[0] = EOS;
		format(text_string, sizeof(text_string), ""c_error"Unrecognized Command: "c_grey"/%s %s", cmd, params);
		SendClientMessage(playerid, col_grey, text_string);
	}
	return 1;
}

stock IsVehicleOccupiedEx(vehicleid)
{
	foreach(Player, i) if(GetPlayerState(i) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(i) == vehicleid) return 1;
	return 0;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{

	if(player_job[playerid] == 2 && IsPlayerAttachedObjectSlotUsed(playerid, 1))
	{
		SendClientMessage(playerid, col_white, !""c_error"You dropped the box. Please try again.");

        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(playerid, 1);
		DisablePlayerCheckpoint(playerid);
		DeletePVar(playerid, "gruzchiki_cps");

		new rand = random(10);
		SetPlayerCheckpoint(playerid, work_pos_gruzchiki[rand][0], work_pos_gruzchiki[rand][1], work_pos_gruzchiki[rand][2], 1);
		SetPVarInt(playerid, "gruzchiki_cp", rand);
		return 1;
	}
	new engine, lights, alarm, doors, bonnet, boot, objective;
	GetVehicleParamsEx(vehicleid, engine,lights,alarm,doors,bonnet,boot,objective);

	if(doors || player_take_collector[playerid] != -1 || player_take_trash[playerid] != -1)
	{
		if(!IsAnyFamilyVehicle(vehicleid))
		{
			new Float: x, Float: y, Float: z;

			GetPlayerPos(playerid, x, y, z);
			SetPlayerPos(playerid, x, y, z);

			if(doors) SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"UveHouse statement", ""c_white"The vehicle doors are closed!", "Close", "");

			else SendClientMessage(playerid, COLOR_GREY, "Something in your hands prevents you from sitting.");

			return 0;
		}
	}
	if(!ispassenger)
	{
	    for(new i; i < MAX_FAMILY; i++)
		{
			if(IsAFamilyVehicle(i, vehicleid))
			{
	            new family_id = p_info[playerid][family]-1;
	            if(family_id != i)
	            {
	                new Float: x, Float: y, Float: z;

					GetPlayerPos(playerid, x, y, z);
					SetPlayerPos(playerid, x, y, z);

	                text_string[0] = EOS;
					format(text_string, sizeof(text_string), "This vehicle belongs to %s.",family_info[i][fam_name]);
	                SendClientMessage(playerid, COLOR_GREY, text_string);
	                return 0;
				}
			}
	    }
    }
	if(veh_info[vehicleid][v_type] == VEHICLE_TYPE_AUTOSALON) ClearAnimations(playerid);

 	if(p_t_info[playerid][pWork] == 1 || p_t_info[playerid][pWork] == 2 || p_t_info[playerid][pWork] == 3)
	{
		SendClientMessage(playerid, COLOR_GREY, "You cannot get into the vehicle, Job.");
		RemovePlayerFromVehicleEx(playerid);
		return ClearAnimations(playerid);
	}
   	if(doors == 1) GameTextForPlayer(playerid, "VEHICLE LOCKED", 5000, 3);
   	VehicleEnters[playerid]=vehicleid;
	return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
//RemovePlayerAttachedObject(playerid, 0);
//SendClientMessage(playerid,COLOR_GREY,"The cap has been removed.");

    if(rent_job_vehicle[playerid] == vehicleid) player_jobvehicle_time[playerid] = 120;

	if(p_info[playerid][pJob] == WORK_TYPE_DELIVERY && rent_job_vehicle[playerid] == vehicleid) DisablePlayerCheckpoint(playerid);

	if(pizza_veh_have{vehicleid}) pizza_veh_time{vehicleid} = 30;

	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    if(player_road_school[playerid] == 2 && veh_info[vehicleid][vStatus] == 67)
	    {
	        player_school_back[playerid] = 60;
	        SendClientMessage(playerid, COLOR_GREY, "Return to the vehicle or the exam will fail.");



	        SetPVarInt(playerid, "school_vehicle", vehicleid);
	    }

        player_taxi_passanger[playerid] = INVALID_PLAYER_ID;
		vehicle_driver[vehicleid] = INVALID_PLAYER_ID;
	}
	else if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
	{
     	new driver_id = vehicle_driver[vehicleid];

	    if(driver_id != INVALID_PLAYER_ID && (70 <= p_info[driver_id][pJob] <= 72))
	    {
            if(player_taxi_passanger[driver_id] == playerid)
            {
                player_taxi_passanger[driver_id] = INVALID_PLAYER_ID;

				SearchNextClientForTaxi(vehicleid, playerid);
            }
		}
	}

    if(p_info[playerid][pJob] == 4 && trash_vehicle_owner[vehicleid] == playerid)
    {
        trash_player_back[playerid] = 120;
        //SendClientMessage(playerid, COLOR_RED, "You have 90 seconds to return to the vehicle or it will disappear!");
    }
    if(p_info[playerid][pJob] == 5 && collector_vehicle_owner[vehicleid] == playerid)
    {
        collector_player_back[playerid] = 120;
        //SendClientMessage(playerid, COLOR_RED, "You have 90 seconds to return to the vehicle or it will disappear!");
    }
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
	if(newstate == PLAYER_STATE_DRIVER)
	{
	    pvehicleid[playerid] = GetPlayerVehicleID(playerid);
	    pmodelid[playerid] = GetVehicleModel(pvehicleid[playerid]);
	}
	else
	{
	    pvehicleid[playerid] = 0;
	    pmodelid[playerid] = 0;
	}
	if(oldstate == PLAYER_STATE_DRIVER && p_t_info[playerid][plveh] != -1)
	{
		DestroyVehicleEx(p_t_info[playerid][plveh]);
		p_t_info[playerid][plveh] = -1;
	}

    if(newstate == PLAYER_STATE_ONFOOT) // ???? Player ??????, ? ?? You??? from ??????
 	{
 	    if(GetPVarInt(playerid, "get vehicle drive"))
 	    {
 	        new old_vehicleid = GetPVarInt(playerid, "get vehicle drive");
 	        vehicle_driver[old_vehicleid] = INVALID_PLAYER_ID;
 	        DeletePVar(playerid, "get vehicle drive");
 	    }

        if(p_info[playerid][pJob] == 2 && p_t_info[playerid][pBusID] != 0)
        {
            DisablePlayerCheckpoint(playerid), p_t_info[playerid][bus_timer] = 15;
            SendClientMessage(playerid, COLOR_REDD, "If you do not return to the bus within 15 seconds, it will be towed!");
        }
        else if(p_info[playerid][pJob] == 3 && p_t_info[playerid][puborkacar] != 0)
        {
            DisablePlayerCheckpoint(playerid), p_t_info[playerid][uborka_timer] = 15;
            SendClientMessage(playerid, COLOR_REDD, "If you do not return to the cleaning vehicle within 15 seconds, it will be towed!");
        }

        if(player_news_live[playerid])
		{
		    format(format_string, 144, "[R] %s[%d] has left the server voluntarily.", Name(playerid), playerid);
	        SendFrac(FRACTION_NEWS, COLOR_GREEN, format_string);

		    SendClientMessage(playerid, COLOR_WHITE, "You have left the server voluntarily.");
		    player_news_live[playerid] = false;
		}

  		return 1;
  		//
  	}

    if(newstate == PLAYER_STATE_DRIVER) // Player ????????
	{
	    new vehicleid = GetPlayerVehicleID(playerid);

	    vehicle_driver[vehicleid] = playerid;

	    if(vehicle_rent_owner[vehicleid] != INVALID_PLAYER_ID && vehicle_rent_owner[vehicleid] != playerid)
	    {
	        SendClientMessage(playerid, COLOR_GREY, "You cannot enter someone else's rented vehicle.");
	        return RemovePlayerFromVehicleEx(playerid);
	    }

	    SetPVarInt(playerid, "get vehicle drive", vehicleid);

	    //if(IsVehicleHaveFuel(vehicleid)) SendClientMessage(playerid, col_white, ""c_sucess"To turn on the underglow lights: /neon ");
	    //SetPlayerAttachedObject(playerid, 0, 18978, 2, 0.0709, 0.0279, 0.0000, 91.1999, 84.3999, -3.3000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF); //
        //SendClientMessage(playerid,col_green,"The cap has been placed.");
        //SendClientMessage(playerid, col_green, ""c_sucess"Dashboard is active for you: /dashboard ");
	    SendClientMessage(playerid, col_green, ""c_sucess"To turn on the vehicle: /en or L.CTRL | To use dashboard: /dashboard");

	    if((IsABike(vehicleid) || CarLicence(vehicleid)) && IsVehicleHaveFuel(vehicleid))
		{
			if(p_info[playerid][pLicenses][0] < 1 && !(1 <= player_road_school[playerid] <= 2) || (1 <= player_road_school[playerid] <= 2) && veh_info[vehicleid][vStatus] != 67)
			{
			    SendClientMessage(playerid, COLOR_GREY, "You do not have a driver's license!");
			    return RemovePlayerFromVehicleEx(playerid);
			}
		}

		SetPlayerArmedWeapon(playerid, 0);

		if(IsAPlane(vehicleid))
		{
			if(p_info[playerid][pLicenses][1] < 1) return RemovePlayerFromVehicleEx(playerid), SendClientMessage(playerid, COLOR_GREY, "You do not have a license for air transport!");
   		}
   		if(IsABoat(vehicleid))
		{
			if(p_info[playerid][pLicenses][2] < 1) return RemovePlayerFromVehicleEx(playerid), SendClientMessage(playerid, COLOR_GREY, "You do not have a license for water transport!");
   		}

   		if(player_rob_id[playerid] != -1)
   		{
   		    new rob_id = player_rob_id[playerid];

			if(rob_info[rob_id][r_vehicleid] == vehicleid)
			{
			    if(rob_info[rob_id][r_loaded] != 0)
			    {
			        SetPlayerGPS(playerid, 789.8063,-606.8367,16.0630);

			        SendMessageToRobPlayers(rob_id, 0x6495EDff, "[ROB]: Head to "c_white"the location of the {6495ED}drop.");
			    }
			    else
			    {
				    if(rob_info[rob_id][r_house] == -1)
				    {
				        /*new try_search = 0;

				        SEARCH_HOUSE:

                        try_search++;

						if(try_search == MAX_HOUSES / 2)
						{
						    new partnerid = GetPlayerRobPartnerID(playerid);

						    if(partnerid != INVALID_PLAYER_ID) PlayerStopRobbery(partnerid);
						    PlayerStopRobbery(playerid);

						    return SendClientMessage(playerid, COLOR_GREY, "No bought House, the robbery is stopped.");
						}

				        new h_id = random(MAX_HOUSES);

				        if(HouseInfo[h_id][hKlass] != 0 || HouseInfo[h_id][hOwned] == 0) goto SEARCH_HOUSE;*/

						for(new i; i < max_houses; i++)
						{
						    if(HouseInfo[i][hKlass] != 0 || HouseInfo[i][hOwned] == 0 || rob_house_obj[i][0] != 0) continue;

				        	rob_info[rob_id][r_house] = i;

							SendMessageToRobPlayers(rob_id, 0xffff00ff, "SMS: I sent you the coordinates of the House you need to go to, head there. | Sender: Marvin Merchants");

							break;
						}

						if(rob_info[rob_id][r_house] == -1)
						{
						    new partnerid = GetPlayerRobPartnerID(playerid);

						    if(partnerid != INVALID_PLAYER_ID) PlayerStopRobbery(partnerid);
						    PlayerStopRobbery(playerid);

						    return SendClientMessage(playerid, COLOR_GREY, "All previous House have already been robbed.");
						}
				    }

				    new h_id = rob_info[rob_id][r_house];

					SetPlayerGPS(playerid, HouseInfo[h_id][hEntrancex], HouseInfo[h_id][hEntrancey], HouseInfo[h_id][hEntrancez]);
				}
			}
   		}

   		if(quest_vehicle_owner[vehicleid] != INVALID_PLAYER_ID)
   		{
   		    if(quest_vehicle_owner[vehicleid] != playerid)
   		    {
				SendClientMessage(playerid, COLOR_GREY, "This is a Quest transport, you cannot use it.");
   		        return RemovePlayerFromVehicleEx(playerid);
   		    }

   		    pc_cmd_gquest(playerid);
   		}
		if(veh_info[vehicleid][vStatus] == 0)
		{
		    if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_KEYPDSTEAL && player_quest_info[playerid][quest_status] == 1 && player_quest_info[playerid][quest_progress] == 1 && (veh_info[playerid][vFr] == FRACTION_LSPD || veh_info[playerid][vFr] == FRACTION_SFPD || veh_info[playerid][vFr] == FRACTION_LVPD))
		    {
		        //?????? ?? ??????, ????? ??? Player ????? ? Floor???????? ?????????? ? Quest??
		        SendClientMessage(playerid, COLOR_YELLOW, "[QUEST] "c_white"Use the command: /kpk to hack the computer");
		    }
		    else if(veh_info[vehicleid][vFr] != form_fraction[playerid])
			{
			    text_string[0] = EOS;
			    format(text_string, sizeof(text_string), ""c_error"You are not a member of The organization "c_server"%s", FracInfo[veh_info[vehicleid][vFr]][fName]);
			    SendClientMessage(playerid, col_white, text_string);
				return RemovePlayerFromVehicleEx(playerid);
			}
			else if(veh_info[vehicleid][vModel] == 433 && veh_info[vehicleid][vFr] == 3)
			{
			    if(p_info[playerid][pRank] < 4) return SendClientMessage(playerid, COLOR_GREY, "Transport is available from rank 4.");
				RemovePlayerFromVehicleEx(playerid);
			}
			if(army_veh_pickup[vehicleid] != 0)
			{
			    SPD(playerid, 8613, DIALOG_STYLE_MSGBOX, !""c_server"Loading ammunition", "Do you want to finish loading ammunition?", "Yes", "No");
			}
		}
		else if(veh_info[vehicleid][vStatus] == 67)
		{
		    if(player_road_school[playerid] == 0)
			{
			    RemovePlayerFromVehicleEx(playerid);
				return SendClientMessage(playerid, COLOR_GREY, "You did not pass the driving test.");
		    }

		    if(player_road_school[playerid] == 1)
		    {
		        player_road_school[playerid] = 2;
		        player_road_id[playerid] = 0;

		        SetPlayerSchoolPoint(playerid);
		    }
		    else if(player_road_school[playerid] == 2)
		    {
		        player_school_back[playerid] = 0;
		        SendClientMessage(playerid, COLOR_GREEN, "You have returned to the transport.");

		        DeletePVar(playerid, "school_vehicle");
		    }
		}
		else if(veh_info[vehicleid][vStatus] == 1)
		{
		    if(p_info[playerid][pJob] == veh_info[vehicleid][vFr])
			{
			    if(rent_job_vehicle[playerid] != vehicleid)
				{
  					if(p_info[playerid][pJob] == 2 && GetVehicleModel(p_t_info[playerid][pBusID]) == 431)
					{
					    new newcar = GetPlayerVehicleID(playerid);
					    if(p_t_info[playerid][pBusID] == newcar) {
			                if(p_t_info[playerid][bus_timer])p_t_info[playerid][bus_timer] = 0;
			                //ShowPlayerSpeed(playerid);
							SetNextCP(playerid,busPos{playerid});
							return 1;
			            }
					}
					if(p_info[playerid][pJob] == 3 && GetVehicleModel(p_t_info[playerid][puborkacar]) == 574)
					{
		                if(p_t_info[playerid][uborka_timer]) p_t_info[playerid][uborka_timer] = 0;
		                //ShowPlayerSpeed(playerid);
						SetNextCP(playerid,uborkaPos{playerid});
						return 1;
					}
					if(veh_info[vehicleid][vFr] == 6 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
					{
					    SendClientMessage(playerid,-1,!"You have returned to the truck!");
					}
					else if(veh_info[vehicleid][vFr] == 7 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
					{
					    SendClientMessage(playerid,-1,"You have returned to the airplane.");
					}
					else if(veh_info[vehicleid][vFr] == WORK_TYPE_BULLDOZER)
					{
					    bd_player_state[playerid] = 1;

					    UpdatePlayerBulldozerMark(playerid);
					}
					else SPD(playerid, 149, DIALOG_STYLE_MSGBOX, !""c_server"Car rental", ""c_white"Rent the taxi for $500?", "Yes", "No"); // ?????? ??????\nprice ??????: 500$
				}
				else
				{
					if(veh_info[vehicleid][vFr] == 4) trash_player_back[playerid] = 0;
					if(veh_info[vehicleid][vFr] == 5) collector_player_back[playerid] = 0;
					if(veh_info[vehicleid][vFr] == WORK_TYPE_DELIVERY) UpdatePlayerDeliveryMark(playerid);
					if(veh_info[vehicleid][vFr] == WORK_TYPE_PIZZA) UpdatePlayerPizzaMark(playerid);
					if(veh_info[vehicleid][vFr] == WORK_TYPE_BULLDOZER)
					{
						if(bd_veh_obj[vehicleid] != 0) bd_player_state[playerid] = 2;

						UpdatePlayerBulldozerMark(playerid);
					}
				}
				new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
				if(engine == 0) SetVehicleParamsEx(vehicleid,1,lights,alarm,doors,bonnet,boot,objective);
    			/*if(veh_info[vehicleid][vFr] == 6 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
				{
				    SendClientMessage(playerid,-1,!"You have returned to the truck!");
				}*/
			}
			else
			{
		 		SendClientMessage(playerid, COLOR_GREY, "You cannot access the transport!");
		 		RemovePlayerFromVehicleEx(playerid);
		 		return 1;
		 	}
		}

		//ShowPlayerSpeed(playerid);
	}
	if(newstate == PLAYER_STATE_PASSENGER) // Player ????????
	{
	    new vehicleid = GetPlayerVehicleID(playerid);
	    //new driver_id = vehicle_driver[vehicleid];

		if(veh_info[vehicleid][vStatus] == 1)
        {
            if(veh_info[vehicleid][vFr] == 2)
            {
	            if(p_info[playerid][pCash] < 50)
	            {
					format(format_string, sizeof(format_string), "{DD90FF}%s[%d] showed the bus driver's ticket.",Name(playerid),playerid);
					ProxDetector(20.0, playerid, format_string, 0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
					SetPlayerChatBubble(playerid,"showed the bus driver's ticket.",0xDD90FFAA,20.0,10000);
				}
				else GivePlayerMoneyEx(playerid, -50, "bus ticket");
			}

			if(70 <= veh_info[vehicleid][vFr] <= 72) SetPlayerAsClientForTaxi(playerid, vehicleid);
        }
	}
	return 1;
}

public OnPlayerEnterDynamicCP(playerid,checkpointid)
{
    for(new b; b < TotalBizz; b++)
	{
		if(checkpointid == BizzInfo[b][bPickup] && PlayerToPoint(2.0,playerid,BizzInfo[b][bBarX],BizzInfo[b][bBarY],BizzInfo[b][bBarZ]))
		{
		    player_use_bizbar[playerid] = b;
		    if(BizzInfo[b][bType] == 2) PC_EmulateCommand(playerid, "/eat");
		}
	}
	return 1;
}
public OnPlayerEnterCheckpoint(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(p_info[playerid][pJob] == 2 && p_t_info[playerid][pBusID] != 0 && GetPlayerVehicleID(playerid) == p_t_info[playerid][pBusID])
    {
        new	pos = busPos{playerid}, route = player_route_id[playerid];

        if(gBusCPs[route][pos][0] == gBusCPs[route][pos+1][0] && gBusCPs[route][pos][1] == gBusCPs[route][pos+1][1])
        {
            format(format_string,24+100,"The bus has arrived at the station, departing in 10 seconds!");//,r_name);
            ProxDetector(30.0,playerid,format_string,0x44b2ffff,0x44b2ffff,0x44b2ffff,0x44b2ffff,0x44b2ffff);
            SetTimerEx("bus_stop",10000,false,"ii",playerid,route);
            DisablePlayerCheckpoint(playerid);
            return 1;
        }
        if(pos == 99 || gBusCPs[route][pos+1][0] == 0.0) busPos{playerid} = 0;
		else busPos{playerid}++;
		SetNextCP(playerid,busPos{playerid});
    }

    if(vehicleid != INVALID_VEHICLE_ID && player_product_id[playerid] != -1)
    {
        new order_id = player_product_id[playerid];

		new amount = vehicle_load_prod[vehicleid];

        new reward = amount;

        new bool: is_product = GetVehicleModel(vehicleid) == 414 ? true : false;

        if(is_product && PlayerToPoint(15.0, playerid, BizzInfo[order_id][bEntranceX], BizzInfo[order_id][bEntranceY], BizzInfo[order_id][bEntranceZ]))
        {
            if(amount == 0) return SendClientMessage(playerid, COLOR_GREY, "You have not loaded the products (/load).");

            BizzInfo[order_id][bProducts] += amount;

            SaveBizzPer(order_id, "bProducts", BizzInfo[order_id][bProducts]);

            SCMF(playerid, COLOR_GREEN, "You unloaded %d products, earnings: $%d.", amount, reward);

			GivePlayerMoneyEx(playerid, reward, "You income for groceries");

            vehicle_load_prod[vehicleid] = 0;
            player_product_id[playerid] = -1;
		}

		if(!is_product && PlayerToPoint(15.0, playerid, BizzAInfo[order_id][aAreaFillX], BizzAInfo[order_id][aAreaFillY], BizzAInfo[order_id][aAreaFillZ]))
        {
            if(amount == 0) return SendClientMessage(playerid, COLOR_GREY, "You did not load fuel (/load).");

            BizzAInfo[order_id][aProducts] += amount;

            SaveABizzPer(order_id, "aProducts", BizzAInfo[order_id][aProducts]);

            SCMF(playerid, COLOR_GREEN, "You unloaded %d fuel, Income: $%d", amount, reward);

            GivePlayerMoneyEx(playerid, reward, "You income for fuel");

            vehicle_load_prod[vehicleid] = 0;
            player_product_id[playerid] = -1;
		}
    }

    if(IsPlayerInAnyVehicle(playerid) && rent_job_vehicle[playerid] == GetPlayerVehicleID(playerid) && p_t_info[playerid][pTrucker] > -1 && p_info[playerid][pJob] == 6)
	{
		switch(p_t_info[playerid][pTrucker])
		{
			case 0:
			{
				TogglePlayerControllable(playerid, false);
				SPD(playerid, 232, DIALOG_STYLE_INPUT, !""c_server"?????????? ?????", ""c_white"1 unit of cargo = "c_green"3$"c_white"\nPlease specify the quantity of cargo:", !"Choose", !"Cancel");
			}
		 	case 1:
		 	{
				TogglePlayerControllable(playerid, false);
				SendClientMessage(playerid, col_white, !""c_error"Please wait for unloading.");
				SetTimerEx("@TruckerTimer", p_t_info[playerid][pTrucker_Unit] * 2, false, "i", playerid);
			}
		}
	}

	if(p_info[playerid][pJob] == WORK_TYPE_BULLDOZER && veh_info[vehicleid][vFr] == WORK_TYPE_BULLDOZER)
	{
		if(bd_player_state[playerid] == 1)
		{
		    TogglePlayerControllable(playerid, false);

		    SetTimerEx("LoadPlayerBulldozer", 3000, false, "i", playerid);

		    SendClientMessage(playerid, -1, "Please wait for the loading of the bulldozer to finish.");
		}
		else if(bd_player_state[playerid] == 2)
		{
		    DestroyDynamicObject(bd_veh_obj[vehicleid]);
		    bd_veh_obj[vehicleid] = 0;

		    bd_player_state[playerid] = 1;

		    new reward = 200 + random(200);

		    SCMF(playerid, -1, "Added to salary: $%d, will be credited to your account on PayDay.", reward);

		    GivePlayerPayCheck(playerid, reward);

		    UpdatePlayerBulldozerMark(playerid);
		}

		return 1;
	}
	if(vehicleid == rent_job_vehicle[playerid] && p_info[playerid][pJob] == WORK_TYPE_DELIVERY)
	{
	    if(delivery_state_id[playerid] == 1)
	    {
	        if(crane_unload_use != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"Please wait, the loading is busy at the moment.");
	        if(crane_unload_refresh != 0) return SendClientMessage(playerid, col_white, !""c_error"Please wait for the preparation of the container.");

	    	new crane_id = MAX_CRANES;
	        crane_unload_use = playerid;
	        crane_unload_refresh = 30;

	        SetVehiclePos(vehicleid, crane_unload_veh[0], crane_unload_veh[1], crane_unload_veh[2]);
	        SetVehicleZAngle(vehicleid, crane_unload_veh[3]);

	        TogglePlayerControllable(playerid, false);

	        new time = 10000;

	        for(new i; i < 4; i++)
			{
		    	time = MoveDynamicObject(crane_unload_obj[i], crane_stop_pos[crane_id][i][0], crane_stop_pos[crane_id][i][1], crane_stop_pos[crane_id][i][2] - 0.004, 0.4, crane_stop_pos[crane_id][i][3], crane_stop_pos[crane_id][i][4], crane_stop_pos[crane_id][i][5]);
			}
			SendClientMessage(playerid, col_white, !""c_info"Loading started, please wait.");

	        SetTimerEx("LoadPlayerContainer", time, false, "i", playerid);
		}
		else if(2 <= delivery_state_id[playerid] <= 3)
		{
		    new crane_id = delivery_state_id[playerid] - 2;
		    if(crane_use[crane_id] != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"At the moment, the platform is busy.");
			if(crane_refresh[crane_id] != 0) return SendClientMessage(playerid, col_white, !""c_error"Please wait until unloading is complete.");

            crane_use[crane_id] = playerid;

		    SetVehiclePos(vehicleid, crane_veh_pos[crane_id][0], crane_veh_pos[crane_id][1], crane_veh_pos[crane_id][2]);
		    SetVehicleZAngle(vehicleid, crane_veh_pos[crane_id][3]);
		    TogglePlayerControllable(playerid, false);

		    DestroyDeliveryObject(playerid);
		    crane_obj[crane_id][2] = CreateDynamicObject(2935, crane_stop_pos[crane_id][2][0], crane_stop_pos[crane_id][2][1], crane_stop_pos[crane_id][2][2], crane_stop_pos[crane_id][2][3], crane_stop_pos[crane_id][2][4], crane_stop_pos[crane_id][2][5]);

		    new time = 10000;
	        for(new i = 1; i != -1; i--)
			{
		    	time = MoveDynamicObject(crane_obj[crane_id][i], crane_stop_pos[crane_id][i][0], crane_stop_pos[crane_id][i][1], crane_stop_pos[crane_id][i][2] - 0.004, 0.4, crane_stop_pos[crane_id][i][3], crane_stop_pos[crane_id][i][4], crane_stop_pos[crane_id][i][5]);
			}

		    SendClientMessage(playerid, col_white, !""c_info"Unloading of the container has started, please wait.");

		    SetTimerEx("UnloadPlayerContainer", time, false, "i", playerid);
		}
		return 1;
	}

	if(GetPVarInt(playerid, !"GPS") != 0)
	{
		DisablePlayerCheckpoint(playerid);
		return SetPVarInt(playerid, !"GPS", 0);
	}

	if(GetPVarInt(playerid,"CHECKPOINTID") == 5 && !IsPlayerInAnyVehicle(playerid) && IsPlayerInRangeOfPoint(playerid, 5.0, 2564.6721,-1292.9766,1044.1250))
	{
		new bablo[33];
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		if(IsPlayerAttachedObjectSlotUsed(playerid,2)) RemovePlayerAttachedObject(playerid,2);
		GivePlayerMoneyEx(playerid, 800, "loader"); //TEST
		SetPVarInt(playerid,"JobMoney",GetPVarInt(playerid,"JobMoney")+800);
		format(bablo,32,"~g~+800$~n~~b~TOTAL:~w~ %d$",GetPVarInt(playerid,"JobMoney"));
		GameTextForPlayer(playerid,bablo, 5000, 1);
		ClearAnimations(playerid);
		DeletePVar(playerid,"CHECKPOINTID");
		DisablePlayerCheckpoint(playerid);
	}
	if(GetPVarInt(playerid,"Saw_"))
	{
		if(player_job[playerid] == 1 && !IsPlayerInAnyVehicle(playerid) && GetPVarInt(playerid,"Saw") != 1)
		{
			ApplyAnimation(playerid,"CHAINSAW","WEAPON_csaw",4.0,1,1,1,1,0);
			SetPVarInt(playerid,"Anti-Sbiv",gettime()+10);
			SetPVarInt(playerid,"Saw",1);
			DisablePlayerCheckpoint(playerid);
			SendClientMessage(playerid,0x27C400FF,"You started cutting the tree.");
		}
	}
	//if(IsPlayerInVehicle(playerid, specialcar))
    if(p_info[playerid][pJob] == 3 && p_t_info[playerid][puborkacar] != 0)
    {
        new pos = uborkaPos{playerid},route = player_route_id[playerid];
        if(pos == 99 || gUborkaCPs[route][pos+1][0] == 0.0) uborkaPos{playerid} = 0;
		else uborkaPos{playerid}++;
		SetNextCP(playerid,uborkaPos{playerid});
    }
    if(GetPVarInt(playerid, "Sad") == 1 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        TogglePlayerControllable(playerid, false);

        SetTimerEx("SadYablkJob",5000,0,"%d",playerid);
        GameTextForPlayer(playerid,"~y~+1",5200,5);
        AmmountWood[playerid] += 1;

        //format(string, 65,"%d",AmmountWood[playerid]);
        //PlayerTextDrawSetString(SADD[playerid],string);
        //format(string, 65,"%d",AmmountWood[playerid]*2);
        //PlayerTextDrawSetString(SADD1[playerid],string);

        ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,1,1,1,1,0);
        new rand = random(sizeof(derevo));
        SetPlayerCheckpoint
		(
			playerid,
			derevo[rand][0],
			derevo[rand][1],
			derevo[rand][2],
			3.0
	    );
        DeletePVar(playerid, "Sad");
        DisablePlayerCheckpoint(playerid);
        SetPVarInt(playerid, "Sad", 1);

        if(beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_APPLE && beg_quest_info[playerid][b_quest_status] == 1)
		{
		    beg_quest_info[playerid][b_quest_progress]++;
		    OnPlayerUpdateAccountsPer(playerid, "b_quest_progress", beg_quest_info[playerid][b_quest_progress]);

		    if(beg_quest_info[playerid][b_quest_progress] >=2000)
		    {
		        SendClientMessage(playerid, col_white, !""c_yellow"Quest:"c_white" You completed Quest 'Water'. Use: "c_server"/quest"c_white", to receive an award.");
		        beg_quest_info[playerid][b_quest_status] = 2;
		        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
		    }
		}

        return 1;
    }
	switch(GetPlayerState(playerid))
	{
		case PLAYER_STATE_ONFOOT:
		{
			if(player_job[playerid] == 2)
			{
			    new cp_id = GetPVarInt(playerid, "gruzchiki_cp"), cp_ids = GetPVarInt(playerid, "gruzchiki_cps");
				if(IsPlayerInRangeOfPoint(playerid, 2.0, work_pos_gruzchiki[cp_id][0], work_pos_gruzchiki[cp_id][1], work_pos_gruzchiki[cp_id][2]))
				{
					SetPlayerAttachedObject(playerid, 1, 1558, 1, 0.206000, 0.440999, -0.036000, 0.000000, 270.000000, 0.000000, -0.449999, -0.449999, -0.449999);
					SendClientMessage(playerid, col_white, !""c_info"You have successfully picked up the box, take it to the trailer.");
					ApplyAnimation(playerid, !"CARRY", !"putdwn", 4.0, 0, 1, 1, 0, 0, 1);
					SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
					DisablePlayerCheckpoint(playerid);
					DeletePVar(playerid, "gruzchiki_cp");

					new rand = random(4);
					SetPlayerCheckpoint(playerid, work_pos_gruzchiki_2[rand][0], work_pos_gruzchiki_2[rand][1], work_pos_gruzchiki_2[rand][2], 1);
					SetPVarInt(playerid, "gruzchiki_cps", rand);
				}
				else if(IsPlayerInRangeOfPoint(playerid, 2.0, work_pos_gruzchiki_2[cp_ids][0], work_pos_gruzchiki_2[cp_ids][1], work_pos_gruzchiki_2[cp_ids][2]))
				{
					SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
					if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

					SetPVarInt(playerid, "JobMoney", GetPVarInt(playerid, "JobMoney") + 1000);
					GivePlayerMoneyEx(playerid, 1000, "loader");

                    new bablo[50];
					format(bablo, sizeof(bablo), "~g~+1000$~n~~b~TOTAL:~w~ %d$", GetPVarInt(playerid,"JobMoney"));
					GameTextForPlayer(playerid, bablo, 5000, 1);

					ClearAnimations(playerid);
					ApplyAnimation(playerid, !"CARRY", !"putdwn", 4.0, 0, 1, 1, 0, 0, 1);
					DisablePlayerCheckpoint(playerid);
					DeletePVar(playerid, "gruzchiki_cps");

					new rand = random(10);
					SetPlayerCheckpoint(playerid, work_pos_gruzchiki[rand][0], work_pos_gruzchiki[rand][1], work_pos_gruzchiki[rand][2], 1);
					SetPVarInt(playerid, "gruzchiki_cp", rand);

					if(beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_LOADER && beg_quest_info[playerid][b_quest_status] == 1)
					{
					    beg_quest_info[playerid][b_quest_progress] += 100;
					    OnPlayerUpdateAccountsPer(playerid, "b_quest_progress", beg_quest_info[playerid][b_quest_progress]);

					    if(beg_quest_info[playerid][b_quest_progress] >= 5000)
					    {
					        SendClientMessage(playerid, col_white, !""c_yellow"Quest:"c_white" Great Job. You earned $5,000, you can change and return or continue working.");
					        beg_quest_info[playerid][b_quest_status] = 2;
					        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
					    }
					}
				}
			}
			return 1;
		}
	}
	return 1;
}

public OnPlayerLeaveCheckpoint(playerid)
{
	return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
	if(GetPVarInt(playerid, "take_pizza") == 1)
	{
	    new i = pizza_player_house[playerid];

	    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT &&
			PlayerToPoint(3.0, playerid, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
	    {
	        new Float: dist = GetPlayerDistanceFromPoint(playerid, 782.6801,-1601.8322,12.9827);

	        new dist_bonus = floatround((dist / 10) * 5);

	        pizza_player_house[playerid] = -1;

	        GivePlayerMoneyEx(playerid, 150 + dist_bonus, "Tip for the pizza");

	        DeletePVar(playerid, "take_pizza");

	        SendClientMessage(playerid, COLOR_YELLOW, "You delivered the pizza, tip: $150");
	        SCMF(playerid, -1, "Distance bonus: $%d", dist_bonus);

            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
			RemovePlayerAttachedObject(playerid, 4);

	        DisablePlayerRaceCheckpoint(playerid);
	    }

	    return 1;
	}

	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && player_road_school[playerid] == 2 && player_road_id[playerid] != -1)
	{
	    if(player_road_id[playerid] + 1 == sizeof school_road)
	    {
			new Float: health;

			GetVehicleHealth(GetPlayerVehicleID(playerid), health);

	        if(health > 800.0)
			{
			    p_info[playerid][pLicenses][0] = 1;
			    new vehicleid = GetPlayerVehicleID(playerid);
			    SetVehicleToRespawnEx(vehicleid);
			    RemovePlayerFromVehicleEx(playerid);
				SendClientMessage(playerid, COLOR_GREEN, "You passed the driving test, driver's license obtained.");

				if(beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_DRIVER && beg_quest_info[playerid][b_quest_status] == 1)
				{
                    SendClientMessage(playerid, col_white, !""c_yellow"Quest:"c_white" You completed Quest 'Driving School'. Use: "c_server"/quest"c_white", to receive an award.");
			        beg_quest_info[playerid][b_quest_status] = 2;
			        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
				}

				SavePlayerLicenses(playerid);
			}
			else SendClientMessage(playerid, COLOR_RED, "You failed the driving test, too many damages, try again...");

	        player_road_school[playerid] = 0;
	        player_road_id[playerid] = -1;

	        DisablePlayerRaceCheckpoint(playerid);
	    }
	    else
	    {
 	    	player_road_id[playerid]++;
	    	SetPlayerSchoolPoint(playerid);
		}
	}

	if(player_race_mark[playerid] != -1)
	{
	    player_race_mark[playerid]++;

		if(player_race_mark[playerid] >= sizeof race_mark_pos)
		{
		    race_finish_id++;

		    format(format_string, 96, "Race Event:"c_white"%s[%d] finished, place: %d", Name(playerid), playerid, race_finish_id);
            foreach(Player, i) if(player_race_reg{i}) SendClientMessage(i, COLOR_SERVER, format_string);

		    if(1 <= race_finish_id <= 3)
		    {
		        SCMF(playerid, -1, "Your from: {91d29a}$%d", race_reward[race_finish_id - 1]);
		        GivePlayerMoneyEx(playerid, race_reward[race_finish_id - 1], "victory in the races");
		    }

			DisablePlayerRaceCheckpoint(playerid);

			DestroyVehicle(player_race_vehicle[playerid]);
			player_race_vehicle[playerid] = INVALID_VEHICLE_ID;

		    SetPlayerPos(playerid,1772.8226,-1666.2528,14.4235);
		    SetPlayerInterior(playerid, 0);
		    SetPlayerVirtualWorld(playerid, 0);

		    player_race_reg{playerid} = 0;

            if(GetRacePlayersAmount() == 0) SendClientMessageToAll(COLOR_SERVER, "Race Event:"c_white"The event is over, all players have finished.");
		}
		else UpdatePlayerRaceMark(playerid);
	}
	//if(IsPlayerInVehicle(playerid, specialcar))
 	if(p_info[playerid][pJob] == 2 && p_t_info[playerid][pBusID] != 0)
    {
        new
            pos = busPos{playerid},
            route = player_route_id[playerid];
        if(gBusCPs[route][pos][0] == gBusCPs[route][pos+1][0] && gBusCPs[route][pos][1] == gBusCPs[route][pos+1][1])
		{
            format(format_string,24+100,"The bus has arrived at the station, departing in 10 seconds!");
            ProxDetector(30.0,playerid,format_string,0x44b2ffff,0x44b2ffff,0x44b2ffff,0x44b2ffff,0x44b2ffff);
            SetTimerEx("bus_stop",10000,false,"ii",playerid,route);
            DisablePlayerRaceCheckpoint(playerid);
            return 1;
        }
        if(pos == 99 || gBusCPs[route][pos+1][0] == 0.0) busPos{playerid} = 0;
		else busPos{playerid}++;
		SetNextCP(playerid,busPos{playerid});
    }
    if(p_info[playerid][pJob] == 3 && p_t_info[playerid][puborkacar] != 0)
    {
        new pos = uborkaPos{playerid},route = player_route_id[playerid];
        if(pos == 99 || gUborkaCPs[route][pos+1][0] == 0.0) uborkaPos{playerid} = 0;
		else uborkaPos{playerid}++;
		SetNextCP(playerid,uborkaPos{playerid});
    }
	if(IsPlayerInAnyVehicle(playerid) &&
		rent_job_vehicle[playerid] == GetPlayerVehicleID(playerid)) {
		switch(p_t_info[playerid][pPilot]) {
			case 1: {
				DisablePlayerCheckpoint(playerid);

				p_t_info[playerid][pPilot_Checkpoint]++;

				if(!!strcmp(checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]-1][textroute], "_")) {
					SendClientMessage(playerid, -1, checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]-1][textroute]);
				}

				if(checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]-1][purpose] == 1) {
			   		p_t_info[playerid][pPilot_Checkpoint] = 0;
			   		GivePlayerMoneyEx(playerid, 10000, "pilot ZP");
				}

				SetPlayerRaceCheckpoint(playerid,
					checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]][typepoint],
					checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]][check_X],
					checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]][check_Y],
					checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]][check_Z],
					checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]+1][check_X],
					checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]+1][check_Y],
					checkpoints_beagle[p_t_info[playerid][pPilot_Checkpoint]+1][check_Z],
					CHECK_SIZE);
			}
			case 2,3: {
				DisablePlayerCheckpoint(playerid);

				p_t_info[playerid][pPilot_Checkpoint]++;

				if(p_t_info[playerid][pPilot] == 2) {
					if(!!strcmp(checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]-1][textroute], "_")) {
						SendClientMessage(playerid, -1, checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]-1][textroute]);
					}

					if(checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]-1][purpose] == 2) {
						TogglePlayerControllable(playerid, false);
						SetTimerEx(!"@PilotSecondTimer", TIME_PILOT_TIMER, false, !"i", playerid);
					}

					if(checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]-1][purpose] == 1) {
				   		p_t_info[playerid][pPilot_Checkpoint] = 0;
				   		// ??????? before?????? ??before???? ??????:
			   			GivePlayerMoneyEx(playerid, 20000, "pilot's salary");
				   		//GivePlayerMoney(playerid, strval(GIVE_PRICE_SHAMAL));

					}

					SetPlayerRaceCheckpoint(playerid,
						checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]][typepoint],
						checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]][check_X],
						checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]][check_Y],
						checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]][check_Z],
						checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]+1][check_X],
						checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]+1][check_Y],
						checkpoints_shamal_lv[p_t_info[playerid][pPilot_Checkpoint]+1][check_Z],
						CHECK_SIZE);
				}
				if(p_t_info[playerid][pPilot] == 3) {
					if(!!strcmp(checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]-1][textroute], "_")) {
						SendClientMessage(playerid, -1, checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]-1][textroute]);
					}

					if(checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]-1][purpose] == 2) {
						TogglePlayerControllable(playerid, false);
						SetTimerEx(!"@PilotSecondTimer", TIME_PILOT_TIMER, false, !"i", playerid);
					}

					if(checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]-1][purpose] == 1) {
				   		p_t_info[playerid][pPilot_Checkpoint] = 0;
				   		// ??????? before?????? ??before???? ??????:
			   			GivePlayerMoneyEx(playerid, 20000, "pilot's salary");
				   		//GivePlayerMoney(playerid, strval(GIVE_PRICE_SHAMAL));

					}

					SetPlayerRaceCheckpoint(playerid,
						checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]][typepoint],
						checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]][check_X],
						checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]][check_Y],
						checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]][check_Z],
						checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]+1][check_X],
						checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]+1][check_Y],
						checkpoints_shamal_sf[p_t_info[playerid][pPilot_Checkpoint]+1][check_Z],
						CHECK_SIZE);
				}
			}
		}
	}
	return 1;
}

