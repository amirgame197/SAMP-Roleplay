alias:re("sp")
cmd:re(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /re [Player id]");
    if(!IsPlayerConnected(targetid) || targetid == playerid) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(admin_level[targetid] > admin_level[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You cannot follow an administrator of a higher level.");
	if(GetPlayerState(targetid) == PLAYER_STATE_SPECTATING && gSpectateID[targetid] != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The player is in spectator mode.");

	if(gSpectateID[playerid] == INVALID_PLAYER_ID)
	{
		new Float: x, Float: y, Float: z;
		GetPlayerPos(playerid, x, y, z);

		SetPVarFloat(playerid, "spec_X", x);
		SetPVarFloat(playerid, "spec_Y", y);
		SetPVarFloat(playerid, "spec_Z", z);
		SetPVarInt(playerid, "spec_int", GetPlayerInterior(playerid));
	    SetPVarInt(playerid, "spec_world", GetPlayerVirtualWorld(playerid));
	}
	StartSpectate(playerid, targetid);
	return 1;
}

alias:reoff("spoff")
cmd:reoff(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) StopSpectate(playerid);
	return 1;
}

cmd:pstats(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /pstats [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

	show_stats(playerid, targetid);
	return 1;
}

cmd:offpstats(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	extract params -> new string:name_player[24]; else return SendClientMessage(playerid, col_grey, !"Use: /offpstats [Player Nick]");
	if(GetPlayerID(name_player) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The Player Online.");

	text_string[0] = EOS;
	mysql_format(dbHandle, text_string, sizeof(text_string), "SELECT * FROM `accounts` WHERE `pName`='%s'", name_player);
	mysql_tquery(dbHandle, text_string, "show_player_offstats", "ds", playerid, name_player);
	return 1;
}

cmd:frz(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, type_frz; else return SendClientMessage(playerid, col_grey, !"Use: /frz [Player id] [0 - freeze | 1 - unfreeze]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(!(0 <= type_frz <= 1)) return SendClientMessage(playerid, col_grey, !"Use: /frz [Player id] [0 - freeze | 1 - unfreeze]");

	TogglePlayerControllable(targetid, type_frz);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] %s Player %s[%d]", Name(playerid), playerid, type_frz ? ("unfroze") : ("froze"), Name(targetid), targetid);
	send_admin_message(col_grey, text_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%d"c_white"%s You.", Name(playerid), type_frz ? ("unfroze") : ("froze"));
	SendClientMessage(targetid, col_white, text_string);
	return 1;
}

cmd:ajail(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, jail_time, string:jail_reason[64]; else return SendClientMessage(playerid, -1, "Use: /jail [Player id] [number of minutes] [Cause]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

    switch(admin_level[playerid])
    {
        case 2:
        {
            if(!(5 <= jail_time <= 30)) return SendClientMessage(playerid, col_white, !""c_error"Jail time can be from 5 to 30 minutes.");
        }
        default:
        {
            if(!(5 <= jail_time <= 120)) return SendClientMessage(playerid, col_white, !""c_error"Jail time can be from 5 to 120 minutes.");
        }
    }


	if(PlayerCuffed[targetid])
	{
		if(IsPlayerAttachedObjectSlotUsed(targetid, 8)) RemovePlayerAttachedObject(targetid, 8);
		SetPlayerSpecialAction(targetid, 0);
		PlayerCuffed[targetid] = 0;
	}

	p_info[playerid][pAdmPrison]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmPrison", p_info[playerid][pAdmPrison]);

	SetPlayerPrison(targetid, 5, jail_time * 60);

 	t_SetPlayerPos(targetid, 264.3258,77.5052,1001.0391);
	SetPlayerFacingAngle(targetid, 270.7134);
 	SetPlayerVirtualWorld(targetid, 1);
	SetPlayerInterior(targetid, 6);
	SetCameraBehindPlayer(targetid);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Administrator %s jailed player %d for %d minutes (Cause: %s)", Name(playerid), Name(targetid), jail_time, jail_reason);
	SendClientMessageToAll(col_orange_red, text_string);
	AddAdminLog(playerid, format_string);
    return 1;
}

cmd:mute(playerid, params[])
{
	if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, mute_time, string:mute_reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /mute [Player id] [minutes] [Cause]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

    switch(admin_level[playerid])
    {
        case 2:
        {
            if(!(5 <= mute_time <= 60)) return SendClientMessage(playerid, col_white, !""c_error"Chat block time can be from 5 to 60 minutes.");
        }
        default:
        {
            if(!(5 <= mute_time <= 120)) return SendClientMessage(playerid, col_white, !""c_error"Chat block time can be from 5 to 120 minutes.");
        }
    }

    if(admin_level[targetid] >= admin_level[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You cannot punish an Administrator of a higher level.");

	p_info[playerid][pAdmMute]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmMute", p_info[playerid][pAdmMute]);

	p_info[targetid][mute] = mute_time * 60;

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Administrator %s muted the player %s for %d minutes (Reason: %s).", Name(playerid), Name(targetid), mute_time, mute_reason);
	SendClientMessageToAll(col_orange_red, text_string);
	AddAdminLog(playerid, text_string);
	return 1;
}

cmd:spawn(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /spawn [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(afk_time[targetid] > 2) return SendClientMessage(playerid, col_white, !""c_error"The Player is AFK.");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] spawned player %s[%d].", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white" Spawned(-a) You.", Name(playerid));
	SendClientMessage(targetid, col_white, text_string);
	SaveGun(targetid);
	SpawnPlayer(targetid);
    return 1;
}

cmd:kick(playerid, params[])
{
	if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, string:kick_reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /kick [Player id] [Cause]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(admin_level[targetid] > admin_level[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You cannot punish an Administrator of a higher level.");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Administrator %s kicked player %s (Reason: %s).", Name(playerid), Name(targetid), kick_reason);
	SendClientMessageToAll(col_orange_red, text_string);

	p_info[playerid][pAdmKick]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmKick", p_info[playerid][pAdmKick]);

	Kick(targetid);
	return 1;
}

cmd:hp(playerid, params[])
{
	if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /hp [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

    SetPlayerHealth(targetid, 100);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] restored the health of player %s[%d].", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);

	if(GetPVarInt(targetid, !"p_dead") >= 1) DeletePVar(targetid, !"p_dead");
	return 1;
}

cmd:okay(playerid, params[])
{
	if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /okay [Player id]");

	new new_nick[MAX_PLAYER_NAME];
	GetPVarString(targetid, "change_name", new_nick, MAX_PLAYER_NAME);
	if(strlen(new_nick) < 4) return SendClientMessage(playerid, col_grey, !"The player did not apply for a nickname change.");
	DeletePVar(targetid, "change_name");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] changed player Nick %s[%d] to %s", Name(playerid), playerid, Name(targetid), targetid, new_nick);
	send_admin_message(col_grey, text_string);

    PlayerChangeName(targetid, new_nick);
	return 1;
}

cmd:nookay(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /nookay [Player id]");

	new new_nick[MAX_PLAYER_NAME];
	GetPVarString(targetid, "change_name", new_nick, MAX_PLAYER_NAME);
	if(strlen(new_nick) < 4) return SendClientMessage(playerid, col_grey, !"The player did not apply for a nickname change.");
    DeletePVar(targetid, "change_name");

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] denied the Nick change for %s[%d]", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);

	format(text_string, sizeof(text_string), "Administrator %s denied you a Nick change.", Name(playerid));
	SendClientMessage(targetid, col_grey, text_string);
	return 1;
}

// ??????? Administrator 3-?? level

cmd:verac(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, ban_day, string:ban_reason[64]; else return SendClientMessage(playerid, col_grey, "Use: /ban [Player id] [number of days] [Cause]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");

    switch(admin_level[playerid])
    {
        case 3:
        {
            if(!(1 <= ban_day <= 10)) return SendClientMessage(playerid, col_white, !""c_error"You can only ban for between 1 and 10 days.");
        }
        default:
        {
            if(!(1 <= ban_day <= 30)) return SendClientMessage(playerid, col_white, !""c_error"You can only ban for between 1 and 10 days.");
        }
    }

    if(admin_level[targetid] > admin_level[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You cannot punish an Administrator of a higher level.");

    new days[6];
	switch(ban_day)
	{
	    case 1: days = "day";
	    case 2..4: days = "days";
		default: days = "days";
	}

	p_info[playerid][pAdmBan]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmBan", p_info[playerid][pAdmBan]);

	text_string[0] = EOS;
    format(text_string, sizeof(text_string), "Administrator %s blocked account for player %s for %d day %s (Reason: %s)", Name(playerid), Name(targetid), ban_day, days, ban_reason);
	SendClientMessageToAll(col_orange_red, text_string);
	AddAdminLog(playerid, text_string);

    BlockAccounts(Name(targetid), ban_reason, Name(playerid), gettime() + (86400 * ban_day));

    text_string[0] = EOS;
    format(text_string, 144, "[A] Last. IP: %s | Reg. IP: %s", GetPlayerIpEx(targetid), p_info[targetid][pIpReg]);
    send_admin_message(col_grey, text_string);
	return 1;
}

cmd:warn(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid, string:warn_reason[64]; else return SendClientMessage(playerid, col_grey, !"Use: /warn [Player id] [Cause]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(admin_level[targetid] >= admin_level[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You cannot punish an Administrator of a higher level.");

    if(p_info[playerid][pWarn] >= 2)
    {
        p_info[playerid][pAdmBan]++;
        OnPlayerUpdateAdminPer(playerid, "pAdmBan", p_info[playerid][pAdmBan]);

        text_string[0] = EOS;
    	format(text_string, sizeof(text_string), "Administrator %s warned player %s! (Reason: %s | 3 out of 3)", Name(playerid), Name(targetid), playerid);
		SendClientMessageToAll(col_orange_red, text_string);
        AddAdminLog(playerid, text_string);

        text_string[0] = EOS;
		mysql_format(dbHandle, text_string, sizeof(text_string), "DELETE FROM `warninfo` WHERE `plID`='%d'", p_info[targetid][pID]);
		mysql_tquery(dbHandle, text_string);

		BlockAccounts(Name(targetid), warn_reason, Name(playerid), gettime() + (86400 * 7));
		return 1;
    }
	p_info[playerid][pAdmWarn]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmWarn", p_info[playerid][pAdmWarn]);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "Administrator %s warned player %s (Reason: %s | %d out of 3)", Name(playerid), Name(targetid), warn_reason, p_info[playerid][pWarn] + 1);
	SendClientMessageToAll(col_orange_red, text_string);
	AddAdminLog(playerid, text_string);

    text_string[0] = EOS;
    format(text_string, sizeof(text_string), "UPDATE `accounts` SET `pLeader`='0',`pMember`='0' WHERE `pID`='%d'", GetPlayerAccountID(targetid));
	mysql_tquery(dbHandle, text_string);

	slobal_string[0] = EOS;
	mysql_format(dbHandle, slobal_string, 350, "INSERT INTO `warninfo` (`plID`,`wReasonWarn`,`wAdminWarn`,`wWarnDate`,`wUnWarnDate`) VALUES ('%d','%e','%e','%d','%d')", p_info[targetid][pID], warn_reason, Name(playerid), gettime(), gettime() + (86400 * 7));
	mysql_query(dbHandle, slobal_string);

	Kick(targetid);
	return 1;
}

cmd:goto(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
	extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /goto [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
	if(GetPlayerState(targetid) != 1 && GetPlayerState(targetid) != 2 && GetPlayerState(targetid) != 3) return SendClientMessage(playerid, col_white, !""c_error"The player has not joined the game.");
	if(GetPlayerState(targetid) == PLAYER_STATE_SPECTATING && gSpectateID[targetid] != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The player is in spectator mode.");

    new Float:plocx, Float:plocy, Float:plocz;
	GetPlayerPos(targetid, plocx, plocy, plocz);
	if(GetPlayerState(playerid) == 2)
	{
		new tmpcar = GetPlayerVehicleID(playerid);
		SetVehiclePos(tmpcar, plocx, plocy + 4, plocz + 1);
	}
	else SetPlayerPos(playerid, plocx, plocy + 2, plocz);

	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(targetid));
	SetPlayerInterior(playerid, GetPlayerInterior(targetid));

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] teleported to player %s[%d]", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:gethere(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    extract params -> new player:targetid; else return SendClientMessage(playerid, col_grey, !"Use: /gethere [Player id]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(GetPlayerState(targetid) != 1 && GetPlayerState(targetid) != 2 && GetPlayerState(targetid) != 3) return SendClientMessage(playerid, col_white, !""c_error" This Player didn't entered the game.");
	if(afk_time[targetid] > 5) return SendClientMessage(playerid, col_white, !""c_error"The Player is AFK.");
	if(p_info[targetid][pPrison] > 0) return SendClientMessage(playerid, col_white, !""c_error"This Player is in prison.");

	new Float:plocx, Float:plocy, Float:plocz, inter = GetPlayerInterior(playerid), world = GetPlayerVirtualWorld(playerid);
	GetPlayerPos(playerid, plocx, plocy, plocz);

	if(GetPlayerState(targetid) == 2)
	{
		new tmpcar = GetPlayerVehicleID(targetid);
		SetVehiclePos(tmpcar, plocx, plocy + 4, plocz + 1);
	}
	else SetPlayerPos(targetid, plocx, plocy + 2, plocz);

    SetPlayerInterior(targetid, inter);
	SetPlayerVirtualWorld(targetid, world);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You have been teleported by the Administrator "c_server"%s"c_white".", Name(playerid));
	SendClientMessage(targetid, col_white, text_string);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] teleported to themselves %s[%d]", Name(playerid), playerid, Name(targetid), targetid);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:fix(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    extract params -> new vehicle_id; else return SendClientMessage(playerid, col_grey, !"Use: /fix [vehicle ID]");

	RepairVehicle(vehicle_id);
	veh_info[vehicle_id][vFuel] = MAX_VEHICLE_FUEL;
	Fuell[vehicle_id] = MAX_VEHICLE_FUEL;

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "[A] %s[%d] fixed vehicle (ID: %d)", Name(playerid), playerid, vehicle_id);
	send_admin_message(col_grey, text_string);
	return 1;
}

cmd:gotcar(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
