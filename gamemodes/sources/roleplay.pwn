forward SaveGun(playerid);
public SaveGun(playerid)
{
	    if(p_info[playerid][pLogin] == 0) return 1;
		for (new i = 0; i <= 12; i++)
		{
		    GetPlayerWeaponData(playerid, i, p_info [ playerid ][ pGun ][i], p_info [ playerid ][ pAmmo ][i]);
		}
		new string[512];
    	format(string, sizeof(string), "UPDATE `accounts` SET pGun='%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d' WHERE pName='%s'"
		,p_info[playerid][pGun][0], p_info[playerid][pGun][1], p_info[playerid][pGun][2], p_info[playerid][pGun][3], p_info[playerid][pGun][4], p_info[playerid][pGun][5],
	    p_info[playerid][pGun][6], p_info[playerid][pGun][7], p_info[playerid][pGun][8], p_info[playerid][pGun][9], p_info[playerid][pGun][10], p_info[playerid][pGun][11], p_info[playerid][pGun][12],p_info[playerid][pName]);
    	mysql_tquery(dbHandle, string);
    	new strr[512];
    	format(strr, sizeof(strr), "UPDATE `accounts` SET pAmmo='%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d' WHERE pName='%s'",
		p_info[playerid][pAmmo][0], p_info[playerid][pAmmo][1], p_info[playerid][pAmmo][2], p_info[playerid][pAmmo][3], p_info[playerid][pAmmo][4], p_info[playerid][pAmmo][5], p_info[playerid][pAmmo][6],
		p_info[playerid][pAmmo][7], p_info[playerid][pAmmo][8], p_info[playerid][pAmmo][9], p_info[playerid][pAmmo][10], p_info[playerid][pAmmo][11], p_info[playerid][pAmmo][12],p_info[playerid][pName]);
    	mysql_tquery(dbHandle, strr);
        return 1;
}
public OnPlayerDisconnect(playerid, reason)
{
	new string2[128];
	format(string2, 188, " {9966CC} %s has left the game (crashed/timed out)", Name(playerid));
    ProxDetector(25.0, playerid, string2, COLOR_RED, COLOR_RED, COLOR_RED, COLOR_RED, COLOR_RED);

	SaveGun(playerid);
	if(p_t_info[playerid][plveh] != -1)
	{
		DestroyVehicle(p_t_info[playerid][plveh]);
		p_t_info[playerid][plveh] = -1;
	}

	if(p_info[playerid][family])
	{
	    new familyid = p_info[playerid][family];
		Iter_Remove(family_players[familyid], playerid);
	}

	if(p_info[playerid][family_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(p_info[playerid][family_text]);
		p_info[playerid][family_text] = Text3D:INVALID_3DTEXT_ID;
	}

	if(p_t_info[playerid][pTrucker] > -1 && p_info[playerid][pJob] == 6 && p_t_info[playerid][pTrucker_Unit] != 0)
	{
	    GivePlayerMoneyEx(playerid, p_t_info[playerid][pTrucker_Unit] * UNIT_PRICE, "refund for cargo");

	    AddPlayerNotify(playerid, "You have been refunded for the loss of cargo.");
	}

	if(report_id[playerid] != -1)
	{
		report_slot[report_id[playerid]] = -1;
		report_id[playerid] = -1;
	}

	for(new i; i < max_report; i++)
	{
		if(report_player[i] == -1) continue;
		if(report_player[i] == playerid) report_delete(i);
	}

	for(new i; i < max_question; i++)
	{
		if(question_player[i] == -1) continue;
		if(question_player[i] == playerid) question_delete(i);
	}

	new old_pay = p_info[playerid][pPayCheck];

	p_info[playerid][pPayCheck] += p_t_info[playerid][pWorkSalary];
	p_info[playerid][pPayCheck] += GetPVarInt(playerid, "JobMoney");
	p_info[playerid][pPayCheck] += AmmountWood[playerid]*30;

	if(p_info[playerid][pPayCheck] != old_pay) OnPlayerUpdateAccountsPer(playerid, "pPayCheck", p_info[playerid][pPayCheck]);

	if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID)
	{
	    new vehicleid = rent_vehicle_id[playerid];

	    DestroyVehicle(vehicleid);

	    vehicle_rent_owner[vehicleid] = INVALID_PLAYER_ID;
	    rent_vehicle_id[playerid] = INVALID_VEHICLE_ID;
	}

	new bool: need_update_td;

	for(new x; x < 2; x++)
	{
		for(new i; i < 8; i++)
		{
			if(cheat_ids[x][i] != playerid) continue;
			cheat_ids[x][i] = -1;

			need_update_td = true;
		}
	}

	if(need_update_td) UpdateCheaterTD();

	//

    for(new i; i < MAX_BARRAGE_OBJ; i++)
	{
	    if(!player_barrage[playerid][i]) continue;

	    DestroyDynamicObject(player_barrage[playerid][i]);
	    player_barrage[playerid][i] = 0;

	    DestroyDynamic3DTextLabel(player_barrage_3d[playerid][i]);
	}

	for(new i; i < MAX_ADVERTS; i++) if(AdvertInfo[i][aEditor] == playerid) AdvertInfo[i][aEditor] = INVALID_PLAYER_ID;

    if(p_t_info[playerid][uborka_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(p_t_info[playerid][uborka_text]);
		p_t_info[playerid][uborka_text] = Text3D:INVALID_3DTEXT_ID;
	}

    if(p_t_info[playerid][bus_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(p_t_info[playerid][bus_text]);
		p_t_info[playerid][bus_text] = Text3D:INVALID_3DTEXT_ID;
	}

    if(GetPVarInt(playerid, "get vehicle drive"))
    {
        new old_vehicleid = GetPVarInt(playerid, "get vehicle drive");

        vehicle_driver[old_vehicleid] = INVALID_PLAYER_ID;
    }

	PlayerStopRobbery(playerid);

	if(rob_offer[playerid] != INVALID_PLAYER_ID)
	{
	    new r_offer = rob_offer[playerid];
	    rob_offer[r_offer] = INVALID_PLAYER_ID;
	}

	DeletePlayerQuestData(playerid);

    DeletePlayerDrugMark(playerid);

    PlayerLoseDuel(playerid);

	RemovePlayerFromContainer(playerid);

    DestroyDeliveryObject(playerid);

    if(player_race_reg{playerid}) PlayerLeaveRace(playerid);

	if(Iter_Contains(admin_list, playerid)) Iter_Remove(admin_list, playerid);

    foreach(new i : Player)
	{
	    if(player_taxi_passanger[i] != INVALID_PLAYER_ID)
        {
            player_taxi_passanger[i] = INVALID_PLAYER_ID;

            SendClientMessage(i, COLOR_GREY, "The passenger has left the game.");

			SearchNextClientForTaxi(GetPlayerVehicleID(i), playerid);

			break;
        }

	    if(player_search_player[i] == playerid)
	    {
	        DisablePlayerCheckpoint(i);
	        SCMF(i, COLOR_GREY, "Connection lost, monitoring of Player %s[%d] has been terminated. (disconnect)", Name(player_search_player[i]), player_search_player[i]);
	        player_search_player[i] = -1;

	        break;
     	}

    	if(gSpectateID[i] == playerid)
    	{
        	StopSpectate(i);
        	break;
    	}
	}
	if(PlantObject[playerid] != -1)// ??????? ?????? ? Player
	{
		DestroyObject(PlantObject[playerid]);
		PlantObject[playerid] = -1;
	}
	if(p_info[playerid][pWanted] > 0 && PlayerCuffed[playerid] > 0)
	{
	    //ResetWeapons(playerid);

	    SetPlayerPrison(playerid, 1, p_info[playerid][pWanted] * 600);
	}
	if(p_t_info[playerid][pWork] >= 1)
	{
		p_t_info[playerid][pWork] = 0;
		if(p_t_info[playerid][pWork] == 2)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
			if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
		}
	}
	if(player_gun_obj[playerid])
	{
		new objectid = player_gun_obj[playerid];
		if(IsValidDynamicObject(objectid)) DestroyDynamicObject(objectid);
	}

    PlayerLeaveHospitalBed(playerid);
    if(rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
	{
		SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
		player_jobvehicle_time[playerid] = 0;
		rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
	}
	if(p_info[playerid][pObject] > 0)
	{
	    DestroyDynamic3DTextLabel(p_info[playerid][pDText]);
	    DestroyDynamicObject(p_info[playerid][pObject]);
 	}
	if(p_info[playerid][pJob] == 2 && p_t_info[playerid][pBusID] != 0)
	{
        spawned_bus(playerid);
 	}
 	if(p_info[playerid][pJob] == 3 && p_t_info[playerid][puborkacar] != 0)
	{
        p_t_info[playerid][puborkacar] = 0;
      	player_route_id[playerid] = 0;
        uborkaPos{playerid} = 0;
        SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
 	}

 	if(GetPVarInt(playerid, "GPS") != 0) DisablePlayerCheckpoint(playerid);


    OnPlayerUpdateAccounts(playerid);
    p_info[playerid][pLogin] = 0;

    mysql_format(dbHandle, MySQLStr, 96, "UPDATE `accounts` SET `pLogin` = 0 WHERE `pID` = %d", p_info[playerid][pID]);
	mysql_tquery(dbHandle, MySQLStr);

	for(new i; i < MAX_PLAYER_VEHICLES; i++) if(player_home_car[playerid][i] != INVALID_VEHICLE_ID) DestroyVehicleEx(player_home_car[playerid][i]); // delete home car
    if(GetPVarInt(playerid, "FillSost") > 0) KillTimer(KillTimer(FillTimer[playerid])); // ???? ??? ?? ????? Gas stations

    new Float:e_playerX, Float:e_playerY, Float:e_playerZ;
    GetPlayerPos(playerid, e_playerX, e_playerY, e_playerZ);

    text_string[0] = EOS;
	format(text_string, sizeof(text_string), "UPDATE `accounts` SET `e_player`='%f,%f,%f,%d,%d,%d' WHERE `pID`='%d' LIMIT 1", e_playerX, e_playerY, e_playerZ, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid), gettime() + 300, p_info[playerid][pID]);
	mysql_query(dbHandle, text_string);
	return 1;
}

stock SetVehicleToRespawnEx(vehicleid)
{
    SetVehicleToRespawn(vehicleid);
    return 1;
}
stock DestroyVehicleEx(vehicleid)
{
	DestroyVehicle(vehicleid);
	return 1;
}

