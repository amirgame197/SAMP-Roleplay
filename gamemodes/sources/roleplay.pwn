public OnGameModeExit()
{
    new f = MAX_OBJ+1;
	for(new a = 0; a < MAX_OBJ; a++)
	{
        DestroyDynamicPickup(dGunData[f][ObjID]);
	}

	SaveAllServers();
    mysql_close(dbHandle);
	return 1;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    if(player_duel_start[playerid] != true)
	{
		switch(weaponid)
		{
			case 23:
			{
				if(p_info[playerid][pGunSkill][0] >= 100) return 1;
				gun_skill_up{playerid} ++;
				if(gun_skill_up{playerid} >= 6)
				{
					gun_skill_up{playerid} = 0;
					p_info[playerid][pGunSkill][0] ++;

					new _query[96];
					format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS SD PISTOL ~n~ALL: ~r~ %i/100", p_info[playerid][pGunSkill][0]);
					GameTextForPlayer(playerid, _query, 2000, 5);

					SetPlayerSkills(playerid);
				}
			}
			case 24:
			{
				if(p_info[playerid][pGunSkill][1] >= 100) return 1;
				gun_skill_up{playerid} ++;
				if(gun_skill_up{playerid} >= 6)
				{
					gun_skill_up{playerid} = 0;
					p_info[playerid][pGunSkill][1] ++;

					new _query[96];
					format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS DEAGLE ~n~ALL: ~r~ %i/100", p_info[playerid][pGunSkill][1]);
					GameTextForPlayer(playerid, _query, 2000, 5);

					SetPlayerSkills(playerid);
				}
			}
			case 25:
			{
				if(p_info[playerid][pGunSkill][2] >= 100) return 1;
				gun_skill_up{playerid} ++;
				if(gun_skill_up{playerid} >= 6)
				{
					gun_skill_up{playerid} = 0;
					p_info[playerid][pGunSkill][2] ++;

					new _query[96];
					format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS SHOTGUN ~n~ALL: ~r~ %i/100", p_info[playerid][pGunSkill][2]);
					GameTextForPlayer(playerid, _query, 2000, 5);

					SetPlayerSkills(playerid);
				}
			}
			case 29:
			{
				if(p_info[playerid][pGunSkill][3] >= 100) return 1;
				gun_skill_up{playerid} ++;
				if(gun_skill_up{playerid} >= 15)
				{
					gun_skill_up{playerid} = 0;
					p_info[playerid][pGunSkill][3] ++;

					new _query[96];
					format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS MP5 ~n~ALL: ~r~ %i/100", p_info[playerid][pGunSkill][3]);
					GameTextForPlayer(playerid, _query, 2000, 5);

					SetPlayerSkills(playerid);
				}
			}
			case 30:
			{
				if(p_info[playerid][pGunSkill][4] >= 100) return 1;
				gun_skill_up{playerid} ++;
				if(gun_skill_up{playerid} >= 15)
				{
					gun_skill_up{playerid} = 0;
					p_info[playerid][pGunSkill][4] ++;

					new _query[96];
					format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS AK47 ~n~ALL: ~r~ %i/100", p_info[playerid][pGunSkill][4]);
					GameTextForPlayer(playerid, _query, 2000, 5);

					SetPlayerSkills(playerid);
				}
			}
			case 31:
			{
				if(p_info[playerid][pGunSkill][5] >= 100) return 1;
				gun_skill_up{playerid} ++;
				if(gun_skill_up{playerid} >= 15)
				{
					gun_skill_up{playerid} = 0;
					p_info[playerid][pGunSkill][5] ++;

					new _query[96];
					format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SKILLS M4 ~n~ALL: ~r~ %i/100", p_info[playerid][pGunSkill][5]);
					GameTextForPlayer(playerid, _query, 2000, 5);

					SetPlayerSkills(playerid);
				}
			}
		}
	}

	if(p_info[playerid][pLevel] < 2 && hittype == BULLET_HIT_TYPE_PLAYER)
	{
	    SendClientMessage(playerid, COLOR_GREY, "You are not level 2.");
	    return 0;
	}

    if(IsACop(playerid) && form_fraction[playerid] && hittype == BULLET_HIT_TYPE_PLAYER && weaponid == 23) return BulletTazer(playerid, hitid);

    if(hittype == BULLET_HIT_TYPE_PLAYER)
	{
		killer_id[hitid] = playerid;
		killer_weapon[hitid] = weaponid;
		killer_clear[hitid] = 10;
    }
    return 1;
}

public OnPlayerGiveDamage(playerid, damagedid, Float: amount, weaponid, bodypart)
{
    if(damagedid != INVALID_PLAYER_ID)
	{
	    if(p_info[playerid][pLevel] < 2)
		{
		    new Float: health, Float: armour;

			GetPlayerHealth(damagedid, health);
		    GetPlayerArmour(damagedid, armour);

		    SetPlayerHealth(damagedid, health);
		    SetPlayerArmour(damagedid, armour);

		    SendClientMessage(playerid, COLOR_GREY, "You are not level 2.");
		    return 0;
		}

		killer_id[damagedid] = playerid;
		killer_weapon[damagedid] = weaponid;
		killer_clear[damagedid] = 10;
	}
 	if(weaponid != 43 && weaponid != 9 && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DRINK_SPRUNK && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DRINK_WINE && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_SMOKE_CIGGY && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DRINK_BEER)
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && pDialog[playerid] == false && IsPlayerInGreenZone(playerid))
	    if(p_info[playerid][pMember] != FRACTION_LSPD)
		{
            new Float: health, Float: armour;
			GetPlayerHealth(damagedid, health);
		    GetPlayerArmour(damagedid, armour);

		    SetPlayerHealth(damagedid, health);
		    SetPlayerArmour(damagedid, armour);

	        SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, !""c_server"Warning", !""c_white"Shooting/Fighting is prohibited in this place.\n\n{AFAFAF}Repeated offenses may result in a kick.", "Okay", "");
	        ApplyAnimation(playerid, !"FAT", !"IDLE_tired", 3.0, 1, 0, 0, 0, 3000, 1);
	        return 0;
		}
	}
    return 1;
}

public OnPlayerTakeDamage(playerid, issuerid, Float: amount, weaponid, bodypart)
{
	killer_id[playerid] = issuerid;
	killer_weapon[playerid] = weaponid;

    return 1;
}
