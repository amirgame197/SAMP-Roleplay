   	for(new b; b < TotalBizz; b++)
	{
		if(pickupid == BizzInfo[b][bPickupHeal])
		{
			if(p_info[playerid][pCash] < 500) return SendClientMessage(playerid, COLOR_GREY, "You do not have $500.");
		    new Float:health;
    		GetPlayerHealth(playerid, health);
		    if(health > 90) return SendClientMessage(playerid, 0xafafafff, "You do not need treatment.");
		    SetPlayerHealthEx(playerid, 100);
			GivePlayerMoneyEx(playerid, -500, "Treatment in the business.");
			GiveBusinessMoney(b, 500);
			break;
		}
	}
	if(player_enter_home[playerid] != -1)
	{
		for(new i; i < max_houses; i++)
		{
			if(pickupid == HouseInfo[i][hAreaHeal])
			{
			    if(HouseInfo[i][hHel] <= 0) return SendClientMessage(playerid, -1, "There are no Home first aid kits in this House; they can be purchased at the 24/7 store.");
				format(String, 128, ""c_white"Are you sure you want to use the Home first aid kit?\nFirst aid kits in the House: {33AA33}%d PC.", HouseInfo[i][hHel]);
				SPD(playerid, 36, DIALOG_STYLE_MSGBOX, !""c_server"Home first aid kit", String, "Yes", "No");
				return SetPVarInt(playerid, "UseHealHome", i);
		    }
	   	}
 	}

	if(pickupid == zavodd[0]) {
	    SetPlayerInterior(playerid,2);
	    SetPlayerPos(playerid, 2575.1619,-1292.2260,1044.1250);
	}
	else if(pickupid == zavodd[1]) {
	    if(player_job[playerid] == 3)
		{
			player_job[playerid] = 0;
			DeletePVar(playerid,"Metal");
			if(PlantObject[playerid] != -1)
			{
				DestroyObject(PlantObject[playerid]);
				PlantObject[playerid] = -1;
			}
			RemovePlayerAttachedObject(playerid, 0);
			SendClientMessage(playerid, 0xB4B5B7FF, "You left the factory premises and are without pay.");
			if(IsPlayerAttachedObjectSlotUsed(playerid,1)) RemovePlayerAttachedObject(playerid,1);
			if(IsPlayerAttachedObjectSlotUsed(playerid,2)) RemovePlayerAttachedObject(playerid,2);
			DeletePVar(playerid,"CHECKPOINTID");
			DisablePlayerCheckpoint(playerid);
			DeletePVar(playerid,"JobMoney");
			SetPlayerSkinEx(playerid,p_info[playerid][pSkin]);
		}
	    SetPlayerInterior(playerid,0);
	    SetPlayerPos(playerid, -1007.6013,-692.5248,32.0078);
	}
	else if(pickupid == mayor_jobs) {
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"You are part of The organization.");
	    SPD(playerid,228,DIALOG_STYLE_LIST, !""c_server"Get licenses",""c_white"1. Boldozer Driver [2 Level]\n2. Bus Driver [2 Level]\n3. Cleaner [3 Level]\n4. Trash Driver [5 Level]\n5. This Thing [6 Level]\n6. Driver [6 Level]\n7. Another Driver [7 Level]\n8. Pilot [9 Level]","Choose","Cancel");
	}
	return 1;
}
public OnPlayerPickUpPickup(playerid, pickupid) //For Pickup
{
	if(pickupid == mayor_enters[0]) SetPPos(playerid, 1462.6122,-1805.4554,33.4243,205.6409, 0, 0, false);
    if(pickupid == mayor_enters[1]) SetPPos(playerid, 1387.3358,-20.8174,1000.9287,269.0969, 3, 2, true);

	if(pickupid == lshosp_pickups) SetPPos(playerid, -642.7250,-918.5214,1436.1736,4.3646, 8, 6, true);
	if(pickupid == sfhosp_pickups[2]) SetPPos(playerid, -642.7250,-918.5214,1436.1736,4.3646, 8, 8, true);
	if(pickupid == lvhosp_pickups[2]) SetPPos(playerid, -642.7250,-918.5214,1436.1736,4.3646, 8, 9, true);

	if(pickupid == lshosp_roof_pickup)
	{
		if(CheckHospitalHealth(playerid)) return 1;

		switch(GetPlayerVirtualWorld(playerid))
		{
		    case 6: SetPPos(playerid, 1161.4312,-1326.3079,31.4985,2.8989, 0, 0, false);
		    case 8: SetPPos(playerid, -2727.6323,624.7358,33.2969,180.7024, 0, 0, false);
		    case 9: SetPPos(playerid, 1606.6919,1789.0757,30.4688,1.6141, 0, 0, false);
		}
	}

	if(pickupid == ship_enter_pickups[0] && ship_pos_id == 3) SetPlayerPos(playerid, 2550.4058,-2652.4631,5.7499);
	if(pickupid == ship_enter_pickups[1] && ship_pos_id == 6) SetPlayerPos(playerid, 2589.5679,-3797.1455,5.7499);
	if(pickupid == attic_pickup[0])  pc_cmd_exit(playerid);
    if(pickupid == attic_pickup[1])
	{
		SPD(playerid, 4558, DIALOG_STYLE_TABLIST, !""c_server"Weapon creation.", !"\
		Silencer Pistol\t100 pts. | 6 Metals.\n\
		Desert Eagle\t100 pts. | 6 Metals.\n\
	    MP5\t100 pts. | 6 Metals.\n\
	    Shotgun\t100 pts. | 6 Metals.\n\
	    AK-47\t100 pts. | 6 Metals.\n\
	    Rifle\t100 pts. | 6 Metals.\n\
	    M4\t100 pts. | 6 Metals.", !"Create", !"Close");
	}
	if(election_status)
	{
		if(pickupid == elecation_enter[0]) SetPPos(playerid, 1387.9913,-21.2610,2001.4272,97.5509, 5, 5, true);
		if(pickupid == elecation_enter[1]) SetPPos(playerid, 1400.4969,-35.9991,1000.9287,92.4609, 3, 2, true);
	}

    if(pickupid == mayor_ammo)
	{
	    if(GetPVarInt(playerid, "take_mats"))
	    {
	        new m_id = FRACTION_MAYOR;
	        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000) return SendClientMessage(playerid, col_white, !""c_error"Enough ammunition in stock.");

	        SendClientMessage(playerid, col_white, !""c_info"You placed ammunition in the organization's warehouse.");

	        text_string[0] = EOS;
	        format(text_string, sizeof(text_string), ""c_info"Warehouse condition: "c_server"%d / 200000", FracInfo[m_id][fBank][0]);
	        SendClientMessage(playerid, col_white, text_string);

	        FracInfo[m_id][fBank][0] += 250;
	        FracInfo[m_id][fBank][1] += 250;

	        return RemovePlayerAmmoBox(playerid);
	    }
	    if(p_info[playerid][pMember] != FRACTION_MAYOR) return SendClientMessage(playerid, col_white, !""c_error"You do not have access to this warehouse.");
	    if(!(1 <= p_info[playerid][pRank] <= 2)) return SendClientMessage(playerid, col_white, !""c_error"The warehouse is accessible only to security personnel.");

	    ShowPlayerAmmoDialog(playerid);
	}

	if(pickupid == sfpd_ammo)
	{
	    if(GetPVarInt(playerid, "take_mats"))
	    {
	        new m_id = FRACTION_SFPD;
	        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000) return SendClientMessage(playerid, col_white, !""c_error"Enough ammunition in stock.");

