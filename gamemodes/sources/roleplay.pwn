				else return TuneMessage(playerid, "(Rear parts) are not allowed on this car."), ShowRear(playerid);
			}
			if(listitem == 1)
			{
				if(m == 562) SetRear(playerid, 7);
				else if(m == 565) SetRear(playerid, 8);
				else if(m == 559) SetRear(playerid, 9);
				else if(m == 561) SetRear(playerid, 10);
				else if(m == 558) SetRear(playerid, 11);
				else if(m == 560) SetRear(playerid, 12);
				else return TuneMessage(playerid, "(Rear parts) are not allowed on this car."), ShowRear(playerid);
			}
		}
		else ShowTuneDialog(playerid);
	}
	if(dialogid == 9509)
	{
		if(response)
		{
			new m = pmodelid[playerid];
			if(listitem == 0)
			{
				if(m == 562) SetRoofs(playerid, 1);
				else if(m == 565) SetRoofs(playerid, 2);
				else if(m == 559) SetRoofs(playerid, 3);
				else if(m == 561) SetRoofs(playerid, 4);
				else if(m == 558) SetRoofs(playerid, 5);
				else if(m == 560) SetRoofs(playerid, 6);
				else return TuneMessage(playerid, "(Roofs) are not allowed on this car."), ShowRoofs(playerid);
			}
			if(listitem == 1)
			{
				if(m == 562) SetRoofs(playerid, 7);
				else if(m == 565) SetRoofs(playerid, 8);
				else if(m == 559) SetRoofs(playerid, 9);
				else if(m == 561) SetRoofs(playerid, 10);
				else if(m == 558) SetRoofs(playerid, 11);
				else if(m == 560) SetRoofs(playerid, 12);
				else return TuneMessage(playerid, "(Roofs) are not allowed on this car."), ShowRoofs(playerid);
			}
		}
		else ShowTuneDialog(playerid);
	}
	if(dialogid == 9510)
	{
		if(response)
		{
			switch(listitem)
			{
				case 0: SetWheels(playerid, 1);
				case 1: SetWheels(playerid, 2);
				case 2: SetWheels(playerid, 3);
				case 3: SetWheels(playerid, 4);
				case 4: SetWheels(playerid, 5);
				case 5: SetWheels(playerid, 6);
				case 6: SetWheels(playerid, 7);
				case 7: SetWheels(playerid, 8);
				case 8: SetWheels(playerid, 9);
				case 9: SetWheels(playerid, 10);
				case 10: SetWheels(playerid, 11);
				case 11: SetWheels(playerid, 12);
				case 12: SetWheels(playerid, 13);
				case 13: SetWheels(playerid, 14);
				case 14: SetWheels(playerid, 15);
				case 15: SetWheels(playerid, 16);
				case 16: SetWheels(playerid, 17);
			}
		}
		else ShowTuneDialog(playerid);
	}
	return 1;
}

