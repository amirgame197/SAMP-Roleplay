	    famveh = CreateVehicle(vehids, pposx, pposy, pposz, 0.0, 1, 1, 1000000000000000);
        veh_info[famveh][vStatus] = 2;
		PutPlayerInVehicle(playerid, famveh, 0);
		Fuell[famveh] = MAX_VEHICLE_FUEL;
	    new lights, alarm, bonnet, boot, objective;
