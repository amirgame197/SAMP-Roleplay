cmd:ahouse(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
    extract params -> new a_house; else return SendClientMessage(playerid, col_grey, !"Use: /ahouse [# House]");
    if(!(0 <= a_house <= max_houses - 1)) return SendClientMessage(playerid, col_white, !""c_error"House with that number not found.");

	SetPlayerPos(playerid, HouseInfo[a_house][hEntrancex], HouseInfo[a_house][hEntrancey], HouseInfo[a_house][hEntrancez]);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerInterior(playerid, 0);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You have been teleported to House "c_server"#%d", a_house);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}
cmd:movehouse(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
    extract params -> new a_movehouse; else return SendClientMessage(playerid, col_grey, !"Use: /movehouse [house id]");
    if(!(0 <= a_movehouse <= max_houses - 1)) return SendClientMessage(playerid, col_white, !""c_error"The house does not exist!");
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    HouseInfo[a_movehouse][hEntrancex] = x;
	HouseInfo[a_movehouse][hEntrancey] = y;
	HouseInfo[a_movehouse][hEntrancez] = z;
	UpdatePickupHouse(a_movehouse);
	SaveHouse(a_movehouse);
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"House has been moved ID:"c_server"#%d", a_movehouse);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}
cmd:changeclass(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
    extract params -> new a_movehouse, a_class; else return SendClientMessage(playerid, col_grey, !"Use: /changeclass [house id] [class]");
    if(!(0 <= a_movehouse <= max_houses - 1)) return SendClientMessage(playerid, col_white, !""c_error"The house does not exist!");
    if(a_class >=7) return SendClientMessage(playerid, col_white, !""c_error"The class does not exist!");
    HouseInfo[a_movehouse][hKlass] = a_class - 1;
	UpdatePickupHouse(a_movehouse);
	SaveHouse(a_movehouse);
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"House ID "c_server"#%d"c_info"Class changed to "c_server"%d", a_class);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}
cmd:changeint(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
    extract params -> new a_movehouse, a_class; else return SendClientMessage(playerid, col_grey, !"Use: /changeint [house id] [interior]");
    if(!(0 <= a_movehouse <= max_houses - 1)) return SendClientMessage(playerid, col_white, !""c_error"The house does not exist!");
    //if(a_class >=7) return SendClientMessage(playerid, col_white, !""c_error"The interior does not exist!");
    HouseInfo[a_movehouse][hInt] = a_class;
	UpdatePickupHouse(a_movehouse);
	SaveHouse(a_movehouse);
	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"House ID "c_server"#%d"c_info"Interior changed to "c_server"%d", a_class);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}
cmd:createhouse(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
    extract params -> new a_class, a_interior, a_cash, a_takings; else return SendClientMessage(playerid, col_grey, !"Use: /createhouse [class] [interior] [amount$] [rent$]");
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    max_houses++;
    HouseInfo[max_houses - 1][hEntrancex] = x;
	HouseInfo[max_houses - 1][hEntrancey] = y;
	HouseInfo[max_houses - 1][hEntrancez] = z;
	HouseInfo[max_houses - 1][hValue] = a_cash;
	HouseInfo[max_houses - 1][hKlass] = a_class - 1;
	HouseInfo[max_houses - 1][hInt] = a_interior;
	HouseInfo[max_houses - 1][hTakings] = a_takings;

	format(format_string, 522, "INSERT INTO `house`(`hID`, `hEntrancex`, `hEntrancey`, `hEntrancez`, `hKlass`, `hInt`, `hValue`, `hTakings`) VALUES ('%d', '%f', '%f', '%f', '%d', '%d', '%d', '%d')", max_houses - 1, HouseInfo[max_houses - 1][hEntrancex],  HouseInfo[max_houses - 1][hEntrancey],  HouseInfo[max_houses - 1][hEntrancez], HouseInfo[max_houses - 1][hKlass], HouseInfo[max_houses - 1][hInt], a_cash, a_takings);
    mysql_tquery(dbHandle, format_string);


    if(HouseInfo[max_houses - 1][hKlass] == 5) HouseInfo[max_houses - 1][hPickup] = CreatePickup(1273, 23, HouseInfo[max_houses - 1][hEntrancex], HouseInfo[max_houses - 1][hEntrancey], HouseInfo[max_houses - 1][hEntrancez],-1);
	else HouseInfo[max_houses - 1][hPickup] = CreatePickup(1273, 23, HouseInfo[max_houses - 1][hEntrancex], HouseInfo[max_houses - 1][hEntrancey], HouseInfo[max_houses - 1][hEntrancez],-1);
	HouseInfo[max_houses - 1][hMIcon] = CreateDynamicMapIcon(HouseInfo[max_houses - 1][hEntrancex], HouseInfo[max_houses - 1][hEntrancey], HouseInfo[max_houses - 1][hEntrancez], 31, -1, 0, -1, -1);

	new h_class = HouseInfo[max_houses - 1][hKlass];
	HouseInfo[max_houses - 1][hAreaExit] = CreateDynamicSphere(house_exit[h_class][0], house_exit[h_class][1], house_exit[h_class][2],3,max_houses);
	HouseInfo[max_houses - 1][hAreaEnter] = CreateDynamicSphere(HouseInfo[max_houses - 1][hEntrancex - 1], HouseInfo[max_houses - 1][hEntrancey], HouseInfo[max_houses - 1][hEntrancez],1.2,0);
	printf("new house: %d",max_houses);
    SendClientMessage(playerid, col_white, "New house has been created");
    return 1;
}
cmd:addcar(playerid, params[])
{
    if(admin_level[playerid] < 7) return 1;
    extract params -> new idplayer, idcar, ccolor1, ccolor2; else return SendClientMessage(playerid, col_grey, !"Use: /addcar [id] [model] [color1] [color2]");
    if(!IsPlayerConnected(idplayer)) return SendClientMessage(playerid, col_white, !""c_error"Player not found.");
    if(p_info[idplayer][pLogin] == 0) return SendClientMessage(playerid, col_white, !""c_error"Player is not logged in.");
    if(afk_time[idplayer] > 2) return SendClientMessage(playerid, col_white, !""c_error"The Player is AFK.");
	if(GetPlayerInterior(idplayer)) SendClientMessage(playerid, col_white, !""c_error"Player must not be in Interior (House/Shop)!");
	if(GetPlayerVirtualWorld(idplayer)) SendClientMessage(playerid, col_white, !""c_error"Player must not be in Virtualworld (House/Shop...)!");
	new slot_car = GetPlayerFreeCarSlot(playerid);
	if(slot_car == -1) return SendClientMessage(playerid, col_white, !""c_error"Player vehicles are full!");
	CarInfo[idplayer][cModel][slot_car] = idcar;
	CarInfo[idplayer][cColor1][slot_car] = ccolor1;
 	CarInfo[idplayer][cColor2][slot_car] = ccolor2;
   	SaveCars(idplayer);
   	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You have given player "c_server"%s"c_info" Vehicle "c_server"%d"c_info".", Name(idplayer), idcar);
	SendClientMessage(playerid, col_white, text_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"Admin "c_server"%s"c_info" Gave you "c_server"%d"c_info" Vehicle.", Name(playerid), idcar);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}
cmd:abiz(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
    extract params -> new a_biz; else return SendClientMessage(playerid, col_grey, !"Use: /abiz [business number]");
    if(!(0 <= a_biz <= TotalBizz)) return SendClientMessage(playerid, col_white, !""c_error"Business with that number not found.");

    SetPVarInt(playerid, "next_area", gettime() + 3);

	SetPlayerPos(playerid, BizzInfo[a_biz][bEntranceX], BizzInfo[a_biz][bEntranceY], BizzInfo[a_biz][bEntranceZ]);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerInterior(playerid, 0);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You have been teleported to business "c_server"%s [ #%d ]", BizzInfo[a_biz][bMessage], a_biz);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}

cmd:afuel(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
    extract params -> new a_fuel; else return SendClientMessage(playerid, col_grey, !"Use: /abiz [Gas station number]");
    if(!(0 <= a_fuel <= TotalABizz)) return SendClientMessage(playerid, col_white, !""c_error"Gas station with that number not found.");

    SetPlayerPos(playerid, BizzAInfo[a_fuel][aAreaFillX], BizzAInfo[a_fuel][aAreaFillY], BizzAInfo[a_fuel][aAreaFillZ]);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerInterior(playerid, 0);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You have been teleported to Gas station."c_server"%s [ #%d ]", BizzAInfo[a_fuel][aMessage], a_fuel);
	SendClientMessage(playerid, col_white, text_string);
	return 1;
}

cmd:delacc(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	extract params -> new string:name_player[24]; else return SendClientMessage(playerid, col_grey, !"Use: /delacc [Player Nick]");

	text_string[0] = EOS;
	mysql_format(dbHandle, text_string, sizeof(text_string), "SELECT `pID` FROM `accounts` WHERE `pName`='%e'", name_player);
	new Cache: result = mysql_query(dbHandle, text_string);

	if(cache_num_rows() == 0)
	{
	    text_string[0] = EOS;
	    format(text_string, sizeof(text_string), ""c_error"Player "c_server"%s"c_white" not found.", name_player);
	    return SendClientMessage(playerid, col_white, text_string);
	}

	cache_delete(result);

	if(GetPlayerID(name_player) != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_white, !""c_error"The Player Online.");

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), "DELETE FROM `accounts` WHERE `pName`='%s'", name_player);
	mysql_query(dbHandle, text_string);

	text_string[0] = EOS;
	format(text_string, sizeof(text_string), ""c_info"You successfully deleted the account."c_server"%s", name_player);
	return SendClientMessage(playerid, col_white, text_string);
}

